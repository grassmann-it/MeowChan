<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeowChan.PostBookmarksDialog" Width="680" Height="620" MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto,2*,Auto,Auto" RowSpacing="8">
        <TextBlock x:Name="Intro" Classes="section-title" TextWrapping="Wrap" />
        <ListBox x:Name="Bookmarks" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <StackPanel Grid.Row="2" Spacing="8">
            <TextBlock x:Name="Target" Classes="workspace-meta" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="8">
                <Button x:Name="OpenTarget" />
                <Button x:Name="Remove" Classes="danger" />
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="NoteLabel" Grid.Row="3" Classes="section-title" TextWrapping="Wrap" />
        <TextBox x:Name="Note" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        <ScrollViewer Grid.Row="5" MaxHeight="96" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="Status" TextWrapping="Wrap" Focusable="True" />
        </ScrollViewer>
        <Border Grid.Row="6" Classes="workspace-dialog-footer" Margin="-16,0,-16,-16">
            <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="8">
                <Button x:Name="Reload" />
                <Button x:Name="Save" Classes="primary" />
                <Button x:Name="Cancel" />
            </WrapPanel>
        </Border>
    </Grid>
</Window>
