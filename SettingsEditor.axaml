<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:local="clr-namespace:MeowChan"
             xmlns:localization="clr-namespace:MeowChan.Desktop.Localization"
             x:Class="MeowChan.SettingsEditor" x:DataType="local:SettingsEditor"
             SizeChanged="OnEditorSizeChanged">
    <UserControl.Styles>
        <!-- Keyboard focus enters the template's text box, so it needs the field semantics too. -->
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="AutomationProperties.Name" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="AutomationProperties.LabeledBy" Value="{Binding (AutomationProperties.LabeledBy), RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_IncreaseButton">
            <Setter Property="AutomationProperties.Name">
                <MultiBinding Converter="{x:Static local:SettingsEditor.NumericActionNameConverter}">
                    <Binding Path="IncreaseNumericValueFormat" />
                    <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource FindAncestor, AncestorType=NumericUpDown}" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_DecreaseButton">
            <Setter Property="AutomationProperties.Name">
                <MultiBinding Converter="{x:Static local:SettingsEditor.NumericActionNameConverter}">
                    <Binding Path="DecreaseNumericValueFormat" />
                    <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource FindAncestor, AncestorType=NumericUpDown}" />
                </MultiBinding>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel x:Name="SettingsHeader" Margin="20,20,20,16" Spacing="5" MaxWidth="880" HorizontalAlignment="Center">
            <TextBlock Text="{Binding SettingsTitle}" Classes="page-title" />
            <TextBlock Text="{Binding SettingsSubtitle}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Margin="20,0,20,16"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnSettingsScrollChanged">
            <StackPanel x:Name="SettingsContent" MaxWidth="880" HorizontalAlignment="Center" Spacing="20">
                <StackPanel Spacing="0" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding InterfaceTitle}" Classes="section-title" Margin="0,0,0,6" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <StackPanel VerticalAlignment="Center" Spacing="3">
                                <TextBlock x:Name="WorkspaceModeFieldLabel" Text="{Binding WorkspaceModeLabel}" FontWeight="Medium" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ModeHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="WorkspaceModeInput" AutomationProperties.LabeledBy="{Binding ElementName=WorkspaceModeFieldLabel}" AutomationProperties.Name="{Binding WorkspaceModeLabel}" AutomationProperties.HelpText="{Binding ModeHint}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding WorkspaceChoices}" SelectedItem="{Binding SelectedWorkspaceMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="LanguageFieldLabel" Text="{Binding LanguageLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <ComboBox x:Name="LanguageInput" AutomationProperties.LabeledBy="{Binding ElementName=LanguageFieldLabel}" AutomationProperties.Name="{Binding LanguageLabel}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="localization:LanguageInfo"><TextBlock Text="{Binding NativeName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="ThemeFieldLabel" Text="{Binding ThemeLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <ComboBox x:Name="ThemeInput" AutomationProperties.LabeledBy="{Binding ElementName=ThemeFieldLabel}" AutomationProperties.Name="{Binding ThemeLabel}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Padding="0,10">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="DensityFieldLabel" Text="{Binding DensityLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <CheckBox x:Name="CompactDensityInput" AutomationProperties.LabeledBy="{Binding ElementName=DensityFieldLabel}" AutomationProperties.Name="{Binding DensityLabel}" Grid.Column="1" Content="{Binding CompactLabel}" IsChecked="{Binding CompactDensity, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{Binding LanguagePacksLabel}">
                        <TextBlock Text="{Binding LanguagePacksHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                    </Expander>
                </StackPanel>
                <StackPanel Spacing="8" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding ReadingMediaTitle}" Classes="section-title" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="ReadingFontSizeFieldLabel" Text="{Binding ReadingFontSizeLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <ComboBox x:Name="ReadingFontSizeInput" AutomationProperties.LabeledBy="{Binding ElementName=ReadingFontSizeFieldLabel}" AutomationProperties.Name="{Binding ReadingFontSizeLabel}" Grid.Column="1" ItemsSource="{Binding ReadingFontSizeChoices}" SelectedItem="{Binding SelectedReadingFontSize, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <CheckBox Content="{Binding VideoAutoplayLabel}" IsChecked="{Binding VideoAutoplay, Mode=TwoWay}" />
                    <CheckBox Content="{Binding VideoStartMutedLabel}" IsChecked="{Binding VideoStartMuted, Mode=TwoWay}" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                        <TextBlock x:Name="VideoVolumeFieldLabel" Text="{Binding VideoVolumeLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                        <NumericUpDown x:Name="VideoVolumeInput" AutomationProperties.LabeledBy="{Binding ElementName=VideoVolumeFieldLabel}" AutomationProperties.Name="{Binding VideoVolumeLabel}" AutomationProperties.HelpText="{Binding VolumeHelp}" Grid.Column="1" Value="{Binding VideoVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1" />
                    </Grid>
                    <CheckBox x:Name="RememberReadingPositionInput" Content="{Binding RememberReadingPositionLabel}" IsChecked="{Binding RememberReadingPosition, Mode=TwoWay}" AutomationProperties.HelpText="{Binding ReadingPositionHint}" />
                    <TextBlock Text="{Binding ReadingPositionHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                    <Button x:Name="ForgetReadingPositionButton" Content="{Binding ForgetReadingPositionLabel}" AutomationProperties.Name="{Binding ForgetReadingPositionLabel}" Click="OnForgetReadingPositionClick" IsEnabled="{Binding CanForgetReadingPosition}" HorizontalAlignment="Left" />
                    <CheckBox Content="{Binding ShowShortcutHelpLabel}" IsChecked="{Binding ShowShortcutHelp, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Spacing="0" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding DownloadsTitle}" Classes="section-title" Margin="0,0,0,10" />
                    <StackPanel Spacing="6" Margin="0,0,0,10">
                        <TextBlock x:Name="DownloadPathFieldLabel" Text="{Binding DownloadPathLabel}" FontWeight="Medium" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="DownloadPathInput" AutomationProperties.LabeledBy="{Binding ElementName=DownloadPathFieldLabel}" AutomationProperties.Name="{Binding DownloadPathLabel}" AutomationProperties.HelpText="{Binding PathHint}" Text="{Binding DownloadPath, Mode=TwoWay}" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowseButtonClick" />
                        </Grid>
                        <TextBlock Text="{Binding PathHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="RecheckFieldLabel" Text="{Binding RecheckLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <NumericUpDown x:Name="RecheckTimerInput" AutomationProperties.LabeledBy="{Binding ElementName=RecheckFieldLabel}" AutomationProperties.Name="{Binding RecheckLabel}" AutomationProperties.HelpText="{Binding SecondsHelp}" Grid.Column="1" Value="{Binding RecheckTimer, Mode=TwoWay}" Minimum="10" Maximum="4294967" Increment="1" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="BandwidthFieldLabel" Text="{Binding BandwidthLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <NumericUpDown x:Name="BandwidthInput" AutomationProperties.LabeledBy="{Binding ElementName=BandwidthFieldLabel}" AutomationProperties.Name="{Binding BandwidthLabel}" AutomationProperties.HelpText="{Binding BandwidthHelp}" Grid.Column="1" Value="{Binding BandwidthLimiterMB, Mode=TwoWay}" Minimum="0" Increment="0.1" />
                        </Grid>
                    </Border>
                    <Border Padding="0,10">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                            <TextBlock x:Name="ParallelFieldLabel" Text="{Binding ParallelLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                            <NumericUpDown x:Name="ParallelDownloadsInput" AutomationProperties.LabeledBy="{Binding ElementName=ParallelFieldLabel}" AutomationProperties.Name="{Binding ParallelLabel}" Grid.Column="1" Value="{Binding MaxParallelDownloads, Mode=TwoWay}" Minimum="1" Maximum="2147483647" Increment="1" />
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="8" IsEnabled="{Binding IsEditable}">
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                        <TextBlock x:Name="ReserveFieldLabel" Text="{Binding ReserveLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                        <NumericUpDown x:Name="ReserveInput" Grid.Column="1" Value="{Binding MinimumFreeSpaceGiB, Mode=TwoWay}" Minimum="0" Maximum="2147483647" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReserveFieldLabel}" AutomationProperties.Name="{Binding ReserveLabel}" AutomationProperties.HelpText="{Binding ReserveHint}" />
                    </Grid>
                    <TextBlock Text="{Binding ReserveHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                    <Expander Header="{Binding AdvancedBudgetsLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10" Margin="0,8,0,0">
                            <TextBlock Text="{Binding BudgetRestartHint}" Classes="muted" TextWrapping="Wrap" />
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock x:Name="ProductionWorkersFieldLabel" Text="{Binding ProductionWorkersLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="ProductionWorkersInput" Grid.Column="1" Value="{Binding ProductionWorkers, Mode=TwoWay}" Minimum="1" Maximum="8" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ProductionWorkersFieldLabel}" AutomationProperties.Name="{Binding ProductionWorkersLabel}" AutomationProperties.HelpText="{Binding BudgetRestartHint}" />
                            </Grid>
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock x:Name="WorkerIdleMinutesFieldLabel" Text="{Binding WorkerIdleMinutesLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="WorkerIdleMinutesInput" Grid.Column="1" Value="{Binding WorkerIdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="30" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=WorkerIdleMinutesFieldLabel}" AutomationProperties.Name="{Binding WorkerIdleMinutesLabel}" AutomationProperties.HelpText="{Binding BudgetRestartHint}" />
                            </Grid>
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock x:Name="SourceHeapMiBFieldLabel" Text="{Binding SourceHeapMiBLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="SourceHeapMiBInput" Grid.Column="1" Value="{Binding SourceHeapMiB, Mode=TwoWay}" Minimum="128" Maximum="1024" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=SourceHeapMiBFieldLabel}" AutomationProperties.Name="{Binding SourceHeapMiBLabel}" AutomationProperties.HelpText="{Binding BudgetRestartHint}" />
                            </Grid>
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock x:Name="FilterHeapMiBFieldLabel" Text="{Binding FilterHeapMiBLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <NumericUpDown x:Name="FilterHeapMiBInput" Grid.Column="1" Value="{Binding FilterHeapMiB, Mode=TwoWay}" Minimum="256" Maximum="2048" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=FilterHeapMiBFieldLabel}" AutomationProperties.Name="{Binding FilterHeapMiBLabel}" AutomationProperties.HelpText="{Binding BudgetRestartHint}" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel Spacing="8" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding UpdatesTitle}" Classes="section-title" />
                    <CheckBox x:Name="AutomaticUpdatesInput" AutomationProperties.Name="{Binding AutomaticUpdateChecksLabel}" AutomationProperties.HelpText="{Binding UpdatePrivacyHint}" IsEnabled="{Binding UpdatesEnabled}" IsChecked="{Binding AutomaticUpdateChecks, Mode=TwoWay}">
                        <TextBlock Text="{Binding AutomaticUpdateChecksLabel}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox x:Name="PrereleaseUpdatesInput" AutomationProperties.Name="{Binding IncludePrereleaseUpdatesLabel}" IsEnabled="{Binding UpdatesEnabled}" IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}">
                        <TextBlock Text="{Binding IncludePrereleaseUpdatesLabel}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock x:Name="UpdatePrivacyText" Text="{Binding UpdatePrivacyHint}" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="UpdateDisabledText" Text="{Binding UpdateDisabledReason}" IsVisible="{Binding UpdatesDisabled}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="10" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding BehaviorTitle}" Classes="section-title" />
                    <CheckBox x:Name="BoardAdmissionWizardInput" Content="{Binding BoardAdmissionWizardLabel}" IsChecked="{Binding ShowBoardAdmissionWizard, Mode=TwoWay}" />
                    <CheckBox x:Name="RestoreSessionInput" Content="{Binding RestoreSessionLabel}" IsChecked="{Binding SaveUrlsOnExit, Mode=TwoWay}" />
                    <CheckBox x:Name="CloseToTrayInput" Content="{Binding CloseToTrayLabel}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    <CheckBox x:Name="MinimizeToTrayInput" Content="{Binding MinimizeToTrayLabel}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    <TextBlock Text="{Binding SupportedSources}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Button x:Name="AboutSettingsButton" Click="OnAboutButtonClick" HorizontalAlignment="Left" />
                </StackPanel>
                <ursa:Banner Type="Error" CanClose="False" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasError}"><TextBlock x:Name="SettingsError" Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" /></ursa:Banner>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Workspace.Border}">
            <Grid x:Name="SettingsFooter" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6" HorizontalAlignment="Center"
                  Width="{Binding Bounds.Width, ElementName=SettingsContent}">
                <TextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel x:Name="SettingsFooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right">
                    <Button x:Name="CancelSettingsButton" Click="OnCancelButtonClick" />
                    <Button x:Name="SaveSettingsButton" Classes="primary" Click="OnSaveButtonClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
