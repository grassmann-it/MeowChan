<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commands="clr-namespace:MeowChan.Desktop.Commands"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:ursa="https://irihi.tech/ursa" x:Class="MeowChan.ArchivePage" SizeChanged="OnSizeChanged">
    <Grid x:Name="ArchiveRoot" Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid x:Name="ArchivePageHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Tag="nav.archive" Classes="page-title localized" />
                <TextBlock x:Name="ArchiveSubtitle" Tag="archive.subtitle" Classes="muted localized" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Top" ItemSpacing="8" LineSpacing="6">
                <Button x:Name="ArchiveCleanupOpen" Click="OnArchiveCleanupClick" />
                <Button x:Name="RefreshArchiveButton" Tag="archive.refresh" Classes="localized" Click="OnRefreshClick" />
            </WrapPanel>
        </Grid>
        <Grid x:Name="ArchiveSplit" Grid.Row="1" ColumnDefinitions="270,6,*" ColumnSpacing="6" Grid.IsSharedSizeScope="True">
            <Grid x:Name="ArchiveListPane" RowSpacing="6">
                <Grid.RowDefinitions>
                    <!-- Share the real pane height after its fixed pagination;
                         search/drafts/chips scroll before results lose their viewport. -->
                    <RowDefinition Height="*" MaxHeight="260" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" SharedSizeGroup="ArchiveFooter" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ArchiveSearchPanelScroll" MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox x:Name="ArchiveSearchText" MaxLength="512" KeyDown="OnSearchKeyDown" />
                        <Button x:Name="SearchArchiveButton" Grid.Column="1" Tag="archive.search" Classes="localized" Click="OnSearchClick" />
                    </Grid>
                    <Expander x:Name="ArchiveFilters" Grid.Row="1" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <desktop:IdentitySuggestionBox x:Name="ArchiveSourceFilter" KeyDown="OnSearchKeyDown" />
                                <Button x:Name="ArchiveAddSource" Grid.Column="1" Click="OnAddSource" />
                            </Grid>
                            <WrapPanel x:Name="ArchiveDraftSources" ItemSpacing="6" LineSpacing="6" />
                            <ComboBox x:Name="ArchiveBoardScope" HorizontalAlignment="Stretch"  />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <desktop:IdentitySuggestionBox x:Name="ArchiveBoardFilter" KeyDown="OnSearchKeyDown" />
                                <Button x:Name="ArchiveAddBoard" Grid.Column="1" Click="OnAddBoard" />
                            </Grid>
                            <WrapPanel x:Name="ArchiveDraftBoards" ItemSpacing="6" LineSpacing="6" />
                            <TextBlock x:Name="ArchiveSuggestionsHint" TextWrapping="Wrap" Classes="muted" FontSize="11" />
                            <Button x:Name="ArchiveRetrySuggestions" HorizontalAlignment="Left" IsVisible="False" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <ComboBox x:Name="ArchiveStateFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <Button x:Name="ArchiveAddState" Grid.Column="1" Click="OnAddState" />
                            </Grid>
                            <WrapPanel x:Name="ArchiveDraftStates" ItemSpacing="6" LineSpacing="6" />
                            <ComboBox x:Name="ArchiveCaptureFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchivePostsFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveWorkFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveSort" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <TextBlock x:Name="ArchiveDateTitle" TextWrapping="Wrap" />
                            <TextBlock x:Name="ArchiveDateFromLabel" />
                            <desktop:ArchiveDateEditor x:Name="ArchiveStartDate" />
                            <TextBlock x:Name="ArchiveDateToLabel" />
                            <desktop:ArchiveDateEditor x:Name="ArchiveEndDate" />
                            <TextBlock x:Name="ArchiveDateZone" TextWrapping="Wrap" Classes="muted" />
                            <Button x:Name="ArchiveUseDeviceZone" Click="OnUseDeviceZone" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ArchiveDateHint" TextWrapping="Wrap" Classes="muted" FontSize="11" />
                        </StackPanel>
                    </Expander>
                    <WrapPanel x:Name="ArchiveAppliedFilters" Grid.Row="2" ItemSpacing="6" LineSpacing="6" />
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock x:Name="ArchiveSearchError" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        <Button x:Name="ArchiveRetrySearch" Click="OnRetrySearch" IsVisible="False" HorizontalAlignment="Left" />
                    </StackPanel>
                    <desktop:ActionToolBar x:Name="ArchiveResultActions" Grid.Row="4">
                        <Button x:Name="ArchiveLayoutList" Content="List" ursa:ToolBar.OverflowMode="Never" />
                        <Button x:Name="ArchiveLayoutTable" Content="Table" ursa:ToolBar.OverflowMode="Never" />
                        <Button x:Name="ArchiveResultsGallery" Tag="gallery.results" Classes="localized" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveThreadColumnsButton" Content="Columns" ursa:ToolBar.OverflowMode="AsNeeded" IsVisible="False" />
                        <Button x:Name="ArchiveFavoritesOverview" Content="★ Favorites" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveResultsExport" Content="HTML…" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveReaderGroups" Content="Reader groups" Click="OnReaderGroupsClick" />
                        <Button x:Name="ArchiveSaveSearch" Click="OnSaveCurrentSearchClick" />
                        <Button x:Name="ArchiveSavedSearches" Click="OnSavedSearchesClick" />
                    </desktop:ActionToolBar>
                </Grid></ScrollViewer>
                <Border x:Name="ArchiveResultsSurface" Grid.Row="1" Classes="panel">
                    <Grid>
                        <ListBox x:Name="ArchiveThreads" SelectionMode="Multiple" SelectionChanged="OnThreadSelected" DoubleTapped="OnThreadDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="desktop:ArchiveThreadRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="8">
                                        <Grid.ContextMenu>
                                            <ContextMenu Opening="OnArchiveSelectionMenuOpening">
                                                <MenuItem Header="{Binding GalleryLabel}" Click="OnThreadGalleryMenu" />
                                                <MenuItem Header="{Binding ReadLabel}" Click="OnThreadReadMenu" />
                                                <MenuItem Tag="selection.export" Classes="localized" Header="Export selection…" Click="OnThreadExportMenu" />
                                                <MenuItem Tag="action.details" Classes="localized" Header="Details" Click="OnArchiveSelectionDetails" />
                                                <MenuItem Tag="check.action" Classes="localized" Header="Check now" Click="OnArchiveCheckSelection" />
                                                <MenuItem Tag="work.retry" Classes="localized" Header="Retry missing media" Click="OnArchiveRetrySelection" />
                                                <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" CommandParameter="rules" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" CommandParameter="folder" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" CommandParameter="browser" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="selection.copyUrls" Classes="localized" Header="Copy selected URLs" Click="OnArchiveCopySelection" />
                                                <MenuItem Tag="selection.remove" Classes="localized" Header="Remove selection" Click="OnArchiveRemoveSelection" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Panel x:DataType="desktop:ArchiveThreadRow" IsVisible="{Binding HasPreviewAttachment}">
                                            <desktop:ArchiveAttachmentView DataContext="{Binding PreviewAttachment}" Width="76" />
                                        </Panel>
                                        <desktop:ArchiveThreadFavoriteButton Grid.Column="2" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding TitleOrId}" ToolTip.Tip="{Binding TitleOrId}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                            <TextBlock Text="{Binding Identity}" ToolTip.Tip="{Binding Identity}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DataGrid x:Name="ArchiveThreadTable" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended"
                                  PointerReleased="OnArchiveColumnsReleased"
                                  SelectionChanged="OnThreadTableSelected" DoubleTapped="OnThreadTableDoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Source / board" SortMemberPath="Identity" Width="150" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding Identity}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Identity}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Title / ID" SortMemberPath="TitleOrId" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding TitleOrId}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitleOrId}" VerticalAlignment="Center" /><desktop:ArchiveThreadFavoriteButton Grid.Column="1" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Posts" Width="65" MinWidth="55" Binding="{Binding Posts, DataType=desktop:ArchiveThreadRow}" />
                                <DataGridTemplateColumn Header="Media" SortMemberPath="SavedMediaCount" Width="80" MinWidth="65"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactMedia}" ToolTip.Tip="{Binding MediaStatus}" AutomationProperties.HelpText="{Binding MediaStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Source" SortMemberPath="CompactSource" Width="90" MinWidth="75"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactSource}" ToolTip.Tip="{Binding SourceStatus}" AutomationProperties.HelpText="{Binding SourceStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Work" SortMemberPath="CompactWork" Width="110" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactWork}" ToolTip.Tip="{Binding WorkStatus}" AutomationProperties.HelpText="{Binding WorkStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last capture" Width="145" MinWidth="125" Binding="{Binding LastCapture, DataType=desktop:ArchiveThreadRow}" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu><ContextMenu Opening="OnArchiveSelectionMenuOpening">
                                <MenuItem x:Name="ArchiveTableGalleryMenu" Header="Open in gallery" Click="OnThreadGalleryMenu" />
                                <MenuItem x:Name="ArchiveTableReadMenu" Header="Read posts" Click="OnThreadReadMenu" />
                                <MenuItem x:Name="ArchiveTableExportMenu" Header="Export selection…" Click="OnThreadExportMenu" />
                                <MenuItem Tag="selection.copyUrls" Classes="localized" Header="Copy selected URLs" Click="OnArchiveCopySelection" />
                                <MenuItem Tag="action.details" Classes="localized" Header="Details" Click="OnArchiveSelectionDetails" />
                                <MenuItem Tag="check.action" Classes="localized" Header="Check now" Click="OnArchiveCheckSelection" />
                                <MenuItem Tag="work.retry" Classes="localized" Header="Retry missing media" Click="OnArchiveRetrySelection" />
                                <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" CommandParameter="rules" Click="OnArchiveLeadAction" />
                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" CommandParameter="folder" Click="OnArchiveLeadAction" />
                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" CommandParameter="browser" Click="OnArchiveLeadAction" />
                                <Separator />
                                <MenuItem x:Name="ArchiveTableRemoveMenu" Tag="selection.remove" Classes="localized" Header="Remove selection" Click="OnArchiveRemoveSelection" />
                            </ContextMenu></DataGrid.ContextMenu>
                        </DataGrid>
                        <StackPanel x:Name="ArchiveEmptyState" Margin="12" Spacing="8" IsVisible="False">
                            <TextBlock x:Name="ArchiveEmpty" Classes="muted" TextWrapping="Wrap" />
                            <Button x:Name="ArchiveReaderGroupsEmpty" Content="Reader groups" Click="OnReaderGroupsClick" />
                            <Button x:Name="ArchiveResetFilters" HorizontalAlignment="Left" Click="OnResetArchiveFiltersClick" />
                        </StackPanel>
                    </Grid>
                </Border>
                <StackPanel x:Name="ArchiveResultsFooter" Grid.Row="2" Spacing="4" Margin="8,0" VerticalAlignment="Top">
                    <ursa:Pagination x:Name="ArchiveResultsPagination" PageSize="50" ShowPageSizeSelector="False" ShowQuickJump="False" CurrentPageChanged="OnResultsPageChanged" HorizontalAlignment="Center">
                        <ursa:Pagination.Styles><Style Selector="ursa|PaginationButton"><Setter Property="MinWidth" Value="24" /><Setter Property="Width" Value="24" /><Setter Property="Padding" Value="2" /></Style></ursa:Pagination.Styles>
                    </ursa:Pagination>
                    <TextBlock x:Name="ArchiveThreadPage" Classes="workspace-meta" HorizontalAlignment="Center" />
                    <TextBlock x:Name="ArchiveSelectionSummary" Classes="workspace-meta" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
                    <Button x:Name="PreviousThreadsButton" IsVisible="False" Click="OnPreviousThreads" />
                    <Button x:Name="NextThreadsButton" IsVisible="False" Click="OnNextThreads" />
                </StackPanel>
            </Grid>
            <GridSplitter x:Name="ArchiveSplitter" Grid.Column="1" Width="6" ResizeDirection="Columns" PointerReleased="OnArchiveSplitReleased" KeyUp="OnArchiveSplitKeyUp" />
            <Grid x:Name="ArchiveReaderPane" Grid.Column="2" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" SharedSizeGroup="ArchiveFooter" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button x:Name="ArchiveBackButton" Tag="archive.back" Classes="localized" Click="OnBackClick" />
                        <TextBlock x:Name="ArchiveReaderTitle" Grid.Column="1" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="CapturePostsButton" Grid.Column="2" Click="OnCaptureClick" />
                    </Grid>
                    <WrapPanel x:Name="ReaderToolbar" HorizontalAlignment="Left" ItemSpacing="8" LineSpacing="6">
                        <WrapPanel.Styles><Style Selector="Button"><Setter Property="MinWidth" Value="38" /><Setter Property="Height" Value="32" /></Style></WrapPanel.Styles>
                    <Button x:Name="ArchiveCloseReader" Tag="reader.close" Classes="localized" IsVisible="False" Click="OnCloseReaderClick" />
                    <desktop:ArchiveThreadFavoriteButton x:Name="ArchiveCurrentThreadFavorite" />
                    <Button x:Name="ArchiveOpenGallery" Tag="gallery.open" Classes="localized" Click="OnCurrentGalleryClick" />
                    <Button x:Name="ArchiveReadPosts" Tag="gallery.read" Classes="localized" Click="OnReadPostsClick" />
                    <Button x:Name="ArchiveGalleryReturn" Content="Back to gallery" IsVisible="False" Click="OnGalleryReturnClick" />
                    <Button x:Name="ArchiveReaderFullscreen" Content="Full screen" Click="OnReaderFullscreenClick" />
                    <Button x:Name="ExportArchiveButton" Tag="archive.export" Classes="localized" Click="OnExportClick" />
                    <!-- URSA-12: explicit skip preserves the displayed post on missing group targets. -->
                    <Button x:Name="ReaderSkipUnavailableGroupMember" IsVisible="False" Click="OnSkipUnavailableGroupMember" />
                    <Button x:Name="ArchiveHistoryBack" Tag="archive.historyBack" Classes="localized" Click="OnHistoryBack" IsVisible="False" />
                    </WrapPanel>
                    <TextBlock x:Name="ReaderGroupAvailabilityMessage" IsVisible="False" TextWrapping="Wrap" />
                    <WrapPanel x:Name="ReaderStatusLine" Orientation="Horizontal">
                        <TextBlock x:Name="ArchiveReaderStatus" Classes="muted" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="ReaderFollowLive" IsEnabled="False" IsCheckedChanged="OnReaderFollowLiveChanged" Margin="0,0,12,0" />
                        <TextBlock x:Name="ReaderNewPostsNotice" IsVisible="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="ReaderShowNewPosts" IsVisible="False" Click="OnShowReaderUpdates" />
                    </WrapPanel>
                </StackPanel>
                <Border x:Name="ArchiveReaderContent" Grid.Row="1" Classes="panel">
                    <Grid x:Name="ReaderContentSurface">
                        <TextBlock x:Name="ArchiveSelectHint" Tag="archive.select" Classes="muted localized" Margin="16" />
                        <TabControl x:Name="ArchiveContentTabs" IsVisible="False">
                            <TabItem x:Name="ArchivePostsTab" Header="Posts">
                                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                    <Grid>
                                        <ListBox x:Name="ArchivePosts" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                                <Style Selector="ListBoxItem:selected">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.ReaderActiveSurface}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.ReaderActiveSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.ReaderActiveSurface}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.ReaderActiveSurface}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="desktop:ArchivePostRow">
                                                    <StackPanel Margin="8,8,8,12" Spacing="6">
                                                        <TextBlock Text="{Binding Header}" Classes="workspace-meta" />
                                                        <TextBlock Text="{Binding Subject}" Classes="section-title" TextWrapping="Wrap" />
                                                        <desktop:ReaderPostLayout>
                                                            <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" HorizontalAlignment="Left">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="desktop:ArchiveAttachmentRow">
                                                                        <desktop:ArchiveAttachmentView Margin="0,2,0,8" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel Spacing="6">
                                                                <!-- The Semi text theme sets FontSize locally; explicitly honor the reader preference. -->
                                                                <desktop:ReaderBodyTextBlock Text="{Binding Body}" IsTextOnly="{Binding IsTextOnly}" FontSize="{Binding $parent[ListBox].FontSize}" TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Quotes}">
                                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                            <Button Content="{Binding Label}" ToolTip.Tip="{Binding AccessibleLabel}" AutomationProperties.Name="{Binding AccessibleLabel}" commands:CommandPresentation.Id="reader.open-quote" Click="OnQuoteClick" Margin="0,2,6,2" HorizontalAlignment="Left" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding BacklinksLabel}" IsVisible="{Binding HasConfirmedNoReplies}" Classes="muted" FontSize="12" />
                                                                <Expander Header="{Binding BacklinksLabel}" IsVisible="{Binding CanExpandReplies}" IsExpanded="{Binding RepliesExpanded, Mode=TwoWay}"
                                                                          Expanded="OnRepliesExpanded" Collapsed="OnRepliesCollapsed" HorizontalAlignment="Left" MinHeight="0" Padding="0">
                                                                    <StackPanel Margin="12,4,0,4" Spacing="4">
                                                                        <ItemsControl ItemsSource="{Binding Replies}">
                                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                                    <Button Content="{Binding Label}" ToolTip.Tip="{Binding AccessibleLabel}" AutomationProperties.Name="{Binding AccessibleLabel}" commands:CommandPresentation.Id="reader.open-quote" Click="OnQuoteClick" Margin="0,2,6,2" HorizontalAlignment="Left" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBlock Text="{Binding RepliesLoadingLabel}" IsVisible="{Binding RepliesLoading}" Classes="muted" />
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMoreReplies}">
                                                                            <Button Content="{Binding MoreRepliesLabel}" commands:CommandPresentation.Id="reader.show-replies" Click="OnMoreRepliesClick" />
                                                                            <TextBlock Text="{Binding RepliesPageLabel}" VerticalAlignment="Center" Classes="muted" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Expander>
                                                                <TextBlock Text="{Binding RepliesError}" IsVisible="{Binding HasRepliesError}" TextWrapping="Wrap" Foreground="{DynamicResource Workspace.Error}" />
                                                            </StackPanel>
                                                        </desktop:ReaderPostLayout>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoPosts" Tag="archive.noPosts" Classes="muted localized" TextWrapping="Wrap" Margin="16" />
                                    </Grid>
                                    <Grid x:Name="ArchivePostNavigation" Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" Margin="8" ColumnSpacing="8">
                                        <Button x:Name="PreviousPostsButton" Tag="archive.previous" Classes="localized" Click="OnPreviousPosts" />
                                        <TextBlock x:Name="ArchivePostPage" Grid.Column="1" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextPostsButton" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextPosts" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveMediaTab" Header="Media">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6" Margin="6,2">
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                        <Button x:Name="ArchiveMediaMode" Tag="gallery.tiles" Classes="localized" Click="OnMediaModeClick" />
                                        <Button x:Name="ArchiveMediaColumnsButton" Content="Columns" Click="OnArchiveColumnsClick" IsVisible="False" />
                                        <Button x:Name="ArchiveFavoritesFilter" Content="☆ Favorites only" Click="OnArchiveFavoritesFilterClick" />
                                        <ComboBox x:Name="ArchiveRatingFilter" MinWidth="140" SelectionChanged="OnMediaRatingFilterChanged" />
                                        <ComboBox x:Name="ArchiveMediaSort" MinWidth="160" SelectedIndex="0" SelectionChanged="OnMediaSortChanged" />
                                        <ComboBox x:Name="ArchiveVersionScope" SelectedIndex="1" SelectionChanged="OnVersionScopeChanged" MinWidth="210" />
                                    </WrapPanel>
                                    <Grid x:Name="ArchiveMediaSurface" Grid.Row="1">
                                        <DataGrid x:Name="ArchiveMediaGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single" SelectionChanged="OnMediaSelected" DoubleTapped="OnMediaDoubleTapped" GridLinesVisibility="None" PointerReleased="OnArchiveColumnsReleased">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*" MinWidth="220" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveAssetRow"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTextColumn Width="85" MinWidth="70" Binding="{Binding Size, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="125" MinWidth="100" Binding="{Binding Version, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="130" MinWidth="100" Binding="{Binding RatingLabel, DataType=desktop:ArchiveAssetRow}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ListBox x:Name="ArchiveMediaTiles" IsVisible="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnMediaSelected" DoubleTapped="OnMediaDoubleTapped">
                                            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
                                            <ListBox.ItemsPanel><ItemsPanelTemplate><desktop:MediaTilePanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveAssetRow">
                                                <desktop:ArchiveMediaTileView />
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoMedia" Tag="archive.noMedia" Classes="muted localized" TextWrapping="Wrap" Margin="8,40,8,8" />
                                    </Grid>
                                    <StackPanel x:Name="ArchiveMediaFooter" Grid.Row="2" Spacing="6"><TextBlock x:Name="ArchiveRatingStatus" Classes="error" TextWrapping="Wrap" IsVisible="False" /><WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6"><Button x:Name="ArchiveEditRatingButton" IsEnabled="False" Click="OnEditMediaRatingClick" /><Button x:Name="PreviewArchiveMediaButton" Tag="archive.preview" Classes="localized" Click="OnPreviewClick" /></WrapPanel></StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveReferencesTab">
                                <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
                                    <TextBlock x:Name="ArchiveReferencesTitle" TextWrapping="Wrap" Classes="muted" />
                                    <ListBox x:Name="ArchiveReferences" Grid.Row="1">
                                        <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                            <Button Content="{Binding Label}" commands:CommandPresentation.Id="reader.open-quote" Click="OnQuoteClick" HorizontalAlignment="Stretch" Margin="0,3" />
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid x:Name="ArchiveReferencesNavigation" Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Button x:Name="PreviousReferences" Tag="archive.previous" Classes="localized" Click="OnPreviousReferences" />
                                        <TextBlock x:Name="ArchiveReferencesPage" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextReferences" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextReferences" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                        <WrapPanel x:Name="ReaderNavigation" IsVisible="False" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,24,56" ZIndex="1">
                            <Border Classes="raised" Padding="4" CornerRadius="8">
                                <Grid RowDefinitions="32,32,32" ColumnDefinitions="32,32,32" RowSpacing="2" ColumnSpacing="2">
                                    <Grid.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
                                            <Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="4" />
                                        </Style>
                                    </Grid.Styles>
                                    <Button x:Name="ReaderPreviousPost" Grid.Column="1" Tag="reader.previousPost" Classes="localized" Click="OnReaderNavigationClick" />
                                    <Button x:Name="ReaderNextPost" Grid.Row="2" Grid.Column="1" Tag="reader.nextPost" Classes="localized" Click="OnReaderNavigationClick" />
                                    <Button x:Name="ReaderPreviousThread" Grid.Row="1" Tag="reader.previousThread" Classes="localized" Click="OnReaderNavigationClick" />
                                    <Button x:Name="ReaderNextThread" Grid.Row="1" Grid.Column="2" Tag="reader.nextThread" Classes="localized" Click="OnReaderNavigationClick" />
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>
                <TextBlock x:Name="ArchivePartialHint" Grid.Row="2" Tag="archive.partial" Classes="muted localized" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ursa:LoadingIcon x:Name="ArchiveContentLoading" Width="16" Height="16" Focusable="False" IsVisible="False" />
                <TextBlock x:Name="ArchiveContentLoadingText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="ArchiveMessage" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ursa:LoadingIcon x:Name="ArchiveMediaLoading" Width="16" Height="16" Focusable="False" IsVisible="False" />
                <TextBlock x:Name="ArchiveMediaLoadingText" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
            <ursa:Banner x:Name="ArchiveErrorBanner" Type="Error" CanClose="False" IsVisible="False" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="104" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ArchiveErrorText" TextWrapping="Wrap" Classes="error" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
            </ursa:Banner>
        </StackPanel>
        <Border x:Name="ArchivePreview" Grid.RowSpan="3" Classes="panel" Padding="12" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PreviewTitle" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="ClosePreviewButton" Grid.Column="1" Tag="action.close" Classes="localized" Click="OnClosePreview" />
                </Grid>
                <Grid Grid.Row="1">
                    <Image x:Name="ArchivePreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="ArchivePreviewMessage" Classes="muted" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="ArchivePreviewPath" IsReadOnly="True" />
                    <Button Grid.Column="1" Tag="action.openFolder" Classes="localized" Click="OnOpenMediaFolder" />
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="ArchiveExportDialog" IsVisible="False" Background="#A6000000" Grid.RowSpan="3" ZIndex="20" />
    </Grid>
</UserControl>
