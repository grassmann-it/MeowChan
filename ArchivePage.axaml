<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" x:Class="MeowChan.ArchivePage" SizeChanged="OnSizeChanged">
    <Grid x:Name="ArchiveRoot" Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Tag="nav.archive" Classes="page-title localized" />
                <TextBlock x:Name="ArchiveSubtitle" Tag="archive.subtitle" Classes="muted localized" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshArchiveButton" Grid.Column="1" VerticalAlignment="Top" Tag="archive.refresh" Classes="localized" Click="OnRefreshClick" />
        </Grid>
        <Grid x:Name="ArchiveSplit" Grid.Row="1" ColumnDefinitions="270,*" ColumnSpacing="12">
            <Grid x:Name="ArchiveListPane" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <StackPanel Spacing="6">
                    <TextBox x:Name="ArchiveSearchText" MaxLength="512" KeyDown="OnSearchKeyDown" />
                    <Expander x:Name="ArchiveFilters" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="5">
                            <TextBox x:Name="ArchiveSourceFilter" />
                            <TextBox x:Name="ArchiveBoardFilter" />
                            <ComboBox x:Name="ArchiveStateFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveCaptureFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchivePostsFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveSort" HorizontalAlignment="Stretch" SelectedIndex="0" />
                        </StackPanel>
                    </Expander>
                    <Button x:Name="SearchArchiveButton" Tag="archive.search" Classes="localized" Click="OnSearchClick" />
                </StackPanel>
                <Border Grid.Row="1" Classes="panel">
                    <Grid>
                        <ListBox x:Name="ArchiveThreads" SelectionChanged="OnThreadSelected">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="desktop:ArchiveThreadRow">
                                    <StackPanel Spacing="4" Margin="5,6">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Identity}" Classes="muted" FontSize="12" />
                                        <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ArchiveEmpty" Tag="archive.empty" Classes="muted localized" TextWrapping="Wrap" Margin="12" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Button x:Name="PreviousThreadsButton" Tag="archive.previous" Classes="localized" Click="OnPreviousThreads" />
                    <TextBlock x:Name="ArchiveThreadPage" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Button x:Name="NextThreadsButton" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextThreads" />
                </Grid>
            </Grid>
            <Grid x:Name="ArchiveReaderPane" Grid.Column="1" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button x:Name="ArchiveBackButton" Tag="archive.back" Classes="localized" Click="OnBackClick" />
                        <TextBlock x:Name="ArchiveReaderTitle" Grid.Column="1" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="CapturePostsButton" Grid.Column="2" Click="OnCaptureClick" />
                    </Grid>
                    <WrapPanel>
                    <Button x:Name="ExportArchiveButton" Tag="archive.export" Classes="localized" Click="OnExportClick" HorizontalAlignment="Left" Margin="0,0,8,0" />
                    <Button x:Name="ArchiveHistoryBack" Tag="archive.historyBack" Classes="localized" Click="OnHistoryBack" HorizontalAlignment="Left" IsVisible="False" />
                    </WrapPanel>
                    <TextBlock x:Name="ArchiveReaderStatus" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                </StackPanel>
                <Border Grid.Row="1" Classes="panel">
                    <Grid>
                        <TextBlock x:Name="ArchiveSelectHint" Tag="archive.select" Classes="muted localized" Margin="16" />
                        <TabControl x:Name="ArchiveContentTabs" IsVisible="False">
                            <TabItem x:Name="ArchivePostsTab" Header="Posts">
                                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                    <Grid>
                                        <ListBox x:Name="ArchivePosts" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="desktop:ArchivePostRow">
                                                    <StackPanel Margin="8,8,8,12" Spacing="6">
                                                        <TextBlock Text="{Binding Header}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="8" SizeChanged="OnPostLayoutChanged">
                                                            <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" MaxWidth="268" HorizontalAlignment="Left">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="desktop:ArchiveAttachmentRow">
                                                                        <desktop:ArchiveAttachmentView Margin="0,2,0,8" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel Grid.Column="1" Spacing="6">
                                                                <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Quotes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                            <Button Content="{Binding Label}" Click="OnQuoteClick" Margin="0,2" HorizontalAlignment="Left" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Button Content="{Binding BacklinksLabel}" Click="OnBacklinksClick" HorizontalAlignment="Left" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoPosts" Tag="archive.noPosts" Classes="muted localized" TextWrapping="Wrap" Margin="16" />
                                    </Grid>
                                    <Grid x:Name="ArchivePostNavigation" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8" ColumnSpacing="8">
                                        <Button x:Name="PreviousPostsButton" Tag="archive.previous" Classes="localized" Click="OnPreviousPosts" />
                                        <TextBlock x:Name="ArchivePostPage" Grid.Column="1" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextPostsButton" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextPosts" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveMediaTab" Header="Media">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
                                    <TextBlock Tag="archive.mediaHint" Classes="muted localized" FontSize="12" TextWrapping="Wrap" />
                                    <Grid Grid.Row="1">
                                        <DataGrid x:Name="ArchiveMediaGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="OnMediaSelected" GridLinesVisibility="None">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Width="*" Binding="{Binding Name, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="85" Binding="{Binding Size, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="125" Binding="{Binding Version, DataType=desktop:ArchiveAssetRow}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock x:Name="ArchiveNoMedia" Tag="archive.noMedia" Classes="muted localized" TextWrapping="Wrap" Margin="8,40,8,8" />
                                    </Grid>
                                    <Button x:Name="PreviewArchiveMediaButton" Grid.Row="2" Tag="archive.preview" Classes="localized" HorizontalAlignment="Right" Click="OnPreviewClick" />
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveReferencesTab">
                                <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
                                    <TextBlock x:Name="ArchiveReferencesTitle" TextWrapping="Wrap" Classes="muted" />
                                    <ListBox x:Name="ArchiveReferences" Grid.Row="1">
                                        <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                            <Button Content="{Binding Label}" Click="OnQuoteClick" HorizontalAlignment="Stretch" Margin="0,3" />
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                        <Button x:Name="PreviousReferences" Tag="archive.previous" Classes="localized" Click="OnPreviousReferences" />
                                        <TextBlock x:Name="ArchiveReferencesPage" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextReferences" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextReferences" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
                <TextBlock x:Name="ArchivePartialHint" Grid.Row="2" Tag="archive.partial" Classes="muted localized" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Grid>
        <TextBlock x:Name="ArchiveMessage" Grid.Row="2" Classes="muted" TextWrapping="Wrap" />
        <Border x:Name="ArchivePreview" Grid.RowSpan="3" Classes="panel" Padding="12" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PreviewTitle" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="ClosePreviewButton" Grid.Column="1" Tag="action.close" Classes="localized" Click="OnClosePreview" />
                </Grid>
                <Grid Grid.Row="1">
                    <Image x:Name="ArchivePreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="ArchivePreviewMessage" Classes="muted" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="ArchivePreviewPath" IsReadOnly="True" />
                    <Button Grid.Column="1" Tag="action.openFolder" Classes="localized" Click="OnOpenMediaFolder" />
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="ArchiveExportDialog" Grid.RowSpan="3" Classes="panel" Padding="16" IsVisible="False" KeyDown="OnExportKeyDown">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
                <TextBlock Tag="archive.export" Classes="section-title localized" />
                <TextBlock x:Name="ArchiveExportSummary" Grid.Row="1" TextWrapping="Wrap" />
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <TextBlock Tag="archive.exportHint" Classes="muted localized" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="ArchiveExportDestination" />
                        <Button x:Name="ArchiveExportBrowse" Grid.Column="1" Tag="archive.exportBrowse" Classes="localized" Click="OnExportBrowse" />
                    </Grid>
                    <CheckBox x:Name="ArchiveExportMedia" IsChecked="True" />
                    <TextBlock x:Name="ArchiveExportStatus" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                </ScrollViewer>
                <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                    <Button x:Name="ArchiveExportClose" Tag="action.close" Classes="localized" Click="OnExportClose" />
                    <Button x:Name="ArchiveExportOpen" Grid.Column="2" Tag="action.openFolder" Classes="localized" Click="OnExportOpen" IsVisible="False" />
                    <Button x:Name="ArchiveExportStart" Grid.Column="3" Tag="archive.exportStart" Classes="localized" Click="OnExportStart" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
