<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" x:Class="MeowChan.ArchivePage" SizeChanged="OnSizeChanged">
    <Grid x:Name="ArchiveRoot" Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid x:Name="ArchivePageHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Tag="nav.archive" Classes="page-title localized" />
                <TextBlock x:Name="ArchiveSubtitle" Tag="archive.subtitle" Classes="muted localized" TextWrapping="Wrap" />
            </StackPanel>
            <Button x:Name="RefreshArchiveButton" Grid.Column="1" VerticalAlignment="Top" Tag="archive.refresh" Classes="localized" Click="OnRefreshClick" />
        </Grid>
        <Grid x:Name="ArchiveSplit" Grid.Row="1" ColumnDefinitions="270,6,*" ColumnSpacing="6">
            <Grid x:Name="ArchiveListPane" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBox x:Name="ArchiveSearchText" MaxLength="512" KeyDown="OnSearchKeyDown" />
                        <Button x:Name="SearchArchiveButton" Grid.Column="1" Tag="archive.search" Classes="localized" Click="OnSearchClick" />
                    </Grid>
                    <Expander x:Name="ArchiveFilters" Grid.Row="1" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="5">
                            <TextBox x:Name="ArchiveSourceFilter" />
                            <TextBox x:Name="ArchiveBoardFilter" />
                            <ComboBox x:Name="ArchiveStateFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveCaptureFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchivePostsFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveWorkFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            <ComboBox x:Name="ArchiveSort" HorizontalAlignment="Stretch" SelectedIndex="0" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                        <Button x:Name="ArchiveLayoutList" Content="List" Click="OnArchiveLayoutClick" />
                        <Button x:Name="ArchiveLayoutTable" Content="Table" Click="OnArchiveLayoutClick" />
                        <Button x:Name="ArchiveThreadColumnsButton" Content="Columns" Click="OnArchiveColumnsClick" IsVisible="False" />
                        <Button x:Name="ArchiveResultsGallery" Tag="gallery.results" Classes="localized" Click="OnResultsGalleryClick" />
                        <Button x:Name="ArchiveFavoritesOverview" Content="★ Favorites" Click="OnFavoritesOverviewClick" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Classes="panel">
                    <Grid>
                        <ListBox x:Name="ArchiveThreads" SelectionMode="Multiple" SelectionChanged="OnThreadSelected" DoubleTapped="OnThreadDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="desktop:ArchiveThreadRow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="5,4">
                                        <Grid.ContextMenu>
                                            <ContextMenu Opened="OnArchiveSelectionMenuOpened">
                                                <MenuItem Header="{Binding GalleryLabel}" InputGesture="Shift+Enter" Click="OnThreadGalleryMenu" />
                                                <MenuItem Header="{Binding ReadLabel}" InputGesture="Enter" Click="OnThreadReadMenu" />
                                                <MenuItem Tag="selection.export" Classes="localized" Header="Export selection…" InputGesture="Ctrl+E" Click="OnThreadExportMenu" />
                                                <MenuItem Tag="action.details" Classes="localized" Header="Details" InputGesture="Alt+Enter" Click="OnArchiveSelectionDetails" />
                                                <MenuItem Tag="check.action" Classes="localized" Header="Check now" InputGesture="F5" Click="OnArchiveCheckSelection" />
                                                <MenuItem Tag="work.retry" Classes="localized" Header="Retry missing media" InputGesture="Shift+F5" Click="OnArchiveRetrySelection" />
                                                <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" InputGesture="Ctrl+R" CommandParameter="rules" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" InputGesture="Ctrl+O" CommandParameter="folder" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" InputGesture="Ctrl+Shift+O" CommandParameter="browser" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="selection.copyUrls" Classes="localized" Header="Copy selected URLs" InputGesture="Ctrl+C" Click="OnArchiveCopySelection" />
                                                <MenuItem Tag="selection.remove" Classes="localized" Header="Remove selection" InputGesture="Delete" Click="OnArchiveRemoveSelection" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Panel x:DataType="desktop:ArchiveThreadRow" IsVisible="{Binding HasPreviewAttachment}">
                                            <desktop:ArchiveAttachmentView DataContext="{Binding PreviewAttachment}" Width="76" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" />
                                            <TextBlock Text="{Binding Identity}" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" />
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" Classes="muted" FontSize="12" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DataGrid x:Name="ArchiveThreadTable" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended"
                                  PointerReleased="OnArchiveColumnsReleased"
                                  SelectionChanged="OnThreadTableSelected" DoubleTapped="OnThreadTableDoubleTapped">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Source / board" SortMemberPath="Identity" Width="150" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding Identity}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Identity}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Title / ID" SortMemberPath="TitleOrId" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding TitleOrId}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitleOrId}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Posts" Width="65" MinWidth="55" Binding="{Binding Posts, DataType=desktop:ArchiveThreadRow}" />
                                <DataGridTemplateColumn Header="Media" SortMemberPath="SavedMediaCount" Width="80" MinWidth="65"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactMedia}" ToolTip.Tip="{Binding MediaStatus}" AutomationProperties.HelpText="{Binding MediaStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Source" SortMemberPath="CompactSource" Width="90" MinWidth="75"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactSource}" ToolTip.Tip="{Binding SourceStatus}" AutomationProperties.HelpText="{Binding SourceStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Work" SortMemberPath="CompactWork" Width="110" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactWork}" ToolTip.Tip="{Binding WorkStatus}" AutomationProperties.HelpText="{Binding WorkStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last capture" Width="145" MinWidth="125" Binding="{Binding LastCapture, DataType=desktop:ArchiveThreadRow}" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu><ContextMenu Opened="OnArchiveSelectionMenuOpened">
                                <MenuItem x:Name="ArchiveTableGalleryMenu" Header="Open in gallery" InputGesture="Shift+Enter" Click="OnThreadGalleryMenu" />
                                <MenuItem x:Name="ArchiveTableReadMenu" Header="Read posts" InputGesture="Enter" Click="OnThreadReadMenu" />
                                <MenuItem x:Name="ArchiveTableExportMenu" Header="Export selection…" InputGesture="Ctrl+E" Click="OnThreadExportMenu" />
                                <MenuItem Tag="selection.copyUrls" Classes="localized" Header="Copy selected URLs" InputGesture="Ctrl+C" Click="OnArchiveCopySelection" />
                                <MenuItem Tag="action.details" Classes="localized" Header="Details" InputGesture="Alt+Enter" Click="OnArchiveSelectionDetails" />
                                <MenuItem Tag="check.action" Classes="localized" Header="Check now" InputGesture="F5" Click="OnArchiveCheckSelection" />
                                <MenuItem Tag="work.retry" Classes="localized" Header="Retry missing media" InputGesture="Shift+F5" Click="OnArchiveRetrySelection" />
                                <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" InputGesture="Ctrl+R" CommandParameter="rules" Click="OnArchiveLeadAction" />
                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" InputGesture="Ctrl+O" CommandParameter="folder" Click="OnArchiveLeadAction" />
                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" InputGesture="Ctrl+Shift+O" CommandParameter="browser" Click="OnArchiveLeadAction" />
                                <Separator />
                                <MenuItem x:Name="ArchiveTableRemoveMenu" Tag="selection.remove" Classes="localized" Header="Remove selection" InputGesture="Delete" Click="OnArchiveRemoveSelection" />
                            </ContextMenu></DataGrid.ContextMenu>
                        </DataGrid>
                        <TextBlock x:Name="ArchiveEmpty" Tag="archive.empty" Classes="muted localized" TextWrapping="Wrap" Margin="12" />
                    </Grid>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <Button x:Name="PreviousThreadsButton" Tag="archive.previous" Classes="localized" Click="OnPreviousThreads" />
                    <TextBlock x:Name="ArchiveThreadPage" Grid.Column="1" Classes="muted" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Button x:Name="NextThreadsButton" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextThreads" />
                </Grid>
            </Grid>
            <GridSplitter x:Name="ArchiveSplitter" Grid.Column="1" Width="6" ResizeDirection="Columns" PointerReleased="OnArchiveSplitReleased" KeyUp="OnArchiveSplitKeyUp" />
            <Grid x:Name="ArchiveReaderPane" Grid.Column="2" RowDefinitions="Auto,*,Auto" RowSpacing="6">
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button x:Name="ArchiveBackButton" Tag="archive.back" Classes="localized" Click="OnBackClick" />
                        <TextBlock x:Name="ArchiveReaderTitle" Grid.Column="1" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="CapturePostsButton" Grid.Column="2" Click="OnCaptureClick" />
                    </Grid>
                    <WrapPanel HorizontalAlignment="Left">
                        <WrapPanel.Styles><Style Selector="Button"><Setter Property="MinWidth" Value="38" /><Setter Property="Height" Value="32" /></Style></WrapPanel.Styles>
                    <Button x:Name="ArchiveCloseReader" Tag="reader.close" Classes="localized" IsVisible="False" Click="OnCloseReaderClick" />
                    <Button x:Name="ArchiveOpenGallery" Tag="gallery.open" Classes="localized" Click="OnCurrentGalleryClick" />
                    <Button x:Name="ArchiveReadPosts" Tag="gallery.read" Classes="localized" Click="OnReadPostsClick" />
                    <Button x:Name="ArchiveGalleryReturn" Content="Back to gallery" IsVisible="False" Click="OnGalleryReturnClick" />
                    <Button x:Name="ArchiveReaderFullscreen" Content="Full screen" Click="OnReaderFullscreenClick" />
                    <Button x:Name="ExportArchiveButton" Tag="archive.export" Classes="localized" Click="OnExportClick" />
                    <Button x:Name="ArchiveHistoryBack" Tag="archive.historyBack" Classes="localized" Click="OnHistoryBack" IsVisible="False" />
                    <WrapPanel x:Name="ReaderNavigation" IsVisible="False" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <Grid ColumnDefinitions="38,38,38" RowDefinitions="32,32" ColumnSpacing="2" RowSpacing="2">
                            <Grid.Styles><Style Selector="Button"><Setter Property="Width" Value="38" /><Setter Property="Height" Value="32" /></Style></Grid.Styles>
                            <Button x:Name="ReaderPreviousPost" Grid.Column="1" Tag="reader.previousPost" Classes="localized" Click="OnReaderNavigationClick" />
                            <Button x:Name="ReaderPreviousThread" Grid.Row="1" Tag="reader.previousThread" Classes="localized" Click="OnReaderNavigationClick" />
                            <Button x:Name="ReaderNextPost" Grid.Row="1" Grid.Column="1" Tag="reader.nextPost" Classes="localized" Click="OnReaderNavigationClick" />
                            <Button x:Name="ReaderNextThread" Grid.Row="1" Grid.Column="2" Tag="reader.nextThread" Classes="localized" Click="OnReaderNavigationClick" />
                        </Grid>
                    </WrapPanel>
                    </WrapPanel>
                    <TextBlock x:Name="ArchiveReaderStatus" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                    <WrapPanel Orientation="Horizontal">
                        <CheckBox x:Name="ReaderFollowLive" IsEnabled="False" IsCheckedChanged="OnReaderFollowLiveChanged" Margin="0,0,12,0" />
                        <TextBlock x:Name="ReaderNewPostsNotice" IsVisible="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="ReaderShowNewPosts" IsVisible="False" Click="OnShowReaderUpdates" />
                    </WrapPanel>
                </StackPanel>
                <Border Grid.Row="1" Classes="panel">
                    <Grid>
                        <TextBlock x:Name="ArchiveSelectHint" Tag="archive.select" Classes="muted localized" Margin="16" />
                        <TabControl x:Name="ArchiveContentTabs" IsVisible="False">
                            <TabItem x:Name="ArchivePostsTab" Header="Posts">
                                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                    <Grid>
                                        <ListBox x:Name="ArchivePosts" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                                                <Style Selector="ListBoxItem:selected">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="desktop:ArchivePostRow">
                                                    <StackPanel Margin="8,8,8,12" Spacing="6">
                                                        <TextBlock Text="{Binding Header}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Subject}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,0" ColumnSpacing="12" RowSpacing="8" SizeChanged="OnPostLayoutChanged">
                                                            <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" MaxWidth="268" HorizontalAlignment="Left">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="desktop:ArchiveAttachmentRow">
                                                                        <desktop:ArchiveAttachmentView Margin="0,2,0,8" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel Grid.Column="1" Spacing="6">
                                                                <SelectableTextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                                                                <ItemsControl ItemsSource="{Binding Quotes}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                            <Button Content="{Binding Label}" Click="OnQuoteClick" Margin="0,2" HorizontalAlignment="Left" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <Expander Header="{Binding BacklinksLabel}" IsExpanded="{Binding RepliesExpanded, Mode=TwoWay}"
                                                                          Expanded="OnRepliesExpanded" Collapsed="OnRepliesCollapsed" HorizontalAlignment="Stretch">
                                                                    <StackPanel Margin="12,4,0,4" Spacing="4">
                                                                        <ItemsControl ItemsSource="{Binding Replies}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                                    <Button Content="{Binding Label}" Click="OnQuoteClick" Margin="0,2" HorizontalAlignment="Left" />
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                        <TextBlock Text="{Binding RepliesLoadingLabel}" IsVisible="{Binding RepliesLoading}" Classes="muted" />
                                                                        <TextBlock Text="{Binding RepliesError}" IsVisible="{Binding HasRepliesError}" TextWrapping="Wrap" />
                                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMoreReplies}">
                                                                            <Button Content="{Binding MoreRepliesLabel}" Click="OnMoreRepliesClick" />
                                                                            <TextBlock Text="{Binding RepliesPageLabel}" VerticalAlignment="Center" Classes="muted" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Expander>
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoPosts" Tag="archive.noPosts" Classes="muted localized" TextWrapping="Wrap" Margin="16" />
                                    </Grid>
                                    <Grid x:Name="ArchivePostNavigation" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8" ColumnSpacing="8">
                                        <Button x:Name="PreviousPostsButton" Tag="archive.previous" Classes="localized" Click="OnPreviousPosts" />
                                        <TextBlock x:Name="ArchivePostPage" Grid.Column="1" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextPostsButton" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextPosts" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveMediaTab" Header="Media">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="8">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ArchiveMediaMode" Tag="gallery.tiles" Classes="localized" Click="OnMediaModeClick" />
                                        <Button x:Name="ArchiveMediaColumnsButton" Content="Columns" Click="OnArchiveColumnsClick" IsVisible="False" />
                                        <Button x:Name="ArchiveFavoritesFilter" Content="☆ Favorites only" Click="OnArchiveFavoritesFilterClick" />
                                        <ComboBox x:Name="ArchiveMediaSort" Width="160" SelectedIndex="0" SelectionChanged="OnMediaSortChanged" />
                                        <ComboBox x:Name="ArchiveVersionScope" SelectedIndex="1" SelectionChanged="OnVersionScopeChanged" Width="210" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <DataGrid x:Name="ArchiveMediaGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Single" SelectionChanged="OnMediaSelected" DoubleTapped="OnMediaDoubleTapped" GridLinesVisibility="None" PointerReleased="OnArchiveColumnsReleased">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*" MinWidth="220" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveAssetRow"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTextColumn Width="85" MinWidth="70" Binding="{Binding Size, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="125" MinWidth="100" Binding="{Binding Version, DataType=desktop:ArchiveAssetRow}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ListBox x:Name="ArchiveMediaTiles" IsVisible="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnMediaSelected" DoubleTapped="OnMediaDoubleTapped">
                                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveAssetRow">
                                                <StackPanel Width="170" Margin="6" Spacing="5">
                                                    <desktop:ArchiveMediaTileView Height="125" />
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding TileSummary}" TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoMedia" Tag="archive.noMedia" Classes="muted localized" TextWrapping="Wrap" Margin="8,40,8,8" />
                                    </Grid>
                                    <Button x:Name="PreviewArchiveMediaButton" Grid.Row="2" Tag="archive.preview" Classes="localized" HorizontalAlignment="Right" Click="OnPreviewClick" />
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveReferencesTab">
                                <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
                                    <TextBlock x:Name="ArchiveReferencesTitle" TextWrapping="Wrap" Classes="muted" />
                                    <ListBox x:Name="ArchiveReferences" Grid.Row="1">
                                        <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                            <Button Content="{Binding Label}" Click="OnQuoteClick" HorizontalAlignment="Stretch" Margin="0,3" />
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
                                        <Button x:Name="PreviousReferences" Tag="archive.previous" Classes="localized" Click="OnPreviousReferences" />
                                        <TextBlock x:Name="ArchiveReferencesPage" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextReferences" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextReferences" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
                <TextBlock x:Name="ArchivePartialHint" Grid.Row="2" Tag="archive.partial" Classes="muted localized" FontSize="12" TextWrapping="Wrap" />
            </Grid>
        </Grid>
        <TextBlock x:Name="ArchiveMessage" Grid.Row="2" Classes="muted" TextWrapping="Wrap" />
        <Border x:Name="ArchivePreview" Grid.RowSpan="3" Classes="panel" Padding="12" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PreviewTitle" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="ClosePreviewButton" Grid.Column="1" Tag="action.close" Classes="localized" Click="OnClosePreview" />
                </Grid>
                <Grid Grid.Row="1">
                    <Image x:Name="ArchivePreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="ArchivePreviewMessage" Classes="muted" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="ArchivePreviewPath" IsReadOnly="True" />
                    <Button Grid.Column="1" Tag="action.openFolder" Classes="localized" Click="OnOpenMediaFolder" />
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="ArchiveExportDialog" IsVisible="False" Background="#A6000000" Grid.RowSpan="3" ZIndex="20" />
    </Grid>
</UserControl>
