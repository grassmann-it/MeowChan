<Project>
  <PropertyGroup>
    <MeowChanPluginDeliveryEnabled Condition="'$(MeowChanPluginDeliveryEnabled)' == ''">true</MeowChanPluginDeliveryEnabled>
    <_PluginRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))/</_PluginRepositoryRoot>
    <_PluginHelperProperties>Configuration=$(Configuration);TargetFramework=net10.0;PublishSingleFile=false;PublishTrimmed=false;CopyOutputSymbolsToPublishDirectory=false;PublishDocumentationFiles=false</_PluginHelperProperties>
    <!-- Keep the build-time contract closed: project/output mutation cannot turn an
         allowlisted project into an arbitrary delivered assembly or source file. -->
    <_ShippedPluginAssemblies>MeowChan.Plugin.FourChan;MeowChan.Plugin.EightKun;MeowChan.Plugin.Danbooru;MeowChan.Plugin.Lainchan;MeowChan.Plugin.Kohlchan;MeowChan.ImageDimensionsFilter;MeowChan.Plugin.Wizchan;MeowChan.Plugin.Endchan;MeowChan.FileRulesFilter;MeowChan.HashBlocklistFilter;MeowChan.AnimationFormatFilter;MeowChan.PngMetadataFilter;MeowChan.Plugin.Leftypol;MeowChan.Plugin.Dvach;MeowChan.Plugin.Uboachan;MeowChan.Plugin.Zzzchan;MeowChan.Plugin.SushiChan;MeowChan.Plugin.SevenChan;MeowChan.Plugin.BbwChan;MeowChan.Plugin.AnonImageboards;MeowChan.Plugin.CapybaraChan;MeowChan.Plugin.EightchanMoe;MeowChan.Plugin.Fchan;MeowChan.Plugin.GuroCx</_ShippedPluginAssemblies>
    <_PluginExampleSourceNames>Lainchan.cs;Kohlchan.cs;ImageDimensionsFilter.cs;Wizchan.cs;Endchan.cs;FileRulesFilter.cs;HashBlocklistFilter.cs;AnimationFormatFilter.cs;PngMetadataFilter.cs;Leftypol.cs;Dvach.cs;Uboachan.cs;Zzzchan.cs;SushiChan.cs;SevenChan.cs;BbwChan.cs;AnonImageboards.cs;CapybaraChan.cs;EightchanMoe.cs;Fchan.cs;GuroCx.cs</_PluginExampleSourceNames>
  </PropertyGroup>
  <!-- These are restore/build graph edges only. No helper/Roslyn assembly is a Desktop reference. -->
  <ItemGroup Condition="'$(MeowChanPluginDeliveryEnabled)' == 'true'">
    <_PluginHelperProject Include="$(_PluginRepositoryRoot)MeowChan.PluginWorker/MeowChan.PluginWorker.csproj;$(_PluginRepositoryRoot)MeowChan.PluginCompiler/MeowChan.PluginCompiler.csproj" />
    <_ShippedPluginProject Include="$(_PluginRepositoryRoot)plugins/Official/FourChan/MeowChan.Plugin.FourChan.csproj;$(_PluginRepositoryRoot)plugins/Official/EightKun/MeowChan.Plugin.EightKun.csproj;$(_PluginRepositoryRoot)plugins/Official/Danbooru/MeowChan.Plugin.Danbooru.csproj;$(_PluginRepositoryRoot)plugins/Examples/Lainchan/MeowChan.Plugin.Lainchan.csproj;$(_PluginRepositoryRoot)plugins/Examples/Kohlchan/MeowChan.Plugin.Kohlchan.csproj;$(_PluginRepositoryRoot)plugins/Examples/ImageDimensionsFilter/MeowChan.ImageDimensionsFilter.csproj;$(_PluginRepositoryRoot)plugins/Examples/Wizchan/MeowChan.Plugin.Wizchan.csproj;$(_PluginRepositoryRoot)plugins/Examples/Endchan/MeowChan.Plugin.Endchan.csproj;$(_PluginRepositoryRoot)plugins/Examples/FileRulesFilter/MeowChan.FileRulesFilter.csproj;$(_PluginRepositoryRoot)plugins/Examples/HashBlocklistFilter/MeowChan.HashBlocklistFilter.csproj;$(_PluginRepositoryRoot)plugins/Examples/AnimationFormatFilter/MeowChan.AnimationFormatFilter.csproj;$(_PluginRepositoryRoot)plugins/Examples/PngMetadataFilter/MeowChan.PngMetadataFilter.csproj;$(_PluginRepositoryRoot)plugins/Examples/Leftypol/MeowChan.Plugin.Leftypol.csproj;$(_PluginRepositoryRoot)plugins/Examples/Dvach/MeowChan.Plugin.Dvach.csproj;$(_PluginRepositoryRoot)plugins/Examples/Uboachan/MeowChan.Plugin.Uboachan.csproj;$(_PluginRepositoryRoot)plugins/Examples/Zzzchan/MeowChan.Plugin.Zzzchan.csproj;$(_PluginRepositoryRoot)plugins/Examples/SushiChan/MeowChan.Plugin.SushiChan.csproj;$(_PluginRepositoryRoot)plugins/Examples/SevenChan/MeowChan.Plugin.SevenChan.csproj;$(_PluginRepositoryRoot)plugins/Examples/BbwChan/MeowChan.Plugin.BbwChan.csproj;$(_PluginRepositoryRoot)plugins/Examples/AnonImageboards/MeowChan.Plugin.AnonImageboards.csproj;$(_PluginRepositoryRoot)plugins/Examples/CapybaraChan/MeowChan.Plugin.CapybaraChan.csproj;$(_PluginRepositoryRoot)plugins/Examples/EightchanMoe/MeowChan.Plugin.EightchanMoe.csproj;$(_PluginRepositoryRoot)plugins/Examples/Fchan/MeowChan.Plugin.Fchan.csproj;$(_PluginRepositoryRoot)plugins/Examples/GuroCx/MeowChan.Plugin.GuroCx.csproj" />
    <!-- Helpers/plugins select their own multifile defaults. Setting false as
         extra global properties creates separate solution build nodes sharing
         the same obj/bin paths; concurrent apphost generation then races. -->
    <ProjectReference Include="@(_PluginHelperProject);@(_ShippedPluginProject)" ReferenceOutputAssembly="false" Private="false" PrivateAssets="all" ExcludeAssets="all" GlobalPropertiesToRemove="PublishSingleFile;PublishTrimmed" />
    <_PluginExampleSource Include="$(_PluginRepositoryRoot)plugins/Examples/Lainchan/Lainchan.cs;$(_PluginRepositoryRoot)plugins/Examples/Kohlchan/Kohlchan.cs;$(_PluginRepositoryRoot)plugins/Examples/ImageDimensionsFilter/ImageDimensionsFilter.cs;$(_PluginRepositoryRoot)plugins/Examples/Wizchan/Wizchan.cs;$(_PluginRepositoryRoot)plugins/Examples/Endchan/Endchan.cs;$(_PluginRepositoryRoot)plugins/Examples/FileRulesFilter/FileRulesFilter.cs;$(_PluginRepositoryRoot)plugins/Examples/HashBlocklistFilter/HashBlocklistFilter.cs;$(_PluginRepositoryRoot)plugins/Examples/AnimationFormatFilter/AnimationFormatFilter.cs;$(_PluginRepositoryRoot)plugins/Examples/PngMetadataFilter/PngMetadataFilter.cs;$(_PluginRepositoryRoot)plugins/Examples/Leftypol/Leftypol.cs;$(_PluginRepositoryRoot)plugins/Examples/Dvach/Dvach.cs;$(_PluginRepositoryRoot)plugins/Examples/Uboachan/Uboachan.cs;$(_PluginRepositoryRoot)plugins/Examples/Zzzchan/Zzzchan.cs;$(_PluginRepositoryRoot)plugins/Examples/SushiChan/SushiChan.cs;$(_PluginRepositoryRoot)plugins/Examples/SevenChan/SevenChan.cs;$(_PluginRepositoryRoot)plugins/Examples/BbwChan/BbwChan.cs;$(_PluginRepositoryRoot)plugins/Examples/AnonImageboards/AnonImageboards.cs;$(_PluginRepositoryRoot)plugins/Examples/CapybaraChan/CapybaraChan.cs;$(_PluginRepositoryRoot)plugins/Examples/EightchanMoe/EightchanMoe.cs;$(_PluginRepositoryRoot)plugins/Examples/Fchan/Fchan.cs;$(_PluginRepositoryRoot)plugins/Examples/GuroCx/GuroCx.cs" />
  </ItemGroup>

  <UsingTask TaskName="StageMeowChanPlugins" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <WorkerAssembly ParameterType="System.String" Required="true" />
      <CompilerAssembly ParameterType="System.String" Required="true" />
      <Plugins ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ExpectedPluginAssemblies ParameterType="System.String" Required="true" />
      <ExpectedSourceFiles ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" /><Using Namespace="System.IO" /><Using Namespace="System.Linq" />
      <Using Namespace="System.Text" /><Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Security.Cryptography" /><Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        try
        {
            string root = Path.GetFullPath(Destination);
            if (Directory.Exists(root)) Directory.Delete(root, true);
            Directory.CreateDirectory(root);
            HashSet<string> expectedAssemblies = new HashSet<string>(ExpectedPluginAssemblies.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries), StringComparer.Ordinal);
            HashSet<string> expectedSources = new HashSet<string>(ExpectedSourceFiles.Split(new[] { ';' }, StringSplitOptions.RemoveEmptyEntries), StringComparer.Ordinal);
            HashSet<string> forbiddenComponents = new HashSet<string>(new[] { "bin", "obj", ".git", ".vs", "profile", "profiles" }, StringComparer.OrdinalIgnoreCase);
            if (expectedAssemblies.Count == 0 || expectedSources.Count == 0) throw new InvalidDataException("The public plugin inventory is empty.");
            Func<string, string> hash = file => { using (var algorithm = SHA256.Create()) using (var data = File.OpenRead(file))
                return BitConverter.ToString(algorithm.ComputeHash(data)).Replace("-", "").ToLowerInvariant(); };
            Action<string, string> requireRegular = (path, description) => {
                FileAttributes attributes = File.GetAttributes(path);
                if ((attributes & FileAttributes.ReparsePoint) != 0 || (attributes & FileAttributes.Directory) != 0 || !File.Exists(path))
                    throw new InvalidDataException(description + " is not a regular file: " + path);
            };
            Action<string, string> copy = (source, target) => {
                requireRegular(source, "Plugin delivery input");
                if (File.Exists(target) || Directory.Exists(target)) {
                    FileAttributes attributes = File.GetAttributes(target);
                    if ((attributes & FileAttributes.ReparsePoint) != 0 || (attributes & FileAttributes.Directory) != 0)
                        throw new InvalidDataException("Plugin delivery destination is not a regular file: " + target);
                }
                Directory.CreateDirectory(Path.GetDirectoryName(target));
                if (!File.Exists(target) || new FileInfo(source).Length != new FileInfo(target).Length || hash(source) != hash(target))
                    File.Copy(source, target, true);
            };
            Action<string, string> copyTree = (source, target) => {
                if ((File.GetAttributes(source) & FileAttributes.ReparsePoint) != 0)
                    throw new InvalidDataException("Plugin helper output cannot be a link: " + source);
                if (Directory.Exists(target)) Directory.Delete(target, true);
                Directory.CreateDirectory(target);
                foreach (string entry in Directory.GetFileSystemEntries(source, "*", SearchOption.AllDirectories)) {
                    FileAttributes attributes = File.GetAttributes(entry);
                    string sourceRoot = source.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar) + Path.DirectorySeparatorChar;
                    string relative = entry.StartsWith(sourceRoot, StringComparison.OrdinalIgnoreCase)
                        ? entry.Substring(sourceRoot.Length) : entry;
                    if (relative.Split(new[] { Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar }, StringSplitOptions.RemoveEmptyEntries).Any(forbiddenComponents.Contains))
                        throw new InvalidDataException("Plugin helper output contains a build or profile artifact: " + relative);
                    if ((attributes & FileAttributes.ReparsePoint) != 0)
                        throw new InvalidDataException("Plugin helper output cannot contain a link: " + relative);
                }
                foreach (string file in Directory.GetFiles(source, "*", SearchOption.AllDirectories))
                {
                    if (Path.GetExtension(file) == ".pdb" || Path.GetExtension(file) == ".xml") continue;
                    string relative = file.Substring(source.TrimEnd(Path.DirectorySeparatorChar).Length + 1);
                    copy(file, Path.Combine(target, relative));
                }
            };
            string worker = Path.GetDirectoryName(Path.GetFullPath(WorkerAssembly));
            string compiler = Path.GetDirectoryName(Path.GetFullPath(CompilerAssembly));
            copyTree(worker, Path.Combine(root, "plugin-worker"));
            copyTree(compiler, Path.Combine(root, "plugin-compiler"));
            string toolchain = File.ReadAllText(Path.Combine(compiler, "toolchain.json"));
            Func<string, string> fingerprint = key => {
                Match match = Regex.Match(toolchain, "\"" + key + "\"\\s*:\\s*\"([0-9a-f]{64})\"");
                if (!match.Success) throw new InvalidDataException("Missing compiler toolchain fingerprint: " + key);
                return match.Groups[1].Value;
            };
            string sdk = fingerprint("SdkFingerprint"), compilerFingerprint = fingerprint("CompilerFingerprint");
            if (hash(Path.Combine(worker, "MeowChan.PluginSdk.dll")) != sdk)
                throw new InvalidDataException("Worker and compiler SDK bytes differ.");
            string plugins = Path.Combine(root, "plugins"); Directory.CreateDirectory(plugins);
            HashSet<string> actualAssemblies = new HashSet<string>(StringComparer.Ordinal);
            if (Plugins.Length != expectedAssemblies.Count) throw new InvalidDataException("Delivered plugin project count differs from the public inventory.");
            foreach (var item in Plugins)
            {
                string assembly = item.ItemSpec, name = Path.GetFileNameWithoutExtension(assembly), fileName = Path.GetFileName(assembly);
                if (!Regex.IsMatch(fileName, "^[A-Za-z0-9._-]+[.]dll$") || !expectedAssemblies.Contains(name) || !actualAssemblies.Add(name))
                    throw new InvalidDataException("Delivered assembly is outside the public plugin inventory: " + fileName);
                string relative = "assemblies/" + fileName;
                copy(assembly, Path.Combine(plugins, relative));
                string manifestName = name + ".plugin.json";
                string json = "{\n  \"SchemaVersion\": 1,\n  \"AssemblyRelativePath\": \"" + relative + "\",\n  \"AssemblySha256\": \"" + hash(assembly) +
                    "\",\n  \"SdkFingerprint\": \"" + sdk + "\",\n  \"CompilerFingerprint\": \"" + compilerFingerprint + "\",\n  \"Resources\": []\n}\n";
                string manifest = Path.Combine(plugins, manifestName);
                if (!File.Exists(manifest) || File.ReadAllText(manifest) != json) File.WriteAllText(manifest, json, new UTF8Encoding(false));

            }
            if (!actualAssemblies.SetEquals(expectedAssemblies)) throw new InvalidDataException("Delivered plugin assemblies differ from the public inventory.");
            HashSet<string> actualSources = new HashSet<string>(StringComparer.Ordinal);
            if (Sources.Length != expectedSources.Count) throw new InvalidDataException("Delivered source count differs from the public inventory.");
            foreach (var item in Sources)
            {
                string sourceName = Path.GetFileName(item.ItemSpec);
                if (!expectedSources.Contains(sourceName) || !actualSources.Add(sourceName) || Path.GetExtension(sourceName) != ".cs")
                    throw new InvalidDataException("Delivered source is outside the public plugin inventory: " + sourceName);
                string relative = "sources/" + sourceName;
                copy(item.ItemSpec, Path.Combine(plugins, relative));
            }
            if (!actualSources.SetEquals(expectedSources)) throw new InvalidDataException("Delivered sources differ from the public inventory.");
        }
        catch (Exception exception) { Log.LogErrorFromException(exception, true); return false; }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="PrepareMeowChanPluginBuildDelivery" BeforeTargets="GetCopyToOutputDirectoryItems" DependsOnTargets="ResolveProjectReferences"
          Condition="'$(MeowChanPluginDeliveryEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_PluginDeliveryStage>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))/plugin-delivery/build/</_PluginDeliveryStage>
      <_PluginPublishStage>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))/plugin-delivery/publish/</_PluginPublishStage>
    </PropertyGroup>
    <MSBuild Projects="$(_PluginRepositoryRoot)MeowChan.PluginWorker/MeowChan.PluginWorker.csproj" Targets="GetTargetPath" Properties="$(_PluginHelperProperties)" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_WorkerDeliveryAssembly" />
    </MSBuild>
    <MSBuild Projects="$(_PluginRepositoryRoot)MeowChan.PluginCompiler/MeowChan.PluginCompiler.csproj" Targets="GetTargetPath" Properties="$(_PluginHelperProperties)" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_CompilerDeliveryAssembly" />
    </MSBuild>
    <MSBuild Projects="@(_ShippedPluginProject)" Targets="GetTargetPath" Properties="$(_PluginHelperProperties)" RemoveProperties="RuntimeIdentifier;SelfContained" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_PluginDeliveryAssembly" />
    </MSBuild>
    <StageMeowChanPlugins WorkerAssembly="@(_WorkerDeliveryAssembly)" CompilerAssembly="@(_CompilerDeliveryAssembly)" Plugins="@(_PluginDeliveryAssembly)" Sources="@(_PluginExampleSource)" ExpectedPluginAssemblies="$(_ShippedPluginAssemblies)" ExpectedSourceFiles="$(_PluginExampleSourceNames)" Destination="$(_PluginDeliveryStage)" />
    <ItemGroup>
      <_PluginBuildPayload Include="$(_PluginDeliveryStage)/**/*" />
      <ContentWithTargetPath Include="@(_PluginBuildPayload)" TargetPath="%(_PluginBuildPayload.RecursiveDir)%(_PluginBuildPayload.Filename)%(_PluginBuildPayload.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Target Name="PrepareMeowChanPluginPublishDelivery" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="PrepareMeowChanPluginBuildDelivery"
          Condition="'$(MeowChanPluginDeliveryEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(RuntimeIdentifier)' == '' or '$(SelfContained)' != 'true'" Text="Desktop plugin delivery requires an explicit RID and self-contained publish." />
    <MSBuild Projects="$(_PluginRepositoryRoot)MeowChan.PluginWorker/MeowChan.PluginWorker.csproj" Targets="Publish" Properties="$(_PluginHelperProperties);PublishDir=$(_PluginPublishStage)/worker/" BuildInParallel="false" />
    <MSBuild Projects="$(_PluginRepositoryRoot)MeowChan.PluginCompiler/MeowChan.PluginCompiler.csproj" Targets="Publish" Properties="$(_PluginHelperProperties);PublishDir=$(_PluginPublishStage)/compiler/" BuildInParallel="false" />
    <StageMeowChanPlugins WorkerAssembly="$(_PluginPublishStage)/worker/MeowChan.PluginWorker.dll" CompilerAssembly="$(_PluginPublishStage)/compiler/MeowChan.PluginCompiler.dll" Plugins="@(_PluginDeliveryAssembly)" Sources="@(_PluginExampleSource)" ExpectedPluginAssemblies="$(_ShippedPluginAssemblies)" ExpectedSourceFiles="$(_PluginExampleSourceNames)" Destination="$(_PluginPublishStage)/payload/" />
    <ItemGroup>
      <_PluginPublishPayload Include="$(_PluginPublishStage)/payload/**/*" />
      <ResolvedFileToPublish Include="@(_PluginPublishPayload)" RelativePath="%(_PluginPublishPayload.RecursiveDir)%(_PluginPublishPayload.Filename)%(_PluginPublishPayload.Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
