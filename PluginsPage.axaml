<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:plugins="using:MeowChan.Desktop.Plugins" xmlns:ursa="https://irihi.tech/ursa" x:Class="MeowChan.PluginsPage" SizeChanged="OnPageSizeChanged">
  <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
    <StackPanel Classes="workspace-page-header">
      <WrapPanel Classes="workspace-toolbar">
        <TextBlock x:Name="PluginsTitle" Classes="page-title" Margin="0,0,8,0" />
        <Button x:Name="PluginsRefresh" Click="OnRefreshClick" />
        <Button x:Name="PluginsFolder" Click="OnFolderClick" />
      </WrapPanel>
      <TextBlock x:Name="PluginsSubtitle" TextWrapping="Wrap" Classes="muted" />
      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ursa:LoadingIcon x:Name="PluginOperationLoading" Width="16" Height="16" IsVisible="False" Focusable="False" />
                        <TextBlock x:Name="PluginTestStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /></StackPanel>
      <Button x:Name="PluginCancel" Click="OnCancelClick" HorizontalAlignment="Left" IsVisible="False" />
      <Expander x:Name="PluginInventoryProblems" IsVisible="False" HorizontalAlignment="Stretch">
        <Expander.Header><ursa:Badge x:Name="PluginInventoryBadge" OverflowCount="2147483647"><TextBlock x:Name="PluginInventoryHeader" Margin="0,0,14,0" /></ursa:Badge></Expander.Header>
        <ScrollViewer MaxHeight="100"><TextBlock x:Name="PluginInventoryDiagnostics" TextWrapping="Wrap" /></ScrollViewer>
      </Expander>
      <ursa:Banner x:Name="PluginErrorBanner" Type="Error" CanClose="False" IsVisible="False" HorizontalContentAlignment="Stretch">
        <ScrollViewer MaxHeight="96"><TextBlock x:Name="PluginPageError" TextWrapping="Wrap" Classes="error" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
      </ursa:Banner>
    </StackPanel>
    <Grid x:Name="PluginSplit" Grid.Row="1" ColumnDefinitions="240,*" ColumnSpacing="14">
      <Grid x:Name="PluginListPane" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <StackPanel Spacing="6">
          <ComboBox x:Name="PluginCategory" HorizontalAlignment="Stretch" SelectionChanged="OnCategoryChanged" />
          <Button x:Name="PluginListActions" Click="OnPluginListActionsClick" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock x:Name="PluginsEmpty" Grid.Row="1" TextWrapping="Wrap" />
        <ScrollViewer x:Name="PluginListScroll" Grid.Row="2"><plugins:PluginSelectionList x:Name="PluginCards" SelectionChanged="OnPluginSelectionChanged" /></ScrollViewer>
        <Expander x:Name="PluginDirectoryExpander" Grid.Row="3" HorizontalAlignment="Stretch">
          <StackPanel Spacing="6" Margin="0,4,0,0">
            <TextBlock x:Name="PluginDirectory" TextWrapping="Wrap" Classes="muted" />
            <TextBlock x:Name="PluginLocalStatusHint" TextWrapping="Wrap" Classes="muted" />
          </StackPanel>
        </Expander>
      </Grid>
      <Border x:Name="PluginNoSelection" Grid.Column="1" Classes="panel" Padding="20" IsVisible="False">
        <TextBlock x:Name="PluginChooseHint" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
      </Border>
      <ScrollViewer x:Name="PluginDetailsPane" Grid.Column="1" IsVisible="False">
        <StackPanel x:Name="PluginDetailContent" Spacing="12">
          <Button x:Name="PluginBack" HorizontalAlignment="Left" Click="OnBackClick" />
          <Border x:Name="PluginPurposeCard" Classes="workspace-section">
            <StackPanel Classes="workspace-section-header">
              <WrapPanel ItemSpacing="10" LineSpacing="4">
                <TextBlock x:Name="PluginHeading" Classes="page-title" TextWrapping="Wrap" />
                <TextBlock x:Name="PluginAuthor" Classes="muted" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
              </WrapPanel>
              <TextBlock x:Name="PluginDescriptionOrigin" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginDescription" TextWrapping="Wrap" />
              <WrapPanel x:Name="PluginCompactIdentity" ItemSpacing="6" LineSpacing="6">
                <Border x:Name="PluginTypeChip" Classes="workspace-status"><TextBlock x:Name="PluginType" Classes="workspace-status" /></Border>
                <Border x:Name="PluginExperimentalChip" Classes="workspace-status workspace-status-warning" IsVisible="False"><TextBlock x:Name="PluginExperimental" Classes="workspace-status" /></Border>
                <Border x:Name="PluginVersionChip" Classes="workspace-status" IsVisible="False"><TextBlock x:Name="PluginVersion" Classes="workspace-status" TextWrapping="Wrap" /></Border>
                <Border x:Name="PluginIdChip" Classes="workspace-status" MaxWidth="260" IsVisible="False"><TextBlock x:Name="PluginCompactId" Classes="workspace-status muted" TextTrimming="CharacterEllipsis" MaxLines="1" /></Border>
              </WrapPanel>
              <TextBlock x:Name="PluginStatus" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <WrapPanel x:Name="PluginPrimaryActions" Classes="workspace-toolbar">
                <Button x:Name="PluginEnabled" Click="OnEnabledClick" />
                <Button x:Name="PluginSelectCandidate" Click="OnSelectCandidateClick" />
                <Button x:Name="PluginWatches" Click="OnWatchesClick" />
                <Button x:Name="PluginMoreActions" Click="OnPluginMoreActionsClick" />
              </WrapPanel>
              <TextBlock x:Name="PluginExperimentalHint" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginDraftSummary" Classes="workspace-status" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginAttention" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="PluginStatusHint" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginCapabilities" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
              <SelectableTextBlock x:Name="PluginActivationReasons" TextWrapping="Wrap" Focusable="True" />
              <SelectableTextBlock x:Name="PluginActionHint" TextWrapping="Wrap" Focusable="True" Classes="muted" IsVisible="False" />
            </StackPanel>
          </Border>
          <desktop:SectionNavigationControl x:Name="PluginSections" />
          <StackPanel x:Name="PluginSettings" Spacing="12" />
          <Border Classes="workspace-section">
            <StackPanel Classes="workspace-section-header">
              <TextBlock x:Name="PluginDraftStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <WrapPanel Classes="workspace-actions">
                <Button x:Name="PluginSave" Classes="primary" Click="OnSaveClick" />
                <Button x:Name="PluginDiscard" Click="OnDiscardClick" />
              </WrapPanel>
              <SelectableTextBlock x:Name="PluginDraftReasons" TextWrapping="Wrap" Focusable="True" Classes="workspace-help" />
            </StackPanel>
          </Border>
          <Expander x:Name="PluginInfoExpander" HorizontalAlignment="Stretch"><StackPanel x:Name="PluginInformation" Spacing="8" /></Expander>
          <Expander x:Name="PluginGrantExpander" HorizontalAlignment="Stretch"><StackPanel x:Name="PluginGrants" Spacing="8" /></Expander>
          <Expander x:Name="PluginDeveloperExpander" HorizontalAlignment="Stretch">
            <StackPanel Spacing="12" Margin="0,4,0,0">
              <ursa:Descriptions x:Name="PluginIdentity" LabelPosition="Top" />
              <Button x:Name="PluginCopyTechnicalDetails" Click="OnCopyTechnicalDetailsClick" HorizontalAlignment="Left" />
              <TextBlock x:Name="PluginTechnicalCopyStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="PluginCandidateDiagnostics" TextWrapping="Wrap" Classes="error" />
              <Button x:Name="PluginRollback" Click="OnRollbackClick" HorizontalAlignment="Left" />
              <SelectableTextBlock x:Name="PluginRecoveryReasons" TextWrapping="Wrap" Focusable="True" />
              <StackPanel x:Name="PluginSourceExpander" Spacing="8">
                <TextBlock x:Name="PluginSourceToolsHeading" Classes="section-title" TextWrapping="Wrap" />
                <TextBlock x:Name="PluginSourcePath" TextWrapping="Wrap" />
                <TextBlock x:Name="PluginTestHint" TextWrapping="Wrap" Classes="muted" />
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                  <Button x:Name="PluginEdit" Click="OnEditClick" />
                  <Button x:Name="PluginDefaultEditor" Click="OnDefaultEditorClick" />
                  <Button x:Name="PluginBuild" Click="OnBuildClick" />
                </WrapPanel>
                <SelectableTextBlock x:Name="PluginSourceReasons" TextWrapping="Wrap" Focusable="True" />
                <StackPanel x:Name="PluginBuildDiagnostics" Spacing="6" />
                <TextBox x:Name="PluginProbeUrl" />
                <Button x:Name="PluginProbe" HorizontalAlignment="Left" Click="OnProbeClick" />
                <TextBox x:Name="PluginProbeResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="300" />
                <Expander x:Name="PluginEditorExpander" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="6">
                    <TextBlock x:Name="PluginEditorHint" TextWrapping="Wrap" />
                    <TextBox x:Name="PluginEditorExecutable" />
                    <TextBox x:Name="PluginEditorArguments" AcceptsReturn="True" MinHeight="70" />
                    <Button x:Name="PluginEditorSave" Click="OnEditorSaveClick" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
