<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MeowChan"
             x:Class="MeowChan.RulesPage" x:DataType="local:RulesPage"
             SizeChanged="OnRulesSizeChanged">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="20,20,20,12" Spacing="5">
            <TextBlock Text="{Binding Title}" Classes="page-title" />
            <TextBlock Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
        <ScrollViewer x:Name="RulesScroll" Grid.Row="1" Margin="20,0,20,16" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RulesContent" MaxWidth="880" HorizontalAlignment="Left" Spacing="16">
                <StackPanel Spacing="6" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding SavedScopesLabel}" Classes="section-title" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <ComboBox x:Name="RulesScopeList" HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ScopeChoices}" SelectedItem="{Binding SelectedScopeChoice, Mode=TwoWay}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:RuleScopeChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="OpenSavedRuleButton" Grid.Column="1" Content="{Binding OpenLabel}" Click="OnOpenSavedScope" />
                    </Grid>
                    <TextBlock Text="{Binding ScopeCountLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Expander x:Name="NewRuleScopeExpander" Header="{Binding NewScopeLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Margin="0,10,0,0">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock Text="{Binding ScopeKindLabel}" VerticalAlignment="Center" />
                                <ComboBox x:Name="NewRuleScopeKindInput" Grid.Column="1" ItemsSource="{Binding ScopeKindChoices}" SelectedIndex="{Binding NewScopeKind, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32" IsVisible="{Binding NeedsSource}">
                                <TextBlock Text="{Binding SourceIdLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="NewRuleSourceInput" Grid.Column="1" Text="{Binding NewSourceId, Mode=TwoWay}" PlaceholderText="4chan" />
                            </Grid>
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32" IsVisible="{Binding NeedsBoard}">
                                <TextBlock Text="{Binding BoardIdLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="NewRuleBoardInput" Grid.Column="1" Text="{Binding NewBoardId, Mode=TwoWay}" PlaceholderText="g" />
                            </Grid>
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32" IsVisible="{Binding NeedsThread}">
                                <TextBlock Text="{Binding ThreadIdLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="NewRuleThreadInput" Grid.Column="1" Text="{Binding NewThreadId, Mode=TwoWay}" PlaceholderText="123" />
                            </Grid>
                            <TextBlock Text="{Binding IdentityHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                            <Button x:Name="OpenNewRuleScopeButton" Content="{Binding OpenLabel}" Click="OnOpenNewScope" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel Spacing="0" IsEnabled="{Binding IsEditable}">
                    <TextBlock Text="{Binding EditingLabel}" Classes="section-title" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <CheckBox x:Name="RuleEnabledInput" Content="{Binding EnabledLabel}" IsChecked="{Binding RuleEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{Binding EnabledHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,4" />
                    <StackPanel IsEnabled="{Binding RuleEnabled}">
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock Text="{Binding TypesLabel}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox x:Name="RuleTypesModeInput" Grid.Column="1" ItemsSource="{Binding TypesModeChoices}" SelectedIndex="{Binding TypesMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <StackPanel IsVisible="{Binding HasTypeSelection}" Spacing="6" Margin="0,10,0,0">
                            <TextBlock Text="{Binding ExtensionsLabel}" FontWeight="Medium" />
                            <TextBox x:Name="RuleExtensionsInput" Text="{Binding ExtensionsText, Mode=TwoWay}" PlaceholderText="JPG, PNG, WebM" />
                            <TextBlock Text="{Binding ExtensionsHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock Text="{Binding SizeLabel}" FontWeight="Medium" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox x:Name="RuleSizeModeInput" Grid.Column="1" ItemsSource="{Binding SizeModeChoices}" SelectedIndex="{Binding SizeMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>
                        <StackPanel IsVisible="{Binding HasSizeLimit}" Spacing="6" Margin="0,10,0,0">
                            <TextBlock Text="{Binding MegabytesLabel}" FontWeight="Medium" />
                            <TextBox x:Name="RuleMegabytesInput" Text="{Binding MegabytesText, Mode=TwoWay}" PlaceholderText="10" />
                            <TextBlock Text="{Binding MegabytesHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding PreviewTitle}" Classes="section-title" />
                    <TextBlock Text="{Binding ValidationMessage}" Classes="error" IsVisible="{Binding HasValidationError}" TextWrapping="Wrap" />
                    <StackPanel Spacing="0" IsVisible="{Binding HasPreview}">
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock Text="{Binding TypesLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="RuleEffectiveTypes" Text="{Binding EffectiveTypesLabel}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RuleTypesOrigin" Text="{Binding TypesOriginLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="32">
                                <TextBlock Text="{Binding SizeLabel}" VerticalAlignment="Center" FontWeight="Medium" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock x:Name="RuleEffectiveSize" Text="{Binding EffectiveSizeLabel}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="RuleSizeOrigin" Text="{Binding SizeOriginLabel}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding FutureHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UnknownHint}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="20,10" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Workspace.Border}">
            <Grid x:Name="RulesFooter" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="6"
                  HorizontalAlignment="Left" Width="{Binding Bounds.Width, ElementName=RulesContent}">
                <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" />
                        <TextBlock x:Name="RuleActionError" Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="RulesFooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="DiscardRuleButton" Content="{Binding DiscardLabel}" IsEnabled="{Binding IsEditable}" Click="OnDiscardDraft" />
                    <Button x:Name="SaveRuleButton" Content="{Binding SaveLabel}" Classes="primary" IsEnabled="{Binding CanSave}" Click="OnSaveRule" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
