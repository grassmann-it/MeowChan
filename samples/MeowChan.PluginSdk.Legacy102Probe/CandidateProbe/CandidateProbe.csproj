<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <AssemblyName>LegacySdk102CandidateProbe</AssemblyName>
    <RootNamespace>MeowChan.PluginSdk.Legacy102Probe</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <Target Name="RequireCandidateSdkAssembly" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SdkAssemblyPath)' == ''"
           Text="SdkAssemblyPath must point to the candidate 1.1.0 MeowChan.PluginSdk.dll." />
    <Error Condition="'$(SdkAssemblyPath)' != '' and !Exists('$(SdkAssemblyPath)')"
           Text="SdkAssemblyPath does not exist: $(SdkAssemblyPath)." />
  </Target>

  <ItemGroup>
    <Reference Include="MeowChan.PluginSdk">
      <HintPath>$(SdkAssemblyPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
