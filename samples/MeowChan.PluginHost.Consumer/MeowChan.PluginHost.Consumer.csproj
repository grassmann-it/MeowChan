<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <MeowChanPluginHostVersion Condition="'$(MeowChanPluginHostVersion)' == ''">$(Version)</MeowChanPluginHostVersion>
    <MeowChanPluginSdkVersion Condition="'$(MeowChanPluginSdkVersion)' == ''">$(Version)</MeowChanPluginSdkVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MeowChan.PluginHost" Version="[$(MeowChanPluginHostVersion)]" />
    <PackageReference Include="MeowChan.PluginSdk" Version="[$(MeowChanPluginSdkVersion)]" />
    <None Include="PackageProbePlugin.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
