<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/meowchan.ico</ApplicationIcon>
    <Product>MeowChan</Product>
    <RepositoryUrl>https://github.com/grassmann-it/MeowChan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Desktop archives contain runtime files and notices; API docs/symbols stay in developer builds. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;samples/**;libmeowchan/**;MeowChan.PluginSdk/**;MeowChan.PluginHost/**;MeowChan.PluginWorker/**;MeowChan.PluginCompiler/**;plugins/**;Shared/**;artifacts/**;docs/**</DefaultItemExcludes>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <!-- Portable restores include both native packages on every host; copying remains host/RID-specific. -->
    <VlcWindowsX64Enabled Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows')))">true</VlcWindowsX64Enabled>
    <VlcWindowsX64Enabled Condition="'$(VlcWindowsX64Enabled)' == ''">false</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
    <VlcMacEnabled Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64' Or ('$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX')))">true</VlcMacEnabled>
    <VlcMacEnabled Condition="'$(VlcMacEnabled)' == ''">false</VlcMacEnabled>
    <!-- Runtime and self-contained/single-file options are selected when publishing. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <PackageReference Include="Semi.Avalonia.DataGrid" Version="12.1.0.1" />
    <PackageReference Include="Irihi.Ursa" Version="2.2.0" />
    <PackageReference Include="Irihi.Ursa.Themes.Semi" Version="2.2.0" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24"
                      Condition="'$(RuntimeIdentifier)' == 'win-x64' Or $([System.String]::Copy('$(RuntimeIdentifiers)').Contains('win-x64')) Or ('$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == '')" />
    <PackageReference Include="VideoLAN.LibVLC.Mac" Version="3.1.3.2"
                      Condition="'$(RuntimeIdentifier)' == 'osx-x64' Or '$(RuntimeIdentifier)' == 'osx-arm64' Or $([System.String]::Copy('$(RuntimeIdentifiers)').Contains('osx-')) Or ('$(RuntimeIdentifier)' == '' And '$(RuntimeIdentifiers)' == '')" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />

    <AvaloniaResource Include="Assets/**" />
    <None Update="Assets/meowchan.png" CopyToPublishDirectory="PreserveNewest" />
    <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs/native-video-licenses.txt;docs/native-video-linux-sources.md;docs/native-video-sources.md;docs/native-video-source-manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs/native-video-macos-sources.md;docs/native-video-macos-source-manifest.json;docs/native-video-macos-COPYING" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scripts/**/*.cs" />
    <Compile Include="Shared/UiResponsivenessProbe.cs" Link="Diagnostics/UiResponsivenessProbe.cs" />
    <ProjectReference Include="libmeowchan/libmeowchan.csproj" />
    <ProjectReference Include="MeowChan.PluginHost/MeowChan.PluginHost.csproj" />
  </ItemGroup>
  <Target Name="ExcludeDesktopSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <!-- Referenced project PDBs can arrive separately from the app's own symbols. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- Plugin trees must remain beside the executable, including single-file publishes. -->
  <Target Name="KeepVlcNativeTreesExternal" AfterTargets="CollectVlcFilesToCopyWindows" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Update="@(Content)" Condition="$([System.String]::Copy('%(Content.Link)').StartsWith('libvlc'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
  <Import Project="packaging/PluginDelivery.targets" />
</Project>
