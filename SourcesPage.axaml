<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop"
             xmlns:ursa="https://irihi.tech/ursa"
             x:Class="MeowChan.SourcesPage" SizeChanged="OnPageSizeChanged">
    <UserControl.Styles>
        <Style Selector="DataGridCell TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style Selector="DataGridColumnHeader TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    </UserControl.Styles>
    <ScrollViewer x:Name="SourcesScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                    <TextBlock Tag="nav.sources" Classes="page-title localized" />
                    <TextBlock Tag="sources.subtitle" Classes="muted localized" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock x:Name="SourceCount" Grid.Column="1" Classes="muted" VerticalAlignment="Top" />
            </Grid>
            <Grid x:Name="SourcesSplit" ColumnDefinitions="280,*" ColumnSpacing="14">
              <StackPanel x:Name="SourcesListPane" Grid.Column="0" Spacing="10">
                <TextBlock x:Name="SourcesEmpty" Tag="sources.empty" Classes="muted localized" />
                <StackPanel x:Name="SourceCards" Spacing="10" />
              </StackPanel>
              <Border x:Name="SourceDetailsPanel" Grid.Column="1" Classes="panel" Padding="16">
                <StackPanel Spacing="12">
                    <Button x:Name="SourceBackButton" HorizontalAlignment="Left" Click="OnBackClick" />
                    <TextBlock x:Name="SourceHeading" Classes="section-title" FontSize="18" />
                    <TextBlock x:Name="SourceExperimental" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="False" />
                    <StackPanel x:Name="SourceMediaIntegrityPanel" Spacing="6" IsVisible="False">
                        <TextBlock x:Name="SourceMediaIntegrityExplanation" TextWrapping="Wrap" />
                        <CheckBox x:Name="SourceAllowProviderMismatch" Click="OnSourceMediaPermissionClick">
                            <TextBlock x:Name="SourceAllowProviderMismatchLabel" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="SourceMediaIntegrityScope" Classes="muted" TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceMediaIntegrityStatus" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <ursa:Banner x:Name="SourceMediaIntegrityErrorBanner" Type="Error" CanClose="False" HorizontalContentAlignment="Stretch" IsVisible="False">
                            <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SourceMediaIntegrityError" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                            </ScrollViewer>
                        </ursa:Banner>
                    </StackPanel>
                    <TextBlock x:Name="SourceIdentity" Classes="muted mono" TextWrapping="Wrap" />
                    <Button x:Name="SourceWebsiteButton" HorizontalAlignment="Left" Click="OnWebsiteClick" />
                    <WrapPanel x:Name="CapabilityCards" ItemSpacing="8" LineSpacing="8" />
                    <TextBlock x:Name="SourceCaptureAvailability" Classes="muted" TextWrapping="Wrap" />
                    <Expander x:Name="AdapterDetails" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SourceHosts" Classes="muted" TextWrapping="Wrap" />
                            <TextBlock x:Name="SourceVersion" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Button x:Name="SourcePluginButton" Click="OnPluginClick" />
                        <Button x:Name="SourceRulesButton" Tag="sources.rules" Classes="localized" Click="OnRulesClick" />
                        <Button x:Name="SourceDiagnosticsButton" Tag="sources.diagnostics" Classes="localized" Click="OnDiagnosticsClick" />
                    </WrapPanel>
                    <TextBlock Tag="sources.urlHint" Classes="muted localized" TextWrapping="Wrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="SourceUrlInput" KeyDown="OnUrlKeyDown" />
                        <Button x:Name="SourceAddButton" Grid.Column="1" Tag="action.add" Classes="primary localized" Click="OnAddClick" />
                    </Grid>
                    <TextBlock x:Name="SourceUrlResult" Classes="muted" TextWrapping="Wrap" />
                    <Button x:Name="SourceDownloadsButton" Tag="nav.downloads" Classes="localized" HorizontalAlignment="Left" Click="OnDownloadsClick" />
                    <TextBlock Tag="sources.watches" Classes="localized" FontWeight="SemiBold" />
                    <TextBlock x:Name="SourceWatchSummary" Classes="muted" TextWrapping="Wrap" />
                    <DataGrid x:Name="SourceWatchesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              GridLinesVisibility="None" SelectionMode="Single" RowHeight="40"
                              MinHeight="100" MaxHeight="240" SelectionChanged="OnWatchSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn MinWidth="150" Width="2*" Binding="{Binding Resource, DataType=desktop:SourceWatchRow}" />
                            <DataGridTextColumn MinWidth="140" Width="140" Binding="{Binding Work, DataType=desktop:SourceWatchRow}" />
                            <DataGridTextColumn MinWidth="190" Width="*" Binding="{Binding Observation, DataType=desktop:SourceWatchRow}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBox x:Name="SourceWatchDetails" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" />
                    <Button x:Name="SourceOpenWatchButton" Tag="diagnostics.openWatch" Classes="localized" HorizontalAlignment="Left" Click="OnOpenWatchClick" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ursa:LoadingIcon x:Name="SourcesOperationLoading" Width="16" Height="16" IsVisible="False" Focusable="False" />
                        <TextBlock x:Name="SourcesOperationStatus" Classes="muted" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    </StackPanel>
                    <ursa:Banner Type="Error" CanClose="False" HorizontalContentAlignment="Stretch" x:Name="SourcesActionErrorBanner" IsVisible="False">
                        <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="SourcesActionError" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
                    </ursa:Banner>
                </StackPanel>
              </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
