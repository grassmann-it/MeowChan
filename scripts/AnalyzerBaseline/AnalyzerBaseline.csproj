<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Runs inside the compiler of the repository's pinned .NET 10 SDK. No new NuGet dependency. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildToolsPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" Private="false" />
  </ItemGroup>
</Project>
