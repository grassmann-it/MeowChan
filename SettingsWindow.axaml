<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeowChan"
        x:Class="MeowChan.SettingsWindow" x:DataType="local:SettingsEditor"
        Title="{Binding SettingsTitle}" Icon="avares://MeowChan/Assets/meowchan.png"
        Width="940" Height="760" MinWidth="480" MinHeight="480" WindowStartupLocation="CenterOwner">
    <ContentControl x:Name="EditorHost" />
</Window>
