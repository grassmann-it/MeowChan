<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.release.lock.json</NuGetLockFilePath>
    <RestoreLockedMode Condition="Exists('packages.release.lock.json')">true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
    <ProjectReference Include="../../plugins/Examples/Lainchan/MeowChan.Plugin.Lainchan.csproj" />
    <ProjectReference Include="../../plugins/Examples/Kohlchan/MeowChan.Plugin.Kohlchan.csproj" />
    <ProjectReference Include="../../plugins/Examples/Wizchan/MeowChan.Plugin.Wizchan.csproj" />
    <ProjectReference Include="../../plugins/Examples/Endchan/MeowChan.Plugin.Endchan.csproj" />
    <ProjectReference Include="../../plugins/Examples/AnimationFormatFilter/MeowChan.AnimationFormatFilter.csproj" />
    <ProjectReference Include="../../plugins/Examples/PngMetadataFilter/MeowChan.PngMetadataFilter.csproj" />
    <ProjectReference Include="../../plugins/Examples/Leftypol/MeowChan.Plugin.Leftypol.csproj" />
    <ProjectReference Include="../../plugins/Examples/Dvach/MeowChan.Plugin.Dvach.csproj" />
    <ProjectReference Include="../../plugins/Examples/Uboachan/MeowChan.Plugin.Uboachan.csproj" />
    <Using Include="Xunit" />
    <None Update="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
