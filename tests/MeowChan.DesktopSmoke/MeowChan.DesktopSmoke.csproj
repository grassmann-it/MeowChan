<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Only the harness replaces native tray creation; production uses public Avalonia APIs. -->
    <AvaloniaAccessUnstablePrivateApis>true</AvaloniaAccessUnstablePrivateApis>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);AVA3001</MSBuildWarningsAsMessages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../MeowChan.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Shared/TemporaryWorkspacePaths.cs" Link="TestSupport/TemporaryWorkspacePaths.cs" />
    <Compile Include="../../Shared/DiagnosticAdapters/ShellLoadConditionalStoreAdapter.cs" Link="TestSupport/ShellLoadConditionalStoreAdapter.cs" />
  </ItemGroup>
</Project>
