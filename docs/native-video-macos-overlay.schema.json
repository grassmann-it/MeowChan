{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/grassmann-it/MeowChan/blob/main/docs/native-video-macos-overlay.schema.json",
  "title": "MeowChan macOS source overlay manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "application_source_commit", "application_source_archive_sha256", "source_base", "source_input_manifest_sha256", "architectures", "application_source_files", "source_coverage", "rebuild_provenance_uncertainties", "scope"],
  "properties": {
    "schema": {"const": "meowchan.macos-source-overlay.v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "application_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "application_source_archive_sha256": {"$ref": "#/$defs/sha256"},
    "source_input_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_base": {
      "type": "object", "required": ["file", "bytes", "sha256", "managed_binding_source"],
      "properties": {"file": {"type": "string"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "managed_binding_source": {"type": "object"}}
    },
    "architectures": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {"osx-arm64": {"$ref": "#/$defs/architecture"}, "osx-x64": {"$ref": "#/$defs/architecture"}}
    },
    "application_source_files": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "source_coverage": {"type": "object"},
    "rebuild_provenance_uncertainties": {"type": "array", "items": {"type": "string"}},
    "scope": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "architecture": {
      "type": "object", "additionalProperties": false, "required": ["signed_dmg", "inventory_zip", "inventory"],
      "properties": {
        "signed_dmg": {"$ref": "#/$defs/asset"},
        "inventory_zip": {"$ref": "#/$defs/asset"},
        "inventory": {"type": "string", "enum": ["binary-inventories/osx-arm64.json", "binary-inventories/osx-x64.json"]}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false, "required": ["file", "bytes", "sha256"],
      "properties": {"file": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
