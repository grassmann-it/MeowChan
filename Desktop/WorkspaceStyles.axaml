                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Workspace.Background">#E3DFD8</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Panel">#EFECE6</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Raised">#DBD5CB</SolidColorBrush>
                                        <!-- UX review 2026-11-13: decorative lines (grid lines, section and panel edges, dividers, disabled outlines) were #A89F92, 2.22:1 on
                         Panel and 1.79:1 on Raised, so on the column head and the selected row the line vanished. #948A7D: 2.88:1 on Panel, 2.55:1 on
                         Background, 2.32:1 on Raised, 2.35:1 on AccentSurface, 3.17:1 on Card; still decorative (below 3:1), but visible. -->
                    <SolidColorBrush x:Key="Workspace.Border">#948A7D</SolidColorBrush>
                    <!-- LW-06 (B1, N7, N8, N10, N12): interactive outlines only; decorative lines stay on Workspace.Border.
                         UX review 2026-11-13: #7A7062 was 2.99:1 on Hover, so a hovered button, chip or row outline fell just under 3:1.
                         #726858 is 3.37:1 on Hover, 3.75:1 on Raised, 3.79:1 on AccentSurface, 4.12:1 on Background, 4.64:1 on Panel/Overlay
                         and 5.12:1 on Card; every Light key that mirrors it below carries the same value. -->
                    <SolidColorBrush x:Key="Workspace.ControlBorder">#726858</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Text">#1A1A1A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Muted">#575148</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Accent">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentSurface">#E7D4BE</SolidColorBrush>
                    <!-- D0 surface tokens (see the Dark block). Light CardEdge equals ControlBorder; Overlay equals Panel. -->
                    <SolidColorBrush x:Key="Workspace.Card">#FAF7F1</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.CardEdge">#726858</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Overlay">#EFECE6</SolidColorBrush>
                    <BoxShadows x:Key="Workspace.Shadow.Overlay">0 4 16 0 #26000000</BoxShadows>
                    <!-- D6: see Dark. -->
                    <BoxShadows x:Key="MenuFlyoutBorderBoxShadow">0 4 16 0 #26000000</BoxShadows>
                    <BoxShadows x:Key="FlyoutBorderBoxShadow">0 4 16 0 #26000000</BoxShadows>
                    <BoxShadows x:Key="ComboBoxPopupBoxShadow">0 4 16 0 #26000000</BoxShadows>
                    <BoxShadows x:Key="AutoCompleteBoxPopupBoxShadow">0 4 16 0 #26000000</BoxShadows>
                    <BoxShadows x:Key="NotificationCardBoxShadows">0 4 16 0 #26000000</BoxShadows>
                    <SolidColorBrush x:Key="Workspace.Scrim">#66000000</SolidColorBrush>
                    <!-- Reader post cards are workspace cards (D3): warm near-white Card on the Background page. Edge = ControlBorder
                         (= CardEdge), 4.12:1 against the page; card 1.24:1 above it. Active card: AccentSurface + accent edge. -->
                    <!-- Greentext: the study's #3F6D1A fell to 4.26:1 on the active card (AccentSurface); #386217
                         is 6.71:1 on the card, 4.97:1 on the active card and 5.40:1 on the page (opening post). -->
                    <SolidColorBrush x:Key="Workspace.ReaderGreentext">#386217</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ReaderCodeSurface">#ECE7DD</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ReaderSpoiler">#D3CDC2</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Hover">#D2CABE</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.OnAccent">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentHover">#9A4B0B</SolidColorBrush>
                    <!-- UX review 2026-11-13: AccentHover (#9A4B0B) is a solid-button surface (white text 6.20:1) but as a text colour it is 4.30:1 on
                         AccentSurface, 4.25:1 on Raised and 3.82:1 on Hover. As text the hover tone is one step darker, as Pressed is in Light:
                         #6E3305 is 6.81:1 on AccentSurface, 6.05:1 on Hover. -->
                    <SolidColorBrush x:Key="Workspace.AccentHoverText">#6E3305</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Error">#A52736</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ErrorSurface">#F4E0E3</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Warning">#795100</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.WarningSurface">#F2E5C4</SolidColorBrush>
                    <!-- Palette review 2026-11-13: #2D4023 was a near-black olive (CIELAB chroma 20) that read as grey and sat 8 dE
                         from Error under protanopia. A clear bluish green at the same text contrast: 5.02:1 on Background, 5.66:1
                         on Panel, 4.57:1 on Raised, 6.24:1 on Card, 5.72:1 on SuccessSurface; simulated distance to Error 8.2 -> 14.4. -->
                    <SolidColorBrush x:Key="Workspace.Success">#1D6941</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.SuccessSurface">#E8F0E4</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Progress">#4A2203</SolidColorBrush>
                    <!-- UX review 2026-11-13 (progress variant A): the fill is a dark accent brown one step below the pressed accent (#662F05),
                         no longer a foreign neutral grey (#333333, 3.12:1 on the track). The empty part of a bar is visible: 3.05:1 on
                         Background, 3.44:1 on Panel/Overlay, 3.79:1 on Card, and the #4A2203 fill is 3.41:1 on it (11.71:1 on Panel, 8.50:1 on Hover,
                         9.57:1 on AccentSurface). 3:1 on Raised (2.78), Hover (2.50) and AccentSurface (2.81) is not reachable together with a 3:1
                         fill: that would need a track luminance of at most 0.19 and at least 0.199. -->
                    <SolidColorBrush x:Key="Workspace.ProgressTrack">#857D74</SolidColorBrush>
