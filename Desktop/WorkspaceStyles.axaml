                    <SolidColorBrush x:Key="BannerInformationBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="BannerInformationBorderBrush">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardInformationIconForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardLightInformationBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardLightInformationBorderBrush">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="LoadingIconForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgePrimaryBadgeBackground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeInvertedPrimaryBadgeForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLightPrimaryBadgeBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLightPrimaryBadgeForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="GridSplitterPreviewBackground">#66803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridDropLocationIndicatorBackground">#66803B06</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <!-- Semi owns every standard control template. These public theme resources
             retain MeowChan's density without replacing focus, input or state behavior. -->
        <Thickness x:Key="DataGridCellTextBlockDefaultMargin">12,0</Thickness>
        <x:Double x:Key="DataGridCellMinHeight">0</x:Double>
        <!-- D6: one radius (8, Workspace.Radius.Group) for every overlay Semi draws: menu, flyout, tooltip, toast, drop-down and
             suggestion popups. Menu items keep Semi's own item radius. -->
        <CornerRadius x:Key="MenuFlyoutCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="FlyoutCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ToolTipCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="NotificationCardCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ComboBoxPopupBoxCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="AutoCompleteBoxPopupCornerRadius">8</CornerRadius>
        <x:Double x:Key="DataGridColumnHeaderMinHeight">28</x:Double>
        <!-- ===== Workspace design tokens (D0) =====
             Colour tokens live in the theme dictionaries above; the tokens below are theme-neutral.
             Use them instead of literals. Nothing here changes a Semi template.
             Surfaces, each only on the level below (never Card in Card):
               Background 0 (window) < Panel 1 (section, table, bar) < Card 2 (content card, CardEdge 1 px)
               < Raised 3 (interactive: buttons, column heads) < Overlay 4 (menu, flyout, toast: Overlay +
               ControlBorder + Shadow.Overlay). Shadow.Overlay is the only shadow: never in lists, tiles or cards.
               Scrim dims the content behind blocking in-window overlays (every blocking dim layer uses Workspace.Scrim, no literal).
             Cards, three classes (DS-P4): workspace-section (Panel + Border, radius 5, inset 16: the section container of a page),
               workspace-card (Card + CardEdge, radius 5, inset Card: a content card in a list or on a section) and workspace-overlay
               (Overlay + ControlBorder, radius 8: an in-window overlay), plus workspace-section-flush (a section with inset 0 for
               content that runs to the edge: tables, media grids, reader content, a frame that brings its own insets).
               Border.panel and Border.raised are retired.
             Radius: None 0 (window, title bar, caption, tab/nav bars, transport), Badge 3 (marks under 20 dip),
               Control 5 (buttons, inputs, sections, cards, tiles), Group 8 (overlays, dialog body),
               Chip 12 (pill at 24 dip), ChipCompact 9 (pill at 18 dip). Circles use Width/2 locally.
             Size: Control 30 (button), Input 32 (text box, combo box, column head), InputProminent 36 (Downloads URL entry), Nav 36, Chip 24, ChipCompact 18,
               TitleBar 48 (code mirror WorkspaceMetrics.TitleBarHeight), Caption 44 (caption-button width),
               Icon 16, IconCaption 10. Row heights stay in code (WorkspaceMetrics, density setting).
             Space: 2/4/8/12/16/24/32. Inset: Section, Message, Footer, Chip, ChipCompact, Card, Overlay, Page (12, page margin).
             Text: Caption 11, Meta 12, Body 13, Section 14, Subtitle 16, Title 20 (the brand's 19 is a special case).
             From code bind a resource, e.g. control[!Border.CornerRadiusProperty] = new DynamicResourceExtension(key). -->
        <!-- Shared composition values. Density remains the existing preference,
             not a new setting and not an instruction to compact every surface. -->
        <x:Double x:Key="Workspace.Space.2">2</x:Double>
        <x:Double x:Key="Workspace.Space.4">4</x:Double>
        <x:Double x:Key="Workspace.Space.8">8</x:Double>
        <x:Double x:Key="Workspace.Space.12">12</x:Double>
        <x:Double x:Key="Workspace.Space.16">16</x:Double>
        <x:Double x:Key="Workspace.Space.24">24</x:Double>
        <x:Double x:Key="Workspace.Space.32">32</x:Double>
        <!-- P2 page grid: title to subtitle inside a page header (4), gap between the cards of a page (12) and between a
             form's label column and its value column (24); ValueColumn is the width of that value column. -->
        <x:Double x:Key="Workspace.Space.Header">4</x:Double>
        <x:Double x:Key="Workspace.Space.Card">12</x:Double>
        <x:Double x:Key="Workspace.Form.Gap">24</x:Double>
        <x:Double x:Key="Workspace.Form.ValueColumn">280</x:Double>
        <x:Double x:Key="Workspace.Text.Caption">11</x:Double>
        <!-- UI font (Inter) and reading font of post bodies only (bundled Noto Sans subset, Inter for missing glyphs).
             These are the static defaults; ReaderFonts.Apply republishes both keys in Application.Resources with the
             platform's installed CJK families appended, the active UI language's regional variant first. -->
        <FontFamily x:Key="Workspace.Font.UI">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="Workspace.Font.Reading">avares://MeowChan/Assets/Fonts#Noto Sans, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <x:Double x:Key="Workspace.Text.Body">13</x:Double>
        <x:Double x:Key="Workspace.Text.Meta">12</x:Double>
        <x:Double x:Key="Workspace.Text.Section">14</x:Double>
        <x:Double x:Key="Workspace.Text.Subtitle">16</x:Double>
        <x:Double x:Key="Workspace.Text.Title">20</x:Double>
        <CornerRadius x:Key="Workspace.Radius.None">0</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Badge">3</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Control">5</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Group">8</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Chip">12</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.ChipCompact">9</CornerRadius>
        <x:Double x:Key="Workspace.Size.Control">32</x:Double>
        <x:Double x:Key="Workspace.Size.HeaderIcon">30</x:Double>
        <x:Double x:Key="Workspace.Size.Input">32</x:Double>
        <x:Double x:Key="Workspace.Size.Nav">36</x:Double>
        <!-- The one prominent entry row of the app (Downloads URL box and its Add button): 36 instead of Input 32, by design. -->
        <x:Double x:Key="Workspace.Size.InputProminent">36</x:Double>
        <x:Double x:Key="Workspace.Size.Chip">24</x:Double>
        <x:Double x:Key="Workspace.Size.ChipCompact">18</x:Double>
        <x:Double x:Key="Workspace.Size.TitleBar">48</x:Double>
        <x:Double x:Key="Workspace.Size.Caption">44</x:Double>
        <x:Double x:Key="Workspace.Size.Icon">16</x:Double>
        <x:Double x:Key="Workspace.Size.IconCaption">10</x:Double>
        <!-- ControlCompact 24: inline buttons inside content (reader post number and quote buttons, pager buttons); same height as a Chip. -->
        <x:Double x:Key="Workspace.Size.ControlCompact">24</x:Double>
        <Thickness x:Key="Workspace.Inset.Section">16</Thickness>
        <Thickness x:Key="Workspace.Inset.Message">12</Thickness>
        <Thickness x:Key="Workspace.Inset.EmptyState">28</Thickness>
        <x:Double x:Key="Workspace.Size.EmptyStateWidth">360</x:Double>
        <Thickness x:Key="Workspace.Inset.Footer">16,12</Thickness>
        <Thickness x:Key="Workspace.Inset.Chip">8,4</Thickness>
        <Thickness x:Key="Workspace.Inset.ChipCompact">6,1</Thickness>
        <Thickness x:Key="Workspace.Inset.Card">12,10,12,12</Thickness>
        <Thickness x:Key="Workspace.Inset.Overlay">12</Thickness>
        <!-- Page margin of every work view (Downloads, Sources, Plugins, Diagnostics, Statistics, Media, Archive). -->
        <Thickness x:Key="Workspace.Inset.Page">12</Thickness>
        <!-- List cards (Sources list, Plugins list): inner spacing and the start-edge selection bar (LW-06). -->
        <Thickness x:Key="Workspace.Inset.ListCard">14</Thickness>
        <Thickness x:Key="Workspace.ListCard.SelectionBar">3,0,0,0</Thickness>
        <!-- Native keyboard-only focus decoration; it overlays rather than moves
             content, and remains separate from selected/error border state.
             D4 (E7): two shells. The outer 2-px ring is the accent; the inner 1-px ring is the window background, so the
             focus stays readable on a solid accent button and on accent-tinted rows (both colours differ from every surface
             they touch by at least 3:1 in Light and Dark). The outer border keeps Margin -4 (the 4-dip offset); the adorner layer must not clip it, or the right and bottom of the ring are
             cut by 8 dip (the clip rectangle is the control's own, measured from the ring's shifted origin). -->
        <Template x:Key="Workspace.FocusAdorner">
            <Border BorderBrush="{DynamicResource Workspace.Accent}" BorderThickness="2"
                    CornerRadius="{StaticResource Workspace.Radius.Control}" Margin="-4"
                    AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
                <Border BorderBrush="{DynamicResource Workspace.Background}" BorderThickness="1"
                        CornerRadius="{StaticResource Workspace.Radius.Badge}" IsHitTestVisible="False" />
            </Border>
        </Template>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Workspace.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Workspace.Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="ProgressBar"><Setter Property="Background" Value="{DynamicResource Workspace.ProgressTrack}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Progress}" /></Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <!-- DS-P3: the empty state of a list or grid (controls:WorkspaceEmptyState): centred, one muted sentence, at most one primary action. -->
    <Style Selector="controls|WorkspaceEmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="{StaticResource Workspace.Size.EmptyStateWidth}" />
        <Setter Property="Margin" Value="{StaticResource Workspace.Inset.EmptyState}" />
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.12}" />
    </Style>
    <Style Selector="TextBlock.workspace-empty-text, SelectableTextBlock.workspace-empty-text">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.brand"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Title}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Section}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="monospace" /></Style>
    <Style Selector="SelectableTextBlock.reader-body"><Setter Property="FontFamily" Value="{DynamicResource Workspace.Font.Reading}" /></Style>
    <Style Selector="Window.workspace-advanced TextBlock.inline-thread-id"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border.shell-bar">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-divider"><Setter Property="Padding" Value="0,8" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /></Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" /><Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <!-- UX round 3 (Dark outlines made every action row a row of boxes): a ghost button is the quiet secondary action inside
         cards, rows and inspector panels. At rest it is only its label (Text 11:1 or more on every surface, so the label, not an
         outline, identifies it); the interactive outline (ControlBorder, 3:1 on Raised and every surface below it) and the Raised fill appear on pointer
         over, the accent outline when pressed; keyboard focus keeps the shared focus ring. The one action of a row that must stay
         findable (the primary one, Remove) keeps its outline. Disabled: text colour only, no outline. -->
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.header-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.HeaderIcon}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.HeaderIcon}" />
        <Setter Property="Padding" Value="6" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- The network/disk graph in the header is a button: compact, no outline until it has focus or the pointer. -->
    <Style Selector="Button.header-graph"><Setter Property="Padding" Value="6,2" /><Setter Property="MinHeight" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.header-icon.selected"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>
    <Style Selector="Path.header-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Icon}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Icon}" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.window-caption">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Caption}" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.None}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- UX review 2026-11-13: the caption hover fill alone is 1.37:1 (Dark) / 1.38:1 (Light) on the bar; the 1-px edge reserved above
         (transparent at rest, inside the square button, nothing moves) shows ControlBorder on hover and the accent when pressed. -->
    <Style Selector="Button.window-caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.window-caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.CaptionCloseEdge}" />
    </Style>
    <Style Selector="Path.window-caption-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.IconCaption}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.IconCaption}" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Thin rule between the footer groups; decorative, so it stays on the decorative border colour. -->
    <Style Selector="Border.nav-separator"><Setter Property="Background" Value="{DynamicResource Workspace.Border}" /></Style>
    <!-- Footer navigation (UX review 2026-11-13: the hover fill alone was 1.37:1 / 1.38:1 on the bar with a Muted label, the selected item
         only Raised, 1.13:1 / 1.24:1). Every item reserves a 1-px edge (transparent at rest; padding 11,7 keeps the 12,8 inset, so nothing
         moves). Hover: Hover fill, ControlBorder edge (3.34:1 / 3.37:1 on Hover, 4.59:1 / 4.64:1 on the bar), label and icon Text.
         Pressed: AccentSurface with the accent edge. Selected: AccentSurface and a 3-px accent bar at the bottom edge like the tab pipe
         (5.14:1 / 5.72:1 on the fill, 6.84:1 / 7.00:1 on the bar; padding 12,8,12,5 keeps the inset), label Text, icon Accent; selected
         and hovered keeps the bar. -->
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Padding" Value="11,7" /><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Nav}" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.nav.selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="0,0,0,3" /><Setter Property="Padding" Value="12,8,12,5" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav.selected Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" /></Style>
    <!-- Semi's translucent dark-blue selection has little contrast on dark fields.
         Keep its native presenter and retained-selection behavior with an opaque pair. -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Workspace.OnAccent}" />
    </Style>
    <!-- A checkbox in a horizontal control row (filter rows: Diagnostics, Reader status line, toolbars) sits on the row's
         centre line with the 32 dip inputs and buttons beside it, not at the top of the line. Vertical lists are unaffected. -->
    <Style Selector="WrapPanel[Orientation=Horizontal] > CheckBox, StackPanel[Orientation=Horizontal] > CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.footer-mode"><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /></Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="RowHeight" Value="{x:Static desktop:WorkspaceMetrics.NormalRowHeight}" /><Setter Property="ColumnHeaderHeight" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="Padding" Value="10,7" />
        <!-- UX review 2026-11-13: Raised head on Panel body is 1.24:1 in Light, so the boundary rests on the fill alone; a lower edge of the
             decorative line colour (2.32:1 on Raised in Light) closes the head. -->
        <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,0" /><Setter Property="ClipToBounds" Value="True" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>
    <!-- UX review 2026-11-13: a hovered row is the Hover fill with a 1-px ControlBorder start edge (the fill alone was 1.13:1 / 1.24:1); drawn
         on the background layer like the selection bar below, so cells do not move. The selected bar wins over it. -->
    <!-- Performance review 2026-11-14 (N1): the 1-px start edge is reserved at rest (transparent) so entering and leaving a row only changes the
         brush, never the border's thickness and with it the row's layout. The background layer is a sibling of the cells, so they do not move. -->
    <Style Selector="DataGridRow /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- LW-06 R1/N4a: selection is never the tint alone. A 3-px accent bar like the active reader post;
         on rows it is drawn on the background layer behind the cells, so cells do not move. -->
    <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="ListBox.workspace-selection-bar ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <!-- Rows of menus, drop-downs and plain lists (UX review 2026-11-13). Semi's rows had a translucent hover (1.09:1 to 1.42:1) and no edge.
         Each row reserves a 1-px edge, transparent at rest; the padding gives it back (Semi's 16,8 menu and 12,8 drop-down/list insets), so
         rows keep their size. Hover (menus: the highlighted row, :selected, also by keyboard) shows it in ControlBorder (3.34:1 / 3.37:1 on
         Hover, 4.59:1 / 4.64:1 on Overlay), pressed in the accent. A chosen drop-down or list row is AccentSurface with a 3-px accent bar at its
         start edge (5.14:1 / 5.72:1), never the tint alone. Lists with their own row design (reader posts, tile grids, chip lists, the
         selection-bar lists above) keep it. The list selectors use the child combinator (a row's logical parent is its ListBox): a row of an inner
         list never matches through an outer list, and rows do not collect one class activator per ListBox ancestor. Template parts checked against Semi 12.1.0.1: MenuItem Border#PART_LayoutRoot, ComboBoxItem and
         ListBoxItem ContentPresenter#PART_ContentPresenter, each binding BorderBrush, BorderThickness and Padding from the row. -->
    <Style Selector="MenuItem"><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="15,7" /></Style>
    <Style Selector="Menu > MenuItem"><Setter Property="Padding" Value="15,0" /></Style>
    <Style Selector="MenuItem:selected"><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /></Style>
    <Style Selector="MenuItem:pressed"><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="ComboBoxItem, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width) > ListBoxItem:not(.chip-item)">
        <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,7" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width) > ListBoxItem:not(.chip-item):pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="ComboBoxItem:pressed, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width) > ListBoxItem:not(.chip-item):pressed">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ComboBoxItem:selected, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width) > ListBoxItem:not(.chip-item):selected">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="9,8,12,8" />
    </Style>

    <!-- Opt-in composition roles; native templates, selection and automation stay
         with Semi/Ursa and the existing controls. Do not nest sections for decoration. -->
    <Style Selector="Button, ToggleButton, TextBox, ComboBox, NumericUpDown, CheckBox, RadioButton, Slider, ListBoxItem, SelectableTextBlock">
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <!-- An inline link: accent text only, no outline and no fill (the default button outline made About links look like boxes). -->
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>
    <Style Selector="TextBlock.workspace-field-label, SelectableTextBlock.workspace-field-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-help, SelectableTextBlock.workspace-help, TextBlock.workspace-meta, SelectableTextBlock.workspace-meta">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-error, SelectableTextBlock.workspace-error">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-warning, SelectableTextBlock.workspace-warning">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-status, SelectableTextBlock.workspace-status">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- workspace-page-header: the title and its one-line subtitle of a page (4 apart); the page stack puts 8 between this header
         and the content. workspace-section-header: the title row of a card, 8 above its content. -->
    <Style Selector="StackPanel.workspace-page-header">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.Header}" />
    </Style>
    <Style Selector="StackPanel.workspace-section-header">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="StackPanel.workspace-section-body, StackPanel.workspace-dialog-content">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.12}" />
    </Style>
    <Style Selector="StackPanel.workspace-field"><Setter Property="Spacing" Value="{StaticResource Workspace.Space.4}" /></Style>
    <Style Selector="Border.workspace-section, Border.workspace-section-flush, Border.workspace-error, Border.workspace-warning, Border.workspace-info, Border.workspace-success, Border.workspace-status, Border.workspace-media-tools, Border.workspace-media-caption, Border.workspace-media-transport">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Section}" />
    </Style>
    <!-- DS-P4: the same surface with no inset, for content that runs to the edge (declared after the shared rule so the inset wins). -->
    <Style Selector="Border.workspace-section-flush"><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="Border.workspace-error">
        <Setter Property="Background" Value="{DynamicResource Workspace.ErrorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-warning">
        <Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <!-- DS-P3: information and success complete the message surface (WorkspaceBanner maps a severity to one of the four). -->
    <Style Selector="Border.workspace-info">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-success">
        <Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Success}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-status">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <!-- UX review 2026-11-13: the tint alone is 1.01 to 1.22:1 on Panel in Light (1.18 to 1.33 in Dark), so a status chip was only its
         text colour. Each state keeps a 1-px outline in its tone, as the banner variants (workspace-error, workspace-warning) do:
         Warning 5.61:1, Error 5.65:1, Success 5.72:1 and Accent 5.72:1 on their own tint in Light. -->
    <Style Selector="Border.workspace-status-active"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-warning"><Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-error"><Setter Property="Background" Value="{DynamicResource Workspace.ErrorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-success"><Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Success}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-active TextBlock, Border.workspace-status-active SelectableTextBlock, TextBlock.workspace-status-active, SelectableTextBlock.workspace-status-active"><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Border.workspace-status-warning TextBlock, Border.workspace-status-warning SelectableTextBlock, TextBlock.workspace-status-warning, SelectableTextBlock.workspace-status-warning"><Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" /></Style>
    <Style Selector="Border.workspace-status-error TextBlock, Border.workspace-status-error SelectableTextBlock, TextBlock.workspace-status-error, SelectableTextBlock.workspace-status-error"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <Style Selector="Border.workspace-status-success TextBlock, Border.workspace-status-success SelectableTextBlock, TextBlock.workspace-status-success, SelectableTextBlock.workspace-status-success"><Setter Property="Foreground" Value="{DynamicResource Workspace.Success}" /></Style>
    <Style Selector="Border.workspace-dialog-body"><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Section}" /></Style>
    <Style Selector="Border.workspace-dialog-footer">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Footer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.workspace-media-tools, Border.workspace-media-caption, Border.workspace-media-transport"><Setter Property="Padding" Value="8" /></Style>
    <!-- Video transport is a quiet strip attached to the viewport, not another
         settings card. Keep the gallery's action/caption surfaces independent. -->
    <Style Selector="Border.workspace-media-transport">
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.None}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- S2: an icon-only toolbar button: a square of the input height with the catalog icon centred (IconButtons.Apply). -->
    <Style Selector="Button.icon-only">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- S2: the filter toggle of Archive and Media has the frame, height and corners of the combo box beside it; open = accent surface. -->
    <Style Selector="ToggleButton.filter-toggle">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <!-- Media controls and gallery overflow rows reserve a 1-px edge (transparent at rest, the padding gives it back): ControlBorder on hover,
         the accent when pressed or checked (UX review 2026-11-13; the fill alone was 1.37:1 / 1.38:1). -->
    <Style Selector="Button.media-control, ToggleButton.media-control">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.media-control"><Setter Property="Padding" Value="9,4" /></Style>
    <Style Selector="ToggleButton.media-control"><Setter Property="Padding" Value="11,0" /></Style>
    <!-- Gallery "⋯" menu: the rare toolbar commands as full-width rows (lead mark, label, shortcut). The check of the two
         overlay choices is drawn by the row itself, so the toggle's own checked fill is switched off here. -->
    <Style Selector="FlyoutPresenter.gallery-overflow">
        <Setter Property="Padding" Value="4" /><Setter Property="MinWidth" Value="300" /><Setter Property="MaxWidth" Value="440" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.gallery-overflow-item, ToggleButton.gallery-overflow-item">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="9,2" /><Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.gallery-overflow-item:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.gallery-overflow-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.gallery-overflow-item:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.gallery-overflow-item:checked:not(:pointerover):not(:focus-visible) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.gallery-overflow-item:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <!-- Disabled rows are Muted text on the overlay (7.37:1 / 6.66:1), no extra dimming: the earlier 0.6 opacity put them at 3.54:1 / 2.72:1. -->
    <Style Selector="Button.gallery-overflow-item:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Button.media-play">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
    </Style>
    <Style Selector="Button.media-control:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.media-control:checked /template/ ContentPresenter#PART_ContentPresenter, Button.media-control:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ToggleButton.media-control:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.AccentHoverText}" />
    </Style>
    <Style Selector="Button.media-control:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Slider.media-slider">
        <Setter Property="Background" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Slider.media-slider /template/ Grid#SliderContainer">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.media-slider /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="WrapPanel.workspace-actions, WrapPanel.workspace-toolbar, WrapPanel.workspace-tool-group">
        <Setter Property="ItemSpacing" Value="{StaticResource Workspace.Space.8}" /><Setter Property="LineSpacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="WrapPanel.workspace-actions"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="StackPanel.workspace-actions, StackPanel.workspace-toolbar, StackPanel.workspace-tool-group">
        <Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="StackPanel.workspace-actions"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="TextBox.workspace-invalid, ComboBox.workspace-invalid, NumericUpDown.workspace-invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>
    <!-- The Ursa TagInput draws its edge on a template border that does not follow the control's own BorderBrush. -->
    <Style Selector="ursa|TagInput.workspace-invalid /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>

    <!-- C1 chips (TAG-SUCHE-CHIPS-ZIELBILD 3.1/3.2). Own tag = filled, offered own tag = solid outline without fill,
         source tag = dashed outline + category mark, filter value = filled + close mark, exclusion = thicker error outline.
         The forms differ by fill and line, not only by colour. Classes only; focus, keys and names stay with the callers. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip.chip-available"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip.chip-compact">
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.ChipCompact}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <!-- Disabled: dimmed as a whole, no colour change, so the form (filled/outlined) stays recognisable. UX review 2026-11-13: 0.75 instead of
         0.6, the label stays 6.17:1 on ChipSurface (3.99:1 at 0.6) and the outline 2.71:1 on Panel (2.15:1) in Light. -->
    <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.chip-available:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip:disabled"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="Path.chip-thread-mark">
        <Setter Property="Width" Value="9" /><Setter Property="Height" Value="9" /><Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style Selector="ursa|ClosableTag.chip">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip.chip-exclude">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipExcludeBorder}" /><Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip:pointerover"><Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /></Style>
    <!-- The close mark is a template button: without this it inherits the 30-px minimum and frame of every Button. -->
    <Style Selector="ursa|ClosableTag.chip /template/ Button#PART_CloseButton">
        <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.chip-badge">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-compact">
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
    </Style>
    <Style Selector="Border.chip-badge TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-compact TextBlock.chip-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A badge that marks a deviation (Sources list: "Experimental"). The tone is an addition: the word says it too. -->
    <Style Selector="Border.chip-badge.chip-warning">
        <Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-warning TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" />
    </Style>

    <!-- The plugin lifecycle steps (Installed, Enabled, Active): a finished step in the success tone, the next one with the accent
         outline; a step that is still ahead stays neutral. The label carries a mark and the automation name the state, so colour is only an addition. -->
    <Style Selector="Border.chip-badge.chip-step-done">
        <Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Success}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-step-done TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Success}" /></Style>
    <Style Selector="Border.chip-badge.chip-step-next">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.chip-badge.chip-step-next TextBlock.chip-label"><Setter Property="FontWeight" Value="SemiBold" /></Style>

    <!-- Sources list: the selected card carries a bar at its start edge (as DataGrid and selection-bar lists do), not a text marker. -->
    <Style Selector="Button.source-card">
        <Setter Property="BorderThickness" Value="{StaticResource Workspace.ListCard.SelectionBar}" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.source-card.selected, Button.source-card.selected:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.source-card.selected /template/ ContentPresenter#PART_ContentPresenter, Button.source-card.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
    </Style>

    <!-- Plugins list: the Ursa selection list drawn as the Sources list cards. The sliding indicator is off; each item is a raised
         card with the same start-edge bar and accent surface when selected. Selection, keyboard and automation stay Ursa's. -->
    <Style Selector="ursa|SelectionList.workspace-card-list /template/ ContentPresenter#PART_Indicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card">
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ListCard}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Workspace.ListCard.SelectionBar}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultPointeroverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- Ursa makes the selected item bold and light-on-accent; a selected card keeps its text as it is, as on the Sources list. -->
    <Style Selector="ursa|SelectionListItem.workspace-list-card:selected, ursa|SelectionListItem.workspace-list-card:selected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card:selected /template/ ContentPresenter#PART_ContentPresenter, ursa|SelectionListItem.workspace-list-card:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
    </Style>

    <!-- The closing part of a card (Plugins: the draft status with Save and Discard): a rule above it instead of a card in the card. -->
    <Style Selector="Border.workspace-card-footer">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,0" />
    </Style>
    <!-- icon-square (P6): the one icon-only button. Input height in both directions, the icon centred, no text; every use gives it a
         tooltip and an accessible name. Menus ("more"; Plugins list and detail), close buttons in a surface, the remove
         cross of a row and a refresh beside a field use it. -->
    <Style Selector="Button.icon-square">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Drawn glyph icons (WorkspaceIcons.cs): 16 dip grid, stroke weight 1.5 (glyph-thin 1, glyph-heavy 2; no other weights), round
         caps. The stroke follows the foreground of the owner in code, so a disabled button greys its icon like its text. -->
    <Style Selector="Path.glyph-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Icon}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Icon}" />
        <Setter Property="Stretch" Value="None" /><Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- A text that is only for assistive technology (a drawn icon or badge has no automation peer of its own): it takes no room, draws nothing
         and is no hit target, but stays in the content view with its text as the name. -->
    <Style Selector="TextBlock.visually-hidden">
        <Setter Property="Width" Value="1" /><Setter Property="Height" Value="1" /><Setter Property="Opacity" Value="0" />
        <Setter Property="FontSize" Value="1" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Path.glyph-icon.glyph-small"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /></Style>
    <Style Selector="Path.glyph-icon.glyph-thin"><Setter Property="StrokeThickness" Value="1" /></Style>
    <Style Selector="Path.glyph-icon.glyph-heavy"><Setter Property="StrokeThickness" Value="2" /></Style>
    <!-- A badge that states a plain fact (plugin type, file version, plugin id): the chip outline on a raised surface, no accent. -->
    <Style Selector="Border.chip-badge.chip-neutral"><Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /></Style>

    <Style Selector="controls|ChipOutline.chip-source">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSourceBorder}" />
        <Setter Property="StrokeThickness" Value="1" /><Setter Property="IsDashed" Value="True" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-compact">
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.ChipCompact}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-compact TextBlock.chip-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
    </Style>
    <Style Selector="Border.chip-category-mark">
        <Setter Property="Width" Value="3" /><Setter Property="CornerRadius" Value="1.5" /><Setter Property="Margin" Value="0,2,5,2" />
        <Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.General}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source-artist Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Artist}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source-copyright Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Copyright}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source-character Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Character}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source-meta Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Meta}" /></Style>
    <!-- A marked source tag (A11Y M7): tint plus a solid 2-px accent outline, so the mark is a change of line, not only of colour. -->
    <Style Selector="ListBoxItem.chip-item">
        <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
    </Style>
    <Style Selector="ListBoxItem.chip-item /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem.chip-item:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem.chip-item:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem.chip-item:pointerover controls|ChipOutline.chip-source"><Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /></Style>
    <Style Selector="ListBoxItem.chip-item:selected controls|ChipOutline.chip-source">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="StrokeThickness" Value="2" /><Setter Property="IsDashed" Value="False" />
    </Style>
    <!-- I8: a source-tag chip that is an action. The button itself is invisible; the dashed chip shows hover and press. -->
    <Style Selector="Button.chip-source-button">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip-source-button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:pointerover controls|ChipOutline.chip-source"><Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /></Style>
    <Style Selector="Button.chip-source-button:pressed controls|ChipOutline.chip-source">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <!-- I7 tile corners: static chip badges and marks; the favourite star appears by opacity only (set, hover, keyboard focus),
         so nothing moves and the tile keeps its height. -->
    <Style Selector="Border.tile-mark"><Setter Property="Padding" Value="3" /></Style>
    <!-- D0: a corner mark is under 20 dip high, so it takes the badge corners (like the selection check), not the pill. -->
    <Style Selector="Border.chip-badge.tile-corner"><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Badge}" /></Style>
    <Style Selector="Path.tile-mark-glyph">
        <Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.Text}" /><Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite">
        <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="Opacity" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:checked"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ToggleButton.tile-favorite:focus-visible"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ListBoxItem:pointerover ToggleButton.tile-favorite"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ListBoxItem:focus-within ToggleButton.tile-favorite"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="ToggleButton.tile-favorite /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
    </Style>
    <Style Selector="ListBoxItem.chip-item:selected controls|ChipOutline.chip-source TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>

    <!-- D4 (E7, A11Y M7): a chosen chip is never the tint alone. The chip-selected class gives the tint and a solid 2-px accent
         outline (Button, filter tag, source tag outline); the border grows inward by one dip, so the padding gives it back and the
         chip keeps its size. Applied and removed instantly: no transition (virtualised lists recycle chips). -->
    <Style Selector="Button.chip.chip-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Button.chip.chip-compact.chip-selected"><Setter Property="Padding" Value="5,0" /></Style>
    <Style Selector="Button.chip.chip-selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.chip-selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.chip-selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip.chip-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" /><Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip.chip-selected:pointerover"><Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="StrokeThickness" Value="2" /><Setter Property="IsDashed" Value="False" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-selected TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>

    <!-- D4 (T3): a selected tile carries a check mark in the preview corner besides the list's tint and bar, so the selection
         is also a shape. A drawn path, not a font glyph; static, shown or hidden with the item's selection, no transition. -->
    <Style Selector="Border.tile-selection-check">
        <Setter Property="Background" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Padding" Value="3" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Badge}" />
    </Style>
    <Style Selector="Path.tile-selection-glyph">
        <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.OnAccent}" /><Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- D5 typography. Subtitle (16, SemiBold): the heading of a DialogFrame (whatever class the dialog gave it: page-title 20 or
         section-title 14 before) and the title of a content card (Booru hit, watcher). tnum: tabular figures for counters, tables
         and transfer numbers, so a changing number does not make its neighbours jump (Inter ships the feature). -->
    <Style Selector="Border#DialogFrameHeader TextBlock.page-title, Border#DialogFrameHeader TextBlock.section-title, TextBlock.card-title, SelectableTextBlock.card-title">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Subtitle}" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.tnum, SelectableTextBlock.tnum, DataGrid TextBlock"><Setter Property="FontFeatures" Value="tnum" /></Style>
    <!-- Figures (D5 / P5): figure columns line up (right-aligned, tabular figures); a headline figure (statistics value tiles,
         counters, transfer numbers) is one Subtitle step, SemiBold, tabular. -->
    <Style Selector="TextBlock.stats-num"><Setter Property="TextAlignment" Value="Right" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="FontFeatures" Value="tnum" /></Style>
    <Style Selector="TextBlock.stats-value"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Subtitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontFeatures" Value="tnum" /></Style>

    <!-- D3 surfaces (design language 5, 6.2). workspace-card: content card on Panel or Background (Booru hit, watcher, reader post
         through the same tokens): Card + CardEdge 1 px, radius 5, no shadow, never a card inside a card. workspace-card-active: the
         selected card, AccentSurface with the accent edge 3,1,1,1 (never the tint alone). workspace-overlay: the in-window overlay
         level (filter surface): Overlay + ControlBorder + radius 8. No shadow on it (D6 measurement: an in-window overlay
         repaints its shadow whenever the grid behind scrolls; the smoke "motion shadow cost" shows mean 14.6 to 16.0 ms, p95 16.9 to 22.4 ms
         under software rendering, so the edge alone separates it; the shadow stays on Semi's popups and toasts, which are own surfaces). workspace-thumb-placeholder: the quiet
         static slot behind a thumbnail that has not arrived (no box once the image is there). -->
    <Style Selector="Border.workspace-card">
        <Setter Property="Background" Value="{DynamicResource Workspace.Card}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.CardEdge}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Card}" />
    </Style>
    <Style Selector="Border.workspace-card.workspace-card-active">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <Style Selector="Border.workspace-overlay">
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Group}" />
    </Style>
    <Style Selector="Border.workspace-thumb-placeholder">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>

    <!-- D1 motion (design language 4.5, E4/E5). Every rule below applies only under a TopLevel WITHOUT the class motion-off
         (MotionPolicy puts it on windows when the environment, the "Animations" setting or the operating system says off), so
         switching at run time needs no restart. Only Opacity and Background/BorderBrush/Foreground move; nothing
         changes size, margin or radius, and nothing here targets virtualised rows or tiles (selection and recycling stay instant).
         Durations: Hover 80 ms, Fade 120 ms, Reveal 180 ms, Enter 260 ms (spec 4.5). Progress and spinners are not touched. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                <BrushTransition Property="Foreground" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel):not(.motion-off) ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                <BrushTransition Property="Foreground" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <!-- E6: buttons inside virtualised containers (tile chips, favourite stars, reader quote buttons) never transition: recycling
         a container changes their classes and states, and every such change would otherwise start an 80 ms brush fade. These
         rules come after the two above and carry the same class condition (a rule without one has a lower value priority and would
         lose to them, however late it stands). -->
    <Style Selector=":is(TopLevel):not(.motion-off) ListBoxItem Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector=":is(TopLevel):not(.motion-off) ListBoxItem ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector=":is(TopLevel):not(.motion-off) DataGridRow Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector=":is(TopLevel):not(.motion-off) DataGridRow ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <!-- The filter chip is a control that tints itself (no template part), so the control carries the transition. -->
    <Style Selector=":is(TopLevel):not(.motion-off) ursa|ClosableTag.chip">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <!-- The reader arrow cross fades in and out with the pointer's idle state (Fade 120 ms); under reduced motion it switches at once. -->
    <Style Selector=":is(TopLevel):not(.motion-off) WrapPanel.reader-cross">
        <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <!-- A filter chip appears with a short fade (the tag bar's own chips are rebuilt often and tile chips are recycled: no fade there). -->
    <Style Selector=":is(TopLevel):not(.motion-off) ursa|ClosableTag.chip.chip-filter">
        <Style.Animations>
            <Animation Duration="0:0:0.12" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Toast (FeedbackToastContent): 260 ms fade on arrival (opacity only: no RenderTransform keyframes, Avalonia has no animator for them); the live region carries the message either way. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Grid.toast-content">
        <Style.Animations>
            <Animation Duration="0:0:0.26" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- In-window overlay (filter surface, bars): hidden until the caller adds .shown; the caller keeps IsVisible true while it fades
         (180 ms in, and removes .shown for the 180 ms out before IsVisible=False). Under motion-off the class does nothing: the
         overlay is simply visible or not. Applies to Border only; one element, static shadow. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Border.motion-overlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel):not(.motion-off) Border.motion-overlay.shown">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Image that arrives asynchronously (see ImageFade): 150 ms fade of Opacity. Never used on recycled tiles or cache hits. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Image.motion-fade-in">
        <Setter Property="Transitions">
            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" /></Transitions>
        </Setter>
    </Style>
    <!-- E5: motion-off also silences transitions the theme brings along on the roles above. -->
    <Style Selector=":is(TopLevel).motion-off Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector=":is(TopLevel).motion-off ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions" Value="{x:Null}" /></Style>
</Styles>
