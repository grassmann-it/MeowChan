<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
        xmlns:ursa="https://irihi.tech/ursa">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Workspace.Background">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Panel">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Raised">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Border">#2D3239</SolidColorBrush>
                    <!-- Interactive outlines (buttons, fields, seek rail). Palette review 2026-11-13: the decorative border
                         value (#2D3239) was 1.15-1.43:1 on Background, Panel, Raised and Card, so Dark buttons and fields had no
                         visible boundary (WCAG 1.4.11 asks 3:1). Now the chip outline grey: 5.06:1 on Background, 4.59:1 on
                         Panel, 4.07:1 on Raised, 4.27:1 on Card, 3.34:1 on Hover and 3.45:1 on AccentSurface; one interactive
                         outline per theme, as in Light (ControlBorder = ChipBorder). Decorative lines stay on Workspace.Border. -->
                    <SolidColorBrush x:Key="Workspace.ControlBorder">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Text">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Muted">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Accent">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentSurface">#25344A</SolidColorBrush>
                    <!-- D0 surface tokens (design language 4.3): level 2 card with a 1-px CardEdge, level 4 overlay
                         (menu, flyout, filter surface, toast) with the app's only shadow, and the scrim behind blocking
                         in-window overlays. Overlay equals Panel today (separate key so it can be tinted later).
                         Dark CardEdge (#5A636E) is computed at 3.03:1 on Background, 2.74:1 on Panel and 2.56:1 on Card
                         (WCAG relative luminance; not measured natively), so it clears 3:1 only against the page; adjust it here only. -->
                    <SolidColorBrush x:Key="Workspace.Card">#20242A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.CardEdge">#5A636E</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Overlay">#1B1E22</SolidColorBrush>
                    <BoxShadows x:Key="Workspace.Shadow.Overlay">0 4 16 0 #66000000</BoxShadows>
                    <!-- D6: Semi's own menu, flyout, drop-down, suggestion and toast shadows carry the one overlay shadow (same value as Workspace.Shadow.Overlay). -->
                    <BoxShadows x:Key="MenuFlyoutBorderBoxShadow">0 4 16 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="FlyoutBorderBoxShadow">0 4 16 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="ComboBoxPopupBoxShadow">0 4 16 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="AutoCompleteBoxPopupBoxShadow">0 4 16 0 #66000000</BoxShadows>
                    <BoxShadows x:Key="NotificationCardBoxShadows">0 4 16 0 #66000000</BoxShadows>
                    <SolidColorBrush x:Key="Workspace.Scrim">#66000000</SolidColorBrush>
                    <!-- Reader post cards are workspace cards (D3): Card on the Background page, CardEdge 3.03:1 against the page
                         (non-text minimum 3:1), the card 1.18:1 above it. The active card uses Workspace.AccentSurface with the accent edge. -->
                    <!-- Greentext ('>' lines) in post bodies: 8.29:1 on the card, 6.69:1 on the active card. -->
                    <SolidColorBrush x:Key="Workspace.ReaderGreentext">#9CCB6A</SolidColorBrush>
                    <!-- Code runs sit on a darker area than the card; a spoiler is one area that hides its text in its own
                         colour until it is shown (text 9:1, accent 4.8:1 and greentext 5.7:1 on it once shown). -->
                    <SolidColorBrush x:Key="Workspace.ReaderCodeSurface">#171A1E</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ReaderSpoiler">#333A42</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Hover">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.OnAccent">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentHover">#8ABBFF</SolidColorBrush>
                    <!-- AccentHover as text colour (checked media toggle on hover): same value as AccentHover in Dark (4.8:1 or more on AccentSurface). -->
                    <SolidColorBrush x:Key="Workspace.AccentHoverText">#8ABBFF</SolidColorBrush>
                    <!-- Status colours (palette review 2026-11-13): salmon #F49B9B and mint #83D4AC had the same lightness, so
                         under protanopia/deuteranopia they collapsed (dE 8-15). Error is a step darker and warmer (coral), Success
                         a step lighter; the smallest simulated distance between any two of Error, Warning, Success and Accent rises
                         from 8.4 to 24.8. Error stays 5.5:1 on Raised and 5.3:1 on ErrorSurface, Success 11.2:1 / 9.5:1. -->
                    <SolidColorBrush x:Key="Workspace.Error">#DF857C</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ErrorSurface">#3C2428</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Warning">#E8BE72</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.WarningSurface">#352C1D</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Success">#A7EFCB</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.SuccessSurface">#20382D</SolidColorBrush>
                    <!-- The fill is the accent blue again (same value as Workspace.Accent): 3.67:1 on the track, 4.98 to 7.55:1 on the surfaces.
                         UX review 2026-11-13: the track was #30363E, the same value as Workspace.Hover, so the empty part vanished on a hovered
                         row (1.00:1). #424A54 stays off every row fill: 1.86:1 on Panel, 1.65:1 on Raised, 1.36:1 on Hover, 1.40:1 on AccentSurface. -->
                    <SolidColorBrush x:Key="Workspace.Progress">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ProgressTrack">#424A54</SolidColorBrush>
                    <!-- Rows of the header and page graphs, each opaque with its own area colour, drawn as separate rows (own scale, own
                         value label), so no row is told apart by colour alone. Disk write (what MeowChan archives) is teal, disk read
                         violet; strokes are at least 3:1 on Panel, Background and Card (the tests measure it). -->
                    <SolidColorBrush x:Key="Workspace.Stats.Disk">#7FD6C2</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Stats.DiskSurface">#1F4540</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Stats.Read">#C3A6FF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Stats.ReadSurface">#3A2D5C</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultDisabledForeground">#A4ADB8</SolidColorBrush>
                    <!-- Disabled outline one step below the interactive one (Light: Border under ControlBorder); hover keeps it. -->
                    <SolidColorBrush x:Key="ButtonDefaultDisabledBorderBrush">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledBackground">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledBorderBrush">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridCellFocusBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridLineBrush">#2D3239</SolidColorBrush>
                    <!-- Semi's dark fields have no outline either (a translucent fill, about 1.4:1 on Panel); like Light (LW-06 N7)
                         text boxes and combo boxes take Workspace.ControlBorder so the field boundary reaches 3:1. -->
                    <SolidColorBrush x:Key="TextBoxDefaultBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="TextBoxPointeroverBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBorderBrush">#7D8793</SolidColorBrush>
                    <!-- C1 chips: the outline is Workspace.ControlBorder (#7D8793, 3.3:1 or more on Background, Panel, Raised,
                         Hover and AccentSurface (selected tiles)). -->
                    <SolidColorBrush x:Key="Workspace.ChipSurface">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ChipBorder">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ChipSourceBorder">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ChipExcludeBorder">#DF857C</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ChipSelectedSurface">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ChipSelectedBorder">#6AA7FF</SolidColorBrush>
                    <!-- Danbooru category marks: an addition to the named category, never the only carrier. -->
                    <SolidColorBrush x:Key="Workspace.TagCategory.Artist">#E88A8A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.TagCategory.Copyright">#C79BF0</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.TagCategory.Character">#8FD3A0</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.TagCategory.Meta">#E8BE72</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.TagCategory.General">#A4ADB8</SolidColorBrush>
                    <!-- Ursa ClosableTag (filter and extension chips) in the chip palette. -->
                    <SolidColorBrush x:Key="ClosableTagForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ClosableTagBackground">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="ClosableTagBorder">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ClosableTagCloseButtonForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="ClosableTagCloseButtonPointeroverForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ClosableTagCloseButtonPressedForeground">#6AA7FF</SolidColorBrush>
                    <!-- UX review 2026-11-13 (hover and pop-up contrast). Semi's overlay surfaces sat outside the palette (#43444A menus,
                         drop-downs, suggestions, confirmations and toasts, a light-grey tooltip) with a 12 % white hover row (1.42:1) and an
                         8 % edge (1.26:1), and its selection was Semi blue #54A9FF. Overlays are now Workspace.Overlay with a 1-px
                         Workspace.ControlBorder edge (4.59:1 on Panel) and the one overlay shadow (D6). States, one each for every surface:
                         hover = Workspace.Hover fill (the 1-px ControlBorder outline in the styles carries the 3:1 boundary, 3.34:1 on Hover),
                         pressed = AccentSurface, selected = AccentSurface (+ accent bar), text = Workspace.Text (14.76:1 on Overlay, 10.75:1
                         on Hover), shortcut and disabled text = Workspace.Muted (7.37:1 on Overlay; disabled stays exempt but readable). -->
                    <SolidColorBrush x:Key="MenuFlyoutBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxPopupBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="AutoCompleteBoxPopupBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="PopConfirmBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="FlyoutBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="ToolTipBackground">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuFlyoutBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxPopupBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="AutoCompleteBoxPopupBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="PopConfirmBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="FlyoutBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ToolTipBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ToolTipForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="FlyoutForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="PopConfirmContentForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemFocusBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLineHeaderPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLineHeaderPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemSelectedPointeroverBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemSelectedPointeroverBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemPointeroverForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemPointeroverForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemFocusForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemPressedForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxItemSelectedForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemPointeroverForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemPressedForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemSelectedForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemInputGestureTextForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemDisabledForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="MenuItemDisabledInputGestureTextForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="ListBoxItemDisabledForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemHeaderDisabledForeground">#A4ADB8</SolidColorBrush>
                    <!-- Line tabs (Threads/Boards): resting label Muted, hover/selected label Text; the 2-px pipe is ControlBorder on hover,
                         the accent when pressed or selected (6.84:1 on Panel). -->
                    <SolidColorBrush x:Key="TabItemLineHeaderForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLineHeaderPointeroverForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLineHeaderSelectedForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLinePipePointeroverBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLinePipePressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLinePipeSelectedBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemIconSelectedForeground">#6AA7FF</SolidColorBrush>
                    <!-- Selectors are Raised like buttons (outline ControlBorder); hover Hover, pressed AccentSurface with the accent edge. -->
                    <SolidColorBrush x:Key="ComboBoxSelectorBackground">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorFocusBackground">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorFocusBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <!-- The caption close button's red hover (#C42B1C) is 2.95:1 on the Dark Panel: a 1-px Text edge (10.75:1) carries the boundary. -->
                    <SolidColorBrush x:Key="Workspace.CaptionCloseEdge">#EEF1F4</SolidColorBrush>
                    <!-- QW-20: marked-favorite tint; Gold is 10.6-13.2:1 on the dark surfaces. -->
                    <SolidColorBrush x:Key="Workspace.Favorite">#FFD700</SolidColorBrush>
                    <!-- Semi blue leftovers (2026-11-14): text box and combo box focus, selection, check box and radio button checked states, slider, progress, pagination, line tabs, info banner/toast, loading icon, badge. Each key is an accent/palette token; the glyph on an accent fill is OnAccent. -->
                    <!-- Field focus and text selection (selection pair is opaque accent with OnAccent, as the TextBox style sets it). -->
                    <SolidColorBrush x:Key="TextBoxFocusBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextBoxBorderedPointeroverBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorBorderedFocusBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorBorderedPointeroverBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ComboBoxSelectorBorderedPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextBoxSelectionBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextBoxSelectionForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="TextBlockSelectionBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextBlockSelectionForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="AdornerLayerBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleButtonPrimaryIndeterminateBorderBrush">#6AA7FF</SolidColorBrush>
                    <!-- Check box: checked fill and border are the accent (hover AccentHover, pressed the pressed accent), the check mark is OnAccent, the unchecked outline is ControlBorder, disabled is the disabled outline tone. -->
                    <SolidColorBrush x:Key="CheckBoxCheckedDefaultBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedDefaultBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBackground">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedPressedBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedDisabledBackground">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCheckedDisabledBorderBrush">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxDefaultBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxPointeroverBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxPressedBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxGlyphFill">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCardCheckedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCardCheckedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCardCheckedPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCardCheckedPressedBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CheckBoxCardCheckedDisabledBorderBrush">#4A525C</SolidColorBrush>
                    <!-- Radio button: same scheme as the check box. -->
                    <SolidColorBrush x:Key="RadioButtonCheckIconDefaultBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconDefaultBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconPointeroverBackground">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconPressedBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconDisabledBackground">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckIconDisabledBorderBrush">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonUncheckIconDefaultBorderBrush">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonUncheckIconPointeroverBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonUncheckIconPressedBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCheckGlyphFill">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonButtonCheckedForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonButtonCheckedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCardCheckedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCardCheckDefaultBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCardCheckPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="RadioButtonCardCheckPressedBorderBrush">#8ABBFF</SolidColorBrush>
                    <!-- Slider and progress: the fill and the thumb edge are the accent; the disabled thumb edge is the disabled outline tone. -->
                    <SolidColorBrush x:Key="SliderTrackForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="SliderThumbBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="SliderThumbPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SliderThumbPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="SliderThumbDisabledBorderBrush">#4A525C</SolidColorBrush>
                    <SolidColorBrush x:Key="ProgressBarIndicatorBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ProgressBarPrimaryForeground">#6AA7FF</SolidColorBrush>
                    <!-- Pagination, line and button tabs, breadcrumb: selected = AccentSurface fill with the accent label; hover/pressed breadcrumb labels use AccentHover and the pressed accent. -->
                    <SolidColorBrush x:Key="PaginationButtonSelectedForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="PaginationButtonSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemLineHeaderSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemButtonHeaderSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemButtonHeaderSelectedForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BreadcrumbItemPointeroverForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BreadcrumbItemPressedForeground">#8ABBFF</SolidColorBrush>
                    <!-- Information banner and toast, loading icon, primary badge, grid-splitter and column-drag previews (the two previews keep Semi's 40 % alpha on the accent). -->
                    <SolidColorBrush x:Key="BannerInformationBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="BannerInformationBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardInformationIconForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardLightInformationBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardLightInformationBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="LoadingIconForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgePrimaryBadgeBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeInvertedPrimaryBadgeForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLightPrimaryBadgeBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLightPrimaryBadgeForeground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="GridSplitterPreviewBackground">#666AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridDropLocationIndicatorBackground">#666AA7FF</SolidColorBrush>
                    <!-- AX-02 (a11y package): ToggleSwitch tracks meet 3:1 against every surface in both states (Semi's own off track was 1.1-1.4:1 and its Light on track 2.1:1).
                         Off track = ControlBorder in every pointer state (the position of the knob, not the track colour, carries on/off), on track = Accent (hover AccentHover, pressed the pressed accent);
                         the knob is OnAccent, so it keeps 4.5:1 or better against the track in both states. Disabled keeps the quiet outline tone. -->
                    <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedDefaultBackground">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPointeroverBackground">#7D8793</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPressedBackground">#7D8793</SolidColorBrush>
