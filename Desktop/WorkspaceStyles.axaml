                    <SolidColorBrush x:Key="SliderThumbDisabledBorderBrush">#948A7D</SolidColorBrush>
                    <SolidColorBrush x:Key="ProgressBarIndicatorBrush">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="ProgressBarPrimaryForeground">#803B06</SolidColorBrush>
                    <!-- Pagination, line and button tabs, breadcrumb: selected = AccentSurface fill with the accent label; hover/pressed breadcrumb labels use AccentHover and the pressed accent. -->
                    <SolidColorBrush x:Key="TabItemLineHeaderSelectedBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemButtonHeaderSelectedBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="TabItemButtonHeaderSelectedForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BreadcrumbItemPointeroverForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BreadcrumbItemPressedForeground">#662F05</SolidColorBrush>
                    <!-- Information banner and toast, loading icon, primary badge, grid-splitter and column-drag previews (the two previews keep Semi's 40 % alpha on the accent). -->
                    <SolidColorBrush x:Key="BannerInformationBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="BannerInformationBorderBrush">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardInformationIconForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardLightInformationBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="NotificationCardLightInformationBorderBrush">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="LoadingIconForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgePrimaryBadgeBackground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeInvertedPrimaryBadgeForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLightPrimaryBadgeBackground">#E7D4BE</SolidColorBrush>
                    <SolidColorBrush x:Key="BadgeLightPrimaryBadgeForeground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="GridSplitterPreviewBackground">#66803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridDropLocationIndicatorBackground">#66803B06</SolidColorBrush>
                    <!-- AX-02 (a11y package): ToggleSwitch tracks meet 3:1 against every surface in both states (Semi's own off track was 1.1-1.4:1 and its Light on track 2.1:1).
                         Off track = ControlBorder in every pointer state (the position of the knob, not the track colour, carries on/off), on track = Accent (hover AccentHover, pressed the pressed accent);
                         the knob is OnAccent, so it keeps 4.5:1 or better against the track in both states. Disabled keeps the quiet outline tone. -->
                    <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedDefaultBackground">#726858</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPointeroverBackground">#726858</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerUnCheckedPressedBackground">#726858</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDefaultBackground">#803B06</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPointeroverBackground">#9A4B0B</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedPressedBackground">#662F05</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchContainerCheckedDisabledBackground">#948A7D</SolidColorBrush>
                    <SolidColorBrush x:Key="ToggleSwitchIndicatorBackground">#FFFFFF</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <!-- Semi owns every standard control template. These public theme resources
             retain MeowChan's density without replacing focus, input or state behavior. -->
        <Thickness x:Key="DataGridCellTextBlockDefaultMargin">12,0</Thickness>
        <x:Double x:Key="DataGridCellMinHeight">0</x:Double>
        <!-- D6: one radius (8, Workspace.Radius.Group) for every overlay Semi draws: menu, flyout, tooltip, toast, drop-down and
             suggestion popups. Menu items keep Semi's own item radius. -->
        <CornerRadius x:Key="MenuFlyoutCornerRadius">8</CornerRadius>
        <!-- Menu layout (CM1): a popup menu is as wide as its widest row between 224 and 416 dip (28 and 52 steps of 8); MenuLayout (code) reads
             both keys and the label column gives way to the maximum with an ellipsis and a tooltip, never the shortcut column. The shortcut is
             one right-aligned column for all rows, set off from the label by at least 24 dip (MenuItemInputGestureTextMargin, the room in front of
             it). A row is Workspace.Size.Control (32) high and 16 dip in from the edge: Workspace.Inset.MenuItem 15,6 plus the 1-px row edge. -->
        <x:Double x:Key="MenuFlyoutMinWidth">224</x:Double>
        <x:Double x:Key="MenuFlyoutMaxWidth">416</x:Double>
        <Thickness x:Key="MenuItemInputGestureTextMargin">24,0,0,0</Thickness>
        <Thickness x:Key="Workspace.Inset.MenuItem">15,6</Thickness>
        <CornerRadius x:Key="FlyoutCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ToolTipCornerRadius">8</CornerRadius>
        <!-- HB1: no tooltip is wider than 360 dip: longer text wraps (style "ToolTip TextBlock" below). Help popovers have their own,
             wider reading column (Workspace.Size.ReadingWidth). -->
        <x:Double x:Key="ToolTipMaxWidth">360</x:Double>
        <!-- Typography pass: 12 at the sides, 8 above and below, so a two-line tooltip does not touch its outline. -->
        <Thickness x:Key="ToolTipPadding">12,8</Thickness>
        <CornerRadius x:Key="NotificationCardCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="ComboBoxPopupBoxCornerRadius">8</CornerRadius>
        <CornerRadius x:Key="AutoCompleteBoxPopupCornerRadius">8</CornerRadius>
        <x:Double x:Key="DataGridColumnHeaderMinHeight">28</x:Double>
        <!-- ===== Workspace design tokens (D0) =====
             Colour tokens live in the theme dictionaries above; the tokens below are theme-neutral.
             Use them instead of literals. Nothing here changes a Semi template.
             Surfaces, each only on the level below (never Card in Card):
               Background 0 (window) < Panel 1 (section, table, bar) < Card 2 (content card, CardEdge 1 px)
               < Raised 3 (interactive: buttons, column heads) < Overlay 4 (menu, flyout, toast: Overlay +
               ControlBorder + Shadow.Overlay). Shadow.Overlay is the only shadow: never in lists, tiles or cards.
               Scrim dims the content behind blocking in-window overlays (every blocking dim layer uses Workspace.Scrim, no literal).
             Cards, three classes (DS-P4): workspace-section (Panel + Border, radius 5, inset 16: the section container of a page),
               workspace-card (Card + CardEdge, radius 5, inset Card: a content card in a list or on a section) and workspace-overlay
               (Overlay + ControlBorder, radius 8: an in-window overlay), plus workspace-section-flush (a section with inset 0 for
               content that runs to the edge: tables, media grids, reader content, a frame that brings its own insets).
               Border.panel and Border.raised are retired.
             Radius: None 0 (window, title bar, caption, tab/nav bars, transport), Badge 3 (marks under 20 dip),
               Control 5 (buttons, inputs, sections, cards, tiles), Group 8 (overlays, dialog body),
               Chip 12 (pill at 24 dip), ChipCompact 9 (pill at 18 dip). Circles use Width/2 locally.
             Size: Control 30 (button), Input 32 (text box, combo box, column head), InputProminent 36 (Downloads URL entry), Nav 36, Chip 24, ChipCompact 18,
               TitleBar 48 (code mirror WorkspaceMetrics.TitleBarHeight), Caption 44 (caption-button width),
               Icon 16, IconCaption 10. Row heights stay in code (WorkspaceMetrics, density setting).
             Space: 2/4/8/12/16/24/32. Inset: Section, Message, Footer, Chip, ChipCompact, Card, Overlay, Page (12, page margin).
             Text: Caption 11, Meta 12, Body 13, Section 14, Subtitle 16, Title 20 (the brand's 19 is a special case).
             From code bind a resource, e.g. control[!Border.CornerRadiusProperty] = new DynamicResourceExtension(key). -->
        <!-- Shared composition values. Density remains the existing preference,
             not a new setting and not an instruction to compact every surface. -->
        <x:Double x:Key="Workspace.Space.2">2</x:Double>
        <x:Double x:Key="Workspace.Space.4">4</x:Double>
        <x:Double x:Key="Workspace.Space.8">8</x:Double>
        <x:Double x:Key="Workspace.Space.12">12</x:Double>
        <x:Double x:Key="Workspace.Space.16">16</x:Double>
        <x:Double x:Key="Workspace.Space.24">24</x:Double>
        <x:Double x:Key="Workspace.Space.32">32</x:Double>
        <!-- P2 page grid: title to subtitle inside a page header (4), gap between the cards of a page (12) and between a
             form's label column and its value column (24); ValueColumn is the width of that value column. -->
        <x:Double x:Key="Workspace.Space.Header">4</x:Double>
        <!-- Toolbar UX review 15.11.: the gap between neighbouring items on a bar (8; the 4-dip focus ring then stays 4 clear of the
             neighbour) and between two groups (16, the 1x20 group line centred in it). ActionToolBarPanel owns both (ItemGap, GroupGap). -->
        <x:Double x:Key="Workspace.Space.BarGap">8</x:Double>
        <x:Double x:Key="Workspace.Space.BarGroupGap">16</x:Double>
        <x:Double x:Key="Workspace.Space.Card">12</x:Double>
        <x:Double x:Key="Workspace.Form.Gap">24</x:Double>
        <x:Double x:Key="Workspace.Form.ValueColumn">280</x:Double>
        <SolidColorBrush x:Key="Workspace.Media.EdgeHint">#64969696</SolidColorBrush>
        <SolidColorBrush x:Key="Workspace.Media.FocusDisc">#E6181A1F</SolidColorBrush>
        <SolidColorBrush x:Key="Workspace.Media.FocusRing">#FFFFFF</SolidColorBrush>
        <x:Double x:Key="Workspace.Text.HeaderMetricTitle">10</x:Double>
        <x:Double x:Key="Workspace.Text.Caption">11</x:Double>
        <!-- UI font (Inter) and reading font of post bodies only (bundled Noto Sans subset, Inter for missing glyphs).
             These are the static defaults; ReaderFonts.Apply republishes both keys in Application.Resources with the
             platform's installed CJK families appended, the active UI language's regional variant first. -->
        <FontFamily x:Key="Workspace.Font.UI">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <FontFamily x:Key="Workspace.Font.Reading">avares://MeowChan/Assets/Fonts#Noto Sans, avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        <x:Double x:Key="Workspace.Text.Body">13</x:Double>
        <x:Double x:Key="Workspace.Text.Meta">12</x:Double>
        <x:Double x:Key="Workspace.Text.Section">14</x:Double>
        <x:Double x:Key="Workspace.Text.Subtitle">16</x:Double>
        <x:Double x:Key="Workspace.Text.Title">20</x:Double>
        <!-- Typography pass (15.11.): the reading line height, 1.4 x the body size, for running text of several lines (help popovers).
             Not a Workspace.Text.* key: those are the type scale. Single-line labels and table cells keep the font's own line height. -->
        <x:Double x:Key="Workspace.LineHeight.Body">18</x:Double>
        <!-- The widest a column of running text gets (HelpPopover.MaxContentWidth): about 60 to 65 characters of body text. -->
        <x:Double x:Key="Workspace.Size.ReadingWidth">400</x:Double>
        <CornerRadius x:Key="Workspace.Radius.None">0</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Badge">3</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Control">5</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Group">8</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Chip">12</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.ChipCompact">9</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.TagPill">14</CornerRadius>
        <!-- The two halves of an assigned tag pill (QuickTagSurface: the chip and its remove cross, joined with no gap): the chip rounds its start, the cross its end,
             both by half the pill height. Physical corners, they do not mirror: a right-to-left language pack would swap the two keys. -->
        <CornerRadius x:Key="Workspace.Radius.TagPillStart">14,0,0,14</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.TagPillEnd">0,14,14,0</CornerRadius>
        <x:Double x:Key="Workspace.Size.Control">32</x:Double>
        <x:Double x:Key="Workspace.Size.HeaderIcon">30</x:Double>
        <x:Double x:Key="Workspace.Size.Input">32</x:Double>
        <x:Double x:Key="Workspace.Size.Nav">36</x:Double>
        <!-- The one prominent entry row of the app (Downloads URL box and its Add button): 36 instead of Input 32, by design. -->
        <x:Double x:Key="Workspace.Size.InputProminent">36</x:Double>
        <x:Double x:Key="Workspace.Size.Chip">24</x:Double>
        <x:Double x:Key="Workspace.Size.ChipCompact">18</x:Double>
        <!-- Media labels stay readable against the same badge disc in every theme. -->
        <Color x:Key="Workspace.MediaLabel.red">#E5484D</Color>
        <Color x:Key="Workspace.MediaLabel.yellow">#F5C400</Color>
        <Color x:Key="Workspace.MediaLabel.green">#30A46C</Color>
        <Color x:Key="Workspace.MediaLabel.blue">#3E8EF7</Color>
        <!-- Tag pill (tag panel suggestions and assigned tags, reader tag bar, tile tags; UX review 15.11.): 28 high, a full pill (radius 14 =
             half the height), 12 dip in from the edge (8 where a key hint leads), the key hint a 16 dip rounded square and 6 dip from the label. -->
        <x:Double x:Key="Workspace.Size.TagPill">28</x:Double>
        <x:Double x:Key="Workspace.Size.TagKey">16</x:Double>
        <x:Double x:Key="Workspace.Space.TagKey">6</x:Double>
        <x:Double x:Key="Workspace.Size.TitleBar">48</x:Double>
        <x:Double x:Key="Workspace.Size.Caption">44</x:Double>
        <x:Double x:Key="Workspace.Size.Icon">16</x:Double>
        <x:Double x:Key="Workspace.Size.IconCaption">10</x:Double>
        <!-- ControlCompact 24: inline buttons inside content (reader post number and quote buttons, pager buttons); same height as a Chip. -->
        <x:Double x:Key="Workspace.Size.ControlCompact">24</x:Double>
        <!-- Card (PT4, card mode of the tagging mode): the big decision targets under the picture, 48 high and at least 120 wide. -->
        <x:Double x:Key="Workspace.Size.Card">48</x:Double>
        <x:Double x:Key="Workspace.Size.CardWidth">120</x:Double>
        <Thickness x:Key="Workspace.Inset.Section">16</Thickness>
        <Thickness x:Key="Workspace.Inset.Message">12</Thickness>
        <Thickness x:Key="Workspace.Inset.EmptyState">28</Thickness>
        <!-- Typography pass: the reading width (400, about 60 to 65 characters) instead of 360, which left one-word last lines. -->
        <x:Double x:Key="Workspace.Size.EmptyStateWidth">400</x:Double>
        <Thickness x:Key="Workspace.Inset.Footer">16,12</Thickness>
        <Thickness x:Key="Workspace.Inset.Chip">8,4</Thickness>
        <Thickness x:Key="Workspace.Inset.MediaTools">8,6</Thickness>
        <Thickness x:Key="Workspace.Inset.ChipCompact">6,1</Thickness>
        <Thickness x:Key="Workspace.Inset.TagPill">12,0</Thickness>
        <Thickness x:Key="Workspace.Inset.TagPillKeyed">8,0,12,0</Thickness>
        <!-- The chip half of a joined assigned pill: 12 in from the edge, 4 before the cross half. -->
        <Thickness x:Key="Workspace.Inset.TagPillJoined">12,0,4,0</Thickness>
        <Thickness x:Key="Workspace.Inset.Card">12,10,12,12</Thickness>
        <Thickness x:Key="Workspace.Inset.Overlay">12</Thickness>
        <!-- Inset of a popover that carries running text (help popover): text never sits closer than 16 dip to the edge. -->
        <Thickness x:Key="Workspace.Inset.Popover">16</Thickness>
        <!-- The vertical volume above the speaker: 12 dip above and below the track keep the 12 dip thumb (the ends of the range) fully inside the box. -->
        <Thickness x:Key="Workspace.Inset.VolumePopup">0,12</Thickness>
        <!-- Page margin of every work view (Downloads, Sources, Plugins, Diagnostics, Statistics, Media, Archive). -->
        <Thickness x:Key="Workspace.Inset.Page">12</Thickness>
        <!-- List cards (Sources list, Plugins list): inner spacing (on the 12 dip grid, one value for both lists) and the start-edge selection bar (LW-06). -->
        <Thickness x:Key="Workspace.Inset.ListCard">12</Thickness>
        <Thickness x:Key="Workspace.ListCard.SelectionBar">3,0,0,0</Thickness>
        <!-- Native keyboard-only focus decoration; it overlays rather than moves
             content, and remains separate from selected/error border state.
             D4 (E7): two shells. The outer 2-px ring is the accent; the inner 1-px ring is the window background, so the
             focus stays readable on a solid accent button and on accent-tinted rows (both colours differ from every surface
             they touch by at least 3:1 in Light and Dark). The outer border keeps Margin -4 (the 4-dip offset); the adorner layer must not clip it, or the right and bottom of the ring are
             cut by 8 dip (the clip rectangle is the control's own, measured from the ring's shifted origin). -->
        <Template x:Key="Workspace.FocusAdorner">
            <Border BorderBrush="{DynamicResource Workspace.Accent}" BorderThickness="2"
                    CornerRadius="{StaticResource Workspace.Radius.Control}" Margin="-4"
                    AdornerLayer.IsClipEnabled="False" IsHitTestVisible="False">
                <Border BorderBrush="{DynamicResource Workspace.Background}" BorderThickness="1"
                        CornerRadius="{StaticResource Workspace.Radius.Badge}" IsHitTestVisible="False" />
            </Border>
        </Template>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Workspace.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Workspace.Font.UI}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="ProgressBar"><Setter Property="Background" Value="{DynamicResource Workspace.ProgressTrack}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Progress}" /></Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <!-- DS-P3: the empty state of a list or grid (controls:WorkspaceEmptyState): centred, one muted sentence, at most one primary action. -->
    <Style Selector="controls|WorkspaceEmptyState">
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="{StaticResource Workspace.Size.EmptyStateWidth}" />
        <Setter Property="Margin" Value="{StaticResource Workspace.Inset.EmptyState}" />
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.12}" />
    </Style>
    <!-- Typography pass: running text that wraps (empty states, hints under labels) gets 2 dip between its lines (about 1.4 x the
         size); LineSpacing only adds between lines, so a one-line hint keeps its height and its row does not move. -->
    <Style Selector="TextBlock.workspace-empty-text, SelectableTextBlock.workspace-empty-text">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="LineSpacing" Value="{StaticResource Workspace.Space.2}" />
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.brand"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <!-- A page title wraps when its column runs out (narrow-window sweep 16.11.2026): a long title in a narrow window or a long language
         takes a second line instead of being cut at the edge. No page title trims; a local TextWrapping still wins. -->
    <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Title}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Section}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="monospace" /></Style>
    <Style Selector="SelectableTextBlock.reader-body"><Setter Property="FontFamily" Value="{DynamicResource Workspace.Font.Reading}" /></Style>
    <Style Selector="Window.workspace-advanced TextBlock.inline-thread-id"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border.shell-bar">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-divider"><Setter Property="Padding" Value="0,8" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /></Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" /><Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <!-- Card action (PT4): one of the big decision cards of the card mode. Colours stay those of every button (Raised fill, ControlBorder
         outline, Text label; hover, pressed, disabled and the focus ring come from the shared button styles), so Light and Dark need no
         extra pair; only the size and the centred two-line content are its own. -->
    <Style Selector="Button.card-action">
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Card}" />
        <Setter Property="MinWidth" Value="{StaticResource Workspace.Size.CardWidth}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <!-- UX round 3 (Dark outlines made every action row a row of boxes): a ghost button is the quiet secondary action inside
         cards, rows and inspector panels. At rest it is only its label (Text 11:1 or more on every surface, so the label, not an
         outline, identifies it); the interactive outline (ControlBorder, 3:1 on Raised and every surface below it) and the Raised fill appear on pointer
         over, the accent outline when pressed; keyboard focus keeps the shared focus ring. The one action of a row that must stay
         findable (the primary one, Remove) keeps its outline. Disabled: text colour only, no outline. -->
    <Style Selector="Button.ghost"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.header-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.HeaderIcon}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.HeaderIcon}" />
        <Setter Property="Padding" Value="6" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <!-- The network/disk graph in the header is a button: compact, no outline until it has focus or the pointer. -->
    <Style Selector="Button.header-graph"><Setter Property="Padding" Value="6,2" /><Setter Property="MinHeight" Value="0" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.header-icon.selected"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>
    <Style Selector="Path.header-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Icon}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Icon}" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.window-caption">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Caption}" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.None}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <!-- UX review 2026-11-13: the caption hover fill alone is 1.37:1 (Dark) / 1.38:1 (Light) on the bar; the 1-px edge reserved above
         (transparent at rest, inside the square button, nothing moves) shows ControlBorder on hover and the accent when pressed. -->
    <Style Selector="Button.window-caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.window-caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.CaptionCloseEdge}" />
    </Style>
    <Style Selector="Path.window-caption-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.IconCaption}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.IconCaption}" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Thin rule between the footer groups; decorative, so it stays on the decorative border colour. -->
    <Style Selector="Border.nav-separator"><Setter Property="Background" Value="{DynamicResource Workspace.Border}" /></Style>
    <!-- Footer navigation (UX review 2026-11-13: the hover fill alone was 1.37:1 / 1.38:1 on the bar with a Muted label, the selected item
         only Raised, 1.13:1 / 1.24:1). Every item reserves a 1-px edge (transparent at rest; padding 11,7 keeps the 12,8 inset, so nothing
         moves). Hover: Hover fill, ControlBorder edge (3.34:1 / 3.37:1 on Hover, 4.59:1 / 4.64:1 on the bar), label and icon Text.
         Pressed: AccentSurface with the accent edge. Selected: AccentSurface and a 3-px accent bar at the bottom edge like the tab pipe
         (5.14:1 / 5.72:1 on the fill, 6.84:1 / 7.00:1 on the bar; padding 12,8,12,5 keeps the inset), label Text, icon Accent; selected
         and hovered keeps the bar. -->
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Padding" Value="11,7" /><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Nav}" /></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.nav.selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="0,0,0,3" /><Setter Property="Padding" Value="12,8,12,5" />
    </Style>
    <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav.selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav:pointerover TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav:pointerover Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav.selected Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Accent}" /></Style>
    <!-- Disabled (bug-class audit 2026-11-16): the label and icon are already Muted at rest, so the dimming carries it - the whole button at 0.75 like a disabled
         chip (the label stays 4.7:1 / 3.7:1 on Panel in Dark / Light, pinned in DisabledStyleTests), no hover or pressed fill, and a disabled selected page keeps its accent bar. Named
         after the label and icon rules above (pointerover and selected set Text and Accent there). -->
    <Style Selector="Button.nav:disabled, Button.nav:disabled:pointerover, Button.nav:disabled:pressed"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="Button.nav:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav:disabled:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.nav.selected:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.nav.selected:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.nav.selected:disabled:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.nav:disabled TextBlock, Button.nav:disabled:pointerover TextBlock, Button.nav.selected:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav:disabled Path, Button.nav:disabled:pointerover Path, Button.nav.selected:disabled Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" /></Style>
    <!-- Semi's translucent dark-blue selection has little contrast on dark fields.
         Keep its native presenter and retained-selection behavior with an opaque pair. -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Workspace.OnAccent}" />
    </Style>
    <!-- A checkbox in a horizontal control row (filter rows: Diagnostics, Reader status line, toolbars) sits on the row's
         centre line with the 32 dip inputs and buttons beside it, not at the top of the line. Vertical lists are unaffected. -->
    <Style Selector="WrapPanel[Orientation=Horizontal] > CheckBox, StackPanel[Orientation=Horizontal] > CheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox.footer-mode"><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /></Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="RowHeight" Value="{x:Static desktop:WorkspaceMetrics.NormalRowHeight}" /><Setter Property="ColumnHeaderHeight" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="Padding" Value="10,7" />
        <!-- UX review 2026-11-13: Raised head on Panel body is 1.24:1 in Light, so the boundary rests on the fill alone; a lower edge of the
             decorative line colour (2.32:1 on Raised in Light) closes the head. -->
        <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <!-- Custom queue tables share the DataGrid header's Input height, Raised fill and lower rule. -->
    <Style Selector="Border.workspace-table-header">
        <Setter Property="Height" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <!-- Narrow-window sweep (16.11.2026): a column head that is narrower than its localized name ("En attente" over the 85 dip Queued
         column) ends in an ellipsis instead of being cut off mid-letter by the column edge; the Columns menu names every column in full. -->
    <Style Selector="DataGridColumnHeader TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis" /></Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,0" /><Setter Property="ClipToBounds" Value="True" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>
    <!-- UX review 2026-11-13: a hovered row is the Hover fill with a 1-px ControlBorder start edge (the fill alone was 1.13:1 / 1.24:1); drawn
         on the background layer like the selection bar below, so cells do not move. The selected bar wins over it. -->
    <!-- Performance review 2026-11-14 (N1): the 1-px start edge is reserved at rest (transparent) so entering and leaving a row only changes the
         brush, never the border's thickness and with it the row's layout. The background layer is a sibling of the cells, so they do not move. -->
    <Style Selector="DataGridRow /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1,0,0,0" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- LW-06 R1/N4a: selection is never the tint alone. A 3-px accent bar like the active reader post;
         on rows it is drawn on the background layer behind the cells, so cells do not move. -->
    <Style Selector="DataGridRow:selected /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <!-- Semi draws separate outlines for the current cell and for cell focus. Suppress both in row tables,
         leaving editable grids and columns marked cell-action their own cell indicators. -->
    <Style Selector="DataGrid[IsReadOnly=True] DataGridCell:not(.cell-action) /template/ Rectangle#CurrencyVisual,
                     DataGrid[IsReadOnly=True] DataGridCell:not(.cell-action) /template/ Panel#FocusVisual">
        <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="DataGrid[IsReadOnly=True]:focus-within DataGridRow:selected /template/ Border#BackgroundBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <Style Selector="ListBox.workspace-selection-bar ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <!-- Rows of menus, drop-downs and plain lists (UX review 2026-11-13). Semi's rows had a translucent hover (1.09:1 to 1.42:1) and no edge.
         Each row reserves a 1-px edge, transparent at rest; the padding gives it back (Semi's 16,8 menu and 12,8 drop-down/list insets), so
         rows keep their size. Hover (menus: the highlighted row, :selected, also by keyboard) shows it in ControlBorder (3.34:1 / 3.37:1 on
         Hover, 4.59:1 / 4.64:1 on Overlay), pressed in the accent. A chosen drop-down or list row is AccentSurface with a 3-px accent bar at its
         start edge (5.14:1 / 5.72:1), never the tint alone. Lists with their own row design (reader posts, tile grids, chip lists, the
         selection-bar lists above) keep it. The list selectors use the child combinator (a row's logical parent is its ListBox): a row of an inner
         list never matches through an outer list, and rows do not collect one class activator per ListBox ancestor. Template parts checked against Semi 12.1.0.1: MenuItem Border#PART_LayoutRoot, ComboBoxItem and
         ListBoxItem ContentPresenter#PART_ContentPresenter, each binding BorderBrush, BorderThickness and Padding from the row. -->
    <Style Selector="MenuItem"><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.MenuItem}" /></Style>
    <Style Selector="ContextMenu MenuItem, MenuFlyoutPresenter MenuItem, Menu MenuItem MenuItem"><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" /></Style>
    <!-- CM1: every popup menu measures to its widest row (MenuLayout); both kinds of popup menu, from code and from XAML, take part. -->
    <Style Selector="ContextMenu, MenuFlyoutPresenter"><Setter Property="controls:MenuLayout.IsManaged" Value="True" /></Style>
    <Style Selector="Menu > MenuItem"><Setter Property="Padding" Value="15,0" /></Style>
    <Style Selector="MenuItem:selected"><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /></Style>
    <Style Selector="MenuItem:pressed"><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /></Style>
    <!-- Group labels of the header menu (Reading, Collection, App): a small disabled line, not focusable, that names the entries below it. -->
    <Style Selector="MenuItem.menu-group-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="15,6,15,2" /><Setter Property="MinHeight" Value="0" /><Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="ComboBoxItem, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width):not(.tagging-table) > ListBoxItem:not(.chip-item)">
        <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,7" />
    </Style>
    <Style Selector="ComboBoxItem:pointerover, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width):not(.tagging-table) > ListBoxItem:not(.chip-item):pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="ComboBoxItem:pressed, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width):not(.tagging-table) > ListBoxItem:not(.chip-item):pressed">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ComboBoxItem:selected, ListBox:not(.workspace-selection-bar):not(.reader-fit-width):not(.reader-column-width):not(.tagging-table) > ListBoxItem:not(.chip-item):selected">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="9,8,12,8" />
    </Style>

    <!-- Tagging table heights are COMPLETE container heights, including the invariant selection edge.
         Zero vertical padding/border leaves 44/32 for the row content; the 3-px edge never changes the inset. -->
    <Style Selector="ListBox.tagging-table > ListBoxItem">
        <Setter Property="Height" Value="{x:Static desktop:WorkspaceMetrics.NormalRowHeight}" />
        <Setter Property="MinHeight" Value="0" /><Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="9,0,12,0" /><Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBox.tagging-table.compact > ListBoxItem">
        <Setter Property="Height" Value="{x:Static desktop:WorkspaceMetrics.CompactRowHeight}" />
    </Style>
    <Style Selector="ListBox.tagging-table > ListBoxItem:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="ListBox.tagging-table > ListBoxItem:pressed, ListBox.tagging-table > ListBoxItem:selected">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>

    <!-- Opt-in composition roles; native templates, selection and automation stay
         with Semi/Ursa and the existing controls. Do not nest sections for decoration. -->
    <!-- AX-05 (a11y package): ToggleSwitch and TabItem are listed explicitly; a type selector does not match derived types, so the ToggleButton entry never reached ToggleSwitch, and TabItem was never listed. -->
    <Style Selector="Button, ToggleButton, ToggleSwitch, TabItem, TextBox, ComboBox, NumericUpDown, CheckBox, RadioButton, Slider, ListBoxItem, SelectableTextBlock">
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <!-- An inline link: accent text only, no outline and no fill (the default button outline made About links look like boxes). -->
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0,6" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>
    <Style Selector="TextBlock.workspace-field-label, SelectableTextBlock.workspace-field-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-help, SelectableTextBlock.workspace-help, TextBlock.workspace-meta, SelectableTextBlock.workspace-meta">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="ToggleButton.accent-preset"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="ToggleButton.accent-preset TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="ToggleButton.accent-preset:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.accent-preset:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.accent-preset:disabled, ToggleButton.accent-preset:pointerover:disabled, ToggleButton.accent-preset:pressed:disabled, ToggleButton.accent-preset:checked:disabled, ToggleButton.accent-preset:checked:pointerover:disabled, ToggleButton.accent-preset:checked:pressed:disabled">
        <Setter Property="Opacity" Value="0.75" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.accent-preset:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="ToggleButton.accent-preset:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.accent-preset:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.accent-preset:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.accent-preset:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.accent-preset:checked:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.accent-preset:checked:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- Typography pass: a hint under a label (several lines in Settings) reads with 2 dip between its lines; see workspace-empty-text. -->
    <Style Selector="TextBlock.workspace-help, SelectableTextBlock.workspace-help"><Setter Property="LineSpacing" Value="{StaticResource Workspace.Space.2}" /></Style>
    <Style Selector="TextBlock.workspace-error, SelectableTextBlock.workspace-error">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-warning, SelectableTextBlock.workspace-warning">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-status, SelectableTextBlock.workspace-status">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- workspace-page-header: the title and its one-line subtitle of a page (4 apart); the page stack puts 8 between this header
         and the content. workspace-section-header: the title row of a card, 8 above its content. -->
    <Style Selector="StackPanel.workspace-page-header">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.Header}" />
    </Style>
    <Style Selector="StackPanel.workspace-section-header">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="StackPanel.workspace-section-body, StackPanel.workspace-dialog-content">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.12}" />
    </Style>
    <Style Selector="StackPanel.workspace-field"><Setter Property="Spacing" Value="{StaticResource Workspace.Space.4}" /></Style>
    <Style Selector="Border.workspace-section, Border.workspace-section-flush, Border.workspace-error, Border.workspace-warning, Border.workspace-info, Border.workspace-success, Border.workspace-status, Border.workspace-media-tools, Border.workspace-media-caption, Border.workspace-media-transport">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Section}" />
    </Style>
    <!-- DS-P4: the same surface with no inset, for content that runs to the edge (declared after the shared rule so the inset wins). -->
    <Style Selector="Border.workspace-section-flush"><Setter Property="Padding" Value="0" /></Style>
    <Style Selector="Border.workspace-error">
        <Setter Property="Background" Value="{DynamicResource Workspace.ErrorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-warning">
        <Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <!-- DS-P3: information and success complete the message surface (WorkspaceBanner maps a severity to one of the four). -->
    <Style Selector="Border.workspace-info">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-success">
        <Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Success}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-status">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <!-- UX review 2026-11-13: the tint alone is 1.01 to 1.22:1 on Panel in Light (1.18 to 1.33 in Dark), so a status chip was only its
         text colour. Each state keeps a 1-px outline in its tone, as the banner variants (workspace-error, workspace-warning) do:
         Warning 5.61:1, Error 5.65:1, Success 5.72:1 and Accent 5.72:1 on their own tint in Light. -->
    <Style Selector="Border.workspace-status-active"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-warning"><Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-error"><Setter Property="Background" Value="{DynamicResource Workspace.ErrorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-success"><Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Success}" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Border.workspace-status-active TextBlock, Border.workspace-status-active SelectableTextBlock, TextBlock.workspace-status-active, SelectableTextBlock.workspace-status-active"><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Border.workspace-status-warning TextBlock, Border.workspace-status-warning SelectableTextBlock, TextBlock.workspace-status-warning, SelectableTextBlock.workspace-status-warning"><Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" /></Style>
    <Style Selector="Border.workspace-status-error TextBlock, Border.workspace-status-error SelectableTextBlock, TextBlock.workspace-status-error, SelectableTextBlock.workspace-status-error"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <Style Selector="Border.workspace-status-success TextBlock, Border.workspace-status-success SelectableTextBlock, TextBlock.workspace-status-success, SelectableTextBlock.workspace-status-success"><Setter Property="Foreground" Value="{DynamicResource Workspace.Success}" /></Style>
    <Style Selector="Border.workspace-dialog-body"><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Section}" /></Style>
    <Style Selector="Border.workspace-dialog-footer">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Footer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.workspace-media-tools, Border.workspace-media-caption, Border.workspace-media-transport"><Setter Property="Padding" Value="8" /></Style>
    <!-- Video transport is a quiet strip attached to the viewport, not another
         settings card. Keep the gallery's action/caption surfaces independent. -->
    <Style Selector="Border.workspace-media-transport">
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.None}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <!-- GL5b: the video bar in the gallery's dock: its row is 40 dip (the 32 dip controls and 4 above and below) and has no side inset (the
         dock's own padding is the only inset); the overlay footer and the Windows fallback keep the padding above. -->
    <Style Selector="Border.workspace-media-transport.in-dock"><Setter Property="Padding" Value="0,4" /></Style>
    <!-- S2: an icon-only toolbar button: a square of the input height with the catalog icon centred (IconButtons.Apply). -->
    <Style Selector="Button.icon-only, ToggleButton.icon-only">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- S2: the filter toggle of Archive and Media has the frame, height and corners of the combo box beside it; open = accent surface. -->
    <Style Selector="ToggleButton.filter-toggle">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <!-- Disabled (this and the toggles below, bug-class audit 2026-11-16): the label in Muted and the whole control dimmed to 0.75 like a disabled
         chip, the form (and a set toggle's accent fill) stays recognisable, but no hover or pressed fill: the rules come after those states and
         name them, so they win. Contrast is pinned in DisabledStyleTests. -->
    <Style Selector="ToggleButton.filter-toggle:disabled, ToggleButton.filter-toggle:pointerover:disabled, ToggleButton.filter-toggle:pressed:disabled, ToggleButton.filter-toggle:checked:disabled, ToggleButton.filter-toggle:checked:pointerover:disabled, ToggleButton.filter-toggle:checked:pressed:disabled"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ToggleButton.filter-toggle:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-toggle:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-toggle:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.filter-toggle:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-toggle:checked:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.filter-toggle:checked:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- A status badge that also carries a filter (shortcuts window: the conflict count): no button frame of its own, the badge inside is the
         look; hover tints it, checked (filter on) draws an accent ring around it. -->
    <Style Selector="ToggleButton.status-toggle">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="2" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.status-toggle:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.status-toggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:disabled, ToggleButton.status-toggle:pointerover:disabled, ToggleButton.status-toggle:pressed:disabled, ToggleButton.status-toggle:checked:disabled, ToggleButton.status-toggle:checked:pointerover:disabled, ToggleButton.status-toggle:checked:pressed:disabled"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ToggleButton.status-toggle:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.status-toggle:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.status-toggle:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.status-toggle:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.status-toggle:checked:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.status-toggle:checked:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- M5: the two-way switch (TwoWayToggle, "all | any"): two touching buttons with the frame, height and corners of the combo box; on = accent surface. -->
    <Style Selector="ToggleButton.segment">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.None}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.segment-first"><Setter Property="CornerRadius" Value="5,0,0,5" /></Style>
    <Style Selector="ToggleButton.segment-last"><Setter Property="CornerRadius" Value="0,5,5,0" /><Setter Property="Margin" Value="-1,0,0,0" /></Style>
    <Style Selector="ToggleButton.segment:checked"><Setter Property="ZIndex" Value="1" /></Style>
    <Style Selector="ToggleButton.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.segment:disabled, ToggleButton.segment:pointerover:disabled, ToggleButton.segment:pressed:disabled, ToggleButton.segment:checked:disabled, ToggleButton.segment:checked:pointerover:disabled, ToggleButton.segment:checked:pressed:disabled"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ToggleButton.segment:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.segment:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:checked:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.segment:checked:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- The parts of the "where was it found" row under the Media search (MediaTextBreakdownRow): separate toggle chips of the control height
         with the frame and states of the segments; on = accent surface. -->
    <Style Selector="ToggleButton.breakdown-chip">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <!-- One style per template selector: a template selector must not share a comma list with another (AVLN2000). -->
    <Style Selector="ToggleButton.breakdown-chip:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:disabled, ToggleButton.breakdown-chip:pointerover:disabled, ToggleButton.breakdown-chip:pressed:disabled, ToggleButton.breakdown-chip:checked:disabled, ToggleButton.breakdown-chip:checked:pointerover:disabled, ToggleButton.breakdown-chip:checked:pressed:disabled"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ToggleButton.breakdown-chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:checked:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.breakdown-chip:checked:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- Split button (the gallery slideshow: toggle + menu button): both halves are exactly Workspace.Size.Control high and share one 1-px edge
         (the menu half overlaps it by 1) and the control radius on the outer corners only; the menu half is a square of that size. A half in
         hover, focus or press lifts above its neighbour so its edge is not cut. States follow the segment buttons. -->
    <Style Selector="Button.split-main, ToggleButton.split-main, Button.split-menu">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{StaticResource Workspace.Size.Control}" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" /><Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.split-main, ToggleButton.split-main"><Setter Property="Padding" Value="10,0" /><Setter Property="CornerRadius" Value="5,0,0,5" /></Style>
    <Style Selector="Button.split-menu">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Control}" /><Setter Property="MinWidth" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="0,5,5,0" /><Setter Property="Margin" Value="-1,0,0,0" />
    </Style>
    <Style Selector="Button.split-main:pointerover, ToggleButton.split-main:pointerover, ToggleButton.split-main:checked, Button.split-menu:pointerover, Button.split-menu:focus-visible, Button.split-menu:pressed">
        <Setter Property="ZIndex" Value="1" />
    </Style>
    <Style Selector="Button.split-main:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.split-main:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.split-menu:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.split-main:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.split-main:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.split-main:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.split-main:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.split-menu:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.split-main:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.split-main:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.split-menu:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- Media controls and gallery overflow rows reserve a 1-px edge (transparent at rest, the padding gives it back): ControlBorder on hover,
         the accent when pressed or checked (UX review 2026-11-13; the fill alone was 1.37:1 / 1.38:1). -->
    <Style Selector="Button.media-control, ToggleButton.media-control">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.media-control"><Setter Property="Padding" Value="9,4" /></Style>
    <Style Selector="ToggleButton.media-control"><Setter Property="Padding" Value="11,0" /></Style>
    <!-- Gallery "⋯" menu: the rare toolbar commands as full-width rows (lead mark, label, shortcut). The check of the two
         overlay choices is drawn by the row itself, so the toggle's own checked fill is switched off here. -->
    <Style Selector="FlyoutPresenter.gallery-overflow">
        <Setter Property="Padding" Value="4" /><Setter Property="MinWidth" Value="300" /><Setter Property="MaxWidth" Value="440" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- Reading history list under the header book button (ReadingHistoryFlyout): wide enough for a thread title (320 to 520), the panel limits
         the height and scrolls; rows are the gallery-overflow-item buttons. -->
    <Style Selector="FlyoutPresenter.reading-history">
        <Setter Property="Padding" Value="4" /><Setter Property="MinWidth" Value="320" /><Setter Property="MaxWidth" Value="520" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- Right-click tag popover (QuickTagPopover): the flyout frame in the overlay tokens. Width (440 by default, narrowed in a narrow window: QuickTagPopover.WidthFor) and padding are set by the popover itself; MaxWidth only has to stay above the widest. -->
    <Style Selector="FlyoutPresenter.quick-tag-popover">
        <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MaxWidth" Value="480" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- Quick settings popover (R7): the in-window overlay look; the surface brings its own 16 dip inset and its width (360). -->
    <Style Selector="FlyoutPresenter.quick-settings">
        <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MaxWidth" Value="400" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Button.gallery-overflow-item, ToggleButton.gallery-overflow-item">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.MenuItem}" /><Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="Button.gallery-overflow-item:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.gallery-overflow-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.gallery-overflow-item:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.gallery-overflow-item:checked:not(:pointerover):not(:focus-visible) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.gallery-overflow-item:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <!-- Disabled rows are Muted text on the overlay (7.37:1 / 6.66:1), no extra dimming: the earlier 0.6 opacity put them at 3.54:1 / 2.72:1. -->
    <Style Selector="Button.gallery-overflow-item:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-overflow-item:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Button.media-play">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
    </Style>
    <Style Selector="Button.media-control:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.media-control:checked /template/ ContentPresenter#PART_ContentPresenter, Button.media-control:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ToggleButton.media-control:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.AccentHoverText}" />
    </Style>
    <Style Selector="Button.media-control:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- Decision-row favourite only: match the rating bar's height and center the icon + label as one unit.
         A minimum (not a fixed height) and vertical padding allow larger fonts and translated labels to grow. Media-control states retain theme tokens. -->
    <Style Selector="ToggleButton.rating-favorite">
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Nav}" /><Setter Property="Padding" Value="11,7" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <!-- Rating star (GalleryDecisionRow, design plan 16.11.2026): one of five equal cells of the rating bar of the "Rate and tag" popover and the gallery tag
         panel. The cells touch (no gaps), so the hit area is continuous; each is Nav high with a 24 dip minimum, a transparent 1-px edge and no fill at rest.
         The glyph (20 dip) is an outline in Muted while empty; a rated star is filled in Workspace.Favorite. Hover fills the cell with Hover and the stars up to
         it show as set in the text colour (rating-preview, set by the row); the checked star has no accent fill, the filled stars carry the value; focus is the
         shared ring; disabled is Muted. -->
    <Style Selector="ToggleButton.rating-star">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Height" Value="{StaticResource Workspace.Size.Nav}" /><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Nav}" />
        <Setter Property="MinWidth" Value="{StaticResource Workspace.Size.ControlCompact}" /><Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ToggleButton.rating-star /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.rating-star:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.rating-star:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.rating-star:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.rating-star:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.rating-star.rating-preview /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.rating-star:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.rating-star:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- The one hairline of the quick tag popover and the gallery tag panel: between the decision row (favourite, rating) and the tag field. Its own 4 dip
         above and below add to the field area's 8 dip spacing: 12 dip of air on both sides. -->
    <Style Selector="Border.quick-tag-divider">
        <Setter Property="Height" Value="1" /><Setter Property="Margin" Value="0,4" /><Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <!-- The gallery's favourite badge beside the way back (GalleryViewer.Favorites): a toggle on a dark scrim over the picture. A 1-px edge is
         transparent at rest (the padding gives it back), ControlBorder under the pointer, the accent when pressed or focused by the keyboard.
         The checked fill of a toggle is switched off: the filled gold star is the saved state. -->
    <Style Selector="ToggleButton.gallery-favorite-badge">
        <Setter Property="Background" Value="#D2181A1F" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" /><Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="ToggleButton.gallery-favorite-badge /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D2181A1F" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.gallery-favorite-badge:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#F0181A1F" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.gallery-favorite-badge:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ToggleButton.gallery-favorite-badge:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <!-- Disabled: the dark scrim stays (a Muted label would be dark on dark in Light), dimmed to 0.75 with no hover, focus or pressed state. -->
    <Style Selector="ToggleButton.gallery-favorite-badge:disabled, ToggleButton.gallery-favorite-badge:checked:disabled, ToggleButton.gallery-favorite-badge:disabled:pointerover, ToggleButton.gallery-favorite-badge:checked:disabled:pointerover, ToggleButton.gallery-favorite-badge:disabled:pressed, ToggleButton.gallery-favorite-badge:checked:disabled:pressed"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ToggleButton.gallery-favorite-badge:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:disabled:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:disabled:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:disabled:focus-visible /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.gallery-favorite-badge:checked:disabled:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#D2181A1F" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Slider.media-slider">
        <Setter Property="Background" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <!-- The compact alignment is only for horizontal tracks. A centered vertical
         container collapses the volume track to the thumb height and makes native
         pointer clicks land outside the actual value track on macOS/Linux. -->
    <Style Selector="Slider.media-slider:horizontal /template/ Grid#SliderContainer">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Semi lays a vertical slider out in three Auto columns (tick, track, tick), which leaves the track at the start edge of a wider
         slider. Centering the container puts the track and the thumb on the middle of the volume box. -->
    <Style Selector="Slider.media-slider:vertical /template/ Grid#SliderContainer">
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.media-slider /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="WrapPanel.workspace-actions, WrapPanel.workspace-toolbar, WrapPanel.workspace-tool-group">
        <Setter Property="ItemSpacing" Value="{StaticResource Workspace.Space.8}" /><Setter Property="LineSpacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="WrapPanel.workspace-actions"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="StackPanel.workspace-actions, StackPanel.workspace-toolbar, StackPanel.workspace-tool-group">
        <Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="StackPanel.workspace-actions"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="TabControl.booru-tabs">
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Grid RowDefinitions="Auto,*">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <Grid>
                            <Border Background="{DynamicResource Workspace.Background}" BorderBrush="{DynamicResource Workspace.Border}"
                                    BorderThickness="0,0,0,1" />
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Grid>
                    </ScrollViewer>
                    <ContentPresenter Grid.Row="1" Name="PART_SelectedContentHost"
                                      Background="{DynamicResource Workspace.Panel}"
                                      Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.booru-tab">
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Nav}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem.booru-tab:pointerover:not(:selected):not(.booru-add-tab)">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="TabItem.booru-tab:selected:not(.booru-add-tab)">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
        <Setter Property="BorderThickness" Value="1,1,1,0" />
    </Style>
    <Style Selector="TabItem.booru-add-tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.booru-add-tab-button">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="{StaticResource Workspace.Size.Nav}" />
    </Style>
    <Style Selector="Button.booru-tab-close, Button.booru-pager-button">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.ControlCompact}" />
        <Setter Property="Height" Value="{StaticResource Workspace.Size.ControlCompact}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.workspace-invalid, ComboBox.workspace-invalid, NumericUpDown.workspace-invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>
    <!-- The Ursa TagInput draws its edge on a template border that does not follow the control's own BorderBrush. -->
    <Style Selector="ursa|TagInput.workspace-invalid /template/ Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>

    <!-- C1 chips (TAG-SUCHE-CHIPS-ZIELBILD 3.1/3.2). Own tag = filled, offered own tag = solid outline without fill,
         source tag = dashed outline + category mark, filter value = filled + close mark, exclusion = thicker error outline.
         The forms differ by fill and line, not only by colour. Classes only; focus, keys and names stay with the callers. -->
    <Style Selector="Button.chip">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip.chip-available"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip.chip-compact">
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.ChipCompact}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <!-- Disabled: dimmed as a whole, no colour change, so the form (filled/outlined) stays recognisable. UX review 2026-11-13: 0.75 instead of
         0.6, the label stays 6.17:1 on ChipSurface (3.99:1 at 0.6) and the outline 2.71:1 on Panel (2.15:1) in Light. -->
    <Style Selector="Button.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.chip-available:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip:disabled"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="Path.chip-thread-mark">
        <Setter Property="Width" Value="9" /><Setter Property="Height" Value="9" /><Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1" />
    </Style>

    <Style Selector="ursa|ClosableTag.chip">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip.chip-exclude">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipExcludeBorder}" /><Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip:pointerover"><Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /></Style>
    <!-- The close mark is a template button: without this it inherits the 30-px minimum and frame of every Button. -->
    <Style Selector="ursa|ClosableTag.chip /template/ Button#PART_CloseButton">
        <Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.chip-badge">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-compact">
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
    </Style>
    <Style Selector="Border.chip-badge TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-compact TextBlock.chip-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A key of a shortcut (KeyCapText, shortcuts window): one cap per key, 22 high, control radius, light and dark from tokens. -->
    <Style Selector="Border.keycap">
        <Setter Property="Height" Value="22" /><Setter Property="MinWidth" Value="22" /><Setter Property="Padding" Value="4,0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
    </Style>
    <Style Selector="Border.keycap > TextBlock">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- A badge that marks a deviation (Sources list: "Experimental"). The tone is an addition: the word says it too. -->
    <Style Selector="Border.chip-badge.chip-warning">
        <Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-warning TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" />
    </Style>

    <!-- The plugin lifecycle steps (Installed, Enabled, Active): a finished step in the success tone, the next one with the accent
         outline; a step that is still ahead stays neutral. The label carries a mark and the automation name the state, so colour is only an addition. -->
    <Style Selector="Border.chip-badge.chip-step-done">
        <Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Success}" />
    </Style>
    <Style Selector="Border.chip-badge.chip-step-done TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Success}" /></Style>
    <Style Selector="Border.chip-badge.chip-step-next">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.chip-badge.chip-step-next TextBlock.chip-label"><Setter Property="FontWeight" Value="SemiBold" /></Style>

    <!-- Sources list: the selected card carries a bar at its start edge (as DataGrid and selection-bar lists do), not a text marker. -->
    <Style Selector="Button.source-card">
        <Setter Property="BorderThickness" Value="{StaticResource Workspace.ListCard.SelectionBar}" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.source-card.selected, Button.source-card.selected:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Button.source-card.selected /template/ ContentPresenter#PART_ContentPresenter, Button.source-card.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
    </Style>
    <!-- Disabled: the card (and the selected card's bar and fill) dimmed to 0.75; the selected look stays so the selection is still readable. -->
    <Style Selector="Button.source-card:disabled"><Setter Property="Opacity" Value="0.75" /></Style>

    <!-- Plugins list: the Ursa selection list drawn as the Sources list cards. The sliding indicator is off; each item is a raised
         card with the same start-edge bar and accent surface when selected. Selection, keyboard and automation stay Ursa's. -->
    <Style Selector="ursa|SelectionList.workspace-card-list /template/ ContentPresenter#PART_Indicator"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card">
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ListCard}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{StaticResource Workspace.ListCard.SelectionBar}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ButtonDefaultPointeroverBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <!-- Ursa makes the selected item bold and light-on-accent; a selected card keeps its text as it is, as on the Sources list. -->
    <Style Selector="ursa|SelectionListItem.workspace-list-card:selected, ursa|SelectionListItem.workspace-list-card:selected:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ursa|SelectionListItem.workspace-list-card:selected /template/ ContentPresenter#PART_ContentPresenter, ursa|SelectionListItem.workspace-list-card:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
    </Style>

    <!-- The closing part of a card (Plugins: the draft status with Save and Discard): a rule above it instead of a card in the card. -->
    <Style Selector="Border.workspace-card-footer">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,12,0,0" />
    </Style>
    <!-- StatFooterRow (Sources list card): a few counts as the closing line of a card. The rule above and the space (8 + the card's 4)
         set it apart; the segments are laid out by the control, with the same slot width and tabular figures, so changing numbers
         never move anything. Icon and label are muted, the value is body text on the card. -->
    <Style Selector="controls|StatFooterRow">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="0,8,0,0" /><Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="controls|StatSegmentView">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="controls|StatSegmentView TextBlock.stat-value">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="controls|StatSegmentView TextBlock.stat-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- icon-square (P6): the one icon-only button. Input height in both directions, the icon centred, no text; every use gives it a
         tooltip and an accessible name. Menus ("more"; Plugins list and detail), close buttons in a surface, the remove
         cross of a row and a refresh beside a field use it. -->
    <!-- HeaderBar (Controls/HeaderBar.cs): the way back of a row sits at its top left edge, also when the content wraps. -->
    <Style Selector="controls|HeaderBar > Button">
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- A narrow row (HeaderBar.CompactWidth, 360 dip) keeps only the icon of its back buttons; tooltip and accessible name still name the target. -->
    <Style Selector="controls|HeaderBar:compact > Button.header-back TextBlock">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.icon-square">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Input}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Input}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- HB1 tooltips: a long text wraps inside the 360 dip tooltip (ToolTipMaxWidth above) instead of running off as one line; a text
         may carry line breaks (CommandBindings.Tooltip: "Label · shortcut" on the first line, hint or reason on the second). -->
    <!-- A tip never takes the pointer from the control it describes: a tip that sits under the pointer (footer: it opens above the bar and
         the pointer enters from above) made the control lose hover, closed itself and opened again (flicker, Tom's video 21.11.). -->
    <Style Selector="ToolTip"><Setter Property="MaxWidth" Value="360" /></Style>
    <Style Selector="ToolTip"><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="Button.nav"><Setter Property="ToolTip.Placement" Value="Top" /><Setter Property="ToolTip.VerticalOffset" Value="-6" /></Style>
    <Style Selector="ToolTip ScrollViewer, ToolTip /template/ ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <Style Selector="ToolTip TextBlock"><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="LineSpacing" Value="{StaticResource Workspace.Space.2}" /></Style>
    <!-- HB1 help-round: the one help button (controls:HelpButton), flat like the other icon buttons (UX review 15.11.: the circled "?" was ugly).
         A 32 dip square hit target with the plain drawn "?" (WorkspaceIcons.Help) centred: no outline at rest (a 1-px edge is reserved so the
         hover does not move it), Muted glyph at rest, Workspace.Text on hover with the rounded Hover pill and ControlBorder edge (the bar-flat /
         media-control hover), the accent pressed look while its popover opens, and the shared focus ring. Never text, never a font glyph; its
         name is "Help: <section>" and it opens a HelpPopover. -->
    <Style Selector="Button.help-round">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Control}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Control}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Also inside a toolbar: Ursa's ToolBar gives its buttons the borderless theme, which has no hover pill and no focus ring of this
             look. The help button keeps the standard button theme, restyled flat here. -->
        <Setter Property="Theme" Value="{DynamicResource {x:Type Button}}" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="Button.help-round /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Button.help-round:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.help-round:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <!-- Disabled: the Muted glyph dimmed to 0.75, no hover or pressed fill. -->
    <Style Selector="Button.help-round:disabled, Button.help-round:disabled:pointerover, Button.help-round:disabled:pressed"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="Button.help-round:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Button.help-round:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Button.help-round:disabled:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- Tagging page (layout review 15.11.): the outlined button of a toolbar row. Ursa's ToolBar gives its buttons the borderless theme, so a
         row of actions beside combo boxes read as flat labels and a disabled one as a dead grey word; bar-button keeps the standard button
         theme (as help-round does), so the selection bar is outlined like the Media selection row. Only on the bar itself: an item that moved
         under "More" (ActionToolBarPanel marks it :in-overflow) keeps the popup's plain rows. -->
    <Style Selector="Button.bar-button:not(:in-overflow)">
        <Setter Property="Theme" Value="{DynamicResource {x:Type Button}}" />
    </Style>
    <!-- Toolbar UX review 15.11. (bar-flat): the item of a page or pane toolbar is a flat button with room around it. At rest only its label
         (transparent fill and a reserved transparent 1-px edge, so nothing jumps); hover the Hover fill with the ControlBorder edge (the fill
         alone is too faint in Light, #D2CABE on #E3DFD8); pressed AccentSurface with the accent edge and the label staying Workspace.Text;
         disabled the Muted label; focus the shared ring. These are the media-control values, so gallery and toolbars match. Padding 8,4 and
         height 32 give back about 4 dip per item against the 8-dip gaps ActionToolBarPanel puts between them.
         ursa|ToolBar is the ActionToolBar (its style key is Ursa's ToolBar; the app has no other); items keep the toolbar as logical parent
         wherever their panel is, so the child selector reaches an item back from "More" too. Under "More" (:in-overflow) the popup's plain
         rows stay. Outlined bar-button (selection bars), primary, help-round, the joined segments and media-control keep their own look. -->
    <Style Selector="ursa|ToolBar > Button:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow), ursa|ToolBar > ToggleButton:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow), Button.bar-flat">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="ursa|ToolBar > SplitButton:not(:in-overflow)">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /><Setter Property="FontWeight" Value="Normal" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="8,4" /><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ursa|ToolBar > Button:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow) /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > ToggleButton:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow) /template/ ContentPresenter#PART_ContentPresenter, Button.bar-flat /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > SplitButton:not(:in-overflow) /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ursa|ToolBar > Button:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):pointerover /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > ToggleButton:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.bar-flat:pointerover /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > SplitButton:not(:in-overflow) /template/ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ursa|ToolBar > Button:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):pressed /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > ToggleButton:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):pressed /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > ToggleButton:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):checked /template/ ContentPresenter#PART_ContentPresenter, Button.bar-flat:pressed /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > SplitButton:not(:in-overflow) /template/ Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ursa|ToolBar > Button:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):disabled /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > ToggleButton:not(.bar-button):not(.primary):not(.help-round):not(.segment):not(.media-control):not(:in-overflow):disabled /template/ ContentPresenter#PART_ContentPresenter, Button.bar-flat:disabled /template/ ContentPresenter#PART_ContentPresenter, ursa|ToolBar > SplitButton:not(:in-overflow) /template/ Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- A disclosure (Tagging stamp block): the quiet section head that opens and closes a block - the turning arrow and the title, no fill
         and no outline at rest and when open (only the page's primary action is filled). Hover shows the Hover fill with the 1-px ControlBorder
         edge (the fill alone is 1.37:1 on the page), keyboard focus keeps the shared ring. -->
    <Style Selector="ToggleButton.disclosure">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="Padding" Value="4,5" /><Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Control}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>
    <Style Selector="ToggleButton.disclosure /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:disabled, ToggleButton.disclosure:pointerover:disabled, ToggleButton.disclosure:pressed:disabled, ToggleButton.disclosure:checked:disabled, ToggleButton.disclosure:checked:pointerover:disabled, ToggleButton.disclosure:checked:pressed:disabled"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ToggleButton.disclosure:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.disclosure:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked:pointerover:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.disclosure:checked:pressed:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- HB1 HelpPopover: a flyout with the popover inset (16), the control outline and the overlay radius; the column inside is
         Workspace.Size.ReadingWidth (400) at most, so MaxWidth here is 400 + 2 x 16 inset + 2 x 1 border. -->
    <Style Selector="FlyoutPresenter.help-popover">
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Popover}" /><Setter Property="MaxWidth" Value="434" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Group}" />
        <!-- UX-LEDGER-02: the flyout frame scrolls its content (the theme template has a ScrollViewer). A help text only ever wraps: never a horizontal scroll bar. -->
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>
    <Style Selector="FlyoutPresenter.help-popover /template/ ScrollViewer"><Setter Property="HorizontalScrollBarVisibility" Value="Disabled" /></Style>
    <!-- The help-text layout (HelpPopover.Build), typography pass 15.11.: 8 between title, paragraphs, list and link; 4 between bullets;
         paragraph and bullet lines at the reading line height; the dot in its own column, 8 before the text (hanging indent). -->
    <Style Selector="StackPanel.help-popover-body"><Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" /></Style>
    <Style Selector="StackPanel.help-text-list"><Setter Property="Spacing" Value="{StaticResource Workspace.Space.4}" /></Style>
    <Style Selector="Grid.help-text-bullet-row"><Setter Property="ColumnSpacing" Value="{StaticResource Workspace.Space.8}" /></Style>
    <Style Selector="TextBlock.help-text-paragraph, TextBlock.help-text-bullet">
        <Setter Property="LineHeight" Value="{StaticResource Workspace.LineHeight.Body}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- The dot is centred on the first line: (LineHeight.Body 18 - 4) / 2 = 7 from the top. -->
    <Style Selector="Border.help-popover-dot">
        <Setter Property="Width" Value="4" /><Setter Property="Height" Value="4" /><Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Muted}" /><Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,7,0,0" /><Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- Drawn glyph icons (WorkspaceIcons.cs): 16 dip grid, stroke weight 1.5 (glyph-thin 1, glyph-heavy 2; no other weights), round
         caps. The stroke follows the foreground of the owner in code, so a disabled button greys its icon like its text. -->
    <Style Selector="Path.glyph-icon">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.Icon}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.Icon}" />
        <Setter Property="Stretch" Value="None" /><Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- A text that is only for assistive technology (a drawn icon or badge has no automation peer of its own): it takes no room, draws nothing
         and is no hit target, but stays in the content view with its text as the name. -->
    <Style Selector="TextBlock.visually-hidden">
        <Setter Property="Width" Value="1" /><Setter Property="Height" Value="1" /><Setter Property="Opacity" Value="0" />
        <Setter Property="FontSize" Value="1" /><Setter Property="IsHitTestVisible" Value="False" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Path.glyph-icon.glyph-small"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /></Style>
    <Style Selector="Path.glyph-icon.glyph-thin"><Setter Property="StrokeThickness" Value="1" /></Style>
    <Style Selector="Path.glyph-icon.glyph-heavy"><Setter Property="StrokeThickness" Value="2" /></Style>
    <!-- A badge that states a plain fact (plugin type, file version, plugin id): the chip outline on a raised surface, no accent. -->
    <Style Selector="Border.chip-badge.chip-neutral"><Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /></Style>
    <!-- Quick tag surface (PLAN-SCHNELL-TAGGEN 3.3): the number or letter key on a suggestion pill, a quiet key hint (UX review 15.11.): a
         16 dip rounded square on the window background with no edge, the key in Muted (Caption SemiBold, 4.5:1 or more on Background in both
         themes), so it reads as a keycap inside the pill and not as a second circle against the pill's edge. -->
    <Style Selector="Border.chip-badge.chip-key">
        <Setter Property="Background" Value="{DynamicResource Workspace.Background}" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="{StaticResource Workspace.Size.TagKey}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.TagKey}" />
        <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Badge}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip-badge.chip-key TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontFeatures" Value="tnum" />
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip.chip-keyed"><Setter Property="Padding" Value="3,2,8,2" /></Style>

    <Style Selector="controls|ChipOutline.chip-source">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSourceBorder}" />
        <Setter Property="StrokeThickness" Value="1" /><Setter Property="IsDashed" Value="True" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.Chip}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-compact">
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.ChipCompact}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-compact TextBlock.chip-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
    </Style>
    <!-- Quick tag surface: a source suggestion with a key badge (see chip-key above). -->
    <Style Selector="controls|ChipOutline.chip-source.chip-keyed"><Setter Property="Padding" Value="3,2,8,2" /></Style>
    <Style Selector="Border.chip-category-mark">
        <Setter Property="Width" Value="3" /><Setter Property="CornerRadius" Value="1.5" /><Setter Property="Margin" Value="0,2,5,2" />
        <Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.General}" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source-artist Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Artist}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source-copyright Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Copyright}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source-character Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Character}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source-meta Border.chip-category-mark"><Setter Property="Background" Value="{DynamicResource Workspace.TagCategory.Meta}" /></Style>
    <!-- A marked source tag (A11Y M7): tint plus a solid 2-px accent outline, so the mark is a change of line, not only of colour. -->
    <Style Selector="ListBoxItem.chip-item">
        <Setter Property="Padding" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Chip}" />
    </Style>
    <Style Selector="ListBoxItem.chip-item /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem.chip-item:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem.chip-item:selected /template/ ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="ListBoxItem.chip-item:pointerover controls|ChipOutline.chip-source"><Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /></Style>
    <Style Selector="ListBoxItem.chip-item:selected controls|ChipOutline.chip-source">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="StrokeThickness" Value="2" /><Setter Property="IsDashed" Value="False" />
    </Style>
    <!-- I8: a source-tag chip that is an action. The button itself is invisible; the dashed chip shows hover and press. -->
    <Style Selector="Button.chip-source-button">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chip-source-button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:pointerover controls|ChipOutline.chip-source"><Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /></Style>
    <Style Selector="Button.chip-source-button:pressed controls|ChipOutline.chip-source">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <!-- Disabled: the dashed chip dimmed to 0.75 like a disabled chip, without the hover or pressed fill. -->
    <Style Selector="Button.chip-source-button:disabled, Button.chip-source-button:disabled:pointerover, Button.chip-source-button:disabled:pressed"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="Button.chip-source-button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.chip-source-button:disabled:pointerover controls|ChipOutline.chip-source, Button.chip-source-button:disabled:pressed controls|ChipOutline.chip-source"><Setter Property="Background" Value="Transparent" /></Style>
    <!-- The invisible "Play video here" button over a video's picture (reader post, media sidebar): Semi's hover/pressed fill of the presenter
         would paint the whole frame flat and hide the poster, so every state is transparent; hover and focus show a thin accent ring. -->
    <Style Selector="Button.video-activator">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.video-activator /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
    <Style Selector="Button.video-activator:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Button.video-activator:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Button.video-activator:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /></Style>
    <!-- The favourite star of a medium (ArchiveFavoriteButton: a post's file line, the reader sidebar's header; the tiles add tile-favorite below,
         which wins for their fill). The star drawing is no hit target (FavoriteStar), so the button's own surface must be one: a transparent fill
         at rest, the Hover fill with the ControlBorder edge under the pointer and while pressed. Without a fill the pointer went through to the
         card and the star did nothing (review 15.11.2026). Unavailable (no saved file): no fill, no edge, the muted foreground and a lighter star,
         so it reads as off; the tooltip says why (ToolTip.ShowOnDisabled). -->
    <Style Selector="ToggleButton.favorite-star">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>
    <Style Selector="ToggleButton.favorite-star /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.favorite-star:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.favorite-star:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.favorite-star:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.favorite-star:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.favorite-star:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.favorite-star:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.favorite-star:checked:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Opacity" Value="0.6" />
    </Style>
    <!-- I7 tile corners: static chip badges and marks; the favourite star appears by opacity only (set, hover, keyboard focus),
         so nothing moves and the tile keeps its height. -->
    <Style Selector="Border.tile-mark"><Setter Property="Padding" Value="3" /></Style>
    <!-- D0: a corner mark is under 20 dip high, so it takes the badge corners (like the selection check), not the pill. -->
    <Style Selector="Border.chip-badge.tile-corner"><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Badge}" /></Style>
    <Style Selector="Path.tile-mark-glyph">
        <Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.Text}" /><Setter Property="StrokeThickness" Value="1.5" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite">
        <Setter Property="Width" Value="26" /><Setter Property="Height" Value="26" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:checked"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ToggleButton.tile-favorite:focus-visible"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ListBoxItem.transient-pointer-over ToggleButton.tile-favorite"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ListBoxItem:focus-within ToggleButton.tile-favorite"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ToggleButton.tile-favorite /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
    </Style>
    <!-- Disabled: where the toggle shows at all (set, hover or focus of the tile) it is dimmed to 0.75 with the Muted glyph and no hover fill. The
         opacity rules name the same tile contexts as the visibility rules above and below, so they win over each of them. -->
    <Style Selector="ToggleButton.tile-favorite:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tile-favorite:checked:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tile-favorite:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.tile-favorite:checked:disabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="ToggleButton.tile-favorite:checked:disabled, ToggleButton.tile-favorite:disabled:focus-visible, ListBoxItem.transient-pointer-over ToggleButton.tile-favorite:disabled, ListBoxItem:focus-within ToggleButton.tile-favorite:disabled">
        <Setter Property="Opacity" Value="0.75" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- MB1b: where the shared media badges already show the favourite at rest (archive tiles), the toggle is only shown while the tile is
         hovered or holds keyboard focus, set or not (declared after the rules above, so it wins over ":checked"). -->
    <Style Selector="ToggleButton.tile-favorite.tile-favorite-quiet:checked"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="ToggleButton.tile-favorite.tile-favorite-quiet:focus-visible"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ListBoxItem.transient-pointer-over ToggleButton.tile-favorite.tile-favorite-quiet"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ListBoxItem:focus-within ToggleButton.tile-favorite.tile-favorite-quiet"><Setter Property="Opacity" Value="1" /><Setter Property="IsHitTestVisible" Value="True" /></Style>
    <Style Selector="ToggleButton.tile-favorite.tile-favorite-quiet:checked:disabled"><Setter Property="Opacity" Value="0" /><Setter Property="IsHitTestVisible" Value="False" /></Style>
    <Style Selector="ToggleButton.tile-favorite.tile-favorite-quiet:disabled:focus-visible, ListBoxItem.transient-pointer-over ToggleButton.tile-favorite.tile-favorite-quiet:disabled, ListBoxItem:focus-within ToggleButton.tile-favorite.tile-favorite-quiet:disabled"><Setter Property="Opacity" Value="0.75" /></Style>
    <Style Selector="ListBoxItem.chip-item:selected controls|ChipOutline.chip-source TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>

    <!-- D4 (E7, A11Y M7): a chosen chip is never the tint alone. The chip-selected class gives the tint and a solid 2-px accent
         outline (Button, filter tag, source tag outline); the border grows inward by one dip, so the padding gives it back and the
         chip keeps its size. Applied and removed instantly: no transition (virtualised lists recycle chips). -->
    <Style Selector="Button.chip.chip-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="7,3" />
    </Style>
    <Style Selector="Button.chip.chip-compact.chip-selected"><Setter Property="Padding" Value="5,0" /></Style>
    <Style Selector="Button.chip.chip-selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.chip-selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.chip-selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip.chip-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" /><Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="ursa|ClosableTag.chip.chip-selected:pointerover"><Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" /></Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="StrokeThickness" Value="2" /><Setter Property="IsDashed" Value="False" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.chip-selected TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>

    <!-- Tag pills (UX review 15.11.: "the pills don't look good yet"). One pill for the tag panel's suggestions and assigned tags, the reader
         tag bar and the tiles' tags: 28 high with a full radius, 12 dip in from the edge (8 before a key hint, the hint 6 dip from the label),
         the label always Workspace.Text. Rest = a quiet filled pill (ChipSurface, a hairline Workspace.Border edge); hover = Workspace.Hover with the
         ControlBorder edge; pressed = AccentSurface with the Accent edge (the toolbar bar-flat and help-round language); focus = the shared focus ring.
         An assigned tag (tag-pill-assigned) rests on the accent tint with an accent edge, a partly assigned one (tag-pill-partial) keeps
         the quiet fill with an accent edge and a dash (an assigned pill carries no check mark: the tint, the section and the joined cross say it); a source suggestion keeps its dashed outline without fill. Colour and form
         both carry the state, never the tint alone. Declared after the chip styles above so that it replaces them on a tag pill; the compact
         tile form keeps the 18 dip size and takes the colours only. Same height everywhere: MinHeight with no vertical padding. -->
    <Style Selector="Button.chip.tag-pill">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.TagPill}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.TagPill}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.TagPill}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.chip-keyed"><Setter Property="Padding" Value="{StaticResource Workspace.Inset.TagPillKeyed}" /></Style>
    <Style Selector="Button.chip.tag-pill.chip-compact">
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.ChipCompact}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.ChipCompact}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.ChipCompact}" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
    </Style>
    <Style Selector="Button.chip.tag-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.tag-pill:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.tag-pill:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.tag-pill-partial">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.tag-pill-partial:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.tag-pill-partial:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.tag-pill-assigned">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.tag-pill-assigned:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.chip.tag-pill.tag-pill-assigned:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <!-- An assigned tag as one pill with two hit halves (QuickTagSurface.AssignedChip): the chip is the start (left corners rounded, no right edge, 4 dip before
         the cross), the cross the end (a 28 dip square, right corners rounded, no left edge) in the fill and edge of the pill's state, so the two read as one
         shape. The cross is Muted until the pointer is on it, then Text on the Hover fill; the edge stays the state's. It is not a tab stop (Delete on the chip
         removes too). No comma lists and no animations in a tag-pill selector (ChipStyleTests). Declared after icon-square so its 28 replaces the 32. -->
    <Style Selector="Button.chip.tag-pill.tag-pill-joined">
        <Setter Property="BorderThickness" Value="1,1,0,1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.TagPillStart}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.TagPillJoined}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove">
        <Setter Property="Width" Value="{StaticResource Workspace.Size.TagPill}" /><Setter Property="Height" Value="{StaticResource Workspace.Size.TagPill}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="0,1,1,1" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.TagPillEnd}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove.tag-pill-assigned">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove.tag-pill-partial">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove.tag-pill-assigned:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove.tag-pill-partial:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.ChipSelectedSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.ChipSelectedBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="Button.icon-square.tag-pill-remove:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <!-- The content of a pill: the dash of a partly assigned tag, the key hint or the stamp mark and the label, 6 dip apart (Workspace.Space.TagKey). -->
    <Style Selector="StackPanel.tag-pill-content"><Setter Property="Spacing" Value="{StaticResource Workspace.Space.TagKey}" /></Style>
    <!-- A source suggestion (dashed, no fill) in the same geometry: ChipOutline draws its edge inside its bounds, so its inset is the pill's plus
         the 1-px edge (13 and 9). The label is Workspace.Text like the other pills; the dash and the missing fill say "from a provider". -->
    <Style Selector="controls|ChipOutline.chip-source.tag-pill">
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.TagPill}" />
        <Setter Property="MinHeight" Value="{StaticResource Workspace.Size.TagPill}" />
        <Setter Property="Padding" Value="13,0" />
    </Style>
    <Style Selector="controls|ChipOutline.chip-source.tag-pill.chip-keyed"><Setter Property="Padding" Value="9,0,13,0" /></Style>
    <Style Selector="controls|ChipOutline.chip-source.tag-pill TextBlock.chip-label"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <!-- ... but the key hint inside it keeps its own quiet look (the rule above and chip-source's body size would otherwise reach its digit). -->
    <Style Selector="controls|ChipOutline.chip-source.tag-pill Border.chip-key TextBlock.chip-label">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Caption}" />
    </Style>

    <!-- D4 (T3): a selected tile carries a check mark in the preview corner besides the list's tint and bar, so the selection
         is also a shape. A drawn path, not a font glyph; static, shown or hidden with the item's selection, no transition. -->
    <Style Selector="Border.tile-selection-check">
        <Setter Property="Background" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Padding" Value="3" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Badge}" />
    </Style>
    <Style Selector="Path.tile-selection-glyph">
        <Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{DynamicResource Workspace.OnAccent}" /><Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" /><Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- D5 typography. Subtitle (16, SemiBold): the heading of a DialogFrame (whatever class the dialog gave it: page-title 20 or
         section-title 14 before) and the title of a content card (Booru hit, watcher). tnum: tabular figures for counters, tables
         and transfer numbers, so a changing number does not make its neighbours jump (Inter ships the feature). -->
    <Style Selector="Border#DialogFrameHeader TextBlock.page-title, Border#DialogFrameHeader TextBlock.section-title, TextBlock.card-title, SelectableTextBlock.card-title">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Subtitle}" /><Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.tnum, SelectableTextBlock.tnum, DataGrid TextBlock"><Setter Property="FontFeatures" Value="tnum" /></Style>
    <!-- Figures (D5 / P5): figure columns line up (right-aligned, tabular figures); a headline figure (statistics value tiles,
         counters, transfer numbers) is one Subtitle step, SemiBold, tabular. -->
    <Style Selector="TextBlock.stats-num"><Setter Property="TextAlignment" Value="Right" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="FontFeatures" Value="tnum" /></Style>
    <Style Selector="TextBlock.stats-value"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Subtitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontFeatures" Value="tnum" /></Style>

    <!-- D3 surfaces (design language 5, 6.2). workspace-card: content card on Panel or Background (Booru hit, watcher, reader post
         through the same tokens): Card + CardEdge 1 px, radius 5, no shadow, never a card inside a card. workspace-card-active: the
         selected card, AccentSurface with the accent edge 3,1,1,1 (never the tint alone). workspace-overlay: the in-window overlay
         level (filter surface): Overlay + ControlBorder + radius 8. No shadow on it (D6 measurement: an in-window overlay
         repaints its shadow whenever the grid behind scrolls; the smoke "motion shadow cost" shows mean 14.6 to 16.0 ms, p95 16.9 to 22.4 ms
         under software rendering, so the edge alone separates it; the shadow stays on Semi's popups and toasts, which are own surfaces). workspace-thumb-placeholder: the quiet
         static slot behind a thumbnail that has not arrived (no box once the image is there). -->
    <Style Selector="Border.workspace-card">
        <Setter Property="Background" Value="{DynamicResource Workspace.Card}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.CardEdge}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Card}" />
    </Style>
    <!-- MV2 Booru result tile: the media page's tile look without the list host. No card: transparent at rest, with the 1-px edge reserved
         (the picture size is unchanged), a quiet Raised background and ControlBorder edge on hover or keyboard focus, AccentSurface and a
         3-px accent bar (Border.booru-tile-bar) when selected, together with the accent check on the picture. The actions row is transparent
         until hover, focus inside or selection; it stays focusable. Square corners. -->
    <Style Selector="Border.booru-tile">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="0" />
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="Border.booru-tile:pointerover, Border.booru-tile:focus-within">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
    </Style>
    <Style Selector="Border.booru-tile.booru-tile-selected">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
    </Style>
    <!-- The cursor of the Booru list and grid: the hit the person is on keeps an accent edge while the focus is elsewhere on the page (the 1-px edge is
         already reserved, so nothing moves). -->
    <Style Selector="Border.workspace-card.booru-cursor, Border.booru-tile.booru-cursor">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Border.booru-tile-bar"><Setter Property="Background" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Border.booru-tile WrapPanel.booru-tile-actions"><Setter Property="Opacity" Value="0" /></Style>
    <Style Selector="Border.booru-tile:pointerover WrapPanel.booru-tile-actions, Border.booru-tile:focus-within WrapPanel.booru-tile-actions, Border.booru-tile.booru-tile-selected WrapPanel.booru-tile-actions">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- A card the keyboard reaches (Booru hit): the shared double focus ring, drawn only for keyboard focus (Avalonia shows the adorner for Tab and arrow focus). -->
    <Style Selector="Border.workspace-card-focusable">
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="Border.workspace-card.workspace-card-active">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="BorderThickness" Value="3,1,1,1" />
    </Style>
    <Style Selector="Border.workspace-overlay">
        <Setter Property="Background" Value="{DynamicResource Workspace.Overlay}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Group}" />
    </Style>
    <Style Selector="Border.workspace-thumb-placeholder">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
    </Style>

    <!-- D1 motion (design language 4.5, E4/E5). Every rule below applies only under a TopLevel WITHOUT the class motion-off
         (MotionPolicy puts it on windows when the environment, the "Animations" setting or the operating system says off), so
         switching at run time needs no restart. Only Opacity and Background/BorderBrush/Foreground move; nothing
         changes size, margin or radius, and nothing here targets virtualised rows or tiles (selection and recycling stay instant).
         Durations: Hover 80 ms, Fade 120 ms, Reveal 180 ms, Enter 260 ms (spec 4.5). Progress and spinners are not touched. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                <BrushTransition Property="Foreground" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel):not(.motion-off) ToggleButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
                <BrushTransition Property="Foreground" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <!-- E6: buttons inside virtualised containers (tile chips, favourite stars, reader quote buttons) never transition: recycling
         a container changes their classes and states, and every such change would otherwise start an 80 ms brush fade. These
         rules come after the two above and carry the same class condition (a rule without one has a lower value priority and would
         lose to them, however late it stands). -->
    <Style Selector=":is(TopLevel):not(.motion-off) ListBoxItem Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector=":is(TopLevel):not(.motion-off) ListBoxItem ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector=":is(TopLevel):not(.motion-off) DataGridRow Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <Style Selector=":is(TopLevel):not(.motion-off) DataGridRow ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions"><Transitions /></Setter></Style>
    <!-- The filter chip is a control that tints itself (no template part), so the control carries the transition. -->
    <Style Selector=":is(TopLevel):not(.motion-off) ursa|ClosableTag.chip">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.08" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.08" />
            </Transitions>
        </Setter>
    </Style>
    <!-- The reader navigation bar fades in and out with the pointer's idle state (Fade 120 ms); under reduced motion it switches at once. -->
    <Style Selector=":is(TopLevel):not(.motion-off) WrapPanel.reader-cross">
        <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Setter>
    </Style>
    <!-- A filter chip appears with a short fade (the tag bar's own chips are rebuilt often and tile chips are recycled: no fade there). -->
    <Style Selector=":is(TopLevel):not(.motion-off) ursa|ClosableTag.chip.chip-filter">
        <Style.Animations>
            <Animation Duration="0:0:0.12" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- Toast (FeedbackToastContent): 260 ms fade on arrival (opacity only: no RenderTransform keyframes, Avalonia has no animator for them); the live region carries the message either way. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Grid.toast-content">
        <Style.Animations>
            <Animation Duration="0:0:0.26" Easing="CubicEaseOut">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <!-- In-window overlay (filter surface, bars): hidden until the caller adds .shown; the caller keeps IsVisible true while it fades
         (180 ms in, and removes .shown for the 180 ms out before IsVisible=False). Under motion-off the class does nothing: the
         overlay is simply visible or not. Applies to Border only; one element, static shadow. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Border.motion-overlay">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.18" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector=":is(TopLevel):not(.motion-off) Border.motion-overlay.shown">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Image that arrives asynchronously (see ImageFade): 150 ms fade of Opacity. Never used on recycled tiles or cache hits. -->
    <Style Selector=":is(TopLevel):not(.motion-off) Image.motion-fade-in">
        <Setter Property="Transitions">
            <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut" /></Transitions>
        </Setter>
    </Style>
    <!-- GL6: the filmstrip's scroll arrows fade in and out with the pointer or keyboard in the band (Hover 80 ms); under reduced motion they switch at once.
         The control keeps IsVisible while there is somewhere to scroll and moves only Opacity (code: GalleryFilmstrip.UpdateChevrons). -->
    <Style Selector=":is(TopLevel):not(.motion-off) Button.filmstrip-chevron">
        <Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.08" /></Transitions></Setter>
    </Style>
    <!-- E5: motion-off also silences transitions the theme brings along on the roles above. -->
    <Style Selector=":is(TopLevel).motion-off Button /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions" Value="{x:Null}" /></Style>
    <Style Selector=":is(TopLevel).motion-off ToggleButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Transitions" Value="{x:Null}" /></Style>
</Styles>
