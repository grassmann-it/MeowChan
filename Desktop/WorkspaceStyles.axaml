<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="clr-namespace:MeowChan.Desktop">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Workspace.Background">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Panel">#1B1E22</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Raised">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Border">#2D3239</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Text">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Muted">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Accent">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentSurface">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ReaderActiveSurface">#152233</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Hover">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.OnAccent">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentHover">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Error">#F49B9B</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ErrorSurface">#3C2428</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Warning">#E8BE72</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.WarningSurface">#352C1D</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Success">#83D4AC</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.SuccessSurface">#20382D</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground">#EEF1F4</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground">#30363E</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPressedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultDisabledForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultDisabledBorderBrush">#2D3239</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBorderBrush">#2D3239</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush">#8ABBFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground">#121416</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledBackground">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledForeground">#A4ADB8</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledBorderBrush">#2D3239</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowPointeroverBackground">#24282D</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowSelectedBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground">#25344A</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridCellFocusBorderBrush">#6AA7FF</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridLineBrush">#2D3239</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Workspace.Background">#F3F5F7</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Panel">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Raised">#E8EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Border">#B8C1CD</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Text">#18212C</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Muted">#46556A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Accent">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentSurface">#E0EBFC</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ReaderActiveSurface">#F2F6FC</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Hover">#DCE3EC</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.OnAccent">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.AccentHover">#174E9A</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Error">#A52736</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.ErrorSurface">#FCE9EC</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Warning">#795100</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.WarningSurface">#FFF3D6</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Success">#176342</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.SuccessSurface">#E1F3E9</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPrimaryForeground">#18212C</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBackground">#DCE3EC</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPressedBackground">#E0EBFC</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultDisabledForeground">#46556A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultDisabledBorderBrush">#B8C1CD</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPointeroverBorderBrush">#B8C1CD</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDefaultPressedBorderBrush">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBackground">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryBorderBrush">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBackground">#174E9A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPointeroverBorderBrush">#174E9A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBackground">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedForeground">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidPrimaryPressedBorderBrush">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledBackground">#E8EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledForeground">#46556A</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonSolidDisabledBorderBrush">#B8C1CD</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowPointeroverBackground">#E8EDF3</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowSelectedBackground">#E0EBFC</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridRowSelectedPointeroverBackground">#E0EBFC</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridCellFocusBorderBrush">#1D5CB5</SolidColorBrush>
                    <SolidColorBrush x:Key="DataGridLineBrush">#B8C1CD</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
        <!-- Semi owns every standard control template. These public theme resources
             retain MeowChan's density without replacing focus, input or state behavior. -->
        <Thickness x:Key="DataGridCellTextBlockDefaultMargin">12,0</Thickness>
        <x:Double x:Key="DataGridCellMinHeight">0</x:Double>
        <x:Double x:Key="DataGridColumnHeaderMinHeight">28</x:Double>
        <!-- Shared composition values. Density remains the existing preference,
             not a new setting and not an instruction to compact every surface. -->
        <x:Double x:Key="Workspace.Space.4">4</x:Double>
        <x:Double x:Key="Workspace.Space.8">8</x:Double>
        <x:Double x:Key="Workspace.Space.12">12</x:Double>
        <x:Double x:Key="Workspace.Space.16">16</x:Double>
        <x:Double x:Key="Workspace.Space.24">24</x:Double>
        <x:Double x:Key="Workspace.Text.Body">13</x:Double>
        <x:Double x:Key="Workspace.Text.Meta">12</x:Double>
        <x:Double x:Key="Workspace.Text.Section">14</x:Double>
        <x:Double x:Key="Workspace.Text.Title">20</x:Double>
        <CornerRadius x:Key="Workspace.Radius.Control">5</CornerRadius>
        <CornerRadius x:Key="Workspace.Radius.Group">8</CornerRadius>
        <Thickness x:Key="Workspace.Inset.Section">16</Thickness>
        <Thickness x:Key="Workspace.Inset.Message">12</Thickness>
        <Thickness x:Key="Workspace.Inset.Footer">16,12</Thickness>
        <Thickness x:Key="Workspace.Inset.Chip">8,4</Thickness>
        <!-- Native keyboard-only focus decoration; it overlays rather than moves
             content, and remains separate from selected/error border state. -->
        <Template x:Key="Workspace.FocusAdorner">
            <Border BorderBrush="{DynamicResource Workspace.Accent}" BorderThickness="2"
                    CornerRadius="{StaticResource Workspace.Radius.Control}" Margin="-4"
                    IsHitTestVisible="False" />
        </Template>
    </Styles.Resources>
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource Workspace.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
    </Style>
    <Style Selector="TextBlock.muted, SelectableTextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="TextBlock.error, SelectableTextBlock.error"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <Style Selector="TextBlock.brand"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.page-title"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Title}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.section-title"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Section}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="monospace" /></Style>
    <Style Selector="Window.workspace-advanced TextBlock.inline-thread-id, Window.workspace-advanced TextBlock.media-state"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector="Border.panel, Border.raised, Border.shell-bar">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.settings-divider"><Setter Property="Padding" Value="0,10" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /></Style>
    <Style Selector="Border.panel"><Setter Property="CornerRadius" Value="5" /></Style>
    <Style Selector="Border.raised"><Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="CornerRadius" Value="5" /></Style>
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="5" /><Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Theme" Value="{DynamicResource SolidButton}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.OnAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /></Style>
    <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <Style Selector="Button.header-icon">
        <Setter Property="Width" Value="30" /><Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="6" /><Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.header-icon.selected"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>
    <Style Selector="Path.header-icon">
        <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.window-caption">
        <Setter Property="Width" Value="44" /><Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Path.window-caption-icon">
        <Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" />
        <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" /><Setter Property="StrokeThickness" Value="1" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /><Setter Property="Padding" Value="12,8" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style Selector="Button.nav.selected"><Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" /></Style>
    <Style Selector="Button.nav Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Muted}" /></Style>
    <Style Selector="Button.nav.selected Path"><Setter Property="Stroke" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="TextBox, ComboBox, NumericUpDown"><Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="13" /></Style>
    <!-- Semi's translucent dark-blue selection has little contrast on dark fields.
         Keep its native presenter and retained-selection behavior with an opaque pair. -->
    <Style Selector="TextBox">
        <Setter Property="SelectionBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Workspace.OnAccent}" />
    </Style>
    <Style Selector="ComboBox.footer-mode"><Setter Property="MinHeight" Value="28" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="BorderThickness" Value="0" /><Setter Property="RowHeight" Value="{x:Static desktop:WorkspaceMetrics.NormalRowHeight}" /><Setter Property="ColumnHeaderHeight" Value="32" /><Setter Property="FontSize" Value="13" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="DataGridCell"><Setter Property="Padding" Value="12,0" /><Setter Property="ClipToBounds" Value="True" /></Style>
    <Style Selector="DataGridRow:selected"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>

    <!-- Opt-in composition roles; native templates, selection and automation stay
         with Semi/Ursa and the existing controls. Do not nest sections for decoration. -->
    <Style Selector="Button, ToggleButton, TextBox, ComboBox, NumericUpDown, CheckBox, RadioButton, Slider, ListBoxItem">
        <Setter Property="FocusAdorner" Value="{StaticResource Workspace.FocusAdorner}" />
    </Style>
    <Style Selector="Button.link">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="8,6" />
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>
    <Style Selector="TextBlock.workspace-field-label, SelectableTextBlock.workspace-field-label">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" /><Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-help, SelectableTextBlock.workspace-help, TextBlock.workspace-meta, SelectableTextBlock.workspace-meta">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-error, SelectableTextBlock.workspace-error">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-warning, SelectableTextBlock.workspace-warning">
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Body}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.workspace-status, SelectableTextBlock.workspace-status">
        <Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /><Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.workspace-page-header, StackPanel.workspace-section-header">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="StackPanel.workspace-section-body, StackPanel.workspace-dialog-content">
        <Setter Property="Spacing" Value="{StaticResource Workspace.Space.12}" />
    </Style>
    <Style Selector="StackPanel.workspace-field"><Setter Property="Spacing" Value="{StaticResource Workspace.Space.4}" /></Style>
    <Style Selector="Border.workspace-section, Border.workspace-error, Border.workspace-warning, Border.workspace-status, Border.workspace-media-tools, Border.workspace-media-caption, Border.workspace-media-transport">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Section}" />
    </Style>
    <Style Selector="Border.workspace-error">
        <Setter Property="Background" Value="{DynamicResource Workspace.ErrorSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-warning">
        <Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Warning}" />
        <Setter Property="Padding" Value="{StaticResource Workspace.Inset.Message}" />
    </Style>
    <Style Selector="Border.workspace-status">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Chip}" />
    </Style>
    <Style Selector="Border.workspace-status-active"><Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" /></Style>
    <Style Selector="Border.workspace-status-warning"><Setter Property="Background" Value="{DynamicResource Workspace.WarningSurface}" /></Style>
    <Style Selector="Border.workspace-status-error"><Setter Property="Background" Value="{DynamicResource Workspace.ErrorSurface}" /></Style>
    <Style Selector="Border.workspace-status-success"><Setter Property="Background" Value="{DynamicResource Workspace.SuccessSurface}" /></Style>
    <Style Selector="Border.workspace-status-active TextBlock, Border.workspace-status-active SelectableTextBlock, TextBlock.workspace-status-active, SelectableTextBlock.workspace-status-active"><Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" /></Style>
    <Style Selector="Border.workspace-status-warning TextBlock, Border.workspace-status-warning SelectableTextBlock, TextBlock.workspace-status-warning, SelectableTextBlock.workspace-status-warning"><Setter Property="Foreground" Value="{DynamicResource Workspace.Warning}" /></Style>
    <Style Selector="Border.workspace-status-error TextBlock, Border.workspace-status-error SelectableTextBlock, TextBlock.workspace-status-error, SelectableTextBlock.workspace-status-error"><Setter Property="Foreground" Value="{DynamicResource Workspace.Error}" /></Style>
    <Style Selector="Border.workspace-status-success TextBlock, Border.workspace-status-success SelectableTextBlock, TextBlock.workspace-status-success, SelectableTextBlock.workspace-status-success"><Setter Property="Foreground" Value="{DynamicResource Workspace.Success}" /></Style>
    <Style Selector="Border.workspace-dialog-body"><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Section}" /></Style>
    <Style Selector="Border.workspace-dialog-footer">
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" /><Setter Property="Padding" Value="{StaticResource Workspace.Inset.Footer}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style Selector="Border.workspace-media-tools, Border.workspace-media-caption, Border.workspace-media-transport"><Setter Property="Padding" Value="8" /></Style>
    <!-- Video transport is a quiet strip attached to the viewport, not another
         settings card. Keep the gallery's action/caption surfaces independent. -->
    <Style Selector="Border.workspace-media-transport">
        <Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Button.media-control, ToggleButton.media-control">
        <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
        <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.media-play">
        <Setter Property="Background" Value="{DynamicResource Workspace.Raised}" />
    </Style>
    <Style Selector="Button.media-control:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
    </Style>
    <Style Selector="ToggleButton.media-control:checked /template/ ContentPresenter#PART_ContentPresenter, Button.media-control:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="ToggleButton.media-control:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.AccentHover}" />
    </Style>
    <Style Selector="Button.media-control:disabled /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.media-control:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Slider.media-slider">
        <Setter Property="Background" Value="{DynamicResource Workspace.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
    </Style>
    <Style Selector="Slider.media-slider /template/ Grid#SliderContainer">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider.media-slider /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Workspace.Panel}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource Workspace.Border}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ RepeatButton#PART_DecreaseButton">
        <Setter Property="Background" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="Slider.media-slider:disabled /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Muted}" />
    </Style>
    <Style Selector="WrapPanel.workspace-actions, WrapPanel.workspace-toolbar, WrapPanel.workspace-tool-group">
        <Setter Property="ItemSpacing" Value="{StaticResource Workspace.Space.8}" /><Setter Property="LineSpacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="WrapPanel.workspace-actions"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="StackPanel.workspace-actions, StackPanel.workspace-toolbar, StackPanel.workspace-tool-group">
        <Setter Property="Orientation" Value="Horizontal" /><Setter Property="Spacing" Value="{StaticResource Workspace.Space.8}" />
    </Style>
    <Style Selector="StackPanel.workspace-actions"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
    <Style Selector="TextBox.workspace-invalid, ComboBox.workspace-invalid, NumericUpDown.workspace-invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" />
    </Style>
</Styles>
