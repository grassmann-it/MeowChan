                    <SolidColorBrush x:Key="Workspace.AccentHover">#9A4B0B</SolidColorBrush>
                    <!-- UX review 2026-11-13: AccentHover (#9A4B0B) is a solid-button surface (white text 6.20:1) but as a text colour it is 4.30:1 on
                         AccentSurface, 4.25:1 on Raised and 3.82:1 on Hover. As text the hover tone is one step darker, as Pressed is in Light:
                         #6E3305 is 6.81:1 on AccentSurface, 6.05:1 on Hover. -->
                    <SolidColorBrush x:Key="Workspace.AccentHoverText">#6E3305</SolidColorBrush>
                    <SolidColorBrush x:Key="Workspace.Error">#A52736</SolidColorBrush>
