<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeowChan" xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls" xmlns:ursa="https://irihi.tech/ursa"
        x:Class="MeowChan.MainWindow" x:DataType="local:MainWindow"
        Width="1380" Height="850" MinWidth="760" MinHeight="500"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="{x:Static desktop:WorkspaceMetrics.TitleBarHeight}"
        Title="MeowChan" TextOptions.TextRenderingMode="Antialias">
    <!-- Paint the complete allocated client root explicitly. Template/native decoration
         margins are outside this root and require separate native evidence.
         This does not change native frame geometry or normal restore behavior. -->
    <Grid x:Name="WorkspaceRoot" Background="{DynamicResource Workspace.Background}"
          DragDrop.AllowDrop="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static desktop:WorkspaceMetrics.TitleBarRow}" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>
        <Border x:Name="WorkspaceTitleBarFrame" Classes="shell-bar" BorderThickness="0,0,0,1">
            <Grid x:Name="WorkspaceTitleBar" ColumnDefinitions="*,Auto" Background="Transparent"
                  WindowDecorationProperties.ElementRole="User" PointerPressed="OnTitleBarPointerPressed">
                <Grid x:Name="WorkspaceHeader" ColumnDefinitions="Auto,*,Auto,Auto" Margin="20,0" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BrandAboutButton" Classes="subtle" Padding="2,0" MinWidth="34" Height="34"
                                Background="Transparent" BorderThickness="0" Click="OnBrandAboutClick">
                            <!-- The header shows exactly one theme-appropriate cat. The button's own name ("About")
                                 is its accessible name; the decorative image is not announced separately. -->
                            <Image x:Name="WorkspaceLogo" Width="30" Height="30" Stretch="Uniform" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw" />
                        </Button>
                        <TextBlock Classes="brand" VerticalAlignment="Center" AutomationProperties.Name="MeowChan"><Run Text="Meow" /><Run Text="Chan" Foreground="{DynamicResource Workspace.Accent}" /></TextBlock>
                        <TextBlock x:Name="WorkspaceVersion" Classes="muted" FontSize="{StaticResource Workspace.Text.Meta}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceSubtitle" Grid.Column="1" Tag="shell.subtitle" Classes="localized muted" FontSize="{StaticResource Workspace.Text.Meta}"
                               VerticalAlignment="Center" FontStyle="Italic" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- A button, so keyboard and screen reader reach it: the name is the current values and a click opens the
                             statistics page. The inner parts are not exposed separately. -->
                        <Button x:Name="TransferSpeed" Classes="subtle header-graph" VerticalAlignment="Center" Click="OnTransferSpeedClick">
                            <!-- Four cells (two graphs, two labels), placed by ApplyHeaderGraphMode from the "Header graph" setting and the
                                 window width: rows (half-height graph and a one-line label each), two blocks (full-height graph and a
                                 two-line label: heading, values) or labels only. Exactly two graph surfaces: Network draws download (solid, filled) and
                                 upload (dashed), Disk draws write (solid, filled) and read (dashed), each on its own scale. -->
                            <Grid x:Name="TransferLayoutGrid" ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="2"
                                  VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                <controls:IoGraph x:Name="TransferSpeedGraph" Source="NetworkIo" Width="128" MinWidth="120" Height="15" HistoryWindowSeconds="60" VerticalAlignment="Center" IsHitTestVisible="False"
                                                  Stroke="{DynamicResource Workspace.Accent}" SecondaryStroke="{DynamicResource Workspace.Accent}" Fill="{DynamicResource Workspace.AccentSurface}" />
                                <StackPanel x:Name="TransferSpeedText" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="232">
                                    <TextBlock x:Name="TransferSpeedTitle" Classes="muted" FontSize="{StaticResource Workspace.Text.Caption}" FontFamily="{DynamicResource Workspace.Font.UI}" Text="Network" />
                                    <TextBlock x:Name="TransferSpeedLabel" FontSize="{StaticResource Workspace.Text.Caption}" FontFamily="{DynamicResource Workspace.Font.UI}" FontFeatures="tnum" Text="↓ 0 B/s ↑ 0 B/s" />
                                </StackPanel>
                                <controls:IoGraph x:Name="TransferDiskGraph" Grid.Row="1" Source="DiskIo" Width="128" MinWidth="120" Height="15" HistoryWindowSeconds="60" VerticalAlignment="Center" IsHitTestVisible="False"
                                                  Stroke="{DynamicResource Workspace.Stats.Disk}" SecondaryStroke="{DynamicResource Workspace.Stats.Disk}" Fill="{DynamicResource Workspace.Stats.DiskSurface}" />
                                <StackPanel x:Name="TransferDiskText" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" MinWidth="232">
                                    <TextBlock x:Name="TransferDiskTitle" Classes="muted" FontSize="{StaticResource Workspace.Text.Caption}" FontFamily="{DynamicResource Workspace.Font.UI}" Text="Disk" />
                                    <TextBlock x:Name="TransferDiskLabel" FontSize="{StaticResource Workspace.Text.Caption}" FontFamily="{DynamicResource Workspace.Font.UI}" FontFeatures="tnum" Text="R 0 B/s W 0 B/s" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button x:Name="ContinueReadingButton" Classes="subtle header-icon" IsVisible="False" />
                        <Button x:Name="PauseButton" Classes="subtle header-icon" Click="OnPauseClick">
                            <Path x:Name="PauseIcon" Classes="header-icon" Data="M 5,3 L 5,13 M 11,3 L 11,13" />
                        </Button>
                        <Button x:Name="FullscreenButton" Classes="subtle header-icon" />
                        <Button x:Name="ThemeToggleButton" Classes="subtle header-icon">
                            <Path x:Name="ThemeToggleIcon" Classes="header-icon" />
                        </Button>
                    </StackPanel>
                    <Menu Grid.Column="3" VerticalAlignment="Center">
                        <!-- The "more" icon is the header, set in code (WorkspaceIcons); the name and tooltip come from the command adapter. -->
                        <MenuItem x:Name="WorkspaceMenuItem">
                            <!-- Group 1: every main page, in footer order (Downloads, Archive, Media | Rules, Sources, Plugins | Diagnostics, Statistics). -->
                            <MenuItem x:Name="DownloadsMenuItem" Tag="nav.downloads" Classes="localized" Header="Downloads" Click="OnDownloadsNavigationClick" />
                            <MenuItem x:Name="ArchiveMenuItem" Tag="nav.archive" Classes="localized" Header="Archive" Click="OnArchiveNavigationClick" />
                            <MenuItem x:Name="MediaMenuItem" Tag="nav.media" Classes="localized" Header="Media" Click="OnMediaNavigationClick" />
                            <Separator x:Name="PagesGroupSeparatorWork" />
                            <MenuItem x:Name="RulesMenuItem" Tag="nav.rules" Classes="localized" Header="Rules" Click="OnRulesNavigationClick" />
                            <MenuItem x:Name="SourcesMenuItem" Tag="nav.sources" Classes="localized" Header="Sources" Click="OnSourcesNavigationClick" />
                            <MenuItem x:Name="PluginsMenuItem" Tag="nav.plugins" Classes="localized" Header="Plugins" Click="OnPluginsNavigationClick" />
                            <Separator x:Name="PagesGroupSeparatorSetUp" />
                            <MenuItem x:Name="DiagnosticsMenuItem" Tag="nav.diagnostics" Classes="localized" Header="Diagnostics" Click="OnDiagnosticsNavigationClick" />
                            <MenuItem x:Name="StatisticsMenuItem" Tag="nav.statistics" Classes="localized" Header="Statistics" Click="OnStatisticsNavigationClick" />
                            <Separator x:Name="MenuPagesToolsSeparator" />
                            <!-- Group 2: tools. Continue reading, post bookmarks and Danbooru insert themselves after this anchor. -->
                            <MenuItem x:Name="ManualImportMenuItem" Tag="import.menu" Classes="localized" Header="Import files…" Click="OnManualImportMenuClick" />
                            <!-- URSA-12 shared shell hunk: group manager entry in every workspace mode. -->
                            <MenuItem x:Name="ReaderGroupsMenuItem" Header="Reader groups" />
                            <Separator x:Name="MenuToolsAppSeparator" />
                            <!-- Group 3: the application. The update check inserts itself in front of About. -->
                            <MenuItem x:Name="PauseMenuItem" Header="Pause downloads" Click="OnPauseClick" />
                            <MenuItem x:Name="SettingsMenuItem" Tag="nav.settings" Classes="localized" Header="Settings" />
                            <MenuItem x:Name="ShortcutHelpMenuItem" Header="Keyboard shortcuts" />
                            <MenuItem x:Name="AboutMenuItem" Tag="nav.about" Classes="localized" Header="About" />
                            <Separator />
                            <MenuItem x:Name="ExitMenuItem" Tag="action.exit" Classes="localized" Header="Exit" />
                        </MenuItem>
                    </Menu>
                </Grid>
                <StackPanel x:Name="WindowCaptionButtons" Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="WindowMinimizeButton" Classes="window-caption" Click="OnWindowMinimizeClick"
                            WindowDecorationProperties.ElementRole="MinimizeButton">
                        <Path Data="M 0,5 L 10,5" Classes="window-caption-icon" />
                    </Button>
                    <Button x:Name="WindowMaximizeButton" Classes="window-caption" Click="OnWindowMaximizeClick"
                            WindowDecorationProperties.ElementRole="MaximizeButton">
                        <Path x:Name="WindowMaximizeIcon" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Classes="window-caption-icon" />
                    </Button>
                    <Button x:Name="WindowCloseButton" Classes="window-caption window-close" Click="OnWindowCloseClick"
                            WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Classes="window-caption-icon" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="WorkspacePages" Grid.Row="1" RowDefinitions="Auto,Auto,*">
        <controls:WorkspaceBanner Grid.Row="0" x:Name="ShellActionErrorBanner" Type="Error" IsVisible="False" Margin="12,8,12,0">
            <Grid ColumnDefinitions="*,Auto">
                <Grid x:Name="ShellFeedbackLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                    <ScrollViewer x:Name="ShellActionErrorScroll" Grid.ColumnSpan="2" MaxHeight="64" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ShellActionError" TextWrapping="Wrap" /></ScrollViewer>
                    <Button x:Name="ShellFeedbackDiagnosticsButton" Grid.Row="1" Click="OnDiagnosticsNavigationClick" HorizontalAlignment="Left"><TextBlock Tag="feedback.open" Classes="localized" /></Button>
                </Grid>
                <Button x:Name="ShellFeedbackDismissButton" Grid.Column="1" Classes="subtle icon-square"
                        Margin="8,0,0,0" VerticalAlignment="Top"
                        AutomationProperties.Name="{Binding #ShellFeedbackDismissLabel.Text}"
                        ToolTip.Tip="{Binding #ShellFeedbackDismissLabel.Text}">
                    <Grid>
                        <Path x:Name="ShellFeedbackDismissIcon" Classes="glyph-icon" />
                        <!-- The normal workspace localizer also refreshes this accessible-only label. -->
                        <TextBlock x:Name="ShellFeedbackDismissLabel" Tag="feedback.dismiss" Classes="localized" IsVisible="False" />
                    </Grid>
                </Button>
            </Grid>
        </controls:WorkspaceBanner>
        <Border x:Name="ClipboardSuggestionPanel" Grid.Row="1" IsVisible="False" Classes="panel" Margin="12,8,12,0" Padding="12,8"
                KeyDown="OnClipboardSuggestionKeyDown">
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                <TextBlock x:Name="ClipboardSuggestionTitle" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button x:Name="ClipboardSuggestionAccept" Grid.Column="1" Classes="primary" Click="OnClipboardSuggestionAccept" />
                <Button x:Name="ClipboardSuggestionDismiss" Grid.Column="2" Click="OnClipboardSuggestionDismiss" />
                <TextBox x:Name="ClipboardSuggestionUrls" Grid.Row="1" Grid.ColumnSpan="3" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" MaxHeight="80" AutomationProperties.LabeledBy="{Binding ElementName=ClipboardSuggestionTitle}" />
                <TextBlock x:Name="ClipboardSuggestionNotice" Grid.Row="2" Grid.ColumnSpan="3" Classes="muted" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" x:Name="WorkspaceBody" RowDefinitions="Auto,Auto,*" Margin="{StaticResource Workspace.Inset.Page}" RowSpacing="8">
            <Grid x:Name="WorkspaceHeading">
                <TextBlock Tag="downloads.title" Classes="localized page-title" Text="Downloads" />
            </Grid>
            <ScrollViewer x:Name="WorkspaceIntakeScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="WorkspaceIntakeCard" Classes="panel" Padding="12">
                <StackPanel x:Name="WorkspaceIntakeStack" Spacing="8">
                    <!-- Display-only last session: rows below come from a disposable cache, not from the session. -->
                    <Border x:Name="StartupPreviewPanel" Classes="panel" Padding="10,6" IsVisible="False">
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="StartupPreviewTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="StartupPreviewDetails" Classes="workspace-meta" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="UrlInput" PlaceholderText="Paste thread or board URLs" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MinHeight="{StaticResource Workspace.Size.InputProminent}" MaxHeight="72" VerticalContentAlignment="Center" />
                        <Button x:Name="AddUrlButton" Grid.Column="1" Classes="primary localized" Tag="action.add" Content="Add"
                                MinWidth="100" MinHeight="{StaticResource Workspace.Size.InputProminent}" VerticalAlignment="Stretch" Click="OnAddUrl" />
                    </Grid>
                    <TextBlock x:Name="UrlInputHint" Tag="downloads.inputHint" Classes="localized workspace-help" TextWrapping="Wrap" />
                    <controls:WorkspaceBanner x:Name="AdmissionRepairPanel" IsVisible="False" Type="Error">
                        <ScrollViewer x:Name="AdmissionRepairScroll" MaxHeight="84" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock x:Name="AdmissionRepairText" TextWrapping="Wrap" FontSize="{StaticResource Workspace.Text.Meta}" /></ScrollViewer>
                    </controls:WorkspaceBanner>
                    <Border x:Name="AdmissionResultsPanel" IsVisible="False">
                        <Expander x:Name="AdmissionResultsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <Expander.Header><TextBlock x:Name="AdmissionResultsTitle" Text="URL results" /></Expander.Header>
                            <ScrollViewer x:Name="AdmissionResultsScroll" MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AdmissionResultRows" Spacing="6" Margin="0,6,0,0" />
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>
            </ScrollViewer>
            <Grid x:Name="WorkspaceContentGrid" Grid.Row="2" ColumnDefinitions="*,6,320" RowDefinitions="*,0">
                <Border x:Name="DownloadsPanel" Classes="panel" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*">
                        <TabControl x:Name="DownloadsTabs" MinHeight="38" Padding="0" SelectionChanged="OnWorkspaceTabChanged">
                            <TabControl.Styles>
                                <Style Selector="TabItem"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Meta}" /></Style>
                            </TabControl.Styles>
                            <TabItem x:Name="ThreadsTab" Header="Threads" />
                            <TabItem x:Name="BoardsTab" Header="Boards" />
                        </TabControl>
                                <Grid x:Name="ThreadsResultPanel" Grid.Row="2" Grid.ColumnSpan="2">
<DataGrid x:Name="ThreadsDataGrid"
                              ItemsSource="{Binding VisibleThreads}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" CanUserReorderColumns="True" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              DoubleTapped="OnThreadDoubleTapped"
                              CanUserResizeColumns="True" SelectionChanged="OnWorkspaceSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Source / board" Width="130" SortMemberPath="SourceBoard">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HostName}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding BoardLabel}" VerticalAlignment="Center" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BoardName}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <!-- Thread ID Column -->
                            <DataGridTemplateColumn Header="Thread ID" Width="105" SortMemberPath="ThreadNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding ThreadId}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title Column -->
                            <DataGridTemplateColumn Header="Thread / title" Width="*" MinWidth="200" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <!-- A drawn up arrow (P6), not the "↑" glyph; the border carries the tooltip and the accessible name. -->
                                                <Border Background="Transparent" IsVisible="{Binding IsHighPriority}" VerticalAlignment="Center" ToolTip.Tip="{Binding PriorityDescription}" AutomationProperties.Name="{Binding PriorityDescription}">
                                                    <Path Classes="glyph-icon" Data="M8,13 L8,3 M4,7 L8,3 L12,7" Stroke="{DynamicResource Workspace.Text}" />
                                                </Border>
                                                <TextBlock Text="{Binding ThreadId, StringFormat='#{0}'}" VerticalAlignment="Center" Classes="muted inline-thread-id" FontSize="{StaticResource Workspace.Text.Meta}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Status" Width="160" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Progress Column -->
                            <DataGridTemplateColumn Header="Media / transfer" Width="300" MinWidth="200" SortMemberPath="Completion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <StackPanel VerticalAlignment="Center" Spacing="0" ToolTip.Tip="{Binding CompactDetails}" AutomationProperties.Name="{Binding CompactDetails}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding CompactStatus}" IsVisible="{Binding ShowCompactStatus}" VerticalAlignment="Center" FontSize="{StaticResource Workspace.Text.Meta}" Classes="muted compact-work-status" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding CompactStatus}" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTip.Tip="{Binding Progress}" AutomationProperties.Name="{Binding SavedProgress}">
                                                    <TextBlock Text="{Binding CompletedMedia}" Classes="mono" FontSize="{StaticResource Workspace.Text.Meta}" />
                                                    <TextBlock Text="/" Classes="muted mono" FontSize="{StaticResource Workspace.Text.Meta}" />
                                                    <TextBlock Text="{Binding SelectedMedia}" Classes="mono" FontSize="{StaticResource Workspace.Text.Meta}" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar AutomationProperties.Name="{Binding Progress}" Value="{Binding Completion}" Minimum="0" Maximum="100" Height="4" MinHeight="0" MaxHeight="4" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Queued" Width="85" SortMemberPath="Queued">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Queued}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active" Width="95" SortMemberPath="Active">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Active}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Missing / errors" Width="190" SortMemberPath="MissingMedia" Binding="{Binding MissingMediaText, DataType=desktop:ThreadRow}" IsVisible="False" />
                            <DataGridTextColumn Header="Earliest retry" Width="160" SortMemberPath="EarliestRetry" Binding="{Binding EarliestRetryText, DataType=desktop:ThreadRow}" IsVisible="False" />
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu><ContextMenu /></DataGrid.ContextMenu>
                    </DataGrid>
                                    <!-- The text never takes input; only the next-step button below it does. -->
                                    <controls:WorkspaceEmptyState x:Name="ThreadsEmptyPanel">
                                        <TextBlock x:Name="ThreadsEmptyState" Tag="downloads.empty" Classes="localized workspace-empty-text"
                                                   IsHitTestVisible="False" />
                                        <Button x:Name="ThreadsEmptyImportButton" Classes="primary" HorizontalAlignment="Center"
                                                Click="OnEmptyStateImportClick" />
                                    </controls:WorkspaceEmptyState>
                                </Grid>
                                <Grid x:Name="BoardsResultPanel" Grid.Row="2" Grid.ColumnSpan="2" IsVisible="False">
<DataGrid x:Name="BoardsDataGrid"
                              ItemsSource="{Binding VisibleBoards}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserReorderColumns="True"
                              GridLinesVisibility="Horizontal"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              DoubleTapped="OnBoardDoubleTapped"
                              CanUserResizeColumns="True" SelectionChanged="OnWorkspaceSelectionChanged">
                        <DataGrid.Columns>
                            <!-- Board URL Column -->
                            <DataGridTemplateColumn Header="Source" Width="100" SortMemberPath="HostName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding HostName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Board" Width="200" SortMemberPath="NiceName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding NiceName}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding NiceName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ErrorDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu><ContextMenu /></DataGrid.ContextMenu>
                    </DataGrid>
                                    <!-- Same next step as the Threads state: the URL on the clipboard is imported (a board URL discovers its threads). -->
                                    <controls:WorkspaceEmptyState x:Name="BoardsEmptyPanel">
                                        <TextBlock x:Name="BoardsEmptyState" Tag="downloads.boardsEmpty" Classes="localized workspace-empty-text"
                                                   IsHitTestVisible="False" />
                                        <Button x:Name="BoardsEmptyImportButton" Classes="primary" HorizontalAlignment="Center"
                                                Click="OnEmptyStateImportClick" />
                                    </controls:WorkspaceEmptyState>
                                </Grid>
                        <desktop:ActionToolBar x:Name="WorkspaceListActions" Grid.Column="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0">
                            <Button x:Name="DownloadSearchButton" Classes="localized subtle" Tag="downloads.search" Click="OnDownloadSearchClick" ursa:ToolBar.OverflowMode="Never" FontSize="{StaticResource Workspace.Text.Meta}" />
                            <Button x:Name="DownloadsColumnsButton" Classes="subtle" Content="Columns" ursa:ToolBar.OverflowMode="AsNeeded" FontSize="{StaticResource Workspace.Text.Meta}" />
                            <Button x:Name="CopyAllUrlsButton" Tag="action.copyAllUrls" Classes="localized subtle" Content="Copy URLs" ursa:ToolBar.OverflowMode="AsNeeded" FontSize="{StaticResource Workspace.Text.Meta}" />
                            <Button x:Name="DetailsToggleButton" Classes="subtle" Content="Details" Click="OnDetailsToggleClick" ursa:ToolBar.OverflowMode="Never" FontSize="{StaticResource Workspace.Text.Meta}" />
                        </desktop:ActionToolBar>
                        <Grid x:Name="DownloadSearchBar" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="8,2,8,6" IsVisible="False">
                            <controls:SearchBox x:Name="DownloadSearchInput" MinWidth="100" TextChanged="OnDownloadSearchChanged" />
                            <TextBlock x:Name="DownloadSearchSummary" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <Button x:Name="DownloadSearchClear" Grid.Column="2" Classes="localized subtle" Tag="downloads.searchClear" Click="OnDownloadSearchClear" />
                            <Button x:Name="DownloadSearchClose" Grid.Column="3" Classes="localized subtle" Tag="downloads.searchClose" Click="OnDownloadSearchClose" />
                        </Grid>
                    </Grid>
                </Border>
                <GridSplitter x:Name="WorkspaceInspectorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" Background="Transparent" />
                <Border x:Name="WorkspaceInspector" Grid.Column="2" Classes="panel" MinWidth="260">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Margin="16,10,10,8" ColumnDefinitions="*,Auto">
                            <TextBlock Tag="detail.title" Classes="localized section-title" Text="Details" VerticalAlignment="Center" />
                            <Button x:Name="InspectorCloseButton" Grid.Column="1" Classes="subtle icon-square" Click="OnDetailsToggleClick" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,2,16,16" Spacing="12">
                                <TextBlock x:Name="InspectorEmptyState" Tag="detail.empty" Classes="localized muted" TextWrapping="Wrap" />
                                <StackPanel x:Name="InspectorSelection" Classes="workspace-section-body" IsVisible="False">
                                    <StackPanel Spacing="5">
                                        <TextBlock x:Name="InspectorKind" Classes="muted" FontSize="{StaticResource Workspace.Text.Meta}" />
                                        <SelectableTextBlock x:Name="InspectorTitle" Classes="card-title" TextWrapping="Wrap" />
                                        <SelectableTextBlock x:Name="InspectorSource" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Classes="workspace-field">
                                        <TextBlock Tag="detail.status" Classes="localized workspace-meta" />
                                        <SelectableTextBlock x:Name="InspectorStatus" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="InspectorErrorSection" Spacing="8">
                                        <TextBlock Tag="detail.error" Classes="localized muted" FontSize="{StaticResource Workspace.Text.Meta}" />
                                        <SelectableTextBlock x:Name="InspectorError" Classes="workspace-error" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <SelectableTextBlock x:Name="InspectorContext" Classes="workspace-warning" TextWrapping="Wrap" IsVisible="False" />
                                    <TextBlock x:Name="InspectorNextStep" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
                                    <WrapPanel Classes="workspace-toolbar" Orientation="Horizontal">
                                        <Button x:Name="InspectorCheckButton" Tag="check.action" Classes="localized subtle" Content="Check now / retry missing" Click="OnCheckSelectionClick" />
                                        <Button x:Name="InspectorMediaRetryButton" Tag="work.retry" Classes="localized subtle" Content="Retry missing media" Click="OnRetryMissingMediaClick" />
                                    </WrapPanel>
                                    <StackPanel Spacing="8">
                                        <WrapPanel x:Name="InspectorLocalActions" Classes="workspace-toolbar" Orientation="Horizontal" IsVisible="False">
                                            <Button x:Name="InspectorReadPosts" Classes="ghost" Click="OnInspectorReadPosts" />
                                            <Button x:Name="InspectorGallery" Classes="ghost" Click="OnInspectorGallery" />
                                            <Button x:Name="InspectorHtmlExport" Classes="ghost" Click="OnInspectorHtmlExport" />
                                        </WrapPanel>
                                        <WrapPanel Classes="workspace-toolbar" Orientation="Horizontal">
                                            <Button x:Name="InspectorOpenFolderButton" Tag="action.openFolder" Classes="localized ghost" Content="Open folder" Click="OnInspectorOpenFolderClick" />
                                            <Button x:Name="InspectorOpenBrowserButton" Tag="action.openBrowser" Classes="localized ghost" Content="Open in browser" Click="OnInspectorOpenBrowserClick" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel x:Name="InspectorMediaSection" Classes="workspace-section-header">
                                        <TextBlock Tag="detail.progress" Classes="localized muted" FontSize="{StaticResource Workspace.Text.Meta}" />
                                        <SelectableTextBlock x:Name="InspectorProgress" FontWeight="Medium" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InspectorKnownMedia" Classes="muted" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="InspectorProgressBar" Minimum="0" Maximum="100" Height="4" MinHeight="0" MaxHeight="4" />
                                        <TextBlock x:Name="InspectorQueue" Classes="muted" />
                                    </StackPanel>
                                    <Expander x:Name="InspectorSourceDetails">
                                        <Expander.Header><TextBlock Tag="detail.source" Classes="localized" /></Expander.Header>
                                        <StackPanel Spacing="12">
                                            <StackPanel Spacing="4">
                                                <TextBlock Tag="detail.url" Classes="localized workspace-meta" />
                                                <SelectableTextBlock x:Name="InspectorUrl" TextWrapping="Wrap" FontSize="{StaticResource Workspace.Text.Meta}" />
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Tag="detail.directory" Classes="localized workspace-meta" />
                                                <SelectableTextBlock x:Name="InspectorDirectory" TextWrapping="Wrap" FontSize="{StaticResource Workspace.Text.Meta}" />
                                            </StackPanel>
                                            <Button x:Name="InspectorCopyUrlButton" Tag="action.copyUrl" Classes="localized subtle" Content="Copy URL" />
                                        </StackPanel>
                                    </Expander>

                                    <Border BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <StackPanel Spacing="8">
                                            <Button x:Name="InspectorRemoveButton" Tag="action.remove" Classes="localized subtle danger" Content="Remove" Click="OnInspectorRemoveClick" />
                                            <TextBlock x:Name="InspectorRemoveHint" Classes="workspace-meta" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <ContentControl Grid.Row="2" x:Name="SettingsPageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="DiagnosticsPageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="RulesPageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="ArchivePageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="MediaPageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="SourcesPageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="PluginsPageHost" IsVisible="False" />
        <ContentControl Grid.Row="2" x:Name="StatisticsPageHost" IsVisible="False" />
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceStatus" Classes="muted" FontSize="{StaticResource Workspace.Text.Meta}" TextTrimming="CharacterEllipsis" />
                <!-- Warns from 75 percent of the favorites, thread favorites and ratings limits and names the setting. -->
                <TextBlock x:Name="WorkspaceStoreWarning" Grid.Column="1" IsVisible="False" MaxWidth="560" FontSize="{StaticResource Workspace.Text.Meta}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Workspace.Warning}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Name="WorkspaceCounts" Grid.Column="2" Classes="muted tnum" FontSize="{StaticResource Workspace.Text.Meta}" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border x:Name="WorkspaceNavigation" Grid.Row="3" Classes="shell-bar" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel x:Name="WorkspaceNavigationButtons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                <Button x:Name="DownloadsNavigationButton" Classes="nav selected" Click="OnDownloadsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 9,1 L 9,12 M 5,8 L 9,12 L 13,8 M 2,13 L 2,17 L 16,17 L 16,13" Width="17" Height="17" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.downloads" Classes="localized" Text="Downloads" />
                    </StackPanel>
                </Button>
                <Button x:Name="ArchiveNavigationButton" Classes="nav localized" Tag="nav.archive" Content="Archive" Click="OnArchiveNavigationClick" />
                <Button x:Name="MediaNavigationButton" Classes="nav localized" Tag="nav.media" Content="Media" Click="OnMediaNavigationClick" />
                <!-- Footer groups: Downloads, Archive, Media | Rules, Sources, Plugins | Diagnostics, Statistics | More, Settings.
                     UpdatePageNavigation shows a separator only between two groups that both have a visible button. -->
                <Border x:Name="FooterSeparatorWork" Classes="nav-separator" Width="1" Height="18" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" AutomationProperties.AccessibilityView="Raw" />
                <Button x:Name="RulesNavigationButton" Classes="nav localized" Tag="nav.rules" Content="Rules" Click="OnRulesNavigationClick" />
                <Button x:Name="SourcesNavigationButton" Classes="nav localized" Tag="nav.sources" Content="Sources" Click="OnSourcesNavigationClick" />
                <Button x:Name="PluginsNavigationButton" Classes="nav" Content="Plugins" Click="OnPluginsNavigationClick" />
                <Border x:Name="FooterSeparatorSetUp" Classes="nav-separator" Width="1" Height="18" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" AutomationProperties.AccessibilityView="Raw" />
                <Button x:Name="DiagnosticsNavigationButton" Classes="nav" Click="OnDiagnosticsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 1,10 L 4,10 L 7,3 L 10,16 L 13,10 L 17,10" Width="17" Height="17" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.diagnostics" Classes="localized" Text="Diagnostics" />
                    </StackPanel>
                </Button>
                <Button x:Name="StatisticsNavigationButton" Classes="nav localized" Tag="nav.statistics" Content="Statistics" Click="OnStatisticsNavigationClick" />
                <Border x:Name="FooterSeparatorObserve" Classes="nav-separator" Width="1" Height="18" Margin="4,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False" AutomationProperties.AccessibilityView="Raw" />
                <Button x:Name="ToolsNavigationButton" Classes="nav localized" Tag="nav.tools" Content="More">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Tag="nav.archive" Classes="localized" Header="Archive" Click="OnArchiveNavigationClick" />
                            <MenuItem Tag="nav.media" Classes="localized" Header="Media" Click="OnMediaNavigationClick" />
                            <Separator Tag="nav.group-separator.0" />
                            <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" Click="OnRulesNavigationClick" />
                            <MenuItem Tag="nav.sources" Classes="localized" Header="Sources" Click="OnSourcesNavigationClick" />
                            <MenuItem Tag="nav.plugins" Classes="localized" Header="Plugins" Click="OnPluginsNavigationClick" />
                            <Separator Tag="nav.group-separator.1" />
                            <MenuItem Tag="nav.diagnostics" Classes="localized" Header="Diagnostics" Click="OnDiagnosticsNavigationClick" />
                            <MenuItem Tag="nav.statistics" Classes="localized" Header="Statistics" Click="OnStatisticsNavigationClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SettingsNavigationButton" Classes="nav" Click="OnSettingsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 2,4 L 16,4 M 2,9 L 16,9 M 2,14 L 16,14 M 5,2 L 5,6 M 11,7 L 11,11 M 7,12 L 7,16" Width="17" Height="17" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.settings" Classes="localized" Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ComboBox x:Name="WorkspaceModeComboBox" Grid.Column="1" Classes="footer-mode" Width="140" VerticalAlignment="Center">
                <ComboBoxItem x:Name="BarebonesModeItem" Tag="Barebones" Content="Barebones" />
                <ComboBoxItem x:Name="SimpleModeItem" Tag="Simple" Content="Simple" />
                <ComboBoxItem x:Name="AdvancedModeItem" Tag="Advanced" Content="Advanced" />
            </ComboBox>
            </Grid>
        </Border>
        <ContentControl x:Name="ReaderHost" Grid.Row="1" Grid.RowSpan="3" IsVisible="False" Background="{DynamicResource Workspace.Background}" />
        <ContentControl x:Name="GalleryHost" Grid.Row="1" Grid.RowSpan="3" IsVisible="False" />
        <!-- Drop feedback only (MainWindow.DragDrop.cs). It is not hit-testable, so the control below
             stays the drop target and the routed drag events still bubble to WorkspaceRoot. -->
        <Grid x:Name="DropOverlay" Grid.RowSpan="4" ZIndex="150" IsVisible="False" IsHitTestVisible="False">
            <Border Background="{DynamicResource Workspace.Background}" Opacity="0.82" />
            <Border x:Name="DropOverlayCard" Classes="panel" BorderThickness="2" BorderBrush="{DynamicResource Workspace.Accent}"
                    Padding="28,22" Margin="20" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="DropOverlayTitle" Classes="section-title" TextWrapping="Wrap" TextAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" />
                    <TextBlock x:Name="DropOverlayDetail" Classes="muted" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="ShellHelpOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="200"
                Classes="panel" Margin="20" MaxWidth="620"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock x:Name="ShellHelpTitle" Classes="section-title" Margin="16,16,16,12" />
                <ScrollViewer Grid.Row="1" Margin="16,0,16,16" Classes="InsetContent"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="ShellHelpText" TextWrapping="Wrap" LineHeight="22" />
                </ScrollViewer>
                <Border Grid.Row="2" Classes="workspace-dialog-footer">
                    <Button x:Name="ShellHelpClose" HorizontalAlignment="Right" MinWidth="96" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
