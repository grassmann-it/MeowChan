<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop"
             xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:feedback="clr-namespace:MeowChan.Desktop.Feedback"
             xmlns:wv="using:MeowChan.Desktop.WorkViews"
             x:Class="MeowChan.DiagnosticsPage" SizeChanged="OnDiagnosticPageSizeChanged">
    <UserControl.Styles>
        <Style Selector="DataGridCell TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style Selector="DataGridColumnHeader TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    </UserControl.Styles>
    <!-- Hosted by the Status page: no page header, hint or summary of its own (the Status head carries them). The page inset is
         the one the Status head and segment bar use, so the sides line up at 12 dip, not 24. -->
    <Grid Margin="{StaticResource Workspace.Inset.Page}" RowDefinitions="*,Auto" RowSpacing="{StaticResource Workspace.Space.8}">
        <!-- Keep page content scrollable at the shell minimum, including with a retained error banner. The Status page above
             already carries the title, the hint and the counts, so the segment starts with its filters. The fixed action row
             below owns the remaining space; the scroll content must not claim that same viewport a second time. -->
        <ScrollViewer x:Name="DiagnosticsContentScroll" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnDiagnosticScrollSizeChanged">
            <Grid x:Name="DiagnosticsContentRoot" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="{StaticResource Workspace.Space.8}">
                <!-- Work views: Barebones starts with the filters closed (an active filter opens them, R6); the data and the default values are the same in every view. -->
                <Expander x:Name="DiagnosticFiltersSection" wv:WorkViewElement.Id="diagnostics.filters" IsExpanded="True"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <WrapPanel Classes="workspace-toolbar">
                        <ComboBox x:Name="DiagnosticSourceFilter" Width="200" SelectionChanged="OnDiagnosticFilterChanged" />
                        <controls:SearchBox x:Name="DiagnosticTextFilter" Width="200" TextChanged="OnDiagnosticFilterChanged" />
                        <CheckBox x:Name="DiagnosticProblemsOnly" IsCheckedChanged="OnDiagnosticFilterChanged" />
                        <CheckBox x:Name="DiagnosticIncludeWaiting" IsChecked="False"
                                  IsCheckedChanged="OnDiagnosticFilterChanged">
                            <TextBlock Tag="diagnostics.includeWaiting" Classes="localized" TextWrapping="NoWrap" />
                        </CheckBox>
                        <Button x:Name="DiagnosticClearFilters" IsEnabled="False" Click="OnClearDiagnosticFilters" />
                    </WrapPanel>
                </Expander>
                <!-- Only while a filter is set or rows are selected: "a / b entries · c selected". -->
                <TextBlock x:Name="DiagnosticFilterSummary" wv:WorkViewElement.Id="diagnostics.filter-summary" Grid.Row="1" Classes="workspace-help" TextWrapping="Wrap"
                           IsVisible="False" AutomationProperties.LiveSetting="Polite" />
                <Grid x:Name="DiagnosticSplit" Grid.Row="2" ColumnDefinitions="*,0" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource Workspace.Space.12}">
                    <Border x:Name="DiagnosticListPane" wv:WorkViewElement.Id="diagnostics.table" Classes="workspace-section-flush">
                        <!-- The platform facts live in their own group below, so this table holds requests and problems only and
                             its "nothing to show" text can sit over the empty grid. -->
                        <Grid>
                            <DataGrid x:Name="DiagnosticsGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120"
                                      GridLinesVisibility="None" SelectionMode="Extended" RowHeight="44"
                                      CanUserReorderColumns="False" SelectionChanged="OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn MinWidth="150" Width="150" Binding="{Binding Category, DataType=desktop:DiagnosticEntry}" />
                                    <DataGridTextColumn Width="180" Binding="{Binding Resource, DataType=desktop:DiagnosticEntry}" />
                                    <DataGridTextColumn MinWidth="180" Width="*" Binding="{Binding Summary, DataType=desktop:DiagnosticEntry}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="DiagnosticsEmpty" Classes="muted" Margin="12"
                                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <Border x:Name="DiagnosticDetailPane" wv:WorkViewElement.Id="diagnostics.details" Grid.Row="1" Classes="workspace-section">
                        <StackPanel Classes="workspace-section-header">
                            <TextBlock x:Name="DiagnosticSelectionHint" Classes="workspace-help" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DiagnosticSelectionTitle" Classes="section-title" TextWrapping="Wrap" IsVisible="False" />
                            <TextBlock x:Name="DiagnosticSelectionContext" Classes="workspace-meta" TextWrapping="Wrap" IsVisible="False" />
                            <TextBox x:Name="DiagnosticDetails" IsReadOnly="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="110" />
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- Facts about this machine (always the same few rows): a closed group with its count, not rows in the table. -->
                <Expander x:Name="DiagnosticPlatformSection" wv:WorkViewElement.Id="diagnostics.platform" Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <DataGrid x:Name="PlatformGrid" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="180"
                              SelectionMode="Single" GridLinesVisibility="None" CanUserReorderColumns="False"
                              SelectionChanged="OnPlatformSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" MinWidth="180" Binding="{Binding Summary, DataType=desktop:DiagnosticEntry}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                <Expander x:Name="SessionFeedbackSection" wv:WorkViewElement.Id="diagnostics.session-messages" Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                        <TextBlock x:Name="SessionFeedbackEmpty" Tag="feedback.empty" Classes="muted localized" TextWrapping="Wrap" />
                        <DataGrid x:Name="SessionFeedbackGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="160"
                                  SelectionMode="Single" GridLinesVisibility="None" SelectionChanged="OnFeedbackSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="130" Binding="{Binding TimeLabel, DataType=feedback:SessionFeedback}" />
                                <DataGridTextColumn Width="100" Binding="{Binding CategoryLabel, DataType=feedback:SessionFeedback}" />
                                <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Description, DataType=feedback:SessionFeedback}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox x:Name="SessionFeedbackDetails" IsReadOnly="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="90" />
                        <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}">
                            <Button x:Name="CopySessionFeedbackButton" Click="OnCopyFeedback" />
                            <Button x:Name="DismissSessionFeedbackButton" Click="OnDismissFeedback" />
                            <Button x:Name="ClearSessionFeedbackButton" Click="OnClearFeedback" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="{StaticResource Workspace.Space.8}">
            <ScrollViewer MaxHeight="64" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DiagnosticsActionError" wv:WorkViewElement.Id="diagnostics.error" Classes="workspace-error" TextWrapping="Wrap" VerticalAlignment="Center" />
            </ScrollViewer>
            <!-- Work views: the three error-path actions never move; "retry filtered" and "copy details" sit under More where the view says so.
                 The row keeps wrapping like before (no width-driven overflow); More lists exactly what the view moved. -->
            <WrapPanel Classes="workspace-toolbar">
                <Button x:Name="RetryDiagnosticButton" wv:WorkViewElement.Id="diagnostics.toolbar.check-now" Tag="check.action" Classes="localized" Click="OnRetryClick" ToolTip.ShowOnDisabled="True" />
                <Button x:Name="RetryDiagnosticSelectionButton" wv:WorkViewElement.Id="diagnostics.toolbar.retry-selection" Click="OnRetryDiagnosticSelection" />
                <Button x:Name="RetryDiagnosticFilteredButton" wv:WorkViewElement.Id="diagnostics.toolbar.retry-filtered" Click="OnRetryDiagnosticFiltered" />
                <Button x:Name="CopyDiagnosticButton" wv:WorkViewElement.Id="diagnostics.toolbar.copy" Tag="diagnostics.copy" Classes="localized" Click="OnCopyClick" />
                <Button x:Name="OpenDiagnosticWatchButton" wv:WorkViewElement.Id="diagnostics.toolbar.show-in-downloads" Tag="diagnostics.openWatch" Classes="localized" Click="OnOpenWatchClick" ToolTip.ShowOnDisabled="True" />
                <Button x:Name="DiagnosticMoreButton" wv:WorkViewElement.Id="diagnostics.toolbar.more" IsVisible="False" Click="OnDiagnosticMoreClick" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
