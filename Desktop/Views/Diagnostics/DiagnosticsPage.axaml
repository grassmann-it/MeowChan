<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop"
             xmlns:feedback="clr-namespace:MeowChan.Desktop.Feedback"
             x:Class="MeowChan.DiagnosticsPage" SizeChanged="OnDiagnosticPageSizeChanged">
    <UserControl.Styles>
        <Style Selector="DataGridCell TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style Selector="DataGridColumnHeader TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    </UserControl.Styles>
    <Grid Margin="16" RowDefinitions="*,Auto" RowSpacing="8">
        <!-- Keep page content scrollable at the shell minimum, including with a retained error banner.
             The explicit grid height preserves its own bounded, virtualized row viewport. -->
        <ScrollViewer x:Name="DiagnosticsContentScroll" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <StackPanel Classes="workspace-section-header">
                    <TextBlock Tag="nav.diagnostics" Classes="page-title localized" Text="Diagnostics" />
                    <TextBlock Tag="diagnostics.hint" Classes="muted localized" TextWrapping="Wrap" />
                </StackPanel>
                <Border Classes="workspace-section" Padding="12,8">
                    <TextBlock x:Name="DiagnosticsSummary" TextWrapping="Wrap" />
                </Border>
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                    <ComboBox x:Name="DiagnosticSourceFilter" MinWidth="140" MaxWidth="230" SelectionChanged="OnDiagnosticFilterChanged" />
                    <TextBox x:Name="DiagnosticTextFilter" Width="210" TextChanged="OnDiagnosticFilterChanged" />
                    <CheckBox x:Name="DiagnosticProblemsOnly" IsCheckedChanged="OnDiagnosticFilterChanged" />
                    <Button x:Name="DiagnosticClearFilters" Click="OnClearDiagnosticFilters" />
                </WrapPanel>
                <TextBlock x:Name="DiagnosticFilterSummary" Classes="muted" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Tag="diagnostics.current" Classes="section-title localized" TextWrapping="Wrap" />
                <Grid x:Name="DiagnosticSplit" ColumnDefinitions="*,0" RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Border x:Name="DiagnosticListPane" Classes="panel">
                        <Grid>
                            <DataGrid x:Name="DiagnosticsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="200"
                                      GridLinesVisibility="None" SelectionMode="Extended" RowHeight="44"
                                      CanUserReorderColumns="False" SelectionChanged="OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn MinWidth="150" Width="150" Binding="{Binding Category, DataType=desktop:DiagnosticEntry}" />
                                    <DataGridTextColumn Width="180" Binding="{Binding Resource, DataType=desktop:DiagnosticEntry}" />
                                    <DataGridTextColumn MinWidth="180" Width="*" Binding="{Binding Summary, DataType=desktop:DiagnosticEntry}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="DiagnosticsEmpty" Tag="diagnostics.empty" Classes="muted localized"
                                       Margin="16,55,16,16" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border x:Name="DiagnosticDetailPane" Grid.Row="1" Classes="workspace-section">
                        <StackPanel Classes="workspace-section-header">
                            <TextBlock x:Name="DiagnosticSelectionHint" Classes="workspace-help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="DiagnosticSelectionTitle" Classes="section-title" TextWrapping="Wrap" IsVisible="False" />
                            <TextBlock x:Name="DiagnosticSelectionContext" Classes="workspace-meta" TextWrapping="Wrap" IsVisible="False" />
                            <TextBox x:Name="DiagnosticDetails" IsReadOnly="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="110" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Expander x:Name="SessionFeedbackSection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="SessionFeedbackEmpty" Tag="feedback.empty" Classes="muted localized" TextWrapping="Wrap" />
                        <DataGrid x:Name="SessionFeedbackGrid" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="80" MaxHeight="160"
                                  SelectionMode="Single" GridLinesVisibility="None" SelectionChanged="OnFeedbackSelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="130" Binding="{Binding TimeLabel, DataType=feedback:SessionFeedback}" />
                                <DataGridTextColumn Width="100" Binding="{Binding CategoryLabel, DataType=feedback:SessionFeedback}" />
                                <DataGridTextColumn Width="*" MinWidth="160" Binding="{Binding Description, DataType=feedback:SessionFeedback}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBox x:Name="SessionFeedbackDetails" IsReadOnly="True" TextWrapping="Wrap" MinHeight="36" MaxHeight="90" />
                        <WrapPanel ItemSpacing="8" LineSpacing="6">
                            <Button x:Name="CopySessionFeedbackButton" Tag="feedback.copy" Classes="localized" Click="OnCopyFeedback" />
                            <Button x:Name="ClearSessionFeedbackButton" Tag="feedback.clear" Classes="localized" Click="OnClearFeedback" />
                        </WrapPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Spacing="8">
            <ScrollViewer MaxHeight="64" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="DiagnosticsActionError" Classes="error workspace-error" TextWrapping="Wrap" VerticalAlignment="Center" />
            </ScrollViewer>
            <WrapPanel Classes="workspace-toolbar">
                <Button x:Name="RetryDiagnosticButton" Tag="check.action" Classes="localized" Click="OnRetryClick" />
                <Button x:Name="RetryDiagnosticSelectionButton" Click="OnRetryDiagnosticSelection" />
                <Button x:Name="RetryDiagnosticFilteredButton" Click="OnRetryDiagnosticFiltered" />
                <Button x:Name="CopyDiagnosticButton" Tag="diagnostics.copy" Classes="localized" Click="OnCopyClick" />
                <Button x:Name="OpenDiagnosticWatchButton" Tag="diagnostics.openWatch" Classes="localized" Click="OnOpenWatchClick" />
                <Button x:Name="ManageMediaRatingsButton" Click="OnManageMediaRatingsClick" />
            </WrapPanel>
        </StackPanel>
    </Grid>
</UserControl>
