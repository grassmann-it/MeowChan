<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:ursa="https://irihi.tech/ursa" xmlns:local="clr-namespace:MeowChan" xmlns:plugins="using:MeowChan.Desktop.Plugins"
             xmlns:wv="using:MeowChan.Desktop.WorkViews"
             x:Class="MeowChan.SourcesPage" SizeChanged="OnPageSizeChanged">
    <local:PluginsPage x:Name="SourcePluginManagement">
      <local:PluginsPage.SourceContent>
    <ScrollViewer x:Name="SourcesScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
            <Grid x:Name="SourcesSplit" ColumnDefinitions="280,*" ColumnSpacing="{StaticResource Workspace.Space.Card}">
              <StackPanel x:Name="SourcesListPane" Grid.Column="0" Spacing="{StaticResource Workspace.Space.Card}">
                <!-- No source at all: the one empty-state pattern, with the one next step (a source comes with a plugin). -->
                <controls:WorkspaceEmptyState x:Name="SourcesEmptyState" IsVisible="False">
                    <TextBlock x:Name="SourcesEmpty" Tag="sources.empty" Classes="workspace-empty-text localized" />
                    <Button x:Name="SourcesEmptyAdd" Classes="primary" HorizontalAlignment="Center" Click="OnSourcesEmptyAddClick" />
                </controls:WorkspaceEmptyState>
                <plugins:PluginSelectionList x:Name="SourceCards" Classes="workspace-card-list" SelectionChanged="OnSourceSelectionChanged" KeyDown="OnSourceListKeyDown">
                    <plugins:PluginSelectionList.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{StaticResource Workspace.Space.Card}" /></ItemsPanelTemplate></plugins:PluginSelectionList.ItemsPanel>
                </plugins:PluginSelectionList>
                <!-- Read-only media folders are no longer a section here (Settings › Storage and limits, 14.11.2026): one quiet pointer for people who look for them. -->
                <Button x:Name="SourcesMediaFoldersLink" Classes="subtle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" IsVisible="False" Click="OnMediaFoldersLinkClick">
                    <TextBlock Tag="sources.mediaFoldersLink" Classes="workspace-help localized" TextWrapping="Wrap" />
                </Button>
              </StackPanel>
              <Border x:Name="SourceDetailsPanel" Grid.Column="1" Classes="workspace-section">
                <StackPanel Spacing="{StaticResource Workspace.Space.12}">
                    <!-- The way back at the far left, then the heading (HeaderBar back slot, Tom's rule 14.11.). -->
                    <controls:HeaderBar>
                        <Button x:Name="SourceBackButton" controls:HeaderBar.IsBack="True" VerticalAlignment="Top" Click="OnBackClick" />
                        <TextBlock x:Name="SourceHeading" Classes="section-title" TextWrapping="Wrap" Focusable="True" />
                    </controls:HeaderBar>
                    <TextBlock x:Name="SourceMeta" Classes="workspace-meta" TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceExperimental" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
                    <StackPanel x:Name="SourceMediaIntegrityPanel" wv:WorkViewElement.Id="sources.detail.media-integrity" Spacing="{StaticResource Workspace.Space.8}" IsVisible="False">
                        <TextBlock x:Name="SourceMediaIntegrityExplanation" TextWrapping="Wrap" />
                        <CheckBox x:Name="SourceAllowProviderMismatch" Click="OnSourceMediaPermissionClick">
                            <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                                <TextBlock x:Name="SourceAllowProviderMismatchLabel" TextWrapping="Wrap" />
                                <TextBlock x:Name="SourceMediaIntegrityTiming" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </WrapPanel>
                        </CheckBox>
                        <TextBlock x:Name="SourceMediaIntegrityScope" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceMediaIntegrityStatus" Classes="workspace-help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="SourceMediaIntegrityRetryHint" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
                        <controls:WorkspaceBanner x:Name="SourceMediaIntegrityErrorBanner" Type="Error" IsVisible="False">
                            <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SourceMediaIntegrityError" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                            </ScrollViewer>
                        </controls:WorkspaceBanner>
                    </StackPanel>
                    <Button x:Name="SourceWebsiteButton" wv:WorkViewElement.Id="sources.detail.website" HorizontalAlignment="Left" Click="OnWebsiteClick" />
                    <!-- The capability cards fold in Barebones; whether capture works at all stays visible below them. -->
                    <Expander x:Name="CapabilitiesExpander" wv:WorkViewElement.Id="sources.detail.capabilities" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><TextBlock Tag="ud.sources.capabilities" Classes="section-title localized" TextWrapping="Wrap" /></Expander.Header>
                        <WrapPanel x:Name="CapabilityCards" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}" Margin="0,8,0,0" />
                    </Expander>
                    <TextBlock x:Name="SourceCaptureAvailability" Classes="workspace-help" TextWrapping="Wrap" />
                    <Expander x:Name="AdapterDetails" wv:WorkViewElement.Id="sources.detail.technical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{StaticResource Workspace.Space.8}" Margin="0,8,0,0">
                            <TextBlock x:Name="SourceIdentity" Classes="workspace-meta mono" TextWrapping="Wrap" />
                            <TextBlock x:Name="SourceHosts" Classes="workspace-help" TextWrapping="Wrap" />
                            <TextBlock x:Name="SourceVersion" Classes="workspace-help" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <WrapPanel Classes="workspace-toolbar">
                        <Button x:Name="SourceAddToDownloadsButton" wv:WorkViewElement.Id="sources.detail.add-downloads" Click="OnAddToDownloadsClick" />
                        <Button x:Name="SourceRulesButton" wv:WorkViewElement.Id="sources.detail.rules" Tag="sources.rules" Classes="localized" Click="OnRulesClick" />
                        <Button x:Name="SourceDiagnosticsButton" wv:WorkViewElement.Id="sources.detail.diagnostics" Tag="sources.diagnostics" Classes="localized" Click="OnDiagnosticsClick" />
                        <!-- What the work view moved off this row (rules, plugin settings, diagnostics): shown only when something is there. -->
                        <Button x:Name="SourcesMoreButton" Classes="subtle icon-square" IsVisible="False" Click="OnSourcesMoreClick" />
                    </WrapPanel>
                    <TextBlock Tag="sources.watches" Classes="section-title localized" TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceWatchSummary" Classes="workspace-help" TextWrapping="Wrap" />
                    <ListBox x:Name="SourceWatchesList" wv:WorkViewElement.Id="sources.detail.watches" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnWatchSelectionChanged"
                             DoubleTapped="OnWatchDoubleTapped" KeyDown="OnWatchKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="desktop:SourceWatchRow">
                                <StackPanel Spacing="{StaticResource Workspace.Space.2}" Margin="0,4">
                                    <TextBlock Text="{Binding Resource}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Resource}" />
                                    <TextBlock Text="{Binding Status}" Classes="workspace-meta" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Classes="workspace-toolbar">
                        <Button x:Name="SourceOpenWatchButton" Tag="diagnostics.openWatch" Classes="localized" Click="OnOpenWatchClick" />
                        <Button x:Name="SourceAllWatchesButton" Classes="subtle" Click="OnAllWatchesClick" IsVisible="False" />
                    </WrapPanel>
                    <Border x:Name="SourcePluginBlock" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Workspace.Border}" Padding="0,12,0,0" IsVisible="False">
                        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                            <TextBlock x:Name="SourcePluginSummary" Classes="section-title" TextWrapping="Wrap" />
                            <WrapPanel x:Name="SourcePluginSteps" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}" />
                            <TextBlock x:Name="SourcePluginNext" Classes="workspace-help" TextWrapping="Wrap" />
                            <TextBlock x:Name="SourcePluginShared" Classes="workspace-help" TextWrapping="Wrap" />
                            <WrapPanel Classes="workspace-toolbar">
                                <Button x:Name="SourcePluginEnabled" Click="OnSourcePluginEnabledClick" />
                                <Button x:Name="SourcePluginCandidate" Click="OnSourcePluginCandidateClick" />
                                <Button x:Name="SourcePluginSdk" Click="OnSourcePluginSdkClick" />
                                <Button x:Name="SourcePluginReview" Click="OnSourcePluginReviewClick" IsVisible="False" />
                                <Button x:Name="SourcePluginButton" wv:WorkViewElement.Id="sources.detail.plugin" Click="OnPluginClick" />
                                <Button x:Name="SourcePluginMore" Classes="icon-square" Click="OnSourcePluginMoreClick" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Tag="sources.reachabilityNote" Classes="workspace-help localized" TextWrapping="Wrap" />
                    <controls:WorkspaceBanner Type="Error" x:Name="SourcesActionErrorBanner" wv:WorkViewElement.Id="sources.detail.error" IsVisible="False">
                        <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="SourcesActionError" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
                    </controls:WorkspaceBanner>
                </StackPanel>
              </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
      </local:PluginsPage.SourceContent>
    </local:PluginsPage>
</UserControl>
