<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:wv="using:MeowChan.Desktop.WorkViews"
             x:Class="MeowChan.SourcesPage" SizeChanged="OnPageSizeChanged">
    <ScrollViewer x:Name="SourcesScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Workspace.Inset.Page}" Spacing="8">
            <Grid x:Name="SourcesPageHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                    <TextBlock Tag="nav.sources" Classes="page-title localized" />
                    <TextBlock Tag="sources.subtitle" Classes="muted localized" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Top" ItemSpacing="8" LineSpacing="6">
                    <TextBlock x:Name="SourceCount" Classes="muted" />
                </WrapPanel>
            </Grid>
            <Grid x:Name="SourcesSplit" ColumnDefinitions="280,*" ColumnSpacing="14">
              <StackPanel x:Name="SourcesListPane" Grid.Column="0" Spacing="10">
                <TextBlock x:Name="SourcesEmpty" Tag="sources.empty" Classes="muted localized" />
                <StackPanel x:Name="SourceCards" Spacing="10" />
              </StackPanel>
              <Border x:Name="SourceDetailsPanel" Grid.Column="1" Classes="workspace-section">
                <StackPanel Spacing="12">
                    <Button x:Name="SourceBackButton" HorizontalAlignment="Left" Click="OnBackClick" />
                    <TextBlock x:Name="SourceHeading" Classes="section-title" TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceMeta" Classes="workspace-meta" TextWrapping="Wrap" />
                    <TextBlock x:Name="SourceExperimental" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
                    <StackPanel x:Name="SourceMediaIntegrityPanel" wv:WorkViewElement.Id="sources.detail.media-integrity" Spacing="6" IsVisible="False">
                        <TextBlock x:Name="SourceMediaIntegrityExplanation" TextWrapping="Wrap" />
                        <CheckBox x:Name="SourceAllowProviderMismatch" Click="OnSourceMediaPermissionClick">
                            <TextBlock x:Name="SourceAllowProviderMismatchLabel" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="SourceMediaIntegrityScope" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock x:Name="SourceMediaIntegrityStatus" Classes="workspace-help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="SourceMediaIntegrityRetryHint" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
                        <controls:WorkspaceBanner x:Name="SourceMediaIntegrityErrorBanner" Type="Error" IsVisible="False">
                            <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="SourceMediaIntegrityError" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                            </ScrollViewer>
                        </controls:WorkspaceBanner>
                    </StackPanel>
                    <Button x:Name="SourceWebsiteButton" wv:WorkViewElement.Id="sources.detail.website" HorizontalAlignment="Left" Click="OnWebsiteClick" />
                    <!-- The capability cards fold in Barebones; whether capture works at all stays visible below them. -->
                    <Expander x:Name="CapabilitiesExpander" wv:WorkViewElement.Id="sources.detail.capabilities" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><TextBlock Tag="ud.sources.capabilities" Classes="section-title localized" /></Expander.Header>
                        <WrapPanel x:Name="CapabilityCards" ItemSpacing="8" LineSpacing="8" Margin="0,8,0,0" />
                    </Expander>
                    <TextBlock x:Name="SourceCaptureAvailability" Classes="workspace-help" TextWrapping="Wrap" />
                    <Expander x:Name="AdapterDetails" wv:WorkViewElement.Id="sources.detail.technical" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <TextBlock x:Name="SourceIdentity" Classes="workspace-meta mono" TextWrapping="Wrap" />
                            <TextBlock x:Name="SourceHosts" Classes="workspace-help" TextWrapping="Wrap" />
                            <TextBlock x:Name="SourceVersion" Classes="workspace-help" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                    <WrapPanel Classes="workspace-toolbar">
                        <Button x:Name="SourceAddToDownloadsButton" wv:WorkViewElement.Id="sources.detail.add-downloads" Click="OnAddToDownloadsClick" />
                        <Button x:Name="SourceRulesButton" wv:WorkViewElement.Id="sources.detail.rules" Tag="sources.rules" Classes="localized" Click="OnRulesClick" />
                        <Button x:Name="SourcePluginButton" wv:WorkViewElement.Id="sources.detail.plugin" Click="OnPluginClick" />
                        <Button x:Name="SourceDiagnosticsButton" wv:WorkViewElement.Id="sources.detail.diagnostics" Tag="sources.diagnostics" Classes="localized" Click="OnDiagnosticsClick" />
                        <!-- What the work view moved off this row (rules, plugin settings, diagnostics): shown only when something is there. -->
                        <Button x:Name="SourcesMoreButton" Classes="plugin-overflow" Width="32" Height="32" IsVisible="False" Click="OnSourcesMoreClick" />
                    </WrapPanel>
                    <TextBlock Tag="sources.watches" Classes="section-title localized" />
                    <TextBlock x:Name="SourceWatchSummary" Classes="workspace-help" TextWrapping="Wrap" />
                    <ListBox x:Name="SourceWatchesList" wv:WorkViewElement.Id="sources.detail.watches" SelectionMode="Single" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnWatchSelectionChanged"
                             DoubleTapped="OnWatchDoubleTapped" KeyDown="OnWatchKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="desktop:SourceWatchRow">
                                <StackPanel Spacing="2" Margin="0,4">
                                    <TextBlock Text="{Binding Resource}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Resource}" />
                                    <TextBlock Text="{Binding Status}" Classes="workspace-meta" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Classes="workspace-toolbar">
                        <Button x:Name="SourceOpenWatchButton" Tag="diagnostics.openWatch" Classes="localized" Click="OnOpenWatchClick" />
                        <Button x:Name="SourceAllWatchesButton" Classes="subtle" Click="OnAllWatchesClick" IsVisible="False" />
                    </WrapPanel>
                    <TextBlock Tag="sources.reachabilityNote" Classes="workspace-help localized" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ursa:LoadingIcon x:Name="SourcesOperationLoading" Width="16" Height="16" VerticalAlignment="Center" IsVisible="False" Focusable="False" />
                        <TextBlock x:Name="SourcesOperationStatus" VerticalAlignment="Center" Classes="muted" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
                    </StackPanel>
                    <controls:WorkspaceBanner Type="Error" x:Name="SourcesActionErrorBanner" wv:WorkViewElement.Id="sources.detail.error" IsVisible="False">
                        <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="SourcesActionError" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
                    </controls:WorkspaceBanner>
                </StackPanel>
              </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
