<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeowChan.SavedArchiveSearchesDialog">
    <!-- UX103 P7 dialog frame: fixed header, local error strip, scrolling body, fixed footer.
         The footer wraps its eight actions (filled in code by DialogFooter.Fill, Apply primary right-most); the minimum size
         (SavedArchiveSearchesDialog.MinimumHeight) is sized so that, in the longest of the 12 languages, header, error strip
         (or status), wrapped footer and a usable body fit together (SavedSearchesFooterBudgetTests). -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="DialogFrameHeader" Padding="16,16,16,8">
            <TextBlock x:Name="SavedSearchHint" TextWrapping="Wrap" />
        </Border>
        <Border x:Name="DialogFrameErrorStrip" Grid.Row="1" Padding="16,0,16,8" IsVisible="False">
            <Border Classes="workspace-error">
                <ScrollViewer MaxHeight="72" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="SavedSearchError" Classes="workspace-error" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </Border>
        <ScrollViewer x:Name="DialogFrameBody" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SavedSearchBody" Margin="16,0,16,8" RowDefinitions="Auto,Auto">
                <Grid x:Name="SavedSearchWorkspace" ColumnDefinitions="220,*" ColumnSpacing="{StaticResource Workspace.Space.12}" RowSpacing="{StaticResource Workspace.Space.12}">
                    <ListBox x:Name="SavedSearchList" Focusable="True" MinHeight="120" MaxHeight="280" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <ScrollViewer x:Name="SavedSearchSelection" Grid.Column="1" MaxHeight="280" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                            <TextBlock x:Name="SavedSearchSelectionName" Classes="section-title" TextWrapping="Wrap" />
                            <TextBlock x:Name="SavedSearchSelectionDefinition" Classes="workspace-meta" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="SavedSearchEditorScroll" Grid.Row="1" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SavedSearchEditor" Spacing="{StaticResource Workspace.Space.8}" IsVisible="False">
                    <TextBlock x:Name="SavedSearchPrompt" Classes="section-title" TextWrapping="Wrap" />
                    <TextBox x:Name="SavedSearchName" />
                    <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="SavedSearchDefinition" Classes="workspace-meta" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel x:Name="SavedSearchConflictPanel" Spacing="{StaticResource Workspace.Space.4}" IsVisible="False">
                        <TextBlock x:Name="SavedSearchConflictTitle" Classes="section-title" TextWrapping="Wrap" />
                        <TextBlock x:Name="SavedSearchConflictCurrent" Classes="workspace-meta" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}">
                        <Button x:Name="SavedSearchConfirm" Classes="primary" />
                        <Button x:Name="SavedSearchCancelEdit" />
                    </WrapPanel>
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </ScrollViewer>
        <Border x:Name="DialogFrameFooter" Grid.Row="3" Classes="workspace-dialog-footer">
            <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                <ScrollViewer x:Name="SavedSearchStatusHost" MaxHeight="48" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="SavedSearchStatus" TextWrapping="Wrap" />
                </ScrollViewer>
                <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}">
                    <Button x:Name="SavedSearchCreate" />
                    <Button x:Name="SavedSearchApply" Classes="primary" />
                    <Button x:Name="SavedSearchRename" />
                    <Button x:Name="SavedSearchReplace" />
                    <Button x:Name="SavedSearchDelete" Classes="danger" />
                    <Button x:Name="SavedSearchReload" />
                    <Button x:Name="SavedSearchRecover" IsVisible="False" />
                    <Button x:Name="SavedSearchClose" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
