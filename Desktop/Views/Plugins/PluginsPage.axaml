<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls" xmlns:plugins="using:MeowChan.Desktop.Plugins" xmlns:ursa="https://irihi.tech/ursa" xmlns:wv="using:MeowChan.Desktop.WorkViews" x:Class="MeowChan.PluginsPage" SizeChanged="OnPageSizeChanged">
  <Grid RowDefinitions="Auto,*" Margin="{StaticResource Workspace.Inset.Page}" RowSpacing="{StaticResource Workspace.Space.8}">
    <!-- Spacing 0: each optional row brings its own 8 dip top margin, so hidden or empty rows add no gap above the list
         (as on the Sources page, the list starts 8 dip under the subtitle). -->
    <StackPanel Spacing="0">
      <!-- The shared page head (PageHeader): the title and subtitle on the left, the action row top right and the count right-aligned under
           it. When the action row would leave the title less than its minimum room (it is long in German and in the Advanced view), and in any
           case below 900 dip of page (876 dip of header), the count and the actions move under the title (count first, then the actions,
           wrapping), so the title and description keep the full width. Help keeps the right edge. "Show" and its dropdown are one WrapPanel child. -->
      <controls:PageHeader x:Name="PluginsPageHeader" StackBelowWidth="876">
        <StackPanel x:Name="PluginsTitleStack" Classes="workspace-page-header">
          <TextBlock x:Name="PluginsTitle" Classes="page-title" />
          <TextBlock x:Name="PluginsSubtitle" TextWrapping="Wrap" Classes="muted" />
        </StackPanel>
        <WrapPanel x:Name="PluginsHeaderActions" controls:PageHeader.Role="Actions" VerticalAlignment="Top" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}">
          <StackPanel x:Name="PluginsShowGroup" Orientation="Horizontal" Spacing="{StaticResource Workspace.Space.8}">
            <TextBlock x:Name="SourcesShowLabel" Classes="workspace-field-label" VerticalAlignment="Center" />
            <ComboBox x:Name="PluginCategory" MinWidth="160" SelectionChanged="OnCategoryChanged" />
          </StackPanel>
          <Button x:Name="PluginsAdd" wv:WorkViewElement.Id="plugins.header.add" Click="OnAddClick" />
          <Button x:Name="PluginsLocalTagger" Click="OnLocalTaggerClick" IsVisible="False" />
          <Button x:Name="PluginsRefresh" wv:WorkViewElement.Id="plugins.header.refresh" Click="OnRefreshClick" />
          <Button x:Name="PluginsFolder" wv:WorkViewElement.Id="plugins.header.folder" Click="OnFolderClick" />
          <Button x:Name="PluginsReviewRepairs" wv:WorkViewElement.Id="plugins.header.review-repairs" Click="OnReviewBundledRepairsClick" />
          <!-- What the work view moved off this row (add file, plugin folder): shown only when something is there. -->
          <Button x:Name="PluginsMoreButton" Classes="subtle icon-square" IsVisible="False" Click="OnPluginsMoreClick" />
        </WrapPanel>
        <!-- HB2: trust, when a change applies and what an image filter may access. -->
        <controls:HelpButton x:Name="PluginsHelpButton" controls:PageHeader.Role="Help" HelpKey="help.plugins" IsEnabled="{Binding #PluginsHeaderActions.IsEnabled}" />
        <!-- The count is a statement about the list, not an action: muted, outside the button row (as the Status line). -->
        <TextBlock x:Name="PluginsCount" controls:PageHeader.Role="Aside" AutomationProperties.LiveSetting="Polite" Classes="muted tnum" TextWrapping="Wrap" Margin="0,4,0,0" />
      </controls:PageHeader>
      <!-- The status row stays in the tree (its live region keeps announcing) but takes no height while it is empty. A DockPanel, not a
           horizontal StackPanel: the stack measured the line at infinite width, so a long status never wrapped and ran out of a narrow page. -->
      <DockPanel x:Name="PluginStatusRow" Margin="0,8,0,0">
        <ursa:LoadingIcon x:Name="PluginOperationLoading" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="False" Focusable="False" />
        <TextBlock x:Name="PluginTestStatus" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      </DockPanel>
      <Button x:Name="PluginCancel" Click="OnCancelClick" HorizontalAlignment="Left" IsVisible="False" Margin="0,8,0,0" />
      <Expander x:Name="PluginInventoryProblems" wv:WorkViewElement.Id="plugins.header.inventory-problems" IsVisible="False" HorizontalAlignment="Stretch" Margin="0,8,0,0">
        <Expander.Header><ursa:Badge x:Name="PluginInventoryBadge" OverflowCount="2147483647"><TextBlock x:Name="PluginInventoryHeader" Margin="0,0,12,0" /></ursa:Badge></Expander.Header>
        <ScrollViewer MaxHeight="100"><TextBlock x:Name="PluginInventoryDiagnostics" TextWrapping="Wrap" /></ScrollViewer>
      </Expander>
      <controls:WorkspaceBanner x:Name="PluginErrorBanner" wv:WorkViewElement.Id="plugins.header.error" Type="Error" IsVisible="False" Margin="0,8,0,0">
        <ScrollViewer MaxHeight="96"><TextBlock x:Name="PluginPageError" TextWrapping="Wrap" Classes="workspace-error" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
      </controls:WorkspaceBanner>
    </StackPanel>
    <!-- List and detail as on the Sources page: a 280 dip column of cards beside one detail card. -->
    <Grid x:Name="PluginSplit" Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="{StaticResource Workspace.Space.Card}">
      <!-- The empty hint sits in the top stack: a hidden row of its own would still add the grid's row spacing twice. -->
      <Grid x:Name="PluginListPane" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Workspace.Space.8}">
        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
          <!-- No plugin in the shown category: the one empty-state pattern, with the one next step. -->
          <controls:WorkspaceEmptyState x:Name="PluginsEmptyState" IsVisible="False">
            <TextBlock x:Name="PluginsEmpty" Classes="workspace-empty-text" />
            <Button x:Name="PluginsEmptyAdd" Classes="primary" HorizontalAlignment="Center" Click="OnAddClick" />
          </controls:WorkspaceEmptyState>
        </StackPanel>
        <ScrollViewer x:Name="PluginListScroll" Grid.Row="1">
          <plugins:PluginSelectionList x:Name="PluginCards" Classes="workspace-card-list" SelectionChanged="OnPluginSelectionChanged">
            <plugins:PluginSelectionList.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{StaticResource Workspace.Space.Card}" /></ItemsPanelTemplate></plugins:PluginSelectionList.ItemsPanel>
          </plugins:PluginSelectionList>
        </ScrollViewer>
      </Grid>
      <ContentControl x:Name="SourceContentHost" Grid.ColumnSpan="2" />
      <!-- One detail card, as on the Sources page: Back, heading and facts, actions, settings, the draft footer and the disclosures. -->
      <ScrollViewer x:Name="PluginDetailsPane" Grid.Column="1" IsVisible="False">
        <Border x:Name="PluginDetailCard" Classes="workspace-section">
        <StackPanel x:Name="PluginDetailContent" Spacing="{StaticResource Workspace.Space.12}">
          <Border x:Name="PluginPurposeCard">
            <StackPanel Classes="workspace-section-header">
              <!-- The way back at the far left, then the heading (HeaderBar back slot, Tom's rule 14.11.). -->
              <controls:HeaderBar>
                <Button x:Name="PluginBack" controls:HeaderBar.IsBack="True" VerticalAlignment="Top" Click="OnBackClick" />
                <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                  <TextBlock x:Name="PluginHeading" VerticalAlignment="Center" Classes="section-title" TextWrapping="Wrap" />
                  <TextBlock x:Name="PluginAuthor" Classes="workspace-meta" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="False" />
                </WrapPanel>
              </controls:HeaderBar>
              <TextBlock x:Name="PluginDescriptionOrigin" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginDescription" TextWrapping="Wrap" />
              <WrapPanel x:Name="PluginCompactIdentity" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                <Border x:Name="PluginTypeChip" Classes="chip chip-badge chip-neutral"><TextBlock x:Name="PluginType" Classes="chip-label" /></Border>
                <Border x:Name="PluginExperimentalChip" Classes="chip chip-badge" IsVisible="False"><TextBlock x:Name="PluginExperimental" Classes="chip-label" TextWrapping="Wrap" /></Border>
                <Border x:Name="PluginVersionChip" Classes="chip chip-badge chip-neutral" IsVisible="False"><TextBlock x:Name="PluginVersion" Classes="chip-label" TextWrapping="Wrap" /></Border>
                <!-- The one chip that acts (dead-affordance audit): a click copies the full plugin ID; the other chips state facts. -->
                <Button x:Name="PluginIdChip" Classes="chip" MaxWidth="260" IsVisible="False" Click="OnCopyPluginIdClick"><TextBlock x:Name="PluginCompactId" Classes="chip-label" TextTrimming="CharacterEllipsis" MaxLines="1" /></Button>
              </WrapPanel>
              <TextBlock x:Name="PluginIdCopyStatus" Classes="workspace-help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" IsVisible="False" />
              <TextBlock x:Name="PluginStatus" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <!-- Installed → Enabled → Active: three chips built in code, then the one next action as a sentence. -->
              <WrapPanel x:Name="PluginStepChips" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}" />
              <TextBlock x:Name="PluginLifecycleNext" Classes="workspace-help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <!-- Several files for one plugin: the list shows one card; the files are chosen here. -->
              <StackPanel x:Name="PluginFilesPanel" Spacing="{StaticResource Workspace.Space.4}" IsVisible="False">
                <TextBlock x:Name="PluginFilesHeading" Classes="section-title" TextWrapping="Wrap" />
                <TextBlock x:Name="PluginFilesHint" Classes="workspace-help" TextWrapping="Wrap" />
                <StackPanel x:Name="PluginFileChoices" Spacing="{StaticResource Workspace.Space.4}" />
              </StackPanel>
              <WrapPanel x:Name="PluginPrimaryActions" Classes="workspace-toolbar">
                <Button x:Name="PluginEnabled" Click="OnEnabledClick" />
                <Button x:Name="PluginSelectCandidate" Click="OnSelectCandidateClick" />
                <Button x:Name="PluginApproveSdkTransition" wv:WorkViewElement.Id="plugins.detail.sdk-transition" Click="OnApproveSdkTransitionClick" IsVisible="False" />
                <!-- Shown only while this plugin's bundled build waits for its repair review: opens that review in one click. -->
                <Button x:Name="PluginReviewRepair" Click="OnReviewBundledRepairsClick" IsVisible="False" />
                <Button x:Name="PluginWatches" wv:WorkViewElement.Id="plugins.detail.watches" Click="OnWatchesClick" />
                <Button x:Name="PluginMoreActions" Classes="icon-square" Click="OnPluginMoreActionsClick" />
              </WrapPanel>
              <TextBlock x:Name="PluginExperimentalHint" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginDraftSummary" Classes="workspace-status" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginAttention" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="PluginStatusHint" TextWrapping="Wrap" IsVisible="False" />
              <TextBlock x:Name="PluginCapabilities" Classes="workspace-help" TextWrapping="Wrap" IsVisible="False" />
              <SelectableTextBlock x:Name="PluginActivationReasons" TextWrapping="Wrap" Focusable="True" />
              <SelectableTextBlock x:Name="PluginActionHint" TextWrapping="Wrap" Focusable="True" Classes="workspace-help" IsVisible="False" />
            </StackPanel>
          </Border>
          <StackPanel x:Name="PluginSettings" Spacing="{StaticResource Workspace.Space.12}" />
          <!-- The draft footer is a part of the card, set off by a rule, not a card in the card. -->
          <Border x:Name="PluginDraftFooter" wv:WorkViewElement.Id="plugins.detail.draft-footer" Classes="workspace-card-footer">
            <StackPanel Classes="workspace-section-header">
              <TextBlock x:Name="PluginDraftStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <WrapPanel Classes="workspace-actions">
                <Button x:Name="PluginSave" Classes="primary" Click="OnSaveClick" />
                <Button x:Name="PluginDiscard" Click="OnDiscardClick" />
              </WrapPanel>
              <SelectableTextBlock x:Name="PluginDraftReasons" TextWrapping="Wrap" Focusable="True" Classes="workspace-help" />
            </StackPanel>
          </Border>
          <Expander x:Name="PluginInfoExpander" wv:WorkViewElement.Id="plugins.detail.info" HorizontalAlignment="Stretch"><StackPanel x:Name="PluginInformation" Spacing="{StaticResource Workspace.Space.8}" /></Expander>
          <Expander x:Name="PluginGrantExpander" wv:WorkViewElement.Id="plugins.detail.grants" HorizontalAlignment="Stretch"><StackPanel x:Name="PluginGrants" Spacing="{StaticResource Workspace.Space.8}" /></Expander>
          <Expander x:Name="PluginDeveloperExpander" wv:WorkViewElement.Id="plugins.detail.developer" HorizontalAlignment="Stretch">
            <StackPanel Spacing="{StaticResource Workspace.Space.12}" Margin="0,4,0,0">
              <ursa:Descriptions x:Name="PluginIdentity" LabelPosition="Top" />
              <Button x:Name="PluginCopyTechnicalDetails" Click="OnCopyTechnicalDetailsClick" HorizontalAlignment="Left" />
              <TextBlock x:Name="PluginTechnicalCopyStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              <TextBlock x:Name="PluginCandidateDiagnostics" TextWrapping="Wrap" Classes="workspace-error" />
              <Button x:Name="PluginRollback" Click="OnRollbackClick" HorizontalAlignment="Left" />
              <SelectableTextBlock x:Name="PluginRecoveryReasons" TextWrapping="Wrap" Focusable="True" />
              <StackPanel x:Name="PluginSourceExpander" Spacing="{StaticResource Workspace.Space.8}">
                <TextBlock x:Name="PluginSourceToolsHeading" Classes="section-title" TextWrapping="Wrap" />
                <TextBlock x:Name="PluginSourcePath" TextWrapping="Wrap" />
                <TextBlock x:Name="PluginTestHint" TextWrapping="Wrap" Classes="workspace-help" />
                <WrapPanel Classes="workspace-toolbar">
                  <Button x:Name="PluginEdit" Click="OnEditClick" />
                  <Button x:Name="PluginDefaultEditor" Click="OnDefaultEditorClick" />
                  <Button x:Name="PluginBuild" Click="OnBuildClick" />
                </WrapPanel>
                <SelectableTextBlock x:Name="PluginSourceReasons" TextWrapping="Wrap" Focusable="True" />
                <StackPanel x:Name="PluginBuildDiagnostics" Spacing="{StaticResource Workspace.Space.8}" />
                <TextBox x:Name="PluginProbeUrl" />
                <Button x:Name="PluginProbe" HorizontalAlignment="Left" Click="OnProbeClick" />
                <TextBox x:Name="PluginProbeResult" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="300" />
                <Expander x:Name="PluginEditorExpander" HorizontalAlignment="Stretch">
                  <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                    <TextBlock x:Name="PluginEditorHint" TextWrapping="Wrap" />
                    <TextBox x:Name="PluginEditorExecutable" />
                    <TextBox x:Name="PluginEditorArguments" AcceptsReturn="True" MinHeight="70" />
                    <Button x:Name="PluginEditorSave" Click="OnEditorSaveClick" HorizontalAlignment="Left" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
