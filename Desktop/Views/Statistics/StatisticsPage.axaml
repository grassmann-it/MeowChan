<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:stats="clr-namespace:MeowChan.Desktop.Stats"
             x:Class="MeowChan.StatisticsPage">
    <UserControl.Styles>
        <!-- Numbers line up: right-aligned, tabular figures. -->
        <Style Selector="TextBlock.stats-num"><Setter Property="TextAlignment" Value="Right" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="FontFeatures" Value="tnum" /></Style>
        <Style Selector="TextBlock.stats-value"><Setter Property="FontSize" Value="{StaticResource Workspace.Text.Subtitle}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontFeatures" Value="tnum" /></Style>
        <Style Selector="DataGridCell TextBlock"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
        <Style Selector="DataGridRow.stats-total-row DataGridCell"><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Border}" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
    </UserControl.Styles>
    <Grid>
    <ScrollViewer x:Name="StatisticsScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Workspace.Inset.Page}" Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="5">
                    <TextBlock x:Name="StatisticsTitle" Classes="page-title" Text="Statistics" />
                    <TextBlock x:Name="StatisticsSubtitle" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <Button x:Name="ResetStatisticsButton" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right" Click="OnResetClick">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout Placement="BottomEdgeAlignedRight" Opened="OnResetConfirmationOpened" Closed="OnResetConfirmationClosed">
                            <Border x:Name="ResetConfirmPanel" MaxWidth="320" KeyDown="OnResetConfirmKeyDown">
                                <StackPanel Spacing="12">
                                    <TextBlock x:Name="ResetQuestion" TextWrapping="Wrap" />
                                    <WrapPanel Classes="workspace-toolbar">
                                        <Button x:Name="ConfirmResetButton" Classes="danger" Click="OnConfirmResetClick" />
                                        <Button x:Name="CancelResetButton" Click="OnCancelResetClick" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                </Button>
            </Grid>
            <Border x:Name="LoadNoticePanel" Classes="workspace-warning" IsVisible="False">
                <TextBlock x:Name="LoadNoticeText" TextWrapping="Wrap" />
            </Border>
            <Border x:Name="PersistErrorPanel" Classes="workspace-warning" IsVisible="False">
                <TextBlock x:Name="PersistErrorText" TextWrapping="Wrap" />
            </Border>

            <Border Classes="workspace-section">
                <StackPanel Spacing="8">
                    <WrapPanel ItemSpacing="24" LineSpacing="8">
                        <StackPanel MinWidth="130"><TextBlock x:Name="NetCaption" Classes="muted" /><TextBlock x:Name="NetValue" Classes="stats-value" /></StackPanel>
                        <StackPanel MinWidth="130"><TextBlock x:Name="DiskWriteCaption" Classes="muted" /><TextBlock x:Name="DiskWriteValue" Classes="stats-value" /></StackPanel>
                        <StackPanel MinWidth="130"><TextBlock x:Name="DiskReadCaption" Classes="muted" /><TextBlock x:Name="DiskReadValue" Classes="stats-value" /></StackPanel>
                        <StackPanel MinWidth="130"><TextBlock x:Name="RequestsCaption" Classes="muted" /><TextBlock x:Name="RequestsValue" Classes="stats-value" /></StackPanel>
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock x:Name="HistoryTitle" Classes="section-title" TextWrapping="Wrap" />
                            <TextBlock x:Name="HistoryNote" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock x:Name="PeakText" Grid.Column="1" Classes="muted stats-num" />
                    </Grid>
                    <TextBlock x:Name="ActivityText" Classes="muted" TextWrapping="Wrap" />
                    <StackPanel Spacing="8">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Panel Width="30" Height="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <Path Data="M 0,13 L 0,4 L 30,4 L 30,13 Z" Fill="{DynamicResource Workspace.AccentSurface}" />
                                    <Path Data="M 0,4 L 30,4" Stroke="{DynamicResource Workspace.Accent}" StrokeThickness="1.6" />
                                </Panel>
                                <TextBlock x:Name="NetTitle" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="NetScale" Grid.Column="2" Classes="muted stats-num" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="56,Auto" ColumnSpacing="8" RowSpacing="4">
                                <Grid x:Name="ScaleLabels" Width="82" RowDefinitions="*,*">
                                    <TextBlock x:Name="ScaleTop" Classes="muted stats-num" VerticalAlignment="Top" />
                                    <TextBlock x:Name="ScaleHalf" Grid.Row="1" Classes="muted stats-num" VerticalAlignment="Top" />
                                </Grid>
                                <controls:IoGraph x:Name="NetGraph" Grid.Column="1" Source="NetDown" ShowDisk="False" Height="56" HorizontalAlignment="Stretch" LineThickness="1.6"
                                                  Stroke="{DynamicResource Workspace.Accent}" Fill="{DynamicResource Workspace.AccentSurface}" GuideStroke="{DynamicResource Workspace.Border}"
                                                  Focusable="False" />
                                <TextBlock x:Name="HistoryEmpty" Grid.ColumnSpan="2" Classes="muted" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto">
                                    <TextBlock x:Name="HistoryStart" Classes="muted" FontFeatures="tnum" />
                                    <TextBlock x:Name="HistoryEnd" Grid.Column="1" Classes="muted" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Panel Width="30" Height="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <Path Data="M 0,13 L 0,4 L 30,4 L 30,13 Z" Fill="{DynamicResource Workspace.Stats.DiskSurface}" />
                                    <Path Data="M 0,4 L 30,4" Stroke="{DynamicResource Workspace.Stats.Disk}" StrokeThickness="1.6" />
                                </Panel>
                                <TextBlock x:Name="DiskWriteTitle" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiskWriteScale" Grid.Column="2" Classes="muted stats-num" />
                            </Grid>
                            <controls:IoGraph x:Name="DiskWriteGraph" Source="DiskWrite" ShowDisk="False" Height="56" HorizontalAlignment="Stretch" LineThickness="1.6"
                                              Stroke="{DynamicResource Workspace.Stats.Disk}" Fill="{DynamicResource Workspace.Stats.DiskSurface}" GuideStroke="{DynamicResource Workspace.Border}" Focusable="False" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <Panel Width="30" Height="14" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
                                    <Path Data="M 0,13 L 0,4 L 30,4 L 30,13 Z" Fill="{DynamicResource Workspace.Stats.ReadSurface}" />
                                    <Path Data="M 0,4 L 30,4" Stroke="{DynamicResource Workspace.Stats.Read}" StrokeThickness="1.6" />
                                </Panel>
                                <TextBlock x:Name="DiskReadTitle" Grid.Column="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="DiskReadScale" Grid.Column="2" Classes="muted stats-num" />
                            </Grid>
                            <controls:IoGraph x:Name="DiskReadGraph" Source="DiskRead" ShowDisk="False" Height="56" HorizontalAlignment="Stretch" LineThickness="1.6"
                                              Stroke="{DynamicResource Workspace.Stats.Read}" Fill="{DynamicResource Workspace.Stats.ReadSurface}" GuideStroke="{DynamicResource Workspace.Border}" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="workspace-section">
                <StackPanel Spacing="8" SizeChanged="OnSourcesSizeChanged">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="SourcesTitle" Classes="section-title" />
                        <Button x:Name="StatisticsHelpButton" Grid.Column="1" Content="?" Classes="subtle">
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock x:Name="StatisticsFootnote" MaxWidth="360" TextWrapping="Wrap" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="SourcesEmpty" Classes="muted" TextWrapping="Wrap" IsVisible="False" />
                    <DataGrid x:Name="StatisticsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column" RowHeight="34" ColumnHeaderHeight="72"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*" MinWidth="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding Now}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding Session}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding Today}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding Retained}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="116">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding DiskWritten}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="116">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding DiskRead}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="84">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding Requests}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="stats:StatisticsRow">
                                        <TextBlock Classes="stats-num" Text="{Binding Errors}" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel x:Name="CompactSources" IsVisible="False" Spacing="4">
                        <Grid ColumnDefinitions="*,90,90,64" ColumnSpacing="8" Margin="32,0,12,0">
                            <TextBlock x:Name="CompactSourceHeader" TextWrapping="Wrap" />
                            <TextBlock x:Name="CompactRateHeader" Grid.Column="1" TextWrapping="Wrap" TextAlignment="Right" />
                            <TextBlock x:Name="CompactSessionHeader" Grid.Column="2" TextWrapping="Wrap" TextAlignment="Right" />
                            <TextBlock x:Name="CompactErrorsHeader" Grid.Column="3" TextWrapping="Wrap" TextAlignment="Right" />
                        </Grid>
                        <ItemsControl x:Name="StatisticsCompactList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="stats:StatisticsRow">
                                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="*,90,90,64" ColumnSpacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Now}" Classes="stats-num" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Session}" Classes="stats-num" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Errors}" Classes="stats-num" FontWeight="{Binding Weight}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontFeatures="tnum" Margin="12,4" />
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
    <!-- Transient result overlays the page; neither asking nor completing a reset moves the content. -->
    <Border x:Name="ResetStatusPanel" Classes="workspace-section" IsVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" MaxWidth="360">
        <TextBlock x:Name="StatisticsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
    </Grid>
</UserControl>
