<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="clr-namespace:MeowChan.Desktop"
        x:Class="MeowChan.AboutWindow"
        Title="About MeowChan"
        Width="800" Height="660" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="{x:Static desktop:WorkspaceMetrics.TitleBarHeight}"
        Background="{DynamicResource Workspace.Background}"
        Foreground="{DynamicResource Workspace.Text}">
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource Workspace.Background}">
        <desktop:WindowChromeBar x:Name="AppCaption" />
        <!-- UX103 P7 dialog frame: fixed header, local error strip, body, fixed footer. Each tab
             keeps its own scrolling (licenses list/text side by side), so the body region itself does
             not scroll vertically; that avoids a second scroll around the tabs. No inner Tab cycle:
             the window cycle keeps the caption buttons reachable. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto">
        <Border x:Name="DialogFrameHeader" Padding="16,16,16,12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <!-- Orange and grey cat together, in either theme; one accessible name for the pair. -->
            <StackPanel x:Name="CatLogoPair" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Content">
                <Image x:Name="CatLogo" Width="72" Height="72" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
                <Image x:Name="CatLogoDark" Width="72" Height="72" Stretch="Uniform" AutomationProperties.AccessibilityView="Raw"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock FontSize="{StaticResource Workspace.Text.Title}" FontWeight="SemiBold"><Run Text="Meow" Foreground="{DynamicResource Workspace.Text}"/><Run Text="Chan" Foreground="{DynamicResource Workspace.Accent}"/></TextBlock>
                <WrapPanel ItemSpacing="12" LineSpacing="4">
                    <SelectableTextBlock x:Name="VersionText" Classes="workspace-meta" VerticalAlignment="Center"/>
                    <Button x:Name="CopyVersionButton" Classes="link" Click="OnCopyVersionClick"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
        </Border>
        <Border x:Name="DialogFrameErrorStrip" Grid.Row="1" Padding="16,0,16,8"
                IsVisible="{Binding #LinkErrorText.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Border Classes="workspace-error">
                <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock x:Name="LinkErrorText" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"/>
                </ScrollViewer>
            </Border>
        </Border>
        <ScrollViewer x:Name="DialogFrameBody" Grid.Row="2" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <TabControl x:Name="AboutTabs" Margin="16,0,16,12">
            <TabItem x:Name="AboutTab">
                <ScrollViewer x:Name="AboutScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="12">
                        <TextBlock x:Name="TaglineText" Classes="muted" FontStyle="Italic" TextWrapping="Wrap"/>
                        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AuthorText"/>
                        <Border x:Name="UpdateSection" Classes="workspace-section">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <TextBlock x:Name="UpdatesTitle" Classes="section-title" VerticalAlignment="Center" />
                                    <Button x:Name="CheckUpdatesButton" Grid.Column="1" HorizontalAlignment="Right" Click="OnCheckUpdatesClick" />
                                </Grid>
                                <TextBlock x:Name="UpdateStatusText" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="LastUpdateCheckText" Classes="workspace-help" />
                                <TextBlock x:Name="AvailableUpdateText" AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel x:Name="UpdateActions" ItemSpacing="16" LineSpacing="8">
                                    <Button x:Name="UpdateReleaseButton" Classes="link" Click="OnUpdateReleaseClick" />
                                    <Button x:Name="UpdateDownloadButton" Classes="link" Click="OnUpdateDownloadClick" />
                                    <Button x:Name="SkipUpdateButton" Classes="link" Click="OnSkipUpdateClick" />
                                </WrapPanel>
                                <TextBlock x:Name="UpdateBrowserHint" Classes="workspace-help" />
                                <TextBlock x:Name="UpdatePrivacyText" Classes="workspace-help" />
                                <TextBlock x:Name="UpdateActionErrorText" Classes="workspace-error" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Border>
                        <WrapPanel ItemSpacing="16" LineSpacing="8">
                            <Button x:Name="ProjectLink" Classes="link" Tag="https://github.com/grassmann-it/MeowChan" Click="OnLinkClick"/>
                            <Button x:Name="AuthorLink" Classes="link" Tag="https://github.com/grassmann-it" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="LicenseText"/>
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock x:Name="SupportTitle" Classes="section-title"/>
                            <TextBlock x:Name="SupportDescription"/>
                            <Button x:Name="DonationLink" Classes="link" HorizontalAlignment="Left"
                                    Tag="https://www.paypal.com/donate/?hosted_button_id=5BR4MK748PDSQ" Click="OnLinkClick"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CreditsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="12">
                        <TextBlock x:Name="HistoryText"/>
                        <WrapPanel ItemSpacing="16" LineSpacing="8">
                            <Button Content="YChan" Classes="link" Tag="https://sourceforge.net/projects/ychan/" Click="OnLinkClick"/>
                            <Button Content="Issung / GChan" Classes="link" Tag="https://github.com/Issung/GChan" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="VideoCreditsText"/>
                        <TextBlock x:Name="UICreditsText"/>
                        <TextBlock x:Name="IconsText"/>
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PhotoCreditText"/>
                            <WrapPanel ItemSpacing="16" LineSpacing="8">
                                <Button x:Name="PhotoCreditLink" Classes="link"
                                        Tag="https://webentwicklung-huxel.de/" Click="OnLinkClick"/>
                                <Button x:Name="PhotoCreditFlickrLink" Classes="link" Content="Flickr"
                                        Tag="https://flickr.com/people/204852984@N05/" Click="OnLinkClick"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="LicensesTab">
                <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
                    <TextBox x:Name="LicenseSearchBox" Grid.Row="0" TextChanged="OnLicenseSearchChanged"/>
                    <TextBlock x:Name="LicenseHintText" Grid.Row="1" Classes="workspace-help"/>
                    <Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="8">
                        <ListBox x:Name="LicenseList" SelectionChanged="OnLicenseSelectionChanged"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                            <Expander x:Name="LicenseMetadataExpander" HorizontalAlignment="Stretch" MaxHeight="140">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock x:Name="LicenseMetadataText" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Expander>
                            <TextBox x:Name="LicenseFullText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        </ScrollViewer>
        <Border x:Name="DialogFrameFooter" Grid.Row="3" Classes="workspace-dialog-footer">
            <Button x:Name="CloseButton" HorizontalAlignment="Right" MinWidth="96" IsCancel="True" Click="OnCloseButtonClick"/>
        </Border>
        </Grid>
    </Grid>
</Window>
