<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:local="clr-namespace:MeowChan"
             xmlns:desktop="clr-namespace:MeowChan.Desktop"
             xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:wv="using:MeowChan.Desktop.WorkViews"
             x:Class="MeowChan.RulesPage" x:DataType="local:RulesPage"
             SizeChanged="OnRulesSizeChanged">
    <UserControl.Resources>
        <!-- The "Choose another scope" header starts on the content column's left edge (Semi insets it by 16 dip) and so do its fields. -->
        <Thickness x:Key="ExpanderHeaderPadding">0,10</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0</Thickness>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- R6: the extensions field has the 32 dip input height of the fields around it (Ursa's tags and close buttons default to a 44 dip field);
             its tags stay readable and centred, the close button keeps a 16 dip hit area inside the tag. -->
        <!-- One 8 dip rhythm: a divider row has 8 dip above and below its content (the shared rule is 10). -->
        <Style Selector="Border.settings-divider"><Setter Property="Padding" Value="0,8" /></Style>
        <Style Selector="ursa|TagInput /template/ Border#PART_RootBorder"><Setter Property="MinHeight" Value="32" /></Style>
        <Style Selector="ursa|TagInput /template/ :is(Control)#PART_ItemsControl"><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="ursa|TagInput ursa|ClosableTag /template/ Button#PART_CloseButton"><Setter Property="MinHeight" Value="16" /><Setter Property="MinWidth" Value="16" /><Setter Property="Padding" Value="4,0" /></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header like Sources: title and one-line subtitle, then the scope picker with its Edit scope action as one row. -->
        <StackPanel x:Name="RulesHeader" Margin="12,12,12,8" Spacing="8" MaxWidth="880" HorizontalAlignment="Center">
            <StackPanel Spacing="5">
                <TextBlock x:Name="RulesTitle" Text="{Binding Title}" Classes="page-title" />
                <TextBlock x:Name="RulesSubtitle" Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Spacing="4" IsEnabled="{Binding IsEditable}">
                <TextBlock Text="{Binding SavedScopesLabel}" Classes="workspace-field-label" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox x:Name="RulesScopeList" HorizontalAlignment="Stretch"
                              ItemsSource="{Binding ScopeChoices}" SelectedItem="{Binding SelectedScopeChoice, Mode=TwoWay}">
                        <ComboBox.ItemTemplate><DataTemplate x:DataType="local:RuleScopeChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="OpenSavedRuleButton" Grid.Column="1" Click="OnOpenSavedScope" />
                </Grid>
                <TextBlock Text="{Binding ScopeCountLabel}" Classes="workspace-help" TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
        <ScrollViewer x:Name="RulesScroll" Grid.Row="1" Margin="12,0,12,12" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RulesContent" MaxWidth="880" HorizontalAlignment="Center" Spacing="12">
                <StackPanel IsEnabled="{Binding IsEditable}">
                    <Expander x:Name="NewRuleScopeExpander" wv:WorkViewElement.Id="rules.scope.new" Header="{Binding NewScopeLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock Classes="workspace-field-label" Text="{Binding ScopeKindLabel}" VerticalAlignment="Center" />
                                <ComboBox x:Name="NewRuleScopeKindInput" Grid.Column="1" ItemsSource="{Binding ScopeKindChoices}" SelectedIndex="{Binding NewScopeKind, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                            </Grid>
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding NeedsSource}">
                                <TextBlock Classes="workspace-field-label" Text="{Binding SourceIdLabel}" VerticalAlignment="Center" />
                                <desktop:IdentitySuggestionBox x:Name="NewRuleSourceInput" Grid.Column="1" Text="{Binding NewSourceId, Mode=TwoWay}" PlaceholderText="4chan" />
                            </Grid>
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding NeedsBoard}">
                                <TextBlock Classes="workspace-field-label" Text="{Binding BoardIdLabel}" VerticalAlignment="Center" />
                                <desktop:IdentitySuggestionBox x:Name="NewRuleBoardInput" Grid.Column="1" Text="{Binding NewBoardId, Mode=TwoWay}" PlaceholderText="g" />
                            </Grid>
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding NeedsThread}">
                                <TextBlock Classes="workspace-field-label" Text="{Binding ThreadIdLabel}" VerticalAlignment="Center" />
                                <TextBox x:Name="NewRuleThreadInput" Grid.Column="1" Text="{Binding NewThreadId, Mode=TwoWay}" PlaceholderText="123" />
                            </Grid>
                            <TextBlock x:Name="RuleSuggestionsHint" Classes="workspace-help" TextWrapping="Wrap" />
                            <Button x:Name="RuleRetrySuggestions" IsVisible="False" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBlock Text="{Binding IdentityHint}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button x:Name="OpenNewRuleScopeButton" Grid.Column="1" Click="OnOpenNewScope" />
                            </Grid>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <Border Classes="workspace-section"><StackPanel Spacing="0" IsEnabled="{Binding IsEditable}">
                    <!-- The scope being edited, always; the page's "More" (⋯) holds what the work view moved off the page. -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                        <TextBlock x:Name="RulesEditingHeader" wv:WorkViewElement.Id="rules.scope.editing-header" Text="{Binding EditingLabel}" Classes="section-title" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button x:Name="RulesMoreButton" Grid.Column="1" Classes="subtle icon-square" IsVisible="False" Click="OnRulesMoreClick" />
                    </Grid>
                    <Grid x:Name="RuleBreadcrumbRow" wv:WorkViewElement.Id="rules.scope.breadcrumb" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                        <ursa:Breadcrumb x:Name="RuleScopeBreadcrumb" VerticalAlignment="Center"><ursa:Breadcrumb.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ursa:Breadcrumb.ItemsPanel></ursa:Breadcrumb>
                        <Button x:Name="OpenParentRuleButton" Grid.Column="1" VerticalAlignment="Center" IsVisible="False" Click="OnOpenParentScope" />
                    </Grid>
                    <CheckBox x:Name="RuleEnabledInput" Content="{Binding EnabledLabel}" IsChecked="{Binding RuleEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{Binding EnabledHint}" Classes="workspace-help" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <StackPanel IsEnabled="{Binding RuleEnabled}">
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock Text="{Binding TypesLabel}" Classes="workspace-field-label" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <ComboBox x:Name="RuleTypesModeInput" ItemsSource="{Binding TypesModeChoices}" SelectedIndex="{Binding TypesMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <!-- The inherited or own value as a quiet chip, its origin as a muted line beside it. -->
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <Border Classes="chip chip-badge chip-neutral" VerticalAlignment="Center"><TextBlock Text="{Binding EffectiveTypesLabel}" Classes="chip-label" TextWrapping="Wrap" /></Border>
                                        <TextBlock Text="{Binding TypesOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding HasTypeSelection}" Classes="workspace-field" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ExtensionsLabel}" Classes="workspace-field-label" />
                    <controls:RuleExtensionsInput x:Name="RuleExtensionsInput" PlaceholderText="JPG, PNG, WebM" />
                    <TextBlock x:Name="RuleExtensionsErrorText" Text="{Binding ExtensionsError}" Classes="workspace-error" TextWrapping="Wrap" IsVisible="{Binding HasExtensionsError}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding ExtensionsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock Text="{Binding SizeLabel}" Classes="workspace-field-label" VerticalAlignment="Top" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <ComboBox x:Name="RuleSizeModeInput" ItemsSource="{Binding SizeModeChoices}" SelectedIndex="{Binding SizeMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <!-- The inherited or own value as a quiet chip, its origin as a muted line beside it. -->
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <Border Classes="chip chip-badge chip-neutral" VerticalAlignment="Center"><TextBlock Text="{Binding EffectiveSizeLabel}" Classes="chip-label" TextWrapping="Wrap" /></Border>
                                        <TextBlock Text="{Binding SizeOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" IsVisible="{Binding HasSizeLimit}" Classes="workspace-field" Margin="0,8,0,0">
                    <TextBlock Text="{Binding MegabytesLabel}" Classes="workspace-field-label" />
                    <TextBox AutomationProperties.Name="{Binding MegabytesLabel}" AutomationProperties.HelpText="{Binding MegabytesHint}" x:Name="RuleMegabytesInput" Text="{Binding MegabytesText, Mode=TwoWay}" PlaceholderText="10" />
                    <TextBlock x:Name="RuleMegabytesErrorText" Text="{Binding MegabytesError}" Classes="workspace-error" TextWrapping="Wrap" IsVisible="{Binding HasMegabytesError}" AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="{Binding MegabytesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel></Border>
                <Border Classes="workspace-section">
                    <!-- Folded in Barebones; an active filter opens it and names itself in the header. -->
                    <Expander x:Name="RulePluginExpander" wv:WorkViewElement.Id="rules.plugin-filter" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><TextBlock x:Name="RulePluginHeader" Classes="section-title" TextWrapping="Wrap" /></Expander.Header>
                        <StackPanel x:Name="RulePluginPanel" Spacing="8" Margin="0,8,0,0" />
                    </Expander>
                </Border>
                <Border x:Name="RuleTemplatesCard" wv:WorkViewElement.Id="rules.templates" Classes="workspace-section">
                    <!-- Under More in Barebones (their shortcuts keep working), folded in Simple. -->
                    <Expander x:Name="RuleTemplatesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><TextBlock x:Name="RuleTemplatesHeader" Classes="section-title" TextWrapping="Wrap" /></Expander.Header>
                        <StackPanel x:Name="RuleTemplatesPanel" Spacing="8" Margin="0,8,0,0" />
                    </Expander>
                </Border>
                <Border Classes="workspace-section">
                    <!-- Folded in Barebones; a validation error opens it, a refused field is named in the blocked hint. -->
                    <Expander x:Name="RulePreviewExpander" wv:WorkViewElement.Id="rules.preview" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header><TextBlock Text="{Binding PreviewTitle}" Classes="section-title" TextWrapping="Wrap" /></Expander.Header>
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                    <controls:WorkspaceBanner Type="Error" IsVisible="{Binding HasValidationBanner}">
                        <TextBlock x:Name="RuleValidationSummary" Focusable="True" Text="{Binding ValidationMessage}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </controls:WorkspaceBanner>
                    <WrapPanel x:Name="RulePreviewBlocked" wv:WorkViewElement.Id="rules.preview.blocked" IsVisible="{Binding HasPreviewBlocked}" ItemSpacing="12" LineSpacing="6">
                        <TextBlock Text="{Binding PreviewBlockedLabel}" Classes="workspace-meta" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="RuleGoToInvalidFieldButton" Content="{Binding GoToFieldLabel}" Click="OnGoToInvalidField" />
                    </WrapPanel>
                    <StackPanel Spacing="0" IsVisible="{Binding HasPreview}">
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock Text="{Binding TypesLabel}" VerticalAlignment="Top" FontWeight="Medium" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <TextBlock x:Name="RuleEffectiveTypes" Text="{Binding EffectiveTypesLabel}" TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <TextBlock x:Name="RuleTypesOrigin" Text="{Binding TypesOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Name="OpenTypesOriginButton" wv:WorkViewElement.Id="rules.preview.origin-types" Classes="link" Padding="4,0" MinHeight="24" VerticalAlignment="Center" IsEnabled="{Binding CanOpenTypesOrigin}" IsVisible="False"
                                                Click="OnOpenTypesOrigin" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock Text="{Binding SizeLabel}" VerticalAlignment="Top" FontWeight="Medium" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <TextBlock x:Name="RuleEffectiveSize" Text="{Binding EffectiveSizeLabel}" TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="8" LineSpacing="4">
                                        <TextBlock x:Name="RuleSizeOrigin" Text="{Binding SizeOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Name="OpenSizeOriginButton" wv:WorkViewElement.Id="rules.preview.origin-size" Classes="link" Padding="4,0" MinHeight="24" VerticalAlignment="Center" IsEnabled="{Binding CanOpenSizeOrigin}" IsVisible="False"
                                                Click="OnOpenSizeOrigin" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding FutureHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UnknownHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                    </Expander>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Classes="workspace-dialog-footer">
            <Grid x:Name="RulesFooter" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8"
                  HorizontalAlignment="Center">
                <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ursa:LoadingIcon Width="16" Height="16" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" IsLoading="{Binding IsBusy}" Focusable="False" />
                            <TextBlock x:Name="RuleStatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" AutomationProperties.LiveSetting="{Binding StatusLiveSetting}" />
                        </StackPanel>
                        <controls:WorkspaceBanner Type="Error" IsVisible="{Binding HasError}">
                            <TextBlock x:Name="RuleActionError" Focusable="True" Text="{Binding ErrorMessage}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </controls:WorkspaceBanner>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="RulesFooterActions" Classes="workspace-actions" Grid.Column="1" HorizontalAlignment="Right">
                    <Button x:Name="DiscardRuleButton" wv:WorkViewElement.Id="rules.footer.discard" IsEnabled="{Binding IsEditable}" Click="OnDiscardDraft" />
                    <Button x:Name="SaveRuleButton" wv:WorkViewElement.Id="rules.footer.save" Classes="primary" IsEnabled="{Binding CanSave}" Click="OnSaveRule" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
