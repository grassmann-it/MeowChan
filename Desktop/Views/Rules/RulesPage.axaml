<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:local="clr-namespace:MeowChan"
             xmlns:desktop="clr-namespace:MeowChan.Desktop"
             xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:wv="using:MeowChan.Desktop.WorkViews"
             x:Class="MeowChan.RulesPage" x:DataType="local:RulesPage"
             SizeChanged="OnRulesSizeChanged">
    <UserControl.Resources>
        <!-- The "Choose another scope" header starts on the content column's left edge (Semi insets it by 16 dip) and so do its fields. -->
        <Thickness x:Key="ExpanderHeaderPadding">0,4</Thickness>
        <Thickness x:Key="ExpanderContentPadding">0</Thickness>
        <!-- Semi insets the header text by its own margin; without it the folded blocks' titles start on the card's content edge,
             like the labels of the scope and settings cards (review walkthrough 15.11.). -->
        <Thickness x:Key="ExpanderHeaderMargin">0</Thickness>
        <!-- Every folded block sits in its own card, whose edge closes it: no extra rule under the block, folded or open. -->
        <Thickness x:Key="ExpanderContentBorderThickness">0</Thickness>
        <!-- The label column of a rule row: the label's first line is centred on the 32 dip control beside it ((32 - 16) / 2), so
             label and control share one line whatever the hint under the label or the chips under the control add below. -->
        <Thickness x:Key="Rules.LabelInset">0,8,0,0</Thickness>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- R6: the extensions field has the 32 dip input height of the fields around it (Ursa's tags and close buttons default to a 44 dip field);
             its tags stay readable and centred, the close button keeps a 16 dip hit area inside the tag. -->
        <Style Selector="ursa|TagInput /template/ Border#PART_RootBorder"><Setter Property="MinHeight" Value="32" /></Style>
        <Style Selector="ursa|TagInput /template/ :is(Control)#PART_ItemsControl"><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style Selector="ursa|TagInput ursa|ClosableTag /template/ Button#PART_CloseButton"><Setter Property="MinHeight" Value="16" /><Setter Property="MinWidth" Value="16" /><Setter Property="Padding" Value="4,0" /></Style>
        <!-- One rule row (the Settings row SP1: label cell with its hint on the left, the control in the 280 dip column), top-aligned
             so label and control share their first line; the stacked narrow row (ApplyRuleRowLayout) puts the label right above. -->
        <Style Selector="Grid.rule-row > StackPanel.rule-label">
            <Setter Property="Spacing" Value="{StaticResource Workspace.Space.4}" /><Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="{StaticResource Rules.LabelInset}" />
        </Style>
        <Style Selector="Grid.rule-row.rule-row-stacked > StackPanel.rule-label"><Setter Property="Margin" Value="0" /></Style>
        <Style Selector="Grid.rule-row > :is(Control)"><Setter Property="VerticalAlignment" Value="Top" /></Style>
        <!-- The card's edge closes its last visible row (MarkLastRuleRows), so no divider runs along the card's bottom inset. -->
        <!-- A refused Next marks the missing ID: the suggestion boxes draw their edge on the inner text box. -->
        <Style Selector="ursa|AutoCompleteBox.workspace-invalid /template/ TextBox#PART_TextBox"><Setter Property="BorderBrush" Value="{DynamicResource Workspace.Error}" /></Style>
        <Style Selector="StackPanel.rule-rows > Border.rule-row-last"><Setter Property="BorderThickness" Value="0" /></Style>
    </UserControl.Styles>
    <Grid RowDefinitions="*,Auto">
      <!-- The page area carries the shared page inset; the footer below it runs to the window edges. -->
      <Grid Margin="{StaticResource Workspace.Inset.Page}" RowDefinitions="Auto,*">
        <!-- Header like Sources: title and the one-line precedence subtitle; the overview's primary action sits on the right edge.
             A centred reading column without a toolbar row (like Settings): nothing above the header but the page inset (the title
             starts where every page title starts, PageHeader.PageTopOffset; LY-03) and 16 to the content, the gap between the overview's
             sections, so the first section title does not read as part of the header. -->
        <StackPanel x:Name="RulesHeader" Margin="0,0,0,16" MaxWidth="880" HorizontalAlignment="Center">
            <!-- The shared page head keeps help at the right edge when Create rule moves below the title. -->
            <controls:PageHeader x:Name="RulesHeaderRow">
                <StackPanel Classes="workspace-page-header">
                    <TextBlock x:Name="RulesTitle" Text="{Binding Title}" Classes="page-title" />
                    <TextBlock x:Name="RulesSubtitle" Text="{Binding Subtitle}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <!-- One primary "Create rule" at a time: while the empty state shows, its button is the page's primary action and this one
                     hides (IsHeaderCreateVisible); with rules or drafts listed it is the overview's primary action here. HB2: the precedence
                     line stays as the subtitle; the popover adds what the line cannot say. -->
                <WrapPanel x:Name="RulesHeaderActions" controls:PageHeader.Role="Actions" VerticalAlignment="Top">
                    <Button x:Name="CreateRuleButton" wv:WorkViewElement.Id="rules.overview.create" Classes="primary" VerticalAlignment="Top"
                            IsVisible="{Binding IsHeaderCreateVisible}" IsEnabled="{Binding IsEditable}" Click="OnCreateRule" />
                </WrapPanel>
                <controls:HelpButton x:Name="RulesHelpButton" controls:PageHeader.Role="Help" HelpKey="help.rules" />
            </controls:PageHeader>
        </StackPanel>
        <ScrollViewer x:Name="RulesScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="RulesContent" MaxWidth="880" HorizontalAlignment="Center" Spacing="{StaticResource Workspace.Space.12}">
                <!-- Overview (default): saved rules by scope, unsaved drafts and the built-in baseline; rows are built in RulesPage.Overview.cs.
                     A filled overview is top-aligned (rows 0 and 2 have no height). Only the empty state is placed in the free height:
                     ApplyOverviewEmptyLayout gives the grid the viewport's height and rows 0 and 2 the shares 1:2, so the empty state and
                     the defaults below it sit at about a third of the page; a short window leaves no free height and the stack scrolls. -->
                <Grid x:Name="RulesOverviewPanel" wv:WorkViewElement.Id="rules.overview" RowDefinitions="0,Auto,0" IsVisible="{Binding IsOverviewVisible}">
                <StackPanel x:Name="RulesOverviewStack" Grid.Row="1" Spacing="{StaticResource Workspace.Space.16}">
                    <!-- DS-P3 empty state: icon, headline, one sentence and the one primary action (Start from template is secondary). -->
                    <controls:WorkspaceEmptyState x:Name="RulesOverviewEmpty" IsVisible="False">
                        <ContentControl x:Name="RulesOverviewEmptyIcon" HorizontalAlignment="Center" Focusable="False" IsTabStop="False"
                                        Foreground="{DynamicResource Workspace.Muted}" />
                        <StackPanel Spacing="{StaticResource Workspace.Space.4}">
                            <TextBlock x:Name="RulesOverviewEmptyTitle" Classes="section-title" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <TextBlock x:Name="RulesOverviewEmptyText" Classes="workspace-empty-text" />
                        </StackPanel>
                        <WrapPanel x:Name="RulesOverviewEmptyActions" HorizontalAlignment="Center" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}">
                            <Button x:Name="CreateFirstRuleButton" Classes="primary" IsEnabled="{Binding IsEditable}" Click="OnCreateRule" />
                            <Button x:Name="StartFromTemplateButton" IsEnabled="{Binding IsEditable}" Click="OnStartFromTemplate" />
                        </WrapPanel>
                    </controls:WorkspaceEmptyState>
                    <StackPanel x:Name="RulesOverviewDrafts" wv:WorkViewElement.Id="rules.overview.drafts" Spacing="{StaticResource Workspace.Space.8}" IsVisible="False" />
                    <StackPanel x:Name="RulesOverviewSaved" Spacing="{StaticResource Workspace.Space.8}" IsVisible="False" />
                    <!-- The read-only baseline: one quiet card with its own small heading, static chips (no hover, no focus) and the hint. -->
                    <Border x:Name="RulesOverviewDefaults" wv:WorkViewElement.Id="rules.overview.defaults" Classes="workspace-card">
                        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                            <TextBlock x:Name="RulesOverviewDefaultsTitle" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <ContentControl x:Name="RulesOverviewDefaultsChips" Focusable="False" IsTabStop="False" />
                            <TextBlock x:Name="RulesOverviewDefaultsHint" Classes="workspace-help" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </Grid>
                <!-- Create/edit wizard (in-page detail like Sources and Plugins): 1 scope, 2 settings, 3 review. -->
                <StackPanel x:Name="RuleWizardPanel" Spacing="{StaticResource Workspace.Space.12}" IsVisible="{Binding IsWizardOpen}">
                    <!-- The editor's header row (Tom's rule 14.11. evening): Back to the rule overview at the far left, apart from the title and
                         steps by a gap and a separator (HeaderBar back slot); More alone on the right (Save and Discard stay in the footer). -->
                    <controls:HeaderBar x:Name="RuleWizardHeader">
                        <Button x:Name="RuleWizardCloseButton" controls:HeaderBar.IsBack="True" wv:WorkViewElement.Id="rules.wizard.close" VerticalAlignment="Top" Click="OnCloseWizard" />
                        <!-- Title and step chips on Back's line (32 dip, centred); a narrow row wraps the chips below the title. The chips name the
                             current step, so no caption repeats it: "Step n of 3 · …" is the chips' accessible name and polite live region. -->
                        <WrapPanel x:Name="RuleWizardHeading" ItemSpacing="{StaticResource Workspace.Space.16}" LineSpacing="{StaticResource Workspace.Space.4}">
                            <Border MinHeight="{StaticResource Workspace.Size.Control}">
                                <TextBlock x:Name="RulesEditingHeader" wv:WorkViewElement.Id="rules.scope.editing-header" Text="{Binding EditingLabel}" Classes="section-title" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Border>
                            <WrapPanel x:Name="RuleWizardSteps" wv:WorkViewElement.Id="rules.wizard.steps" VerticalAlignment="Center" ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.8}"
                                       AutomationProperties.Name="{Binding WizardStepLabel}" AutomationProperties.LiveSetting="Polite">
                                <Button x:Name="RuleWizardStepScope" Classes="chip" Click="OnWizardStepClick" Tag="1" />
                                <Button x:Name="RuleWizardStepSettings" Classes="chip" Click="OnWizardStepClick" Tag="2" />
                                <Button x:Name="RuleWizardStepReview" Classes="chip" Click="OnWizardStepClick" Tag="3" />
                            </WrapPanel>
                        </WrapPanel>
                        <Button x:Name="RulesMoreButton" controls:HeaderBar.IsEnd="True" Classes="subtle icon-square" VerticalAlignment="Top" IsVisible="False" Click="OnRulesMoreClick" />
                    </controls:HeaderBar>
                    <!-- Step 1: the scope. Its identity stays fixed while its values are edited; an existing rule or draft opens from the overview or below. -->
                    <StackPanel x:Name="RuleWizardScopeStep" Spacing="{StaticResource Workspace.Space.12}" IsEnabled="{Binding IsEditable}">
                        <!-- Rows like Settings: label and its hint on the left, the control in the 280 dip column, one divider per row. -->
                        <Border x:Name="NewRuleScopePanel" wv:WorkViewElement.Id="rules.scope.new" Classes="workspace-section">
                        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                        <StackPanel x:Name="NewRuleScopeRows" Classes="rule-rows" Spacing="0">
                            <Border Classes="settings-divider">
                                <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                    <StackPanel Classes="rule-label">
                                        <TextBlock Classes="workspace-field-label" Text="{Binding ScopeKindLabel}" />
                                        <TextBlock Text="{Binding IdentityHint}" Classes="workspace-help" />
                                    </StackPanel>
                                    <ComboBox x:Name="NewRuleScopeKindInput" Grid.Column="1" AutomationProperties.Name="{Binding ScopeKindLabel}" ItemsSource="{Binding ScopeKindChoices}" SelectedIndex="{Binding NewScopeKind, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <Border Classes="settings-divider" IsVisible="{Binding NeedsSource}">
                                <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                    <StackPanel Classes="rule-label">
                                        <TextBlock Classes="workspace-field-label" Text="{Binding SourceIdLabel}" />
                                        <TextBlock x:Name="RuleSuggestionsHint" Classes="workspace-help" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Classes="workspace-field">
                                        <desktop:IdentitySuggestionBox x:Name="NewRuleSourceInput" Text="{Binding NewSourceId, Mode=TwoWay}" PlaceholderText="4chan" />
                                        <Button x:Name="RuleRetrySuggestions" HorizontalAlignment="Left" IsVisible="False" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Classes="settings-divider" IsVisible="{Binding NeedsBoard}">
                                <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                    <StackPanel Classes="rule-label"><TextBlock Classes="workspace-field-label" Text="{Binding BoardIdLabel}" /></StackPanel>
                                    <desktop:IdentitySuggestionBox x:Name="NewRuleBoardInput" Grid.Column="1" Text="{Binding NewBoardId, Mode=TwoWay}" PlaceholderText="g" />
                                </Grid>
                            </Border>
                            <Border Classes="settings-divider" IsVisible="{Binding NeedsThread}">
                                <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                    <StackPanel Classes="rule-label"><TextBlock Classes="workspace-field-label" Text="{Binding ThreadIdLabel}" /></StackPanel>
                                    <TextBox x:Name="NewRuleThreadInput" Grid.Column="1" AutomationProperties.Name="{Binding ThreadIdLabel}" Text="{Binding NewThreadId, Mode=TwoWay}" PlaceholderText="123" />
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- One rule per scope: when the entered scope already has a saved rule, Next opens it for editing, and this says so first. -->
                        <controls:WorkspaceBanner x:Name="RuleScopeExistsNote" Type="Information" IsVisible="{Binding HasExistingScopeRule}">
                            <TextBlock Text="{Binding ExistingScopeRuleNote}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </controls:WorkspaceBanner>
                        </StackPanel>
                        </Border>
                        <!-- A folded block in its own card, like Image filter and Rule templates in step 2: the same edge and inset. -->
                        <Border Classes="workspace-section">
                        <Expander x:Name="RuleSavedScopesExpander" wv:WorkViewElement.Id="rules.scope.saved" AutomationProperties.Name="{Binding SavedScopesLabel}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <Expander.Header><TextBlock Text="{Binding SavedScopesLabel}" Classes="section-title" TextWrapping="Wrap" /></Expander.Header>
                            <StackPanel Classes="workspace-field" Margin="0,8,0,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.8}">
                                    <ComboBox x:Name="RulesScopeList" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding SavedScopesLabel}"
                                              ItemsSource="{Binding ScopeChoices}" SelectedItem="{Binding SelectedScopeChoice, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate><DataTemplate x:DataType="local:RuleScopeChoice"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="OpenSavedRuleButton" Grid.Column="1" Click="OnOpenSavedScope" />
                                </Grid>
                                <TextBlock Text="{Binding ScopeCountLabel}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                        </Border>
                    </StackPanel>
                    <!-- Step 2: the settings of the chosen scope. -->
                    <StackPanel x:Name="RuleWizardSettingsStep" Spacing="{StaticResource Workspace.Space.12}">
                <Border Classes="workspace-section"><StackPanel Spacing="0" IsEnabled="{Binding IsEditable}">
                    <!-- The edited scope is named in the header row above; its breadcrumb and parent link start the card. -->
                    <Grid x:Name="RuleBreadcrumbRow" wv:WorkViewElement.Id="rules.scope.breadcrumb" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.8}" Margin="0,0,0,8">
                        <ursa:Breadcrumb x:Name="RuleScopeBreadcrumb" VerticalAlignment="Center"><ursa:Breadcrumb.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ursa:Breadcrumb.ItemsPanel></ursa:Breadcrumb>
                        <Button x:Name="OpenParentRuleButton" Grid.Column="1" VerticalAlignment="Center" IsVisible="False" Click="OnOpenParentScope" />
                    </Grid>
                    <CheckBox x:Name="RuleEnabledInput" Content="{Binding EnabledLabel}" IsChecked="{Binding RuleEnabled, Mode=TwoWay}" />
                    <TextBlock Text="{Binding EnabledHint}" Classes="workspace-help" TextWrapping="Wrap" Margin="0,4,0,8" />
                    <!-- Each value is a rule row; its own value (extensions, limit) follows as a row of its own with the hint under its label. -->
                    <StackPanel x:Name="RuleSettingsRows" Classes="rule-rows" IsEnabled="{Binding RuleEnabled}">
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                <StackPanel Classes="rule-label"><TextBlock Text="{Binding TypesLabel}" Classes="workspace-field-label" /></StackPanel>
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <ComboBox x:Name="RuleTypesModeInput" AutomationProperties.Name="{Binding TypesLabel}" ItemsSource="{Binding TypesModeChoices}" SelectedIndex="{Binding TypesMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <!-- The inherited or own value as a quiet chip, its origin as a muted line beside it. -->
                                    <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                                        <Border Classes="chip chip-badge chip-neutral" VerticalAlignment="Center"><TextBlock Text="{Binding EffectiveTypesLabel}" Classes="chip-label" TextWrapping="Wrap" /></Border>
                                        <TextBlock Text="{Binding TypesOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider" IsVisible="{Binding HasTypeSelection}">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                <StackPanel Classes="rule-label">
                                    <TextBlock Text="{Binding ExtensionsLabel}" Classes="workspace-field-label" />
                                    <TextBlock Text="{Binding ExtensionsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <controls:RuleExtensionsInput x:Name="RuleExtensionsInput" PlaceholderText="JPG, PNG, WebM" />
                                    <TextBlock x:Name="RuleExtensionsErrorText" Text="{Binding ExtensionsError}" Classes="workspace-error" TextWrapping="Wrap" IsVisible="{Binding HasExtensionsError}" AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                <StackPanel Classes="rule-label"><TextBlock Text="{Binding SizeLabel}" Classes="workspace-field-label" /></StackPanel>
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <ComboBox x:Name="RuleSizeModeInput" AutomationProperties.Name="{Binding SizeLabel}" ItemsSource="{Binding SizeModeChoices}" SelectedIndex="{Binding SizeMode, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                                    <!-- The inherited or own value as a quiet chip, its origin as a muted line beside it. -->
                                    <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                                        <Border Classes="chip chip-badge chip-neutral" VerticalAlignment="Center"><TextBlock Text="{Binding EffectiveSizeLabel}" Classes="chip-label" TextWrapping="Wrap" /></Border>
                                        <TextBlock Text="{Binding SizeOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider" IsVisible="{Binding HasSizeLimit}">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                <StackPanel Classes="rule-label">
                                    <TextBlock Text="{Binding MegabytesLabel}" Classes="workspace-field-label" />
                                    <TextBlock Text="{Binding MegabytesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <TextBox AutomationProperties.Name="{Binding MegabytesLabel}" AutomationProperties.HelpText="{Binding MegabytesHint}" x:Name="RuleMegabytesInput" Text="{Binding MegabytesText, Mode=TwoWay}" PlaceholderText="10" />
                                    <TextBlock x:Name="RuleMegabytesErrorText" Text="{Binding MegabytesError}" Classes="workspace-error" TextWrapping="Wrap" IsVisible="{Binding HasMegabytesError}" AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel></Border>
                <Border Classes="workspace-section">
                    <!-- Folded in Barebones; an active filter opens it and names itself in the header. -->
                    <Expander x:Name="RulePluginExpander" wv:WorkViewElement.Id="rules.plugin-filter" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><TextBlock x:Name="RulePluginHeader" Classes="section-title" TextWrapping="Wrap" /></Expander.Header>
                        <StackPanel x:Name="RulePluginPanel" Spacing="{StaticResource Workspace.Space.8}" Margin="0,8,0,0" />
                    </Expander>
                </Border>
                <Border x:Name="RuleTemplatesCard" wv:WorkViewElement.Id="rules.templates" Classes="workspace-section">
                    <!-- Under More in Barebones (their shortcuts keep working), folded in Simple. -->
                    <Expander x:Name="RuleTemplatesExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header><TextBlock x:Name="RuleTemplatesHeader" Classes="section-title" TextWrapping="Wrap" /></Expander.Header>
                        <StackPanel x:Name="RuleTemplatesPanel" Spacing="{StaticResource Workspace.Space.8}" Margin="0,8,0,0" />
                    </Expander>
                </Border>
                    </StackPanel>
                    <!-- Step 3: what applies after saving, field by field with its origin; validation and the way to an invalid field stay here. -->
                    <StackPanel x:Name="RuleWizardReviewStep" Spacing="{StaticResource Workspace.Space.12}">
                <Border x:Name="RulePreviewSection" wv:WorkViewElement.Id="rules.preview" Classes="workspace-section">
                    <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                    <TextBlock x:Name="RulePreviewHeading" Text="{Binding PreviewTitle}" Classes="section-title" TextWrapping="Wrap" Focusable="True" />
                    <controls:WorkspaceBanner Type="Error" IsVisible="{Binding HasValidationBanner}">
                        <TextBlock x:Name="RuleValidationSummary" Focusable="True" Text="{Binding ValidationMessage}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </controls:WorkspaceBanner>
                    <WrapPanel x:Name="RulePreviewBlocked" wv:WorkViewElement.Id="rules.preview.blocked" IsVisible="{Binding HasPreviewBlocked}" ItemSpacing="{StaticResource Workspace.Space.12}" LineSpacing="{StaticResource Workspace.Space.8}">
                        <TextBlock Text="{Binding PreviewBlockedLabel}" Classes="workspace-meta" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="RuleGoToInvalidFieldButton" Content="{Binding GoToFieldLabel}" Click="OnGoToInvalidField" />
                    </WrapPanel>
                    <StackPanel Spacing="0" IsVisible="{Binding HasPreview}">
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                <TextBlock Text="{Binding TypesLabel}" VerticalAlignment="Top" FontWeight="Medium" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <TextBlock x:Name="RuleEffectiveTypes" Text="{Binding EffectiveTypesLabel}" TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                                        <TextBlock x:Name="RuleTypesOrigin" Text="{Binding TypesOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Name="OpenTypesOriginButton" wv:WorkViewElement.Id="rules.preview.origin-types" Classes="link" Padding="4,0" MinHeight="24" VerticalAlignment="Center" IsEnabled="{Binding CanOpenTypesOrigin}" IsVisible="False"
                                                Click="OnOpenTypesOrigin" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider">
                            <Grid Classes="rule-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Form.Gap}">
                                <TextBlock Text="{Binding SizeLabel}" VerticalAlignment="Top" FontWeight="Medium" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Classes="workspace-field">
                                    <TextBlock x:Name="RuleEffectiveSize" Text="{Binding EffectiveSizeLabel}" TextWrapping="Wrap" />
                                    <WrapPanel ItemSpacing="{StaticResource Workspace.Space.8}" LineSpacing="{StaticResource Workspace.Space.4}">
                                        <TextBlock x:Name="RuleSizeOrigin" Text="{Binding SizeOriginLabel}" Classes="workspace-help" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <Button x:Name="OpenSizeOriginButton" wv:WorkViewElement.Id="rules.preview.origin-size" Classes="link" Padding="4,0" MinHeight="24" VerticalAlignment="Center" IsEnabled="{Binding CanOpenSizeOrigin}" IsVisible="False"
                                                Click="OnOpenSizeOrigin" />
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding FutureHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding UnknownHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
      </Grid>
        <!-- The footer bar (the Settings footer pattern) shows while the editor is open and on the overview only while it has
             something to say: saving, a confirmation, an error. The idle "n saved rules" line repeated the list's own heading. -->
        <Border x:Name="RulesFooterBar" Grid.Row="1" Classes="workspace-dialog-footer" IsVisible="{Binding HasFooter}">
            <Grid x:Name="RulesFooter" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.12}" RowSpacing="{StaticResource Workspace.Space.8}"
                  HorizontalAlignment="Center">
                <ScrollViewer MaxHeight="80" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel VerticalAlignment="Center">
                        <!-- A DockPanel, not a horizontal StackPanel: the stack measured the status at infinite width, so a long line never wrapped
                             and was cut at the footer's edge in a narrow window. -->
                        <DockPanel>
                            <ursa:LoadingIcon DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" IsLoading="{Binding IsBusy}" Focusable="False" />
                            <TextBlock x:Name="RuleStatusText" Text="{Binding StatusMessage}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasStatus}" AutomationProperties.LiveSetting="{Binding StatusLiveSetting}" />
                        </DockPanel>
                        <controls:WorkspaceBanner Type="Error" IsVisible="{Binding HasError}">
                            <TextBlock x:Name="RuleActionError" Focusable="True" Text="{Binding ErrorMessage}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </controls:WorkspaceBanner>
                    </StackPanel>
                </ScrollViewer>
                <WrapPanel x:Name="RulesFooterActions" Classes="workspace-actions" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsWizardOpen}">
                    <Button x:Name="RuleWizardBackButton" wv:WorkViewElement.Id="rules.wizard.back" Click="OnWizardBack" />
                    <Button x:Name="DiscardRuleButton" wv:WorkViewElement.Id="rules.footer.discard" IsEnabled="{Binding IsEditable}" Click="OnDiscardDraft" />
                    <Button x:Name="RuleWizardNextButton" wv:WorkViewElement.Id="rules.wizard.next" Click="OnWizardNext" />
                    <Button x:Name="OpenNewRuleScopeButton" Classes="primary" IsEnabled="{Binding IsEditable}" Click="OnOpenNewScope" />
                    <Button x:Name="SaveRuleButton" wv:WorkViewElement.Id="rules.footer.save" Classes="primary" IsEnabled="{Binding CanSave}" Click="OnSaveRule" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
