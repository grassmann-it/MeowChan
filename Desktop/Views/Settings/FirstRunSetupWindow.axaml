<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:desktop="clr-namespace:MeowChan.Desktop"
        x:Class="MeowChan.Desktop.FirstRunSetupWindow"
        Width="720" Height="700" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="{x:Static desktop:WorkspaceMetrics.TitleBarHeight}"
        Background="{DynamicResource Workspace.Background}" Foreground="{DynamicResource Workspace.Text}">
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource Workspace.Background}">
        <desktop:WindowChromeBar x:Name="AppCaption" />
        <!-- UX103 P7 dialog frame: fixed header, local error strip, scrolling body, fixed footer.
             No inner Tab cycle: the window cycle keeps the caption buttons reachable. -->
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto">
            <Border x:Name="DialogFrameHeader" Padding="20,16,20,8">
                <StackPanel Spacing="6">
                    <TextBlock x:Name="SetupHeading" Classes="section-title" FontSize="23" />
                    <TextBlock x:Name="SetupIntroduction" Classes="workspace-help" />
                </StackPanel>
            </Border>
            <Border x:Name="DialogFrameErrorStrip" Grid.Row="1" Padding="20,0,20,8">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.Or}">
                        <Binding ElementName="SetupError" Path="IsVisible" />
                        <Binding ElementName="SetupCleanupWarning" Path="Text" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
                    </MultiBinding>
                </Border.IsVisible>
                <Border Classes="workspace-error">
                    <ScrollViewer MaxHeight="120" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="6">
                            <TextBlock x:Name="SetupError" Classes="workspace-error" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            <TextBlock x:Name="SetupCleanupWarning" Classes="workspace-error" AutomationProperties.LiveSetting="Assertive"
                                       IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Border>
            <ScrollViewer x:Name="DialogFrameBody" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="20,4,20,16">
                    <StackPanel x:Name="SetupFields" Spacing="10">
                        <TextBlock x:Name="SetupFolderLabel" Classes="workspace-field-label" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox x:Name="SetupFolderInput" TextChanged="OnDraftChanged" AutomationProperties.LabeledBy="{Binding ElementName=SetupFolderLabel}" />
                            <Button x:Name="SetupBrowseButton" Grid.Column="1" Click="OnBrowseClick" />
                        </Grid>
                        <TextBlock x:Name="SetupNormalizedPath" Classes="workspace-help" />
                        <TextBlock x:Name="SetupPathError" Classes="workspace-error" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="SetupBandwidthLabel" Classes="workspace-field-label" />
                        <TextBox x:Name="SetupBandwidthInput" TextChanged="OnDraftChanged" AutomationProperties.LabeledBy="{Binding ElementName=SetupBandwidthLabel}" />
                        <TextBlock x:Name="SetupParallelLabel" Classes="workspace-field-label" />
                        <TextBox x:Name="SetupParallelInput" TextChanged="OnDraftChanged" AutomationProperties.LabeledBy="{Binding ElementName=SetupParallelLabel}" />
                        <TextBlock x:Name="SetupEffectiveParallelLimit" Classes="workspace-help" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="SetupParallelSafetyHint" Classes="workspace-help" />
                        <TextBlock x:Name="SetupLimitsError" Classes="workspace-error" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="SetupReserveHint" Classes="workspace-help" />
                        <TextBlock x:Name="SetupScopeHint" Classes="workspace-help" />
                        <TextBlock x:Name="SetupProbePolicy" Classes="workspace-help" />
                        <Button x:Name="SetupCheckButton" Click="OnCheckClick" HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <Border x:Name="DialogFrameFooter" Grid.Row="3" Classes="workspace-dialog-footer">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="SetupStatus" AutomationProperties.LiveSetting="Polite"
                               IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <WrapPanel ItemSpacing="8" LineSpacing="8" HorizontalAlignment="Right">
                        <Button x:Name="SetupCancelCheckButton" Click="OnCancelCheckClick" IsVisible="False" />
                        <Button x:Name="SetupLaterButton" Click="OnLaterClick" />
                        <Button x:Name="SetupAcceptButton" Classes="primary" Click="OnAcceptClick" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
