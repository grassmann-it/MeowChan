<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeowChan" xmlns:desktop="clr-namespace:MeowChan.Desktop"
        x:Class="MeowChan.SettingsWindow" x:DataType="local:SettingsEditor"
        Title="{Binding SettingsTitle}"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="{x:Static desktop:WorkspaceMetrics.TitleBarHeight}"
        Background="{DynamicResource Workspace.Background}" Foreground="{DynamicResource Workspace.Text}">
    <Grid RowDefinitions="Auto,*" Background="{DynamicResource Workspace.Background}">
        <desktop:WindowChromeBar x:Name="AppCaption" />
        <ContentControl x:Name="EditorHost" Grid.Row="1" />
    </Grid>
</Window>
