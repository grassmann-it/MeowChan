                        </Grid>
                    </Border>
                    <StackPanel x:Name="TaggingCardsPanel" Spacing="0" Margin="0,8,0,0">
                        <TextBlock x:Name="TaggingCardsHeading" Text="{Binding TaggingCardsHeadingLabel}" Classes="workspace-field-label settings-subheading" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TaggingCardSlotsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Border Classes="settings-divider">
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                                <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
