                </StackPanel>
                <StackPanel x:Name="SettingsDownloadsPage" Spacing="0" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <Grid Classes="settings-section-header" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.12}">
                        <TextBlock x:Name="SettingsDownloadsHeading" Text="{Binding DownloadsTitle}" Classes="section-title" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="ResetDownloadsButton" Tag="settings.downloads" Classes="subtle" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetDownloadsLabel}" ToolTip.Tip="{Binding ResetDownloadsLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" Grid.Column="1" />
                    </Grid>
                    <StackPanel Classes="workspace-field settings-wide" Margin="0,0,0,12">
                        <TextBlock x:Name="DownloadPathFieldLabel" Text="{Binding DownloadPathLabel}" Classes="workspace-field-label" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.8}">
                            <TextBox x:Name="DownloadPathInput" AutomationProperties.LabeledBy="{Binding ElementName=DownloadPathFieldLabel}" AutomationProperties.Name="{Binding DownloadPathLabel}" AutomationProperties.HelpText="{Binding DownloadPathHelp}" Text="{Binding DownloadPath, Mode=TwoWay}" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowseButtonClick" />
                            <Button x:Name="CheckDestinationButton" Grid.Column="2" Content="{Binding CheckDestinationLabel}" AutomationProperties.Name="{Binding CheckDestinationLabel}" Click="OnCheckDestinationClick" />
                        </Grid>
                        <TextBlock x:Name="NormalizedDestinationPreview" Text="{Binding NormalizedDestination}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DestinationScopeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DestinationPolicyHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock x:Name="DestinationCheckStatus" Text="{Binding DestinationStatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding DestinationCleanupWarning}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="DownloadPathInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="BandwidthFieldLabel" Text="{Binding BandwidthLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding BandwidthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="BandwidthInput" AutomationProperties.LabeledBy="{Binding ElementName=BandwidthFieldLabel}" AutomationProperties.Name="{Binding BandwidthLabel}" AutomationProperties.HelpText="{Binding BandwidthInputHelp}" Value="{Binding BandwidthLimiterMB, Mode=TwoWay}" Minimum="0" Maximum="100000" Increment="0.1" />
                                <TextBlock x:Name="BandwidthInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ParallelFieldLabel" Text="{Binding ParallelLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ParallelHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ParallelDownloadsInput" AutomationProperties.LabeledBy="{Binding ElementName=ParallelFieldLabel}" AutomationProperties.Name="{Binding ParallelLabel}" Value="{Binding MaxParallelDownloads, Mode=TwoWay}" Minimum="1" Maximum="256" Increment="1" AutomationProperties.HelpText="{Binding ParallelDownloadsHelp}" />
                                <TextBlock x:Name="ParallelDownloadsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ParallelEffectiveLine" Margin="0,2,0,0" Text="{Binding ParallelEffectiveText}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.LiveSetting="Polite" />
                    <Expander x:Name="SettingsDownloadsMoreGroup" wv:WorkViewElement.Id="settings.group.downloads-more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                        <StackPanel x:Name="SettingsDownloadsMoreBody" Spacing="0" Margin="0,8,0,0">
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="RecheckFieldLabel" Text="{Binding RecheckLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="RecheckTimerInput" AutomationProperties.LabeledBy="{Binding ElementName=RecheckFieldLabel}" AutomationProperties.Name="{Binding RecheckLabel}" AutomationProperties.HelpText="{Binding RecheckTimerHelp}" Value="{Binding RecheckTimer, Mode=TwoWay}" Minimum="10" Maximum="4294967" Increment="1" />
                                <TextBlock x:Name="RecheckTimerInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ParallelSafetyFieldLabel" Text="{Binding ParallelSafetyLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding ParallelSafetyHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ParallelDownloadsSafetyInput" AutomationProperties.LabeledBy="{Binding ElementName=ParallelSafetyFieldLabel}" AutomationProperties.Name="{Binding ParallelSafetyLabel}" Value="{Binding ParallelDownloadsSafetyLimit, Mode=TwoWay}" Minimum="1" Maximum="256" Increment="1" AutomationProperties.HelpText="{Binding ParallelDownloadsSafetyHelp}" />
                                <TextBlock x:Name="ParallelDownloadsSafetyInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="SettingsWorkerBudgetsPage" Spacing="0" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <Grid Classes="settings-section-header" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.12}">
                        <controls:LabelHelpPanel Spacing="{StaticResource Workspace.Space.8}">
                            <TextBlock x:Name="SettingsWorkerBudgetsPageTitle" Text="{Binding StorageLimitsLabel}" Classes="section-title" TextWrapping="Wrap" />
                            <controls:HelpButton x:Name="StorageLimitsHelpButton" HelpKey="help.limits" />
                        </controls:LabelHelpPanel>
                        <Button x:Name="ResetWorkerBudgetsButton" Tag="settings.worker-budgets" Classes="subtle" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetWorkerBudgetsLabel}" ToolTip.Tip="{Binding ResetWorkerBudgetsLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" Grid.Column="1" />
                    </Grid>
                    <TextBlock x:Name="StorageLimitsIntroText" Text="{Binding StorageLimitsIntro}" Classes="workspace-help" TextWrapping="Wrap" />
                    <StackPanel x:Name="ProfileFolderRow" Classes="workspace-field settings-wide" Spacing="{StaticResource Workspace.Space.4}">
                        <TextBlock x:Name="ProfileFolderFieldLabel" Text="{Binding ProfileFolderLabel}" Classes="workspace-field-label" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.8}">
                            <SelectableTextBlock x:Name="ProfileFolderPathText" Text="{Binding ProfileFolderPath}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ProfileFolderFieldLabel}" AutomationProperties.Name="{Binding ProfileFolderLabel}" />
                            <Button x:Name="ProfileFolderOpenButton" Grid.Column="1" Content="{Binding ProfileFolderOpenLabel}" AutomationProperties.Name="{Binding ProfileFolderOpenLabel}" Click="OnOpenProfileFolderClick" />
                        </Grid>
                        <TextBlock Text="{Binding ProfileFolderHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock x:Name="ProfileFolderOpenError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" wv:WorkViewElement.Id="settings.safety.reserve" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ReserveFieldLabel" Text="{Binding ReserveLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReserveHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ReserveInput" Value="{Binding MinimumFreeSpaceGiB, Mode=TwoWay}" Minimum="0" Maximum="65536" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReserveFieldLabel}" AutomationProperties.Name="{Binding ReserveLabel}" AutomationProperties.HelpText="{Binding ReserveInputHelp}" />
                                <TextBlock x:Name="ReserveInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Media folders (read-only folder sources, moved here from the Plugins page 14.11.2026): heading and explanation are the
                         search entry "MediaFolders"; the list below is built by the shell's folder services (SettingsEditor.MediaFolders.cs). -->
                    <StackPanel x:Name="MediaFolders" Spacing="{StaticResource Workspace.Space.4}" Margin="0,8,0,0">
                        <TextBlock x:Name="MediaFoldersHeading" Text="{Binding MediaFoldersLabel}" Classes="workspace-field-label settings-subheading" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MediaFoldersHelp}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MediaFoldersLimitsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                    <ContentControl x:Name="MediaFoldersHost" HorizontalContentAlignment="Stretch" />
                    <Expander x:Name="SettingsLimitsGroup" wv:WorkViewElement.Id="settings.group.limits" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="SettingsLimitsBody" Spacing="0" Margin="0,8,0,0">
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="BooruCatalogMiBFieldLabel" Text="{Binding BooruCatalogMiBLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding BooruCatalogMiBHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
