<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ursa="https://irihi.tech/ursa"
             xmlns:local="clr-namespace:MeowChan"
             xmlns:commands="clr-namespace:MeowChan.Desktop.Commands"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls"
             xmlns:wv="using:MeowChan.Desktop.WorkViews"
             xmlns:localization="clr-namespace:MeowChan.Desktop.Localization"
             x:Class="MeowChan.SettingsEditor" x:DataType="local:SettingsEditor"
             SizeChanged="OnEditorSizeChanged">
    <UserControl.Styles>
        <Style Selector="ToggleButton.settings-category">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- D4: the chosen category carries a 3-px accent bar besides the tint; the bar's width is always reserved. -->
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="10,7" />
        </Style>
        <Style Selector="ToggleButton.settings-category:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        </Style>
        <!-- The setting the search jumped to. -->
        <Style Selector="Panel.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <Style Selector="Border.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <Style Selector="CheckBox.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <Style Selector="TextBlock.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <!-- Keyboard focus enters the template's text box, so it needs the field semantics too. -->
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="AutomationProperties.Name" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="AutomationProperties.LabeledBy" Value="{Binding (AutomationProperties.LabeledBy), RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_IncreaseButton">
            <Setter Property="AutomationProperties.Name">
                <MultiBinding Converter="{x:Static local:SettingsEditor.NumericActionNameConverter}">
                    <Binding Path="IncreaseNumericValueFormat" />
                    <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource FindAncestor, AncestorType=NumericUpDown}" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_DecreaseButton">
            <Setter Property="AutomationProperties.Name">
                <MultiBinding Converter="{x:Static local:SettingsEditor.NumericActionNameConverter}">
                    <Binding Path="DecreaseNumericValueFormat" />
                    <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource FindAncestor, AncestorType=NumericUpDown}" />
                </MultiBinding>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel x:Name="SettingsHeader" Classes="workspace-page-header" Margin="20,12,20,12" MaxWidth="1088" HorizontalAlignment="Center">
            <TextBlock Text="{Binding SettingsTitle}" Classes="page-title" />
            <TextBlock Text="{Binding SettingsSubtitle}" Classes="muted" TextWrapping="Wrap" />
            <Button x:Name="SettingsMoreButton" Classes="ghost" AutomationProperties.Name="{Binding SettingsMoreLabel}" Click="OnSettingsMoreClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
            <Button x:Name="ResetAllSettingsButton" Classes="ghost" Content="{Binding ResetAllLabel}" AutomationProperties.Name="{Binding ResetAllLabel}" Click="OnResetAllClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
            <TextBlock x:Name="SettingsResetStatus" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Right" />
        </StackPanel>
        <Grid x:Name="SettingsFormLayout" Grid.Row="1" ColumnDefinitions="176,*" RowDefinitions="Auto,*" ColumnSpacing="16" Margin="20,0,20,16" MaxWidth="1088" HorizontalAlignment="Center">
            <desktop:SectionNavigationControl x:Name="SettingsSections" Grid.ColumnSpan="2" Margin="0,0,0,12" />
            <ScrollViewer x:Name="SettingsCategories" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                <StackPanel x:Name="SettingsCategoryLinks" Spacing="4" IsEnabled="{Binding IsEditable}" />
            </ScrollViewer>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnSettingsScrollChanged">
            <StackPanel x:Name="SettingsContent" MaxWidth="880" HorizontalAlignment="Center" Spacing="16">
                <StackPanel x:Name="SettingsInterfacePage" Spacing="0" IsEnabled="{Binding IsEditable}">
                    <TextBlock x:Name="SettingsInterfaceHeading" Text="{Binding InterfaceTitle}" Classes="section-title" Margin="0,0,0,8" />
                    <Button x:Name="ResetInterfaceButton" Tag="settings.interface" Classes="ghost" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetInterfaceLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="WorkspaceModeFieldLabel" Text="{Binding WorkspaceModeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ModeHint}" Classes="workspace-help" />
                            </StackPanel>
                            <ComboBox x:Name="WorkspaceModeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=WorkspaceModeFieldLabel}" AutomationProperties.Name="{Binding WorkspaceModeLabel}" AutomationProperties.HelpText="{Binding ModeHint}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding WorkspaceChoices}" SelectedItem="{Binding SelectedWorkspaceMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="LanguageFieldLabel" Text="{Binding LanguageLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <ComboBox x:Name="LanguageInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=LanguageFieldLabel}" AutomationProperties.Name="{Binding LanguageLabel}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="localization:LanguageInfo"><TextBlock Text="{Binding NativeName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="ThemeFieldLabel" Text="{Binding ThemeLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <ComboBox x:Name="ThemeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ThemeFieldLabel}" AutomationProperties.Name="{Binding ThemeLabel}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Expander x:Name="SettingsInterfaceMoreGroup" wv:WorkViewElement.Id="settings.group.interface-more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                        <StackPanel x:Name="SettingsInterfaceMoreBody" Spacing="0" Margin="0,8,0,0">
                    <CheckBox x:Name="ShrinkWindowForBarebonesInput" IsChecked="{Binding ShrinkWindowForBarebones, Mode=TwoWay}" AutomationProperties.Name="{Binding ShrinkWindowForBarebonesLabel}" AutomationProperties.HelpText="{Binding ShrinkWindowForBarebonesHint}">
                        <TextBlock Text="{Binding ShrinkWindowForBarebonesLabel}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="{Binding ShrinkWindowForBarebonesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="AnimationsFieldLabel" Text="{Binding AnimationsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AnimationsHint}" Classes="workspace-help" />
                            </StackPanel>
                            <ComboBox x:Name="AnimationsInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=AnimationsFieldLabel}" AutomationProperties.Name="{Binding AnimationsLabel}" AutomationProperties.HelpText="{Binding AnimationsHint}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding AnimationsChoices}" SelectedItem="{Binding SelectedAnimations, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="DensityFieldLabel" Text="{Binding DensityLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <CheckBox x:Name="CompactDensityInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=DensityFieldLabel}" AutomationProperties.Name="{Binding DensityLabel}" Grid.Column="1" Content="{Binding CompactLabel}" IsChecked="{Binding CompactDensity, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="HeaderTaglineFieldLabel" Text="{Binding HeaderTaglineLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HeaderTaglineHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HeaderTaglineInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=HeaderTaglineFieldLabel}" AutomationProperties.Name="{Binding HeaderTaglineLabel}" AutomationProperties.HelpText="{Binding HeaderTaglineHint}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding HeaderTaglineChoices}" SelectedItem="{Binding SelectedHeaderTagline, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsEnabled="{Binding HeaderTaglineFixedEnabled}">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="HeaderTaglineFixedFieldLabel" Text="{Binding HeaderTaglineFixedLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HeaderTaglineFixedHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HeaderTaglineFixedIdInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=HeaderTaglineFixedFieldLabel}" AutomationProperties.Name="{Binding HeaderTaglineFixedLabel}" AutomationProperties.HelpText="{Binding HeaderTaglineFixedHint}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding HeaderTaglineFixedChoices}" SelectedItem="{Binding SelectedHeaderTaglineFixed, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                        </StackPanel>
                    </Expander>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{Binding LanguagePacksLabel}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding LanguagePacksHint}" Classes="workspace-help" Margin="0,8,0,0" />
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="SettingsReadingMediaPage" Spacing="8" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <TextBlock x:Name="SettingsReadingMediaHeading" Text="{Binding ReadingMediaTitle}" Classes="section-title" />
                    <Button x:Name="ResetReadingMediaButton" Tag="settings.reading-media" Classes="ghost" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetReadingMediaLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                    <Expander x:Name="SettingsReadingMediaGroup" wv:WorkViewElement.Id="settings.group.reading-media" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="SettingsReadingMediaBody" Spacing="8" Margin="0,8,0,0">
                            <TextBlock x:Name="ReaderDisplayHeading" Text="{Binding ReaderDisplayTitle}" Classes="workspace-field-label" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="ReadingFontSizeFieldLabel" Text="{Binding ReadingFontSizeLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <ComboBox x:Name="ReadingFontSizeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ReadingFontSizeFieldLabel}" AutomationProperties.Name="{Binding ReadingFontSizeLabel}" Grid.Column="1" ItemsSource="{Binding ReadingFontSizeChoices}" SelectedItem="{Binding SelectedReadingFontSize, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="ReaderPostWidthFieldLabel" Text="{Binding ReaderPostWidthLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderPostWidthHint}" Classes="workspace-help" />
                            </StackPanel>
                            <ComboBox x:Name="ReaderPostWidthInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ReaderPostWidthFieldLabel}" AutomationProperties.Name="{Binding ReaderPostWidthLabel}" AutomationProperties.HelpText="{Binding ReaderPostWidthHint}" Grid.Column="1" ItemsSource="{Binding ReaderPostWidthChoices}" SelectedItem="{Binding SelectedReaderPostWidth, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <StackPanel Spacing="4">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                            <TextBlock x:Name="ReaderThumbnailWidthFieldLabel" Text="{Binding ReaderThumbnailWidthLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ReaderThumbnailWidthInput" Value="{Binding ReaderThumbnailWidth, Mode=TwoWay}" Minimum="{Binding ReaderThumbnailWidthMinimum}" Maximum="{Binding ReaderThumbnailWidthMaximum}" Increment="10" AutomationProperties.LabeledBy="{Binding ElementName=ReaderThumbnailWidthFieldLabel}" AutomationProperties.Name="{Binding ReaderThumbnailWidthLabel}" AutomationProperties.HelpText="{Binding ReaderThumbnailWidthHelp}" />
                                <TextBlock x:Name="ReaderThumbnailWidthInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding ReaderThumbnailWidthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="ReaderDateStyleFieldLabel" Text="{Binding ReaderDateStyleLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReaderDateStyleHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ReaderDateStyleInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding ReaderDateStyleChoices}" SelectedItem="{Binding SelectedReaderDateStyle, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=ReaderDateStyleFieldLabel}" AutomationProperties.Name="{Binding ReaderDateStyleLabel}" AutomationProperties.HelpText="{Binding ReaderDateStyleHint}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="ReaderSpoilersFieldLabel" Text="{Binding ReaderSpoilersLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReaderSpoilersHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="ReaderSpoilersInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding ReaderSpoilersChoices}" SelectedItem="{Binding SelectedReaderSpoilers, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=ReaderSpoilersFieldLabel}" AutomationProperties.Name="{Binding ReaderSpoilersLabel}" AutomationProperties.HelpText="{Binding ReaderSpoilersHint}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Expander x:Name="ReaderLongPostsSettings" Header="{Binding ReaderLongPostsTitle}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderFoldLinesFieldLabel" Text="{Binding ReaderFoldLinesLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderFoldLinesInput" Value="{Binding ReaderFoldLines, Mode=TwoWay}" Minimum="{Binding ReaderFoldLinesMinimum}" Maximum="{Binding ReaderFoldLinesMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReaderFoldLinesFieldLabel}" AutomationProperties.Name="{Binding ReaderFoldLinesLabel}" AutomationProperties.HelpText="{Binding ReaderFoldLinesHelp}" />
                                        <TextBlock x:Name="ReaderFoldLinesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderFoldLinesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderPreviewLinesFieldLabel" Text="{Binding ReaderPreviewLinesLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderPreviewLinesInput" Value="{Binding ReaderPreviewLines, Mode=TwoWay}" Minimum="{Binding ReaderPreviewLinesMinimum}" Maximum="{Binding ReaderPreviewLinesMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReaderPreviewLinesFieldLabel}" AutomationProperties.Name="{Binding ReaderPreviewLinesLabel}" AutomationProperties.HelpText="{Binding ReaderPreviewLinesHelp}" />
                                        <TextBlock x:Name="ReaderPreviewLinesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderPreviewLinesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderPreviewDelayMsFieldLabel" Text="{Binding ReaderPreviewDelayMsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderPreviewDelayMsInput" Value="{Binding ReaderPreviewDelayMs, Mode=TwoWay}" Minimum="{Binding ReaderPreviewDelayMsMinimum}" Maximum="{Binding ReaderPreviewDelayMsMaximum}" Increment="50" AutomationProperties.LabeledBy="{Binding ElementName=ReaderPreviewDelayMsFieldLabel}" AutomationProperties.Name="{Binding ReaderPreviewDelayMsLabel}" AutomationProperties.HelpText="{Binding ReaderPreviewDelayMsHelp}" />
                                        <TextBlock x:Name="ReaderPreviewDelayMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderPreviewDelayMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderReplyStepFieldLabel" Text="{Binding ReaderReplyStepLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderReplyStepInput" Value="{Binding ReaderReplyStep, Mode=TwoWay}" Minimum="{Binding ReaderReplyStepMinimum}" Maximum="{Binding ReaderReplyStepMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReaderReplyStepFieldLabel}" AutomationProperties.Name="{Binding ReaderReplyStepLabel}" AutomationProperties.HelpText="{Binding ReaderReplyStepHelp}" />
                                        <TextBlock x:Name="ReaderReplyStepInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderReplyStepHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderReplyLinesFieldLabel" Text="{Binding ReaderReplyLinesLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderReplyLinesInput" Value="{Binding ReaderReplyLines, Mode=TwoWay}" Minimum="{Binding ReaderReplyLinesMinimum}" Maximum="{Binding ReaderReplyLinesMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReaderReplyLinesFieldLabel}" AutomationProperties.Name="{Binding ReaderReplyLinesLabel}" AutomationProperties.HelpText="{Binding ReaderReplyLinesHelp}" />
                                        <TextBlock x:Name="ReaderReplyLinesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderReplyLinesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderPageSizeFieldLabel" Text="{Binding ReaderPageSizeLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderPageSizeInput" Value="{Binding ReaderPageSize, Mode=TwoWay}" Minimum="{Binding ReaderPageSizeMinimum}" Maximum="{Binding ReaderPageSizeMaximum}" Increment="10" AutomationProperties.LabeledBy="{Binding ElementName=ReaderPageSizeFieldLabel}" AutomationProperties.Name="{Binding ReaderPageSizeLabel}" AutomationProperties.HelpText="{Binding ReaderPageSizeHelp}" />
                                        <TextBlock x:Name="ReaderPageSizeInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderPageSizeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderThreadingDepthFieldLabel" Text="{Binding ReaderThreadingDepthLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderThreadingDepthInput" Value="{Binding ReaderThreadingDepth, Mode=TwoWay}" Minimum="{Binding ReaderThreadingDepthMinimum}" Maximum="{Binding ReaderThreadingDepthMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReaderThreadingDepthFieldLabel}" AutomationProperties.Name="{Binding ReaderThreadingDepthLabel}" AutomationProperties.HelpText="{Binding ReaderThreadingDepthHelp}" />
                                        <TextBlock x:Name="ReaderThreadingDepthInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderThreadingDepthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="ReaderTextlessLargeImagesInput" Content="{Binding ReaderTextlessLargeImagesLabel}" IsChecked="{Binding ReaderTextlessLargeImages, Mode=TwoWay}" AutomationProperties.HelpText="{Binding ReaderTextlessLargeImagesHint}" />
                                <TextBlock Text="{Binding ReaderTextlessLargeImagesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderTextlessMediaWidthFieldLabel" Text="{Binding ReaderTextlessMediaWidthLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderTextlessMediaWidthInput" Value="{Binding ReaderTextlessMediaWidth, Mode=TwoWay}" Minimum="{Binding ReaderTextlessMediaWidthMinimum}" Maximum="{Binding ReaderTextlessMediaWidthMaximum}" Increment="20" AutomationProperties.LabeledBy="{Binding ElementName=ReaderTextlessMediaWidthFieldLabel}" AutomationProperties.Name="{Binding ReaderTextlessMediaWidthLabel}" AutomationProperties.HelpText="{Binding ReaderTextlessMediaWidthHelp}" />
                                        <TextBlock x:Name="ReaderTextlessMediaWidthInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderTextlessMediaWidthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="ReaderFocusedMediaEnlargeInput" Content="{Binding ReaderFocusedMediaEnlargeLabel}" IsChecked="{Binding ReaderFocusedMediaEnlarge, Mode=TwoWay}" AutomationProperties.HelpText="{Binding ReaderFocusedMediaEnlargeHint}" />
                                <TextBlock Text="{Binding ReaderFocusedMediaEnlargeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderFocusedMediaScalePercentFieldLabel" Text="{Binding ReaderFocusedMediaScalePercentLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderFocusedMediaScalePercentInput" Value="{Binding ReaderFocusedMediaScalePercent, Mode=TwoWay}" Minimum="{Binding ReaderFocusedMediaScalePercentMinimum}" Maximum="{Binding ReaderFocusedMediaScalePercentMaximum}" Increment="25" AutomationProperties.LabeledBy="{Binding ElementName=ReaderFocusedMediaScalePercentFieldLabel}" AutomationProperties.Name="{Binding ReaderFocusedMediaScalePercentLabel}" AutomationProperties.HelpText="{Binding ReaderFocusedMediaScalePercentHelp}" />
                                        <TextBlock x:Name="ReaderFocusedMediaScalePercentInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderFocusedMediaScalePercentHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="ReaderHoverEnlargeInput" Content="{Binding ReaderHoverEnlargeLabel}" IsChecked="{Binding ReaderHoverEnlarge, Mode=TwoWay}" AutomationProperties.HelpText="{Binding ReaderHoverEnlargeHint}" />
                                <TextBlock Text="{Binding ReaderHoverEnlargeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderHoverEnlargeSizeFieldLabel" Text="{Binding ReaderHoverEnlargeSizeLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderHoverEnlargeSizeInput" Value="{Binding ReaderHoverEnlargeSize, Mode=TwoWay}" Minimum="{Binding ReaderHoverEnlargeSizeMinimum}" Maximum="{Binding ReaderHoverEnlargeSizeMaximum}" Increment="40" AutomationProperties.LabeledBy="{Binding ElementName=ReaderHoverEnlargeSizeFieldLabel}" AutomationProperties.Name="{Binding ReaderHoverEnlargeSizeLabel}" AutomationProperties.HelpText="{Binding ReaderHoverEnlargeSizeHelp}" />
                                        <TextBlock x:Name="ReaderHoverEnlargeSizeInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderHoverEnlargeSizeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                    <TextBlock x:Name="ReaderHoverEnlargeDelayMsFieldLabel" Text="{Binding ReaderHoverEnlargeDelayMsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <desktop:SettingsNumberInput x:Name="ReaderHoverEnlargeDelayMsInput" Value="{Binding ReaderHoverEnlargeDelayMs, Mode=TwoWay}" Minimum="{Binding ReaderHoverEnlargeDelayMsMinimum}" Maximum="{Binding ReaderHoverEnlargeDelayMsMaximum}" Increment="50" AutomationProperties.LabeledBy="{Binding ElementName=ReaderHoverEnlargeDelayMsFieldLabel}" AutomationProperties.Name="{Binding ReaderHoverEnlargeDelayMsLabel}" AutomationProperties.HelpText="{Binding ReaderHoverEnlargeDelayMsHelp}" />
                                        <TextBlock x:Name="ReaderHoverEnlargeDelayMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ReaderHoverEnlargeDelayMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                    <TextBlock x:Name="SettingsGalleryPlaybackHeading" Text="{Binding GalleryPlaybackTitle}" Classes="section-title" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding GalleryPlaybackProfileHelp}" Classes="workspace-help" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                        <TextBlock x:Name="GalleryPlaybackModeFieldLabel" Text="{Binding GalleryPlaybackModeLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <ComboBox x:Name="GalleryPlaybackModeInput" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ItemsSource="{Binding GalleryPlaybackModeChoices}" SelectedItem="{Binding SelectedGalleryPlaybackMode, Mode=TwoWay}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=GalleryPlaybackModeFieldLabel}" AutomationProperties.Name="{Binding GalleryPlaybackModeLabel}" AutomationProperties.HelpText="{Binding GalleryPlaybackModeHelp}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding GalleryPlaybackModeHelp}" Classes="workspace-help" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding IsGallerySlideshow}">
                        <TextBlock x:Name="GallerySlideshowSecondsFieldLabel" Text="{Binding GallerySlideshowSecondsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GallerySlideshowSecondsInput" Value="{Binding GallerySlideshowSeconds, Mode=TwoWay}" Minimum="1" Maximum="300" Increment="1"
                                AutomationProperties.LabeledBy="{Binding ElementName=GallerySlideshowSecondsFieldLabel}" AutomationProperties.Name="{Binding GallerySlideshowSecondsLabel}" AutomationProperties.HelpText="{Binding GallerySlideshowSecondsHelp}" />
                            <TextBlock Text="{Binding GallerySlideshowSecondsHelp}" Classes="workspace-help" />
                            <TextBlock x:Name="GallerySlideshowSecondsInputError" IsVisible="False" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="GalleryFitUpscaleFieldLabel" Text="{Binding GalleryFitUpscaleLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding GalleryFitUpscaleHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox x:Name="GalleryFitUpscaleInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding GalleryFitUpscaleChoices}" SelectedItem="{Binding SelectedGalleryFitUpscale, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFitUpscaleFieldLabel}" AutomationProperties.Name="{Binding GalleryFitUpscaleLabel}" AutomationProperties.HelpText="{Binding GalleryFitUpscaleHint}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <StackPanel Spacing="4" IsVisible="{Binding IsGalleryFitLimited}">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                            <TextBlock x:Name="GalleryFitMaxUpscalePercentFieldLabel" Text="{Binding GalleryFitMaxUpscalePercentLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="GalleryFitMaxUpscalePercentInput" Value="{Binding GalleryFitMaxUpscalePercent, Mode=TwoWay}" Minimum="{Binding GalleryFitMaxUpscalePercentMinimum}" Maximum="{Binding GalleryFitMaxUpscalePercentMaximum}" Increment="25" IsEnabled="{Binding IsGalleryFitLimited}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFitMaxUpscalePercentFieldLabel}" AutomationProperties.Name="{Binding GalleryFitMaxUpscalePercentLabel}" AutomationProperties.HelpText="{Binding GalleryFitMaxUpscalePercentHelp}" />
                                <TextBlock x:Name="GalleryFitMaxUpscalePercentInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding GalleryFitMaxUpscalePercentHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- What a running slideshow does with a video; the number row belongs to the chosen rule. -->
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding IsGallerySlideshow}">
                        <TextBlock x:Name="GallerySlideshowVideoRuleFieldLabel" Text="{Binding GallerySlideshowVideoRuleLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <ComboBox x:Name="GallerySlideshowVideoRuleInput" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  ItemsSource="{Binding GallerySlideshowVideoRuleChoices}" SelectedItem="{Binding SelectedGallerySlideshowVideoRule, Mode=TwoWay}"
                                  AutomationProperties.LabeledBy="{Binding ElementName=GallerySlideshowVideoRuleFieldLabel}" AutomationProperties.Name="{Binding GallerySlideshowVideoRuleLabel}" AutomationProperties.HelpText="{Binding GallerySlideshowVideoRuleHint}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{Binding GallerySlideshowVideoRuleHint}" Classes="workspace-help" TextWrapping="Wrap" IsVisible="{Binding IsGallerySlideshow}" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding IsGallerySlideshowVideoSeconds}">
                        <TextBlock x:Name="GallerySlideshowVideoSecondsFieldLabel" Text="{Binding GallerySlideshowVideoSecondsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GallerySlideshowVideoSecondsInput" Value="{Binding GallerySlideshowVideoSeconds, Mode=TwoWay}" Minimum="1" Maximum="600" Increment="1" IsEnabled="{Binding IsGallerySlideshowVideoSeconds}"
                                AutomationProperties.LabeledBy="{Binding ElementName=GallerySlideshowVideoSecondsFieldLabel}" AutomationProperties.Name="{Binding GallerySlideshowVideoSecondsLabel}" AutomationProperties.HelpText="{Binding GallerySlideshowVideoSecondsHelp}" />
                            <TextBlock x:Name="GallerySlideshowVideoSecondsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding GallerySlideshowVideoSecondsHint}" Classes="workspace-help" TextWrapping="Wrap" IsVisible="{Binding IsGallerySlideshowVideoSeconds}" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" IsVisible="{Binding IsGallerySlideshowVideoRepeats}">
                        <TextBlock x:Name="GallerySlideshowVideoRepeatsFieldLabel" Text="{Binding GallerySlideshowVideoRepeatsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GallerySlideshowVideoRepeatsInput" Value="{Binding GallerySlideshowVideoRepeats, Mode=TwoWay}" Minimum="1" Maximum="50" Increment="1" IsEnabled="{Binding IsGallerySlideshowVideoRepeats}"
                                AutomationProperties.LabeledBy="{Binding ElementName=GallerySlideshowVideoRepeatsFieldLabel}" AutomationProperties.Name="{Binding GallerySlideshowVideoRepeatsLabel}" AutomationProperties.HelpText="{Binding GallerySlideshowVideoRepeatsHelp}" />
                            <TextBlock x:Name="GallerySlideshowVideoRepeatsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding GallerySlideshowVideoRepeatsHint}" Classes="workspace-help" TextWrapping="Wrap" IsVisible="{Binding IsGallerySlideshowVideoRepeats}" />
                    <CheckBox x:Name="GalleryVideoRepeatInput" IsChecked="{Binding GalleryVideoRepeat, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryVideoRepeatLabel}" AutomationProperties.HelpText="{Binding GalleryVideoRepeatHint}"><TextBlock Text="{Binding GalleryVideoRepeatLabel}" TextWrapping="Wrap" /></CheckBox>
                    <TextBlock Text="{Binding GalleryVideoRepeatHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <CheckBox x:Name="GalleryMediaFocusInput" IsChecked="{Binding GalleryMediaFocus, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryMediaFocusLabel}"><TextBlock Text="{Binding GalleryMediaFocusLabel}" TextWrapping="Wrap" /></CheckBox>
                    <StackPanel Spacing="8">
                        <CheckBox x:Name="GalleryOverlayControlsInput" IsChecked="{Binding GalleryOverlayControls, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryOverlayControlsLabel}" AutomationProperties.HelpText="{Binding GalleryOverlayHelp}"><TextBlock Text="{Binding GalleryOverlayControlsLabel}" TextWrapping="Wrap" /></CheckBox>
                        <!-- Compatibility binding only: overlay and auto-hide are one visible choice. -->
                        <CheckBox x:Name="GalleryAutoHideControlsInput" IsVisible="False" IsTabStop="False" IsChecked="{Binding GalleryAutoHideControls, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryAutoHideControlsLabel}" />
                        <CheckBox x:Name="GalleryOverlayPostContextInput" IsChecked="{Binding GalleryOverlayPostContext, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryOverlayPostContextLabel}" AutomationProperties.HelpText="{Binding GalleryOverlayHelp}"><TextBlock Text="{Binding GalleryOverlayPostContextLabel}" TextWrapping="Wrap" /></CheckBox>
                        <TextBlock Text="{Binding GalleryOverlayHelp}" Classes="workspace-help" />
                    </StackPanel>
                    <!-- One idle time for the gallery's overlay controls and the reader's arrow cross. -->
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                        <TextBlock x:Name="ControlsIdleHideMsFieldLabel" Text="{Binding ControlsIdleHideMsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="ControlsIdleHideMsInput" Value="{Binding ControlsIdleHideMs, Mode=TwoWay}" Minimum="500" Maximum="30000" Increment="100"
                                AutomationProperties.LabeledBy="{Binding ElementName=ControlsIdleHideMsFieldLabel}" AutomationProperties.Name="{Binding ControlsIdleHideMsLabel}" AutomationProperties.HelpText="{Binding ControlsIdleHideMsHelp}" />
                            <TextBlock x:Name="ControlsIdleHideMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ControlsIdleHideMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <!-- Gallery filmstrip (V3): on/off, thumbnail size and how many thumbnails are decoded ahead of scrolling. -->
                    <CheckBox x:Name="GalleryFilmstripInput" IsChecked="{Binding GalleryFilmstrip, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryFilmstripLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripHint}"><TextBlock Text="{Binding GalleryFilmstripLabel}" TextWrapping="Wrap" /></CheckBox>
                    <TextBlock Text="{Binding GalleryFilmstripHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                        <TextBlock x:Name="GalleryFilmstripHeightFieldLabel" Text="{Binding GalleryFilmstripHeightLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryFilmstripHeightInput" Value="{Binding GalleryFilmstripHeight, Mode=TwoWay}" Minimum="48" Maximum="160" Increment="4"
                                AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripHeightFieldLabel}" AutomationProperties.Name="{Binding GalleryFilmstripHeightLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripHeightHelp}" />
                            <TextBlock x:Name="GalleryFilmstripHeightInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding GalleryFilmstripHeightHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                        <TextBlock x:Name="GalleryFilmstripPreloadFieldLabel" Text="{Binding GalleryFilmstripPreloadLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryFilmstripPreloadInput" Value="{Binding GalleryFilmstripPreload, Mode=TwoWay}" Minimum="4" Maximum="60" Increment="1"
                                AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripPreloadFieldLabel}" AutomationProperties.Name="{Binding GalleryFilmstripPreloadLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripPreloadHelp}" />
                            <TextBlock x:Name="GalleryFilmstripPreloadInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding GalleryFilmstripPreloadHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <CheckBox Content="{Binding VideoAutoplayLabel}" IsChecked="{Binding VideoAutoplay, Mode=TwoWay}" />
                    <CheckBox Content="{Binding VideoStartMutedLabel}" IsChecked="{Binding VideoStartMuted, Mode=TwoWay}" />
                    <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                        <TextBlock x:Name="VideoVolumeFieldLabel" Text="{Binding VideoVolumeLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                        <desktop:AccessibleNumberInput x:Name="VideoVolumeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=VideoVolumeFieldLabel}" AutomationProperties.Name="{Binding VideoVolumeLabel}" AutomationProperties.HelpText="{Binding VolumeHelp}" Grid.Column="1" Value="{Binding VideoVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1" />
                    </Grid>
                    <!-- The Forget action sits beside the setting it undoes instead of on a line of its own; it wraps below the box in a narrow window. -->
                    <WrapPanel ItemSpacing="16" LineSpacing="8">
                        <CheckBox x:Name="RememberReadingPositionInput" Content="{Binding RememberReadingPositionLabel}" IsChecked="{Binding RememberReadingPosition, Mode=TwoWay}" AutomationProperties.HelpText="{Binding ReadingPositionHint}" />
                        <Button x:Name="ForgetReadingPositionButton" Content="{Binding ForgetReadingPositionLabel}" AutomationProperties.Name="{Binding ForgetReadingPositionLabel}" Click="OnForgetReadingPositionClick" IsEnabled="{Binding CanForgetReadingPosition}" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBlock Text="{Binding ReadingPositionHint}" Classes="workspace-help" />
                    <StackPanel Spacing="4" Margin="0,4,0,0">
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                                <TextBlock x:Name="ReadingHistoryLimitFieldLabel" Text="{Binding ReadingHistoryLimitLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <desktop:SettingsNumberInput x:Name="ReadingHistoryLimitInput" Value="{Binding ReadingHistoryLimit, Mode=TwoWay}" Minimum="{Binding ReadingHistoryLimitMinimum}" Maximum="{Binding ReadingHistoryLimitMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReadingHistoryLimitFieldLabel}" AutomationProperties.Name="{Binding ReadingHistoryLimitLabel}" AutomationProperties.HelpText="{Binding ReadingHistoryLimitHelp}" />
                                    <TextBlock x:Name="ReadingHistoryLimitInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding ReadingHistoryLimitHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                    <CheckBox x:Name="ShowShortcutHelpInput" Content="{Binding ShowShortcutHelpLabel}" IsChecked="{Binding ShowShortcutHelp, Mode=TwoWay}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="SettingsDownloadsPage" Spacing="0" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <TextBlock x:Name="SettingsDownloadsHeading" Text="{Binding DownloadsTitle}" Classes="section-title" Margin="0,0,0,8" />
                    <Button x:Name="ResetDownloadsButton" Tag="settings.downloads" Classes="ghost" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetDownloadsLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                    <StackPanel Classes="workspace-field" Margin="0,0,0,12">
                        <TextBlock x:Name="DownloadPathFieldLabel" Text="{Binding DownloadPathLabel}" Classes="workspace-field-label" />
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <TextBox x:Name="DownloadPathInput" AutomationProperties.LabeledBy="{Binding ElementName=DownloadPathFieldLabel}" AutomationProperties.Name="{Binding DownloadPathLabel}" AutomationProperties.HelpText="{Binding DownloadPathHelp}" Text="{Binding DownloadPath, Mode=TwoWay}" />
                            <Button x:Name="BrowseButton" Grid.Column="1" Click="OnBrowseButtonClick" />
                            <Button x:Name="CheckDestinationButton" Grid.Column="2" Content="{Binding CheckDestinationLabel}" AutomationProperties.Name="{Binding CheckDestinationLabel}" Click="OnCheckDestinationClick" />
                        </Grid>
                        <TextBlock x:Name="NormalizedDestinationPreview" Text="{Binding NormalizedDestination}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DestinationScopeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DestinationPolicyHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock x:Name="DestinationCheckStatus" Text="{Binding DestinationStatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding DestinationCleanupWarning}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock x:Name="DownloadPathInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="BandwidthFieldLabel" Text="{Binding BandwidthLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="BandwidthInput" AutomationProperties.LabeledBy="{Binding ElementName=BandwidthFieldLabel}" AutomationProperties.Name="{Binding BandwidthLabel}" AutomationProperties.HelpText="{Binding BandwidthInputHelp}" Value="{Binding BandwidthLimiterMB, Mode=TwoWay}" Minimum="0" Maximum="100000" Increment="0.1" />
                                <TextBlock x:Name="BandwidthInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="{Binding BandwidthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <Border Padding="0,10">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="ParallelFieldLabel" Text="{Binding ParallelLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ParallelDownloadsInput" AutomationProperties.LabeledBy="{Binding ElementName=ParallelFieldLabel}" AutomationProperties.Name="{Binding ParallelLabel}" Value="{Binding MaxParallelDownloads, Mode=TwoWay}" Minimum="1" Maximum="256" Increment="1" AutomationProperties.HelpText="{Binding ParallelDownloadsHelp}" />
                                <TextBlock x:Name="ParallelDownloadsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="{Binding ParallelHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ParallelEffectiveLine" Margin="0,2,0,0" Text="{Binding ParallelEffectiveText}" FontWeight="SemiBold" TextWrapping="Wrap"
                               IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.LiveSetting="Polite" />
                    <Expander x:Name="SettingsDownloadsMoreGroup" wv:WorkViewElement.Id="settings.group.downloads-more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                        <StackPanel x:Name="SettingsDownloadsMoreBody" Spacing="0" Margin="0,8,0,0">
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="RecheckFieldLabel" Text="{Binding RecheckLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="RecheckTimerInput" AutomationProperties.LabeledBy="{Binding ElementName=RecheckFieldLabel}" AutomationProperties.Name="{Binding RecheckLabel}" AutomationProperties.HelpText="{Binding RecheckTimerHelp}" Value="{Binding RecheckTimer, Mode=TwoWay}" Minimum="10" Maximum="4294967" Increment="1" />
                                <TextBlock x:Name="RecheckTimerInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Padding="0,10">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="ParallelSafetyFieldLabel" Text="{Binding ParallelSafetyLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ParallelDownloadsSafetyInput" AutomationProperties.LabeledBy="{Binding ElementName=ParallelSafetyFieldLabel}" AutomationProperties.Name="{Binding ParallelSafetyLabel}" Value="{Binding ParallelDownloadsSafetyLimit, Mode=TwoWay}" Minimum="1" Maximum="256" Increment="1" AutomationProperties.HelpText="{Binding ParallelDownloadsSafetyHelp}" />
                                <TextBlock x:Name="ParallelDownloadsSafetyInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Text="{Binding ParallelSafetyHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="SettingsWorkerBudgetsPage" Spacing="8" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <TextBlock x:Name="SettingsWorkerBudgetsPageTitle" Text="{Binding StorageLimitsLabel}" Classes="section-title" />
