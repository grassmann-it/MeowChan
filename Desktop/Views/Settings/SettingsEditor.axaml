                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                                <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                    <TextBlock x:Name="GalleryOverlayControlsFieldLabel" Text="{Binding GalleryOverlayControlsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="GalleryOverlayControlsInput" IsChecked="{Binding GalleryOverlayControls, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryOverlayControlsLabel}" AutomationProperties.HelpText="{Binding GalleryOverlayHelp}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryOverlayControlsFieldLabel}" />
                            </Grid>
                        </Border>
                        <!-- Compatibility binding only: overlay and auto-hide are one visible choice. -->
                        <ToggleSwitch x:Name="GalleryAutoHideControlsInput" IsVisible="False" IsTabStop="False" IsChecked="{Binding GalleryAutoHideControls, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryAutoHideControlsLabel}" OnContent="{x:Null}" OffContent="{x:Null}" />
                        <Border Classes="settings-divider">
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                                <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                    <TextBlock x:Name="GalleryOverlayPostContextFieldLabel" Text="{Binding GalleryOverlayPostContextLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding GalleryOverlayHelp}" Classes="workspace-help" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch x:Name="GalleryOverlayPostContextInput" IsChecked="{Binding GalleryOverlayPostContext, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryOverlayPostContextLabel}" AutomationProperties.HelpText="{Binding GalleryOverlayHelp}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryOverlayPostContextFieldLabel}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                    <!-- One idle time for the gallery's overlay controls and the reader's navigation bar. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ControlsIdleHideMsFieldLabel" Text="{Binding ControlsIdleHideMsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ControlsIdleHideMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="ControlsIdleHideMsInput" Value="{Binding ControlsIdleHideMs, Mode=TwoWay}" Minimum="500" Maximum="30000" Increment="100" AutomationProperties.LabeledBy="{Binding ElementName=ControlsIdleHideMsFieldLabel}" AutomationProperties.Name="{Binding ControlsIdleHideMsLabel}" AutomationProperties.HelpText="{Binding ControlsIdleHideMsHelp}" />
                            <TextBlock x:Name="ControlsIdleHideMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Reader navigation bar: when it is shown (auto-hide with the idle time above, always, or off) and whether it carries the counters. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="ReaderNavigationModeFieldLabel" Text="{Binding ReaderNavigationModeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderNavigationModeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ReaderNavigationModeInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding ReaderNavigationModeChoices}" SelectedItem="{Binding SelectedReaderNavigationMode, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=ReaderNavigationModeFieldLabel}" AutomationProperties.Name="{Binding ReaderNavigationModeLabel}" AutomationProperties.HelpText="{Binding ReaderNavigationModeHint}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ReaderNavigationShowPositionFieldLabel" Text="{Binding ReaderNavigationShowPositionLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderNavigationShowPositionHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ReaderNavigationShowPositionInput" IsChecked="{Binding ReaderNavigationShowPosition, Mode=TwoWay}" AutomationProperties.Name="{Binding ReaderNavigationShowPositionLabel}" AutomationProperties.HelpText="{Binding ReaderNavigationShowPositionHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=ReaderNavigationShowPositionFieldLabel}" />
                        </Grid>
                    </Border>
                    <!-- Gallery mouse wheel: zoom (default) or browse to the next and previous medium; Ctrl does the other one. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="GalleryWheelModeFieldLabel" Text="{Binding GalleryWheelModeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryWheelModeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="GalleryWheelModeInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding GalleryWheelModeChoices}" SelectedItem="{Binding SelectedGalleryWheelMode, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryWheelModeFieldLabel}" AutomationProperties.Name="{Binding GalleryWheelModeLabel}" AutomationProperties.HelpText="{Binding GalleryWheelModeHint}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <!-- Gallery filmstrip (V3): on/off, thumbnail size and how many thumbnails are decoded ahead of scrolling. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryFilmstripFieldLabel" Text="{Binding GalleryFilmstripLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="GalleryFilmstripInput" IsChecked="{Binding GalleryFilmstrip, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryFilmstripLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripFieldLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryFilmstripHeightFieldLabel" Text="{Binding GalleryFilmstripHeightLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripHeightHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryFilmstripHeightInput" Value="{Binding GalleryFilmstripHeight, Mode=TwoWay}" Minimum="48" Maximum="160" Increment="4" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripHeightFieldLabel}" AutomationProperties.Name="{Binding GalleryFilmstripHeightLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripHeightHelp}" />
                            <TextBlock x:Name="GalleryFilmstripHeightInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryFilmstripPreloadFieldLabel" Text="{Binding GalleryFilmstripPreloadLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripPreloadHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryFilmstripPreloadInput" Value="{Binding GalleryFilmstripPreload, Mode=TwoWay}" Minimum="4" Maximum="60" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripPreloadFieldLabel}" AutomationProperties.Name="{Binding GalleryFilmstripPreloadLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripPreloadHelp}" />
                            <TextBlock x:Name="GalleryFilmstripPreloadInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Media badges (MB1): the thumbnail sizes below which the small badges shrink to dots or disappear, and how many fit in a corner. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaBadgeCollapseBelowFieldLabel" Text="{Binding MediaBadgeCollapseBelowLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MediaBadgeCollapseBelowHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="MediaBadgeCollapseBelowInput" Value="{Binding MediaBadgeCollapseBelow, Mode=TwoWay}" Minimum="24" Maximum="96" Increment="4" AutomationProperties.LabeledBy="{Binding ElementName=MediaBadgeCollapseBelowFieldLabel}" AutomationProperties.Name="{Binding MediaBadgeCollapseBelowLabel}" AutomationProperties.HelpText="{Binding MediaBadgeCollapseBelowHelp}" />
                            <TextBlock x:Name="MediaBadgeCollapseBelowInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaBadgeHideBelowFieldLabel" Text="{Binding MediaBadgeHideBelowLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MediaBadgeHideBelowHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="MediaBadgeHideBelowInput" Value="{Binding MediaBadgeHideBelow, Mode=TwoWay}" Minimum="16" Maximum="64" Increment="4" AutomationProperties.LabeledBy="{Binding ElementName=MediaBadgeHideBelowFieldLabel}" AutomationProperties.Name="{Binding MediaBadgeHideBelowLabel}" AutomationProperties.HelpText="{Binding MediaBadgeHideBelowHelp}" />
                            <TextBlock x:Name="MediaBadgeHideBelowInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="MediaBadgeMaxPerCornerFieldLabel" Text="{Binding MediaBadgeMaxPerCornerLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MediaBadgeMaxPerCornerHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="MediaBadgeMaxPerCornerInput" Value="{Binding MediaBadgeMaxPerCorner, Mode=TwoWay}" Minimum="1" Maximum="3" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=MediaBadgeMaxPerCornerFieldLabel}" AutomationProperties.Name="{Binding MediaBadgeMaxPerCornerLabel}" AutomationProperties.HelpText="{Binding MediaBadgeMaxPerCornerHelp}" />
                            <TextBlock x:Name="MediaBadgeMaxPerCornerInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <!-- GL5c: how long a transient status of the gallery's info line stays on the screen. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryStatusDwellMsFieldLabel" Text="{Binding GalleryStatusDwellMsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryStatusDwellMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryStatusDwellMsInput" Value="{Binding GalleryStatusDwellMs, Mode=TwoWay}" Minimum="1000" Maximum="10000" Increment="500" AutomationProperties.LabeledBy="{Binding ElementName=GalleryStatusDwellMsFieldLabel}" AutomationProperties.Name="{Binding GalleryStatusDwellMsLabel}" AutomationProperties.HelpText="{Binding GalleryStatusDwellMsHelp}" />
                            <TextBlock x:Name="GalleryStatusDwellMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Review 15.11.: how many tags the gallery's Post segment lists as chips. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryPostTagChipLimitFieldLabel" Text="{Binding GalleryPostTagChipLimitLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryPostTagChipLimitHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryPostTagChipLimitInput" Value="{Binding GalleryPostTagChipLimit, Mode=TwoWay}" Minimum="5" Maximum="200" Increment="5" AutomationProperties.LabeledBy="{Binding ElementName=GalleryPostTagChipLimitFieldLabel}" AutomationProperties.Name="{Binding GalleryPostTagChipLimitLabel}" AutomationProperties.HelpText="{Binding GalleryPostTagChipLimitHelp}" />
                            <TextBlock x:Name="GalleryPostTagChipLimitInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <!-- GL5e: the gap between two filmstrip tiles. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryFilmstripTileGapFieldLabel" Text="{Binding GalleryFilmstripTileGapLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripTileGapHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                            <desktop:SettingsNumberInput x:Name="GalleryFilmstripTileGapInput" Value="{Binding GalleryFilmstripTileGap, Mode=TwoWay}" Minimum="4" Maximum="16" Increment="4" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripTileGapFieldLabel}" AutomationProperties.Name="{Binding GalleryFilmstripTileGapLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripTileGapHelp}" />
                            <TextBlock x:Name="GalleryFilmstripTileGapInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Filmstrip flags (decision 123): what a filmstrip tile shows besides the length: favourite, rating, no tags yet. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryFilmstripFlagFavoriteFieldLabel" Text="{Binding GalleryFilmstripFlagFavoriteLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripFlagFavoriteHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="GalleryFilmstripFlagFavoriteInput" IsChecked="{Binding GalleryFilmstripFlagFavorite, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryFilmstripFlagFavoriteLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripFlagFavoriteHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripFlagFavoriteFieldLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="GalleryFilmstripFlagRatingFieldLabel" Text="{Binding GalleryFilmstripFlagRatingLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripFlagRatingHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="GalleryFilmstripFlagRatingInput" IsChecked="{Binding GalleryFilmstripFlagRating, Mode=TwoWay}" AutomationProperties.Name="{Binding GalleryFilmstripFlagRatingLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripFlagRatingHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripFlagRatingFieldLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="GalleryFilmstripFlagUntaggedFieldLabel" Text="{Binding GalleryFilmstripFlagUntaggedLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding GalleryFilmstripFlagUntaggedHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="GalleryFilmstripFlagUntaggedInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding GalleryFilmstripFlagUntaggedChoices}" SelectedItem="{Binding SelectedGalleryFilmstripFlagUntagged, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=GalleryFilmstripFlagUntaggedFieldLabel}" AutomationProperties.Name="{Binding GalleryFilmstripFlagUntaggedLabel}" AutomationProperties.HelpText="{Binding GalleryFilmstripFlagUntaggedHint}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding GalleryLayoutResetHint}" Classes="workspace-help" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Button x:Name="GalleryLayoutResetButton" Content="{Binding GalleryLayoutResetLabel}" AutomationProperties.Name="{Binding GalleryLayoutResetLabel}" AutomationProperties.HelpText="{Binding GalleryLayoutResetHint}" Click="OnGalleryLayoutResetClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="1" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="VideoAutoplayFieldLabel" Text="{Binding VideoAutoplayLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding VideoAutoplay, Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=VideoAutoplayFieldLabel}" AutomationProperties.Name="{Binding VideoAutoplayLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="VideoStartMutedFieldLabel" Text="{Binding VideoStartMutedLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="VideoStartMutedInput" IsChecked="{Binding VideoStartMuted, Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=VideoStartMutedFieldLabel}" AutomationProperties.Name="{Binding VideoStartMutedLabel}" AutomationProperties.HelpText="{Binding GalleryPlaybackProfileHelp}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="VideoVolumeFieldLabel" Text="{Binding VideoVolumeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <desktop:AccessibleNumberInput x:Name="VideoVolumeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=VideoVolumeFieldLabel}" AutomationProperties.Name="{Binding VideoVolumeLabel}" AutomationProperties.HelpText="{Binding VolumeHelp}" Grid.Column="1" Value="{Binding VideoVolume, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1" />
                        </Grid>
                    </Border>
                    <!-- The Forget action sits beside the setting it undoes instead of on a line of its own; it wraps below the box in a narrow window. -->
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="RememberReadingPositionFieldLabel" Text="{Binding RememberReadingPositionLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReadingPositionHint}" Classes="workspace-help" TextWrapping="Wrap" />
                                <Button x:Name="ForgetReadingPositionButton" Content="{Binding ForgetReadingPositionLabel}" AutomationProperties.Name="{Binding ForgetReadingPositionLabel}" Click="OnForgetReadingPositionClick" IsEnabled="{Binding CanForgetReadingPosition}" HorizontalAlignment="Left" Classes="subtle" />
                            </StackPanel>
                            <ToggleSwitch x:Name="RememberReadingPositionInput" IsChecked="{Binding RememberReadingPosition, Mode=TwoWay}" AutomationProperties.HelpText="{Binding ReadingPositionHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=RememberReadingPositionFieldLabel}" AutomationProperties.Name="{Binding RememberReadingPositionLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadingHistoryLimitFieldLabel" Text="{Binding ReadingHistoryLimitLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReadingHistoryLimitHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                    <desktop:SettingsNumberInput x:Name="ReadingHistoryLimitInput" Value="{Binding ReadingHistoryLimit, Mode=TwoWay}" Minimum="{Binding ReadingHistoryLimitMinimum}" Maximum="{Binding ReadingHistoryLimitMaximum}" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ReadingHistoryLimitFieldLabel}" AutomationProperties.Name="{Binding ReadingHistoryLimitLabel}" AutomationProperties.HelpText="{Binding ReadingHistoryLimitHelp}" />
                                    <TextBlock x:Name="ReadingHistoryLimitInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                                </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadingHistoryMenuEntriesFieldLabel" Text="{Binding ReadingHistoryMenuEntriesLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReadingHistoryMenuEntriesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
