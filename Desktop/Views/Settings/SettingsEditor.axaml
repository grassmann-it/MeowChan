<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ursa="https://irihi.tech/ursa" xmlns:local="clr-namespace:MeowChan" xmlns:commands="clr-namespace:MeowChan.Desktop.Commands" xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls" xmlns:wv="using:MeowChan.Desktop.WorkViews" xmlns:localization="clr-namespace:MeowChan.Desktop.Localization" x:Class="MeowChan.SettingsEditor" x:DataType="local:SettingsEditor" SizeChanged="OnEditorSizeChanged">
    <UserControl.Styles>
        <Style Selector="ToggleButton.settings-category">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <!-- D4: the chosen category carries a 3-px accent bar besides the tint; the bar's width is always reserved. -->
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="ToggleButton.settings-category:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
        </Style>
        <!-- The setting the search jumped to. -->
        <Style Selector="Panel.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <Style Selector="Border.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <Style Selector="ToggleSwitch.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <!-- SP1: the section header is one row (heading at the start, "Reset" at the end); a row that only applies under a condition is indented
             under the row it depends on (a second level once more), it is not greyed out. -->
        <Style Selector="Grid.settings-section-header">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.settings-subheading">
            <Setter Property="Margin" Value="0,16,0,4" />
        </Style>
        <Style Selector="Border.settings-conditional">
            <Setter Property="Margin" Value="24,0,0,0" />
        </Style>
        <Style Selector="Border.settings-conditional.settings-conditional-nested">
            <Setter Property="Padding" Value="24,8,0,8" />
        </Style>
        <Style Selector="TextBlock.settings-search-hit">
            <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
        </Style>
        <!-- Keyboard focus enters the template's text box, so it needs the field semantics too. -->
        <!-- Numbers are right-aligned in their field (the unit is named by the label and the help text). -->
        <Style Selector="NumericUpDown">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="AutomationProperties.Name" Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="AutomationProperties.LabeledBy" Value="{Binding (AutomationProperties.LabeledBy), RelativeSource={RelativeSource TemplatedParent}}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_IncreaseButton">
            <Setter Property="AutomationProperties.Name">
                <MultiBinding Converter="{x:Static local:SettingsEditor.NumericActionNameConverter}">
                    <Binding Path="IncreaseNumericValueFormat" />
                    <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource FindAncestor, AncestorType=NumericUpDown}" />
                </MultiBinding>
            </Setter>
        </Style>
        <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ :is(Button)#PART_DecreaseButton">
            <Setter Property="AutomationProperties.Name">
                <MultiBinding Converter="{x:Static local:SettingsEditor.NumericActionNameConverter}">
                    <Binding Path="DecreaseNumericValueFormat" />
                    <Binding Path="(AutomationProperties.Name)" RelativeSource="{RelativeSource FindAncestor, AncestorType=NumericUpDown}" />
                </MultiBinding>
            </Setter>
        </Style>
    </UserControl.Styles>
    <Grid x:Name="SettingsRoot" RowDefinitions="Auto,*,Auto">
        <StackPanel x:Name="SettingsHeader" Classes="workspace-page-header" Margin="16,12,16,12" MaxWidth="1088" HorizontalAlignment="Center">
            <StackPanel x:Name="SettingsTitleBlock" Classes="workspace-page-header">
                <TextBlock Text="{Binding SettingsTitle}" Classes="page-title" />
                <TextBlock Text="{Binding SettingsSubtitle}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <!-- The polite line that reads out a row which appeared under its parent (its own label; see SettingsConditional). -->
            <TextBlock x:Name="SettingsConditionalAnnouncement" Height="0" Opacity="0" IsHitTestVisible="False" Focusable="False" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="SettingsResetStatus" IsVisible="False" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" HorizontalAlignment="Right" Margin="0,0,10,0" />
        </StackPanel>
        <Grid x:Name="SettingsFormLayout" Grid.Row="1" ColumnDefinitions="176,*" RowDefinitions="Auto,*" ColumnSpacing="{StaticResource Workspace.Space.16}" Margin="16,0,16,16" MaxWidth="1088" HorizontalAlignment="Center">
            <desktop:SectionNavigationControl x:Name="SettingsSections" Grid.ColumnSpan="2" Margin="0,0,0,12" />
            <ScrollViewer x:Name="SettingsCategories" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsVisible="False">
                <StackPanel x:Name="SettingsCategoryLinks" Spacing="{StaticResource Workspace.Space.4}" IsEnabled="{Binding IsEditable}" />
            </ScrollViewer>
            <!-- UX-LEDGER-09: search/actions and the form share the actual content column, not a second header grid.
                 The 10 dip inset matches SettingsContent; only the form scrolls. Hits overlay the page below the field. -->
            <Grid x:Name="SettingsContentColumn" Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*">
                <Grid x:Name="SettingsSearchActions" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.12}" Margin="10,0,10,12">
                    <ContentControl x:Name="SettingsSearchHost" VerticalAlignment="Top" HorizontalContentAlignment="Stretch" />
                    <Button x:Name="SettingsMoreButton" Grid.Column="1" Classes="ghost" VerticalAlignment="Top" AutomationProperties.Name="{Binding SettingsMoreLabel}" Click="OnSettingsMoreClick" IsEnabled="{Binding IsEditable}" />
                </Grid>
        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" ScrollChanged="OnSettingsScrollChanged">
            <StackPanel x:Name="SettingsContent" MaxWidth="880" HorizontalAlignment="Center" Spacing="{StaticResource Workspace.Space.16}">
                <StackPanel x:Name="SettingsInterfacePage" Spacing="0" IsEnabled="{Binding IsEditable}">
                    <Grid Classes="settings-section-header" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.12}">
                        <TextBlock x:Name="SettingsInterfaceHeading" Text="{Binding InterfaceTitle}" Classes="section-title" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="ResetInterfaceButton" Tag="settings.interface" Classes="subtle" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetInterfaceLabel}" ToolTip.Tip="{Binding ResetInterfaceLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" Grid.Column="1" />
                    </Grid>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <controls:LabelHelpPanel Spacing="{StaticResource Workspace.Space.8}">
                                    <TextBlock x:Name="WorkspaceModeFieldLabel" Text="{Binding WorkspaceModeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                    <controls:HelpButton x:Name="WorkspaceModeHelpButton" HelpKey="help.workviews" />
                                </controls:LabelHelpPanel>
                                <TextBlock Text="{Binding ModeHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="WorkspaceModeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=WorkspaceModeFieldLabel}" AutomationProperties.Name="{Binding WorkspaceModeLabel}" AutomationProperties.HelpText="{Binding ModeHint}" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding WorkspaceChoices}" SelectedItem="{Binding SelectedWorkspaceMode, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="LanguageFieldLabel" Text="{Binding LanguageLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=LanguageFieldLabel}" AutomationProperties.Name="{Binding LanguageLabel}" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding LanguageChoices}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="localization:LanguageInfo"><TextBlock Text="{Binding NativeName}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ThemeFieldLabel" Text="{Binding ThemeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ThemeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ThemeFieldLabel}" AutomationProperties.Name="{Binding ThemeLabel}" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider" x:Name="ThemeColors">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="ThemeColorsFieldLabel" Text="{Binding ThemeColorsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ThemeColorsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ThemeColorsButton" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" Content="{Binding ThemeColorsOpenLabel}" AutomationProperties.Name="{Binding ThemeColorsOpenLabel}" AutomationProperties.HelpText="{Binding ThemeColorsHint}" Click="OnThemeColorsClick" IsEnabled="{Binding IsEditable}" />
                        </Grid>
                    </Border>
                    <!-- Footer (F1): heading and explanation are the search entry "FooterLayoutSection"; the list below is built in code (FooterLayoutEditor). -->
                    <StackPanel x:Name="FooterLayoutSection" Spacing="{StaticResource Workspace.Space.4}">
                        <TextBlock x:Name="FooterLayoutHeading" Text="{Binding FooterLayoutLabel}" Classes="workspace-field-label settings-subheading" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FooterLayoutHelp}" Classes="workspace-help" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FooterLayoutBooruHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                    <ContentControl x:Name="FooterLayoutHost" HorizontalContentAlignment="Stretch" Margin="0,8,0,8" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ShowBooruActionsFieldLabel" Text="{Binding ShowBooruActionsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ShowBooruActionsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShowBooruActionsInput" IsChecked="{Binding ShowBooruActions, Mode=TwoWay}" AutomationProperties.Name="{Binding ShowBooruActionsLabel}" AutomationProperties.HelpText="{Binding ShowBooruActionsHint}" ToolTip.Tip="{Binding ShowBooruActionsHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=ShowBooruActionsFieldLabel}" />
                        </Grid>
                    </Border>
                    <Expander x:Name="SettingsInterfaceMoreGroup" wv:WorkViewElement.Id="settings.group.interface-more" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,4,0,0">
                        <StackPanel x:Name="SettingsInterfaceMoreBody" Spacing="0" Margin="0,8,0,0">
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ShrinkWindowForBarebonesFieldLabel" Text="{Binding ShrinkWindowForBarebonesLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ShrinkWindowForBarebonesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ShrinkWindowForBarebonesInput" IsChecked="{Binding ShrinkWindowForBarebones, Mode=TwoWay}" AutomationProperties.Name="{Binding ShrinkWindowForBarebonesLabel}" AutomationProperties.HelpText="{Binding ShrinkWindowForBarebonesHint}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{x:Null}" OffContent="{x:Null}" AutomationProperties.LabeledBy="{Binding ElementName=ShrinkWindowForBarebonesFieldLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="AnimationsFieldLabel" Text="{Binding AnimationsLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AnimationsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="AnimationsInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=AnimationsFieldLabel}" AutomationProperties.Name="{Binding AnimationsLabel}" AutomationProperties.HelpText="{Binding AnimationsHint}" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding AnimationsChoices}" SelectedItem="{Binding SelectedAnimations, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="DensityFieldLabel" Text="{Binding DensityLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="CompactDensityInput" AutomationProperties.LabeledBy="{Binding ElementName=DensityFieldLabel}" AutomationProperties.Name="{Binding DensityLabel}" IsChecked="{Binding CompactDensity, Mode=TwoWay}" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="{Binding CompactLabel}" OffContent="{Binding CompactLabel}" />
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="HeaderTaglineFieldLabel" Text="{Binding HeaderTaglineLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HeaderTaglineHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HeaderTaglineInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=HeaderTaglineFieldLabel}" AutomationProperties.Name="{Binding HeaderTaglineLabel}" AutomationProperties.HelpText="{Binding HeaderTaglineHint}" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding HeaderTaglineChoices}" SelectedItem="{Binding SelectedHeaderTagline, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider settings-conditional" desktop:SettingsConditional.When="{Binding HeaderTaglineFixedEnabled}">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}" IsEnabled="{Binding HeaderTaglineFixedEnabled}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="HeaderTaglineFixedFieldLabel" Text="{Binding HeaderTaglineFixedLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding HeaderTaglineFixedHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="HeaderTaglineFixedIdInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=HeaderTaglineFixedFieldLabel}" AutomationProperties.Name="{Binding HeaderTaglineFixedLabel}" AutomationProperties.HelpText="{Binding HeaderTaglineFixedHint}" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding HeaderTaglineFixedChoices}" SelectedItem="{Binding SelectedHeaderTaglineFixed, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border x:Name="StatsHeaderMonitorRow" Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="StatsHeaderMonitorFieldLabel" Text="{Binding StatsHeaderMonitorLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatsHeaderMonitorHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StatsHeaderMonitorInput" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StatsHeaderMonitorShown, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=StatsHeaderMonitorFieldLabel}" AutomationProperties.Name="{Binding StatsHeaderMonitorLabel}" AutomationProperties.HelpText="{Binding StatsHeaderMonitorHint}" ToolTip.Tip="{Binding StatsHeaderMonitorHint}" OnContent="{x:Null}" OffContent="{x:Null}" Click="OnHeaderMonitorClick" />
                        </Grid>
                    </Border>
                        </StackPanel>
                    </Expander>
                    <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="{Binding LanguagePacksLabel}" Margin="0,4,0,0">
                        <TextBlock Text="{Binding LanguagePacksHint}" Classes="workspace-help" Margin="0,8,0,0" />
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="SettingsReadingMediaPage" Spacing="0" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <Grid Classes="settings-section-header" ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Workspace.Space.12}">
                        <TextBlock x:Name="SettingsReadingMediaHeading" Text="{Binding ReadingMediaTitle}" Classes="section-title" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button x:Name="ResetReadingMediaButton" Tag="settings.reading-media" Classes="subtle" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetReadingMediaLabel}" ToolTip.Tip="{Binding ResetReadingMediaLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" VerticalAlignment="Center" Grid.Column="1" />
                    </Grid>
                    <Expander x:Name="SettingsReadingMediaGroup" wv:WorkViewElement.Id="settings.group.reading-media" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="SettingsReadingMediaBody" Spacing="0" Margin="0,8,0,0">
                            <TextBlock x:Name="ReaderDisplayHeading" Text="{Binding ReaderDisplayTitle}" Classes="workspace-field-label settings-subheading" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadingFontSizeFieldLabel" Text="{Binding ReadingFontSizeLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ReadingFontSizeInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ReadingFontSizeFieldLabel}" AutomationProperties.Name="{Binding ReadingFontSizeLabel}" Grid.Column="1" ItemsSource="{Binding ReadingFontSizeChoices}" SelectedItem="{Binding SelectedReadingFontSize, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="ReaderPostWidthFieldLabel" Text="{Binding ReaderPostWidthLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderPostWidthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ReaderPostWidthInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=ReaderPostWidthFieldLabel}" AutomationProperties.Name="{Binding ReaderPostWidthLabel}" AutomationProperties.HelpText="{Binding ReaderPostWidthHint}" Grid.Column="1" ItemsSource="{Binding ReaderPostWidthChoices}" SelectedItem="{Binding SelectedReaderPostWidth, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <TextBlock x:Name="ReaderThumbnailWidthFieldLabel" Text="{Binding ReaderThumbnailWidthLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderThumbnailWidthHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ReaderThumbnailWidthInput" Value="{Binding ReaderThumbnailWidth, Mode=TwoWay}" Minimum="{Binding ReaderThumbnailWidthMinimum}" Maximum="{Binding ReaderThumbnailWidthMaximum}" Increment="10" AutomationProperties.LabeledBy="{Binding ElementName=ReaderThumbnailWidthFieldLabel}" AutomationProperties.Name="{Binding ReaderThumbnailWidthLabel}" AutomationProperties.HelpText="{Binding ReaderThumbnailWidthHelp}" />
                                <TextBlock x:Name="ReaderThumbnailWidthInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="ReaderDateStyleFieldLabel" Text="{Binding ReaderDateStyleLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderDateStyleHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ReaderDateStyleInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding ReaderDateStyleChoices}" SelectedItem="{Binding SelectedReaderDateStyle, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=ReaderDateStyleFieldLabel}" AutomationProperties.Name="{Binding ReaderDateStyleLabel}" AutomationProperties.HelpText="{Binding ReaderDateStyleHint}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        </Grid>
                    </Border>
                    <Border Classes="settings-divider">
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                            <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Workspace.Space.4}" Classes="settings-label">
                                <TextBlock x:Name="ReaderSpoilersFieldLabel" Text="{Binding ReaderSpoilersLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ReaderSpoilersHint}" Classes="workspace-help" TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox x:Name="ReaderSpoilersInput" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Stretch" ItemsSource="{Binding ReaderSpoilersChoices}" SelectedItem="{Binding SelectedReaderSpoilers, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding ElementName=ReaderSpoilersFieldLabel}" AutomationProperties.Name="{Binding ReaderSpoilersLabel}" AutomationProperties.HelpText="{Binding ReaderSpoilersHint}">
                            <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        </Grid>
                    </Border>
                    <Expander x:Name="ReaderLongPostsSettings" Header="{Binding ReaderLongPostsTitle}" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="{StaticResource Workspace.Space.8}">
                            <Border Classes="settings-divider">
                                <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                                    <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
