                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="ProductionWorkersInput" Value="{Binding ProductionWorkers, Mode=TwoWay}" Minimum="1" Maximum="8" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=ProductionWorkersFieldLabel}" AutomationProperties.Name="{Binding ProductionWorkersLabel}" AutomationProperties.HelpText="{Binding ProductionWorkersHelp}" />
                                <TextBlock x:Name="ProductionWorkersInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            </Grid>
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock x:Name="WorkerIdleMinutesFieldLabel" Text="{Binding WorkerIdleMinutesLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="WorkerIdleMinutesInput" Value="{Binding WorkerIdleMinutes, Mode=TwoWay}" Minimum="1" Maximum="30" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=WorkerIdleMinutesFieldLabel}" AutomationProperties.Name="{Binding WorkerIdleMinutesLabel}" AutomationProperties.HelpText="{Binding WorkerIdleMinutesHelp}" />
                                <TextBlock x:Name="WorkerIdleMinutesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            </Grid>
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock x:Name="SourceHeapMiBFieldLabel" Text="{Binding SourceHeapMiBLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="SourceHeapMiBInput" Value="{Binding SourceHeapMiB, Mode=TwoWay}" Minimum="128" Maximum="1024" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=SourceHeapMiBFieldLabel}" AutomationProperties.Name="{Binding SourceHeapMiBLabel}" AutomationProperties.HelpText="{Binding SourceHeapMiBHelp}" />
                                <TextBlock x:Name="SourceHeapMiBInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            </Grid>
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                                <TextBlock x:Name="FilterHeapMiBFieldLabel" Text="{Binding FilterHeapMiBLabel}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="FilterHeapMiBInput" Value="{Binding FilterHeapMiB, Mode=TwoWay}" Minimum="256" Maximum="2048" Increment="1" AutomationProperties.LabeledBy="{Binding ElementName=FilterHeapMiBFieldLabel}" AutomationProperties.Name="{Binding FilterHeapMiBLabel}" AutomationProperties.HelpText="{Binding FilterHeapMiBHelp}" />
                                <TextBlock x:Name="FilterHeapMiBInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Expander>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel x:Name="SettingsUpdatesPage" Spacing="8" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <TextBlock x:Name="SettingsUpdatesHeading" Text="{Binding UpdatesTitle}" Classes="section-title" />
                    <Button x:Name="ResetUpdatesButton" Tag="settings.updates" Classes="ghost" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetUpdatesLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                    <CheckBox x:Name="AutomaticUpdatesInput" AutomationProperties.Name="{Binding AutomaticUpdateChecksLabel}" AutomationProperties.HelpText="{Binding UpdatePrivacyHint}" IsEnabled="{Binding UpdatesEnabled}" IsChecked="{Binding AutomaticUpdateChecks, Mode=TwoWay}">
                        <TextBlock Text="{Binding AutomaticUpdateChecksLabel}" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox x:Name="PrereleaseUpdatesInput" AutomationProperties.Name="{Binding IncludePrereleaseUpdatesLabel}" IsEnabled="{Binding UpdatesEnabled}" IsChecked="{Binding IncludePrereleaseUpdates, Mode=TwoWay}">
                        <TextBlock Text="{Binding IncludePrereleaseUpdatesLabel}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock x:Name="UpdatePrivacyText" Text="{Binding UpdatePrivacyHint}" Classes="workspace-help" />
                    <TextBlock x:Name="UpdateDisabledText" Text="{Binding UpdateDisabledReason}" IsVisible="{Binding UpdatesDisabled}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="SettingsNotificationsSection" Spacing="8" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <TextBlock x:Name="SettingsNotificationsHeading" Text="{Binding NotificationsTitle}" Classes="section-title" />
                    <Button x:Name="ResetNotificationsButton" Tag="settings.notifications" Classes="ghost" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetNotificationsLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                    <CheckBox x:Name="InformationNotificationsInput" IsChecked="{Binding ShowInformationNotifications, Mode=TwoWay}" AutomationProperties.Name="{Binding InformationNotificationsLabel}"><TextBlock Text="{Binding InformationNotificationsLabel}" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="WarningNotificationsInput" IsChecked="{Binding ShowWarningNotifications, Mode=TwoWay}" AutomationProperties.Name="{Binding WarningNotificationsLabel}"><TextBlock Text="{Binding WarningNotificationsLabel}" TextWrapping="Wrap" /></CheckBox>
                    <CheckBox x:Name="ErrorNotificationsInput" IsChecked="{Binding ShowErrorNotifications, Mode=TwoWay}" AutomationProperties.Name="{Binding ErrorNotificationsLabel}"><TextBlock Text="{Binding ErrorNotificationsLabel}" TextWrapping="Wrap" /></CheckBox>
                    <TextBlock Text="{Binding NotificationsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="SettingsBehaviorPage" Spacing="8" IsEnabled="{Binding IsEditable}" IsVisible="False">
                    <TextBlock x:Name="SettingsBehaviorHeading" Text="{Binding BehaviorTitle}" Classes="section-title" />
                    <Button x:Name="ResetBehaviorButton" Tag="settings.behavior" Classes="ghost" Content="{Binding ResetLabel}" AutomationProperties.Name="{Binding ResetBehaviorLabel}" Click="OnResetCategoryClick" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right" />
                    <Expander x:Name="SettingsBehaviorGroup" wv:WorkViewElement.Id="settings.group.behavior" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel x:Name="SettingsBehaviorBody" Spacing="8" Margin="0,8,0,0">
                    <CheckBox x:Name="BoardAdmissionWizardInput" Content="{Binding BoardAdmissionWizardLabel}" IsChecked="{Binding ShowBoardAdmissionWizard, Mode=TwoWay}" />
                    <CheckBox x:Name="MonitorClipboardUrlsInput" IsChecked="{Binding MonitorClipboardUrls, Mode=TwoWay}" AutomationProperties.Name="{Binding MonitorClipboardLabel}" AutomationProperties.HelpText="{Binding MonitorClipboardHint}">
                        <TextBlock Text="{Binding MonitorClipboardLabel}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="{Binding MonitorClipboardHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    <CheckBox x:Name="RestoreSessionInput" Content="{Binding RestoreSessionLabel}" IsChecked="{Binding SaveUrlsOnExit, Mode=TwoWay}" />
                    <CheckBox x:Name="CloseToTrayInput" Content="{Binding CloseToTrayLabel}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    <CheckBox x:Name="MinimizeToTrayInput" Content="{Binding MinimizeToTrayLabel}" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                    <StackPanel x:Name="SettingsStatisticsSection" Spacing="8" Margin="0,16,0,0">
                        <StackPanel.Styles>
                            <!-- An unavailable row stays readable but is visibly set apart; its tooltip names the switch it depends on. -->
                            <Style Selector="TextBlock.workspace-field-label:disabled"><Setter Property="Foreground" Value="{DynamicResource Workspace.Muted}" /></Style>
                        </StackPanel.Styles>
                        <TextBlock x:Name="SettingsStatisticsHeading" Text="{Binding StatisticsTitle}" Classes="workspace-field-label" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatisticsIntro}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" ColumnSpacing="24">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="StatsHeaderGraphFieldLabel" Text="{Binding StatsHeaderGraphLabel}" Classes="workspace-field-label" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding StatsHeaderGraphHint}" Classes="workspace-help" />
                            </StackPanel>
                            <ComboBox x:Name="StatsHeaderGraphInput" VerticalAlignment="Center" AutomationProperties.LabeledBy="{Binding ElementName=StatsHeaderGraphFieldLabel}" AutomationProperties.Name="{Binding StatsHeaderGraphLabel}" AutomationProperties.HelpText="{Binding StatsHeaderGraphHint}" Grid.Column="1" HorizontalAlignment="Stretch"
                                      ItemsSource="{Binding StatsHeaderGraphChoices}" SelectedItem="{Binding SelectedStatsHeaderGraph, Mode=TwoWay}">
                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="StatsHeaderIconsInput" IsChecked="{Binding StatsHeaderIcons, Mode=TwoWay}" AutomationProperties.Name="{Binding StatsHeaderIconsLabel}" AutomationProperties.HelpText="{Binding StatsHeaderIconsHint}">
                            <TextBlock Text="{Binding StatsHeaderIconsLabel}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding StatsHeaderIconsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="StatsSampleIntervalMsFieldLabel" Text="{Binding StatsSampleIntervalMsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="StatsSampleIntervalMsInput" Value="{Binding StatsSampleIntervalMs, Mode=TwoWay}" Minimum="500" Maximum="10000" Increment="100" AutomationProperties.LabeledBy="{Binding ElementName=StatsSampleIntervalMsFieldLabel}" AutomationProperties.Name="{Binding StatsSampleIntervalMsLabel}" AutomationProperties.HelpText="{Binding StatsSampleIntervalMsHelp}" />
                                <TextBlock x:Name="StatsSampleIntervalMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatsSampleIntervalMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="StatsHistorySamplesFieldLabel" Text="{Binding StatsHistorySamplesLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="StatsHistorySamplesInput" Value="{Binding StatsHistorySamples, Mode=TwoWay}" Minimum="30" Maximum="3600" Increment="10" AutomationProperties.LabeledBy="{Binding ElementName=StatsHistorySamplesFieldLabel}" AutomationProperties.Name="{Binding StatsHistorySamplesLabel}" AutomationProperties.HelpText="{Binding StatsHistorySamplesHelp}" />
                                <TextBlock x:Name="StatsHistorySamplesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatsHistorySamplesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <CheckBox x:Name="StatsTrayTooltipInput" IsChecked="{Binding StatsTrayTooltip, Mode=TwoWay}" AutomationProperties.Name="{Binding StatsTrayTooltipLabel}" AutomationProperties.HelpText="{Binding StatsTrayTooltipHint}">
                            <TextBlock Text="{Binding StatsTrayTooltipLabel}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding StatsTrayTooltipHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" ToolTip.Tip="{Binding StatsBackgroundIntervalMsReason}" ToolTip.ShowOnDisabled="True">
                            <TextBlock x:Name="StatsBackgroundIntervalMsFieldLabel" Text="{Binding StatsBackgroundIntervalMsLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" IsEnabled="{Binding StatsBackgroundIntervalMsEnabled}" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="StatsBackgroundIntervalMsInput" Value="{Binding StatsBackgroundIntervalMs, Mode=TwoWay}" Minimum="2000" Maximum="60000" Increment="1000" IsEnabled="{Binding StatsBackgroundIntervalMsEnabled}" ToolTip.Tip="{Binding StatsBackgroundIntervalMsReason}" ToolTip.ShowOnDisabled="True" AutomationProperties.LabeledBy="{Binding ElementName=StatsBackgroundIntervalMsFieldLabel}" AutomationProperties.Name="{Binding StatsBackgroundIntervalMsLabel}" AutomationProperties.HelpText="{Binding StatsBackgroundIntervalMsHelp}" />
                                <TextBlock x:Name="StatsBackgroundIntervalMsInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatsBackgroundIntervalMsHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <CheckBox x:Name="StatsTrayMenuInput" IsChecked="{Binding StatsTrayMenu, Mode=TwoWay}" AutomationProperties.Name="{Binding StatsTrayMenuLabel}" AutomationProperties.HelpText="{Binding StatsTrayMenuHint}">
                            <TextBlock Text="{Binding StatsTrayMenuLabel}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding StatsTrayMenuHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <CheckBox x:Name="StatsPersistInput" IsChecked="{Binding StatsPersist, Mode=TwoWay}" AutomationProperties.Name="{Binding StatsPersistLabel}" AutomationProperties.HelpText="{Binding StatsPersistHint}">
                            <TextBlock Text="{Binding StatsPersistLabel}" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="{Binding StatsPersistHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" ToolTip.Tip="{Binding StatsRetentionDaysReason}" ToolTip.ShowOnDisabled="True">
                            <TextBlock x:Name="StatsRetentionDaysFieldLabel" Text="{Binding StatsRetentionDaysLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" IsEnabled="{Binding StatsRetentionDaysEnabled}" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="StatsRetentionDaysInput" Value="{Binding StatsRetentionDays, Mode=TwoWay}" Minimum="1" Maximum="365" Increment="1" IsEnabled="{Binding StatsRetentionDaysEnabled}" ToolTip.Tip="{Binding StatsRetentionDaysReason}" ToolTip.ShowOnDisabled="True" AutomationProperties.LabeledBy="{Binding ElementName=StatsRetentionDaysFieldLabel}" AutomationProperties.Name="{Binding StatsRetentionDaysLabel}" AutomationProperties.HelpText="{Binding StatsRetentionDaysHelp}" />
                                <TextBlock x:Name="StatsRetentionDaysInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatsRetentionDaysHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24" ToolTip.Tip="{Binding StatsPersistIntervalMinutesReason}" ToolTip.ShowOnDisabled="True">
                            <TextBlock x:Name="StatsPersistIntervalMinutesFieldLabel" Text="{Binding StatsPersistIntervalMinutesLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" IsEnabled="{Binding StatsPersistIntervalMinutesEnabled}" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="StatsPersistIntervalMinutesInput" Value="{Binding StatsPersistIntervalMinutes, Mode=TwoWay}" Minimum="1" Maximum="60" Increment="1" IsEnabled="{Binding StatsPersistIntervalMinutesEnabled}" ToolTip.Tip="{Binding StatsPersistIntervalMinutesReason}" ToolTip.ShowOnDisabled="True" AutomationProperties.LabeledBy="{Binding ElementName=StatsPersistIntervalMinutesFieldLabel}" AutomationProperties.Name="{Binding StatsPersistIntervalMinutesLabel}" AutomationProperties.HelpText="{Binding StatsPersistIntervalMinutesHelp}" />
                                <TextBlock x:Name="StatsPersistIntervalMinutesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatsPersistIntervalMinutesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                        <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="24">
                            <TextBlock x:Name="StatsMaxSourcesFieldLabel" Text="{Binding StatsMaxSourcesLabel}" VerticalAlignment="Center" Classes="workspace-field-label" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <desktop:SettingsNumberInput x:Name="StatsMaxSourcesInput" Value="{Binding StatsMaxSources, Mode=TwoWay}" Minimum="8" Maximum="256" Increment="8" AutomationProperties.LabeledBy="{Binding ElementName=StatsMaxSourcesFieldLabel}" AutomationProperties.Name="{Binding StatsMaxSourcesLabel}" AutomationProperties.HelpText="{Binding StatsMaxSourcesHelp}" />
                                <TextBlock x:Name="StatsMaxSourcesInputError" Classes="workspace-error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding StatsMaxSourcesHint}" Classes="workspace-help" TextWrapping="Wrap" />
                    </StackPanel>
                        </StackPanel>
                    </Expander>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding SupportedSources}" Classes="workspace-help" VerticalAlignment="Center" />
                        <Button x:Name="AboutSettingsButton" Grid.Column="1" Click="OnAboutButtonClick" />
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="SettingsWorkViewsPage" Spacing="8" IsVisible="False" IsEnabled="{Binding IsEditable}">
                    <TextBlock x:Name="SettingsWorkViewsHeading" Text="{Binding WorkViewsTitle}" Classes="section-title" TextWrapping="Wrap" />
                    <ContentControl x:Name="SettingsWorkViewOverviewHost" HorizontalContentAlignment="Stretch" />
                </StackPanel>
                <commands:ShortcutEditor x:Name="ShortcutsEditor" IsVisible="False" IsEnabled="{Binding IsEditable}" />
                <controls:WorkspaceBanner x:Name="SettingsErrorBanner" wv:WorkViewElement.Id="settings.error.banner" Type="Error" IsVisible="{Binding HasError}"><StackPanel Spacing="6">
                    <TextBlock x:Name="SettingsError" Text="{Binding ErrorMessage}" Classes="workspace-error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <Expander x:Name="SettingsErrorDetails" Header="{Binding ErrorDetailsLabel}" IsVisible="{Binding HasErrorDetails}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBox Text="{Binding ErrorDetails}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" />
                    </Expander>
                </StackPanel></controls:WorkspaceBanner>
            </StackPanel>
        </ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Classes="workspace-dialog-footer">
            <Grid x:Name="SettingsFooter" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8" HorizontalAlignment="Center" MaxWidth="1088">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="CancelDestinationCheckButton" Content="{Binding CancelDestinationCheckLabel}" Click="OnCancelDestinationCheckClick" IsVisible="{Binding IsCheckingDestination}" />
                    <ursa:LoadingIcon Width="16" Height="16" IsVisible="{Binding IsBusy}" IsLoading="{Binding IsBusy}" Focusable="False" />
                    <TextBlock Text="{Binding BusyStatusMessage}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel x:Name="SettingsFooterActions" wv:WorkViewElement.Id="settings.footer.actions" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,10,0" IsEnabled="{Binding IsEditable}" HorizontalAlignment="Right">
                    <Button x:Name="CancelSettingsButton" Click="OnCancelButtonClick" />
                    <Button x:Name="SaveSettingsButton" Classes="primary" Click="OnSaveButtonClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
