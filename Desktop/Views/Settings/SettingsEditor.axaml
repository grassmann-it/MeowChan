                                <ComboBox.ItemTemplate><DataTemplate x:DataType="local:SettingsChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
                            </ComboBox>
                            </Grid>
                        </Border>
                        <Border Classes="settings-divider">
                            <Grid Classes="settings-row" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Workspace.Space.24}">
                                <StackPanel Classes="settings-label" Spacing="{StaticResource Workspace.Space.4}" VerticalAlignment="Center">
                                    <TextBlock x:Name="TaggingCard5FieldLabel" Text="{Binding TaggingCard5Label}" Classes="workspace-field-label" TextWrapping="Wrap" />
