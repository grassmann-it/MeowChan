<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:commands="clr-namespace:MeowChan.Desktop.Commands"
             xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:controls="clr-namespace:MeowChan.Desktop.Controls" xmlns:ursa="https://irihi.tech/ursa" x:Class="MeowChan.ArchivePage" SizeChanged="OnSizeChanged">
    <Grid x:Name="ArchiveRoot" Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Grid x:Name="ArchivePageHeader" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="5">
                <TextBlock Tag="nav.archive" Classes="page-title localized" />
                <TextBlock x:Name="ArchiveSubtitle" Tag="archive.subtitle" Classes="muted localized" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Top" ItemSpacing="8" LineSpacing="6">
                <Button x:Name="ArchiveTransferPreview" Click="OnTransferPreviewClick" />
                <Button x:Name="ArchiveCleanupOpen" Click="OnArchiveCleanupClick" />
                <Button x:Name="RefreshArchiveButton" Tag="archive.refresh" Classes="localized" Click="OnRefreshClick" />
            </WrapPanel>
        </Grid>
        <!-- ARCH-DENSE-01: while no error banner is shown the split also spans the empty
             status row, so both boxes end at the page margin. -->
        <Grid x:Name="ArchiveSplit" Grid.Row="1" Grid.RowSpan="2" ColumnDefinitions="270,6,*" ColumnSpacing="6">
            <Grid x:Name="ArchiveListPane" RowSpacing="6">
                <Grid.RowDefinitions>
                    <!-- Collapsed search tools use only their content height;
                         expanded tools scroll at the cap instead of pushing results down. -->
                    <RowDefinition Height="Auto" MaxHeight="260" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>
                <ScrollViewer x:Name="ArchiveSearchPanelScroll" MaxHeight="260" HorizontalScrollBarVisibility="Disabled"><Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <controls:SearchBox x:Name="ArchiveSearchText" MaxLength="512" KeyDown="OnSearchKeyDown" />
                        <Button x:Name="SearchArchiveButton" Grid.Column="1" Tag="archive.search" Classes="localized" Click="OnSearchClick" />
                    </Grid>
                    <!-- P2: the expander stays the filter toggle (command, IsExpanded, draft marker);
                         its fields open as ArchiveFilterSurface over the results instead of
                         pushing them down inside this capped search area. -->
                    <Expander x:Name="ArchiveFilters" Grid.Row="1" HorizontalAlignment="Stretch">
                        <Expander.Styles>
                            <Style Selector="Expander /template/ :is(Control)#ExpanderContent, Expander /template/ :is(Control)#PART_ContentPresenter, Expander /template/ :is(Control)#ExpanderContentLayoutContainer">
                                <Setter Property="MaxHeight" Value="0" />
                            </Style>
                        </Expander.Styles>
                    </Expander>
                    <WrapPanel x:Name="ArchiveAppliedFilters" Grid.Row="2" ItemSpacing="6" LineSpacing="6" />
                    <StackPanel Grid.Row="3" Spacing="6">
                        <TextBlock x:Name="ArchiveSearchError" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Assertive" />
                        <Button x:Name="ArchiveRetrySearch" Click="OnRetrySearch" IsVisible="False" HorizontalAlignment="Left" />
                    </StackPanel>
                    <desktop:ActionToolBar x:Name="ArchiveResultActions" Grid.Row="4">
                        <ToggleButton x:Name="ArchiveLayoutList" Content="List" Classes="media-control" ursa:ToolBar.OverflowMode="Never" />
                        <ToggleButton x:Name="ArchiveLayoutTable" Content="Table" Classes="media-control" ursa:ToolBar.OverflowMode="Never" />
                        <Button x:Name="ArchiveResultsGallery" Tag="gallery.results" Classes="localized" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveThreadColumnsButton" Content="Columns" ursa:ToolBar.OverflowMode="AsNeeded" IsVisible="False" />
                        <Button x:Name="ArchiveFavoritesOverview" Content="★ Favorites" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveFilenameSearchOpen" Click="OnFilenameSearchClick" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveResultsExport" ursa:ToolBar.OverflowMode="AsNeeded" />
                        <Button x:Name="ArchiveReaderGroups" Content="Reader groups" Click="OnReaderGroupsClick" />
                        <Button x:Name="ArchiveSaveSearch" Click="OnSaveCurrentSearchClick" />
                        <Button x:Name="ArchiveSavedSearches" Click="OnSavedSearchesClick" />
                    </desktop:ActionToolBar>
                </Grid></ScrollViewer>
                <!-- P2: local filter surface anchored over the result list. Same controls and
                     names as before; Search applies via the existing path, Escape closes. -->
                <Border x:Name="ArchiveFilterSurface" Grid.Row="1" ZIndex="10" Classes="workspace-overlay" Padding="10"
                        VerticalAlignment="Top" IsVisible="{Binding #ArchiveFilters.IsExpanded}"
                        KeyboardNavigation.TabNavigation="Cycle" KeyDown="OnFilterSurfaceKeyDown">
                    <!-- The toggle directly above names the surface; no repeated title. -->
                    <Grid RowDefinitions="*,Auto" RowSpacing="8">
                        <ScrollViewer x:Name="ArchiveFilterSurfaceScroll" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ArchiveFilterFields" Spacing="8" Margin="0,0,12,0">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <desktop:IdentitySuggestionBox x:Name="ArchiveSourceFilter" KeyDown="OnSearchKeyDown" />
                                    <Button x:Name="ArchiveAddSource" Grid.Column="1" Click="OnAddSource" />
                                </Grid>
                                <WrapPanel x:Name="ArchiveDraftSources" ItemSpacing="6" LineSpacing="6" AutomationProperties.LiveSetting="Polite" />
                                <ComboBox x:Name="ArchiveBoardScope" HorizontalAlignment="Stretch"  />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <desktop:IdentitySuggestionBox x:Name="ArchiveBoardFilter" KeyDown="OnSearchKeyDown" />
                                    <Button x:Name="ArchiveAddBoard" Grid.Column="1" Click="OnAddBoard" />
                                </Grid>
                                <WrapPanel x:Name="ArchiveDraftBoards" ItemSpacing="6" LineSpacing="6" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="ArchiveSuggestionsHint" TextWrapping="Wrap" Classes="muted" FontSize="{StaticResource Workspace.Text.Caption}" />
                                <Button x:Name="ArchiveRetrySuggestions" HorizontalAlignment="Left" IsVisible="False" />
                                <!-- Choosing a state adds it at once; no separate Add step. -->
                                <ComboBox x:Name="ArchiveStateFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <WrapPanel x:Name="ArchiveDraftStates" ItemSpacing="6" LineSpacing="6" AutomationProperties.LiveSetting="Polite" />
                                <!-- Own tags: include, exclude, and how several included tags combine. -->
                                <ComboBox x:Name="ArchiveTagChoice" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                    <Button x:Name="ArchiveAddTagInclude" HorizontalAlignment="Stretch" Click="OnAddTagInclude" />
                                    <Button x:Name="ArchiveAddTagExclude" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnAddTagExclude" />
                                </Grid>
                                <WrapPanel x:Name="ArchiveDraftTags" ItemSpacing="6" LineSpacing="6" />
                                <ComboBox x:Name="ArchiveTagMode" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <Button x:Name="ArchiveTagManage" HorizontalAlignment="Left" Click="OnManageTags" />
                                <ComboBox x:Name="ArchiveCaptureFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <ComboBox x:Name="ArchivePostsFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <ComboBox x:Name="ArchiveWorkFilter" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <ComboBox x:Name="ArchiveSort" HorizontalAlignment="Stretch" SelectedIndex="0" />
                                <TextBlock x:Name="ArchiveDateTitle" TextWrapping="Wrap" />
                                <TextBlock x:Name="ArchiveDateFromLabel" />
                                <desktop:ArchiveDateEditor x:Name="ArchiveStartDate" />
                                <TextBlock x:Name="ArchiveDateToLabel" />
                                <desktop:ArchiveDateEditor x:Name="ArchiveEndDate" />
                                <TextBlock x:Name="ArchiveDateZone" TextWrapping="Wrap" Classes="muted" />
                                <Button x:Name="ArchiveUseDeviceZone" Click="OnUseDeviceZone" HorizontalAlignment="Left" />
                                <TextBlock x:Name="ArchiveDateHint" TextWrapping="Wrap" Classes="muted" FontSize="{StaticResource Workspace.Text.Caption}" />
                            </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button x:Name="ArchiveFilterApply" Tag="archive.search" Classes="localized" Click="OnFilterApplyClick" />
                            <Button x:Name="ArchiveFilterClose" Grid.Column="1" Tag="action.close" Classes="localized" Click="OnFilterCloseClick" />
                        </Grid>
                    </Grid>
                </Border>
                <Border x:Name="ArchiveResultsSurface" Grid.Row="1" Classes="panel">
                    <Grid RowDefinitions="*,Auto">
                        <ListBox x:Name="ArchiveThreads" Classes="workspace-selection-bar" SelectionMode="Multiple" SelectionChanged="OnThreadSelected" DoubleTapped="OnThreadDoubleTapped" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="desktop:ArchiveThreadRow">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="8">
                                        <Grid.ContextMenu>
                                            <ContextMenu Opening="OnArchiveSelectionMenuOpening">
                                                <MenuItem Header="{Binding GalleryLabel}" Click="OnThreadGalleryMenu" />
                                                <MenuItem Header="{Binding ReadLabel}" Click="OnThreadReadMenu" />
                                                <MenuItem Tag="selection.export" Classes="localized" Header="Export selection…" Click="OnThreadExportMenu" />
                                                <MenuItem Tag="action.details" Classes="localized" Header="Details" Click="OnArchiveSelectionDetails" />
                                                <MenuItem Tag="check.action" Classes="localized" Header="Check now" Click="OnArchiveCheckSelection" />
                                                <MenuItem Tag="work.retry" Classes="localized" Header="Retry missing media" Click="OnArchiveRetrySelection" />
                                                <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" CommandParameter="rules" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" CommandParameter="folder" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" CommandParameter="browser" Click="OnArchiveLeadAction" />
                                                <MenuItem Tag="selection.copyUrls" Classes="localized" Header="Copy selected URLs" Click="OnArchiveCopySelection" />
                                                <MenuItem Tag="selection.remove" Classes="localized" Header="Remove selection" Click="OnArchiveRemoveSelection" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Panel x:DataType="desktop:ArchiveThreadRow" IsVisible="{Binding HasPreviewAttachment}">
                                            <desktop:ArchiveAttachmentView DataContext="{Binding PreviewAttachment}" Width="76" />
                                        </Panel>
                                        <desktop:ArchiveThreadFavoriteButton Grid.Column="2" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding TitleOrId}" ToolTip.Tip="{Binding TitleOrId}" TextTrimming="CharacterEllipsis" FontWeight="Medium" />
                                            <TextBlock Text="{Binding PreviewText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                            <TextBlock Text="{Binding Identity}" ToolTip.Tip="{Binding Identity}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                            <TextBlock Text="{Binding TagsText}" ToolTip.Tip="{Binding TagsText}" IsVisible="{Binding HasTags}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Classes="workspace-meta" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <DataGrid x:Name="ArchiveThreadTable" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Extended"
                                  PointerReleased="OnArchiveColumnsReleased"
                                  SelectionChanged="OnThreadTableSelected" DoubleTapped="OnThreadTableDoubleTapped">
                            <DataGrid.Styles>
                                <!-- Template and generated text columns share one row center. -->
                                <Style Selector="DataGridCell">
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                                <Style Selector="DataGridCell TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Source / board" SortMemberPath="Identity" Width="150" MinWidth="125"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding Identity}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Identity}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Title / ID" SortMemberPath="TitleOrId" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalAlignment="Center"><TextBlock Text="{Binding TitleOrId}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TitleOrId}" VerticalAlignment="Center" /><desktop:ArchiveThreadFavoriteButton Grid.Column="1" VerticalAlignment="Center" /></Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Posts" Width="65" MinWidth="55" Binding="{Binding Posts, DataType=desktop:ArchiveThreadRow}" />
                                <DataGridTemplateColumn Header="Saved versions" SortMemberPath="SavedMediaCount" Width="145" MinWidth="110"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactMedia}" ToolTip.Tip="{Binding MediaStatus}" AutomationProperties.HelpText="{Binding MediaStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Source" SortMemberPath="CompactSource" Width="90" MinWidth="75"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactSource}" ToolTip.Tip="{Binding SourceStatus}" AutomationProperties.HelpText="{Binding SourceStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Work" SortMemberPath="CompactWork" Width="110" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock Text="{Binding CompactWork}" ToolTip.Tip="{Binding WorkStatus}" AutomationProperties.HelpText="{Binding WorkStatus}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="Last capture" Width="145" MinWidth="125" Binding="{Binding LastCapture, DataType=desktop:ArchiveThreadRow}" />
                                <DataGridTemplateColumn Header="Tags" SortMemberPath="TagColumnText" Width="170" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveThreadRow"><TextBlock AutomationProperties.AutomationId="ArchiveThreadTagCell" Text="{Binding TagColumnText}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding TagColumnTip}" AutomationProperties.HelpText="{Binding TagColumnTip}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu><ContextMenu Opening="OnArchiveSelectionMenuOpening">
                                <MenuItem x:Name="ArchiveTableGalleryMenu" Header="Open in gallery" Click="OnThreadGalleryMenu" />
                                <MenuItem x:Name="ArchiveTableReadMenu" Header="Read posts" Click="OnThreadReadMenu" />
                                <MenuItem x:Name="ArchiveTableExportMenu" Header="Export selection…" Click="OnThreadExportMenu" />
                                <MenuItem Tag="selection.copyUrls" Classes="localized" Header="Copy selected URLs" Click="OnArchiveCopySelection" />
                                <MenuItem Tag="action.details" Classes="localized" Header="Details" Click="OnArchiveSelectionDetails" />
                                <MenuItem Tag="check.action" Classes="localized" Header="Check now" Click="OnArchiveCheckSelection" />
                                <MenuItem Tag="work.retry" Classes="localized" Header="Retry missing media" Click="OnArchiveRetrySelection" />
                                <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" CommandParameter="rules" Click="OnArchiveLeadAction" />
                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" CommandParameter="folder" Click="OnArchiveLeadAction" />
                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" CommandParameter="browser" Click="OnArchiveLeadAction" />
                                <Separator />
                                <MenuItem x:Name="ArchiveTableRemoveMenu" Tag="selection.remove" Classes="localized" Header="Remove selection" Click="OnArchiveRemoveSelection" />
                            </ContextMenu></DataGrid.ContextMenu>
                        </DataGrid>
                        <!-- Same pattern as the empty Downloads list: centred, one sentence, one primary next step. -->
                        <StackPanel x:Name="ArchiveEmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    MaxWidth="360" Margin="20" Spacing="12" IsVisible="False">
                            <TextBlock x:Name="ArchiveEmpty" Classes="muted" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            <Button x:Name="ArchiveGoDownloads" Classes="primary" HorizontalAlignment="Center" Click="OnGoDownloadsClick" />
                            <Button x:Name="ArchiveResetFilters" Classes="primary" HorizontalAlignment="Center" Click="OnResetArchiveFiltersClick" />
                        </StackPanel>
                        <!-- ARCH-DENSE-01 slice 2: the pager is docked under the list inside the results
                             box; it is its own row, so it never covers a list row. -->
                        <Border x:Name="ArchiveResultsBar" Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Workspace.Border}" Padding="8,4">
                            <StackPanel x:Name="ArchiveResultsFooter" Spacing="4">
                                <!-- ARCH-DENSE-01: pager and range share one line when both fit. -->
                                <desktop:ArchiveFooterLayout x:Name="ArchiveResultsRange">
                                    <ursa:Pagination x:Name="ArchiveResultsPagination" PageSize="50" ShowPageSizeSelector="False" ShowQuickJump="False" CurrentPageChanged="OnResultsPageChanged">
                                        <ursa:Pagination.Styles><Style Selector="ursa|PaginationButton"><Setter Property="MinWidth" Value="24" /><Setter Property="Width" Value="24" /><Setter Property="Padding" Value="2" /></Style></ursa:Pagination.Styles>
                                    </ursa:Pagination>
                                    <TextBlock x:Name="ArchiveThreadPage" Classes="workspace-meta tnum" />
                                </desktop:ArchiveFooterLayout>
                                <TextBlock x:Name="ArchiveSelectionSummary" Classes="workspace-meta tnum" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="PreviousThreadsButton" IsVisible="False" Click="OnPreviousThreads" />
                                <Button x:Name="NextThreadsButton" IsVisible="False" Click="OnNextThreads" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <GridSplitter x:Name="ArchiveSplitter" Grid.Column="1" Width="6" ResizeDirection="Columns" PointerReleased="OnArchiveSplitReleased" KeyUp="OnArchiveSplitKeyUp" />
            <Grid x:Name="ArchiveReaderPane" Grid.Column="2" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="3">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Button x:Name="ArchiveBackButton" Tag="archive.back" Classes="localized" Click="OnBackClick" />
                        <TextBlock x:Name="ArchiveReaderTitle" Grid.Column="1" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Button x:Name="CapturePostsButton" Grid.Column="2" Click="OnCaptureClick" />
                    </Grid>
                    <!-- Wide readers carry up to ten labelled actions; rarely used ones overflow into More instead of wrapping. -->
                    <desktop:ActionToolBar x:Name="ReaderToolbar">
                        <desktop:ActionToolBar.Styles><Style Selector=":is(Button)"><Setter Property="MinWidth" Value="38" /><Setter Property="Height" Value="32" /><Setter Property="Margin" Value="0,0,8,0" /></Style></desktop:ActionToolBar.Styles>
                    <Button x:Name="ArchiveCloseReader" ursa:ToolBar.OverflowMode="Never" Tag="reader.close" Classes="localized" IsVisible="False" Click="OnCloseReaderClick" />
                    <desktop:ArchiveThreadFavoriteButton x:Name="ArchiveCurrentThreadFavorite" ursa:ToolBar.OverflowMode="Never" />
                    <Button x:Name="ReaderTagsOpen" ursa:ToolBar.OverflowMode="Never" Click="OnOpenThreadTags" />
                    <Button x:Name="ArchiveOpenGallery" ursa:ToolBar.OverflowMode="Never" Tag="gallery.open" Classes="localized" Click="OnCurrentGalleryClick" />
                    <Button x:Name="ReaderUnreadReturn" ursa:ToolBar.OverflowMode="Never" IsVisible="False" Click="OnReaderUnreadReturnClick" />
                    <Button x:Name="ReaderFindOpen" ursa:ToolBar.OverflowMode="AsNeeded" Click="OnOpenThreadFind" />
                    <Button x:Name="ArchiveReadPosts" ursa:ToolBar.OverflowMode="Never" Tag="gallery.read" Classes="localized" Click="OnReadPostsClick" />
                    <Button x:Name="ArchiveGalleryReturn" ursa:ToolBar.OverflowMode="Never" Content="Back to gallery" IsVisible="False" Click="OnGalleryReturnClick" />
                    <!-- MEDIA103-NAV: shown instead of the gallery return while a "show in thread" from the Medien page can go back. -->
                    <Button x:Name="ArchiveMediaReturn" ursa:ToolBar.OverflowMode="Never" Content="Back to media" IsVisible="False" Click="OnMediaReturnClick" />
                    <!-- URSA-12: explicit skip preserves the displayed post on missing group targets. -->
                    <Button x:Name="ReaderSkipUnavailableGroupMember" ursa:ToolBar.OverflowMode="Never" IsVisible="False" Click="OnSkipUnavailableGroupMember" />
                    <!-- Overflow candidates by usefulness (find in thread first, export last): later ones move into More first. -->
                    <Button x:Name="ArchiveReaderFullscreen" ursa:ToolBar.OverflowMode="AsNeeded" Content="Full screen" Click="OnReaderFullscreenClick" />
                    <Button x:Name="ArchiveHistoryBack" ursa:ToolBar.OverflowMode="AsNeeded" Tag="archive.historyBack" Classes="localized" Click="OnHistoryBack" IsVisible="False" />
                    <Button x:Name="ReaderFilenameSearchOpen" ursa:ToolBar.OverflowMode="AsNeeded" Click="OnFilenameSearchClick" />
                    <Button x:Name="ReaderHashSearchOpen" ursa:ToolBar.OverflowMode="AsNeeded" Click="OnHashSearchClick" />
                    <Button x:Name="ExportArchiveButton" ursa:ToolBar.OverflowMode="AsNeeded" Tag="archive.export" Classes="localized" Click="OnExportClick" />
                    </desktop:ActionToolBar>
                    <TextBlock x:Name="ReaderGroupAvailabilityMessage" IsVisible="False" TextWrapping="Wrap" />
                    <StackPanel x:Name="ReaderFindBar" IsVisible="False" Spacing="4">
                        <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <controls:SearchBox x:Name="ReaderFindQuery" Width="240" TextChanged="OnThreadFindQueryChanged" />
                            <Button x:Name="ReaderFindPrevious" Click="OnPreviousThreadFind" />
                            <Button x:Name="ReaderFindNext" Click="OnNextThreadFind" />
                            <Button x:Name="ReaderFindRetry" Click="OnRetryThreadFind" IsVisible="False" />
                            <Button x:Name="ReaderFindClose" Click="OnCloseThreadFind" />
                        </WrapPanel>
                        <TextBlock x:Name="ReaderFindStatus" TextWrapping="Wrap" />
                        <TextBlock x:Name="ReaderFindExcerpt" TextWrapping="Wrap" />
                    </StackPanel>
                    <!-- Own thread tags: inline like reader find, always bound to the open thread. -->
                    <StackPanel x:Name="ReaderTagBar" IsVisible="False" Spacing="4">
                        <WrapPanel x:Name="ReaderTagChips" ItemSpacing="6" LineSpacing="4" />
                        <WrapPanel x:Name="ReaderTagSuggestions" ItemSpacing="6" LineSpacing="4" IsVisible="False" />
                        <WrapPanel ItemSpacing="6" LineSpacing="4">
                            <desktop:IdentitySuggestionBox x:Name="ReaderTagInput" Width="240" />
                            <Button x:Name="ReaderTagAdd" Click="OnAddThreadTag" />
                            <Button x:Name="ReaderTagManage" Click="OnManageTags" />
                            <Button x:Name="ReaderTagClose" Click="OnCloseThreadTags" />
                        </WrapPanel>
                        <TextBlock x:Name="ReaderTagStatus" TextWrapping="Wrap" IsVisible="False" />
                    </StackPanel>
                    <WrapPanel x:Name="ReaderStatusLine" Orientation="Horizontal">
                        <TextBlock x:Name="ArchiveReaderStatus" Classes="muted" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <CheckBox x:Name="ReaderFollowLive" IsEnabled="False" IsCheckedChanged="OnReaderFollowLiveChanged" Margin="0,0,12,0" />
                        <TextBlock x:Name="ReaderNewPostsNotice" IsVisible="False" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button x:Name="ReaderShowNewPosts" IsVisible="False" Click="OnShowReaderUpdates" />
                    </WrapPanel>
                </StackPanel>
                <Border x:Name="ArchiveReaderContent" Grid.Row="1" Classes="panel">
                    <Grid x:Name="ReaderContentSurface">
                        <TextBlock x:Name="ArchiveSelectHint" Tag="archive.select" Classes="muted localized" Margin="16" />
                        <TabControl x:Name="ArchiveContentTabs" IsVisible="False">
                            <TabItem x:Name="ArchivePostsTab" Header="Posts">
                                <Grid RowDefinitions="*,Auto" RowSpacing="8">
                                    <Grid>
                                        <!-- Reader post cards (study 2026-11-13, variant A): each post is a card with a
                                             1-px edge (>= 3:1 against the page) on the darker page tone. The active post is an
                                             AccentSurface card with the accent edge; keyboard focus adds a heavier edge and the
                                             shared focus adorner. Semi's hover/pressed tints are suppressed on cards. -->
                                        <ListBox x:Name="ArchivePosts" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 Background="{DynamicResource Workspace.Background}" Padding="2,4"
                                                 ContainerPrepared="OnReaderPostContainerPrepared">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.Card}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.CardEdge}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
                                                    <Setter Property="Margin" Value="6,4" />
                                                    <Setter Property="Padding" Value="2,0" />
                                                </Style>
                                                <Style Selector="ListBoxItem /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.Card}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.CardEdge}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.Card}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:pressed /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.Card}" />
                                                </Style>
                                                <!-- Opening post: no card, directly on the page (classic imageboard order: OP, then
                                                     reply cards). The transparent 1-px edge keeps its geometry; selected, it becomes
                                                     the active card like every post (the styles below win). -->
                                                <Style Selector="ListBoxItem.reader-op">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem.reader-op /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem.reader-op:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem.reader-op:pressed /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.AccentSurface}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="BorderThickness" Value="3,2,2,2" />
                                                </Style>
                                                <Style Selector="Button.reader-post-number">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="MinHeight" Value="24" />
                                                    <Setter Property="FontSize" Value="12" />
                                                </Style>
                                                <Style Selector="ItemsControl.reader-quote-keys:not(:focus-within):not(.reader-quotes-visible)">
                                                    <Setter Property="MaxHeight" Value="0" />
                                                    <Setter Property="ClipToBounds" Value="True" />
                                                </Style>
                                                <!-- Reference buttons (keyboard quote row, expanded backlinks) read as links, not raised buttons. -->
                                                <Style Selector="Button.reader-reply-toggle">
                                                    <Setter Property="Padding" Value="4,0" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                                <Style Selector="Button.reader-reply-card">
                                                    <Setter Property="Background" Value="{DynamicResource Workspace.ReaderCodeSurface}" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="CornerRadius" Value="{StaticResource Workspace.Radius.Control}" />
                                                    <Setter Property="Padding" Value="10,6" />
                                                    <Setter Property="MinHeight" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Text}" />
                                                </Style>
                                                <Style Selector="Button.reader-quote">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}" />
                                                    <Setter Property="Padding" Value="4,2" />
                                                    <Setter Property="MinHeight" Value="24" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="desktop:ArchivePostRow">
                                                    <StackPanel Margin="8,8,8,12" Spacing="6">
                                                        <!-- Reading mark: a full-width divider at the top edge of the first post after the last one read. It runs to the
                                                             card edges (it cancels the card's inner margin) and carries the count between two rules. -->
                                                        <Grid ColumnDefinitions="14,Auto,*" ColumnSpacing="8" Margin="-8,-8,-8,0" IsVisible="{Binding HasUnreadLine}" AutomationProperties.Name="{Binding UnreadLabel}">
                                                            <Rectangle Height="2" Fill="{DynamicResource Workspace.Accent}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding UnreadLabel}" Classes="workspace-meta" FontWeight="SemiBold" Foreground="{DynamicResource Workspace.Accent}" VerticalAlignment="Center" Margin="0,4" />
                                                            <Rectangle Grid.Column="2" Height="2" Fill="{DynamicResource Workspace.Accent}" VerticalAlignment="Center" />
                                                        </Grid>
                                                        <!-- One header line: Subject · Name · Date · No.; the number copies ">>No.".
                                                             The reply counter at the right opens the nested reply cards below the text. -->
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                                            <WrapPanel ItemSpacing="8" LineSpacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Subject}" IsVisible="{Binding HasSubject}" Classes="section-title" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Author}" IsVisible="{Binding HasAuthor}" Classes="workspace-meta" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Posted}" IsVisible="{Binding HasPosted}" Classes="workspace-meta" VerticalAlignment="Center" />
                                                                <Button Classes="link reader-post-number" Content="{Binding NumberLabel}" ToolTip.Tip="{Binding CopyNumberLabel}"
                                                                        AutomationProperties.Name="{Binding CopyNumberLabel}" Click="OnCopyPostNumberClick" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding RemovedLabel}" IsVisible="{Binding IsDeleted}" Classes="workspace-meta" VerticalAlignment="Center" />
                                                            </WrapPanel>
                                                            <Button Grid.Column="1" Classes="link reader-reply-toggle" IsVisible="{Binding HasReplyToggle}"
                                                                    ToolTip.Tip="{Binding ReplyToggleLabel}" AutomationProperties.Name="{Binding ReplyToggleLabel}"
                                                                    Click="OnReplyToggleClick" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                                    <TextBlock Text="{Binding BacklinkCountLabel}" Classes="workspace-meta" VerticalAlignment="Center" />
                                                                    <Path Classes="reader-reply-chevron" Data="M 0,0 L 3.5,3.5 L 7,0" Stroke="{DynamicResource Workspace.Muted}" StrokeThickness="1.4"
                                                                          IsVisible="{Binding !RepliesExpanded}" VerticalAlignment="Center" />
                                                                    <Path Classes="reader-reply-chevron" Data="M 0,3.5 L 3.5,0 L 7,3.5" Stroke="{DynamicResource Workspace.Muted}" StrokeThickness="1.4"
                                                                          IsVisible="{Binding RepliesExpanded}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                        <desktop:ReaderPostLayout>
                                                            <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}" HorizontalAlignment="Left">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="desktop:ArchiveAttachmentRow">
                                                                        <desktop:ArchiveAttachmentView Margin="0,2,0,8" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <StackPanel Spacing="6">
                                                                <StackPanel>
                                                                    <!-- The Semi text theme sets FontSize locally; explicitly honor the reader preference.
                                                                         Greentext and >>No. are runs over the plain text; a click on >>No. opens it like the buttons. -->
                                                                    <desktop:ReaderBodyTextBlock x:Name="PostBody" Classes="reader-body" Document="{Binding BodyDocument}" SpoilersRevealed="{Binding SpoilersRevealed, Mode=TwoWay}" Expanded="{Binding Expanded, Mode=TwoWay}" IsTextOnly="{Binding IsTextOnly}" FontSize="{Binding $parent[ListBox].FontSize}"
                                                                                                 TextWrapping="Wrap" QuoteInvoked="OnInlineQuoteInvoked" LinkInvoked="OnInlineLinkInvoked" QuoteHover="OnInlineQuoteHover" />
                                                                    <!-- A body over 24 lines shows 18 and a fade; this button unfolds it (and folds it again). -->
                                                                    <Button Classes="reader-quote reader-fold" IsVisible="{Binding #PostBody.IsFoldable}" Content="{Binding #PostBody.FoldLabel}"
                                                                            Click="OnFoldToggleClick" HorizontalAlignment="Left" />
                                                                    <!-- Keyboard/screen-reader path for the inline references (inline runs are not focusable):
                                                                         after the text in tab and reading order, zero height until it holds keyboard focus. -->
                                                                    <ItemsControl ItemsSource="{Binding Quotes}" Classes="reader-quote-keys" Classes.reader-quotes-visible="{Binding HasUnplacedQuotes}"
                                                                                  AutomationProperties.Name="{Binding QuotesLabel}">
                                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                                <Button Classes="reader-quote" Content="{Binding Label}" ToolTip.Tip="{Binding AccessibleLabel}" AutomationProperties.Name="{Binding AccessibleLabel}" commands:CommandPresentation.Id="reader.open-quote" Click="OnQuoteClick" PointerEntered="OnQuoteButtonEntered" PointerExited="OnQuoteButtonExited" Margin="0,2,6,2" HorizontalAlignment="Left" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <!-- I2: replies as nested cards, one level deep: a left rail, the header and the first lines of each reply.
                                                                     The header counter above opens and closes them; "Show more replies" adds the next five. -->
                                                                <StackPanel IsVisible="{Binding RepliesExpanded}" Margin="10,2,0,2" Spacing="6">
                                                                    <ItemsControl ItemsSource="{Binding Replies}">
                                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                                                    <Rectangle Width="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Workspace.Accent}" Opacity="0.55" />
                                                                                    <Button Grid.Column="1" Classes="reader-reply-card" ToolTip.Tip="{Binding AccessibleLabel}" AutomationProperties.Name="{Binding AccessibleLabel}"
                                                                                            commands:CommandPresentation.Id="reader.open-quote" Click="OnQuoteClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                                                        <StackPanel Spacing="2">
                                                                                            <TextBlock Text="{Binding ReplyCardHeader}" Classes="workspace-meta" TextWrapping="Wrap" />
                                                                                            <TextBlock Text="{Binding ReplyExcerpt}" IsVisible="{Binding HasReplyExcerpt}" TextWrapping="Wrap" />
                                                                                        </StackPanel>
                                                                                    </Button>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                    <TextBlock Text="{Binding RepliesLoadingLabel}" IsVisible="{Binding RepliesLoading}" Classes="muted" />
                                                                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMoreReplies}">
                                                                        <Button Content="{Binding MoreRepliesLabel}" commands:CommandPresentation.Id="reader.show-replies" Click="OnMoreRepliesClick" />
                                                                        <TextBlock Text="{Binding RepliesPageLabel}" VerticalAlignment="Center" Classes="muted" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding RepliesError}" IsVisible="{Binding HasRepliesError}" TextWrapping="Wrap" Foreground="{DynamicResource Workspace.Error}" />
                                                            </StackPanel>
                                                        </desktop:ReaderPostLayout>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoPosts" Tag="archive.noPosts" Classes="muted localized" TextWrapping="Wrap" Margin="16" />
                                        <!-- One accent wash for the post a jump lands on (fades out once in 400 ms; never per post). -->
                                        <Border x:Name="ReaderJumpFlash" IsVisible="False" IsHitTestVisible="False" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                CornerRadius="{StaticResource Workspace.Radius.Control}" Background="{DynamicResource Workspace.Accent}" />
                                        <!-- The quote preview: one at a time, filled from the thread's post index when it opens. -->
                                        <Popup x:Name="QuotePreviewPopup" Placement="Bottom" IsLightDismissEnabled="False">
                                            <Border IsHitTestVisible="False" Background="{DynamicResource Workspace.Card}" BorderBrush="{DynamicResource Workspace.Accent}"
                                                    BorderThickness="1" CornerRadius="{StaticResource Workspace.Radius.Control}" Padding="10,8" MaxWidth="480" MaxHeight="320">
                                                <StackPanel Spacing="4">
                                                    <TextBlock x:Name="QuotePreviewHeader" Classes="workspace-meta" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="QuotePreviewSubject" Classes="section-title" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="QuotePreviewBody" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <!-- An external link opens only after this confirmation: the full address, its host in ASCII form and highlighted. -->
                                        <Border x:Name="ReaderLinkDialog" IsVisible="False" Background="#A6000000" ZIndex="5">
                                            <Border Background="{DynamicResource Workspace.ReaderPostSurface}" BorderBrush="{DynamicResource Workspace.Accent}" BorderThickness="1"
                                                    CornerRadius="4" Padding="16" MaxWidth="520" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <StackPanel Spacing="10">
                                                    <TextBlock x:Name="ReaderLinkTitle" Classes="section-title" TextWrapping="Wrap" />
                                                    <SelectableTextBlock x:Name="ReaderLinkUrl" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="ReaderLinkHint" Classes="workspace-meta" TextWrapping="Wrap" />
                                                    <CheckBox x:Name="ReaderLinkRemember" />
                                                    <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6">
                                                        <Button x:Name="ReaderLinkCancel" Click="OnReaderLinkCancel" />
                                                        <Button x:Name="ReaderLinkOpen" Classes="accent" Click="OnReaderLinkOpen" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Border>
                                    </Grid>
                                    <Grid x:Name="ArchivePostNavigation" Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center" Margin="8" ColumnSpacing="8">
                                        <Button x:Name="PreviousPostsButton" Tag="archive.previous" Classes="localized" Click="OnPreviousPosts" />
                                        <TextBlock x:Name="ArchivePostPage" Grid.Column="1" Classes="muted tnum" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextPostsButton" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextPosts" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveMediaTab" Header="Media">
                                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6" Margin="6,2">
                                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6">
                                        <Button x:Name="ArchiveMediaMode" Tag="gallery.tiles" Classes="localized" Click="OnMediaModeClick" />
                                        <Button x:Name="ArchiveMediaColumnsButton" Content="Columns" Click="OnArchiveColumnsClick" IsVisible="False" />
                                        <Button x:Name="ArchiveFavoritesFilter" Content="☆ Favorites only" Click="OnArchiveFavoritesFilterClick" />
                                        <ComboBox x:Name="ArchiveRatingFilter" MinWidth="140" SelectionChanged="OnMediaRatingFilterChanged" />
                                        <ComboBox x:Name="ArchiveMediaSort" MinWidth="160" SelectedIndex="0" SelectionChanged="OnMediaSortChanged" />
                                        <ComboBox x:Name="ArchiveVersionScope" SelectedIndex="1" SelectionChanged="OnVersionScopeChanged" MinWidth="210" />
                                    </WrapPanel>
                                    <Grid x:Name="ArchiveMediaSurface" Grid.Row="1">
                                        <DataGrid x:Name="ArchiveMediaGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionChanged="OnMediaSelected" DoubleTapped="OnMediaDoubleTapped" GridLinesVisibility="None" PointerReleased="OnArchiveColumnsReleased">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Width="*" MinWidth="220" SortMemberPath="Name"><DataGridTemplateColumn.CellTemplate><DataTemplate x:DataType="desktop:ArchiveAssetRow"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                                <DataGridTextColumn Width="85" MinWidth="70" Binding="{Binding Size, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="125" MinWidth="100" Binding="{Binding Version, DataType=desktop:ArchiveAssetRow}" />
                                                <DataGridTextColumn Width="130" MinWidth="100" Binding="{Binding RatingLabel, DataType=desktop:ArchiveAssetRow}" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <ListBox x:Name="ArchiveMediaTiles" Classes="workspace-selection-bar" IsVisible="False" SelectionMode="Multiple" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="OnMediaSelected" DoubleTapped="OnMediaDoubleTapped">
                                            <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style></ListBox.Styles>
                                            <ListBox.ItemsPanel><ItemsPanelTemplate><desktop:MediaTilePanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                                            <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveAssetRow">
                                                <desktop:ArchiveMediaTileView />
                                            </DataTemplate></ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="ArchiveNoMedia" Tag="archive.noMedia" Classes="muted localized" TextWrapping="Wrap" Margin="8,40,8,8" />
                                    </Grid>
                                    <StackPanel x:Name="ArchiveMediaFooter" Grid.Row="2" Spacing="6"><TextBlock x:Name="ArchiveRatingStatus" Classes="error" TextWrapping="Wrap" IsVisible="False" />
                                        <!-- T3: the selection status of the Media tab; shown from two selected files on. -->
                                        <WrapPanel x:Name="ArchiveMediaSelectionBar" ItemSpacing="8" LineSpacing="6" IsVisible="False">
                                            <TextBlock x:Name="ArchiveMediaSelectionStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button x:Name="ArchiveMediaSelectionTag" Click="OnMediaSelectionTagClick" />
                                            <Button x:Name="ArchiveMediaSelectionGallery" Click="OnMediaSelectionGalleryClick" />
                                            <Button x:Name="ArchiveMediaSelectionExport" Click="OnMediaSelectionExportClick" />
                                            <Button x:Name="ArchiveMediaSelectionClear" Click="OnMediaSelectionClearClick" />
                                        </WrapPanel><WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="6"><Button x:Name="ArchiveEditRatingButton" IsEnabled="False" Click="OnEditMediaRatingClick" /><Button x:Name="PreviewArchiveMediaButton" Tag="archive.preview" Classes="localized" Click="OnPreviewClick" /><Button x:Name="ArchiveManageRatingsButton" Click="OnManageMediaRatingsClick" /></WrapPanel></StackPanel>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ArchiveReferencesTab">
                                <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
                                    <TextBlock x:Name="ArchiveReferencesTitle" TextWrapping="Wrap" Classes="muted" />
                                    <ListBox x:Name="ArchiveReferences" Grid.Row="1">
                                        <ListBox.ItemTemplate><DataTemplate x:DataType="desktop:ArchiveQuoteRow">
                                            <Button Content="{Binding Label}" commands:CommandPresentation.Id="reader.open-quote" Click="OnQuoteClick" HorizontalAlignment="Stretch" Margin="0,3" />
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <Grid x:Name="ArchiveReferencesNavigation" Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Button x:Name="PreviousReferences" Tag="archive.previous" Classes="localized" Click="OnPreviousReferences" />
                                        <TextBlock x:Name="ArchiveReferencesPage" Grid.Column="1" Classes="tnum" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <Button x:Name="NextReferences" Grid.Column="2" Tag="archive.next" Classes="localized" Click="OnNextReferences" />
                                    </Grid>
                                </Grid>
                            </TabItem>
                        </TabControl>
                        <WrapPanel x:Name="ReaderNavigation" IsVisible="False" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,24,56" ZIndex="1">
                            <Border Classes="raised" Padding="4" CornerRadius="{StaticResource Workspace.Radius.Group}">
                                <Grid RowDefinitions="32,32,32" ColumnDefinitions="32,32,32" RowSpacing="2" ColumnSpacing="2">
                                    <Grid.Styles>
                                        <Style Selector="Button">
                                            <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" />
                                            <Setter Property="MinWidth" Value="32" /><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="4" />
                                        </Style>
                                    </Grid.Styles>
                                    <Button x:Name="ReaderPreviousPost" Grid.Column="1" Tag="reader.previousPost" Classes="localized" Click="OnReaderNavigationClick" />
                                    <Button x:Name="ReaderNextPost" Grid.Row="2" Grid.Column="1" Tag="reader.nextPost" Classes="localized" Click="OnReaderNavigationClick" />
                                    <Button x:Name="ReaderPreviousThread" Grid.Row="1" Tag="reader.previousThread" Classes="localized" Click="OnReaderNavigationClick" />
                                    <Button x:Name="ReaderNextThread" Grid.Row="1" Grid.Column="2" Tag="reader.nextThread" Classes="localized" Click="OnReaderNavigationClick" />
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
            <!-- ARCH-DENSE-01 (user decision 11.11.2026): loading and status messages reserve
                 no layout height. They float at the bottom left of the reader column (or of the
                 stacked list), above that column's docked footer, only while there is something
                 to show; hidden, the overlay is not hit-tested at all. Shown, it takes the pointer
                 only over its own small box, for the full-text tooltip; hovering keeps a message,
                 a click dismisses it, and messages expire on their own (ArchivePage.Feedback). -->
            <Border x:Name="ArchiveStatusOverlay" Grid.Column="2" Classes="raised" Padding="8,4" Margin="8" MaxWidth="560"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="2"
                    IsVisible="False" Focusable="False">
                <Grid x:Name="ArchiveStatusLine">
                    <WrapPanel ItemSpacing="8" LineSpacing="4" VerticalAlignment="Center">
                        <ursa:LoadingIcon x:Name="ArchiveContentLoading" Width="16" Height="16" Focusable="False" IsVisible="False" VerticalAlignment="Center" />
                        <TextBlock x:Name="ArchiveContentLoadingText" Classes="muted" TextWrapping="Wrap" IsVisible="False" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ArchiveMessage" Classes="muted" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" IsVisible="False" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <ursa:LoadingIcon x:Name="ArchiveMediaLoading" Width="16" Height="16" Focusable="False" IsVisible="False" VerticalAlignment="Center" />
                        <TextBlock x:Name="ArchiveMediaLoadingText" Classes="muted" TextWrapping="Wrap" IsVisible="False" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ARCH-DENSE-01: the error banner stays in layout flow (it can be long and is
             important); its row takes space only while an error is shown. Status and
             loading messages are an overlay inside ArchiveSplit instead. -->
        <StackPanel x:Name="ArchiveStatusStrip" Grid.Row="2" Spacing="6" IsVisible="False">
            <ursa:Banner x:Name="ArchiveErrorBanner" Type="Error" CanClose="False" IsVisible="False" HorizontalContentAlignment="Stretch">
                <ScrollViewer MaxHeight="104" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ArchiveErrorText" TextWrapping="Wrap" Classes="error" AutomationProperties.LiveSetting="Assertive" /></ScrollViewer>
            </ursa:Banner>
        </StackPanel>
        <Border x:Name="ArchivePreview" Grid.RowSpan="3" Classes="panel" Padding="12" IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock x:Name="PreviewTitle" Classes="section-title" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Button x:Name="ClosePreviewButton" Grid.Column="1" Tag="action.close" Classes="localized" Click="OnClosePreview" />
                </Grid>
                <Grid Grid.Row="1">
                    <Image x:Name="ArchivePreviewImage" Stretch="Uniform" />
                    <TextBlock x:Name="ArchivePreviewMessage" Classes="muted" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBox x:Name="ArchivePreviewPath" IsReadOnly="True" />
                    <Button Grid.Column="1" Tag="action.openFolder" Classes="localized" Click="OnOpenMediaFolder" />
                </Grid>
            </Grid>
        </Border>
        <Border x:Name="ArchiveExportDialog" IsVisible="False" Background="#A6000000" Grid.RowSpan="3" ZIndex="20" />
    </Grid>
</UserControl>
