<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="clr-namespace:oChan.Desktop"
             x:Class="oChan.DiagnosticsPage">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel Spacing="5">
            <TextBlock Tag="nav.diagnostics" Classes="page-title localized" Text="Diagnostics" />
            <TextBlock Tag="diagnostics.hint" Classes="muted localized" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Classes="panel" Padding="12,8">
            <TextBlock x:Name="DiagnosticsSummary" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="2" Classes="panel">
            <Grid>
                <DataGrid x:Name="DiagnosticsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="None" SelectionMode="Single" RowHeight="44"
                          CanUserReorderColumns="False" SelectionChanged="OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="110" Binding="{Binding Category, DataType=desktop:DiagnosticEntry}" />
                        <DataGridTextColumn Width="180" Binding="{Binding Resource, DataType=desktop:DiagnosticEntry}" />
                        <DataGridTextColumn Width="*" Binding="{Binding Summary, DataType=desktop:DiagnosticEntry}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock x:Name="DiagnosticsEmpty" Tag="diagnostics.empty" Classes="muted localized"
                           Margin="16,55,16,16" TextWrapping="Wrap" HorizontalAlignment="Center" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Spacing="8">
            <TextBox x:Name="DiagnosticDetails" IsReadOnly="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="110" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock x:Name="DiagnosticsActionError" Classes="error" TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CopyDiagnosticButton" Tag="diagnostics.copy" Classes="localized" Click="OnCopyClick" />
                    <Button x:Name="OpenDiagnosticWatchButton" Tag="diagnostics.openWatch" Classes="localized" Click="OnOpenWatchClick" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
