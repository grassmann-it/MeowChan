<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version><PackageId>MeowChan.PluginHost</PackageId>
    <Description>Optional MeowChan plugin process host. Public API may change in 1.x.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile><NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MeowChan.PluginSdk/MeowChan.PluginSdk.csproj" />
    <ProjectReference Include="../libmeowchan/libmeowchan.csproj" />
    <Compile Include="../Shared/PluginProtocol/**/*.cs" Link="Protocol/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
