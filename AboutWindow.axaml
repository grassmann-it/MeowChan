<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeowChan.AboutWindow"
        Title="About MeowChan"
        Icon="avares://MeowChan/Assets/meowchan.png"
        Width="800" Height="660" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Workspace.Background}"
        Foreground="{DynamicResource Workspace.Text}">
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style Selector="Button.link">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="14" Margin="0,0,0,14">
            <Image x:Name="CatLogo" Width="72" Height="72" Source="avares://MeowChan/Assets/meowchan.png" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="MeowChan" FontSize="26" FontWeight="SemiBold"/>
                <SelectableTextBlock x:Name="VersionText"/>
            </StackPanel>
            <Button x:Name="CopyVersionButton" Grid.Column="2" VerticalAlignment="Center" Click="OnCopyVersionClick"/>
        </Grid>
        <TabControl x:Name="AboutTabs" Grid.Row="1">
            <TabItem x:Name="AboutTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="12">
                        <TextBlock x:Name="DescriptionText" FontSize="15"/>
                        <TextBlock x:Name="AuthorText"/>
                        <WrapPanel>
                            <Button x:Name="ProjectLink" Classes="link" Tag="https://github.com/tfgrass/MeowChan" Click="OnLinkClick"/>
                            <Button x:Name="AuthorLink" Classes="link" Tag="https://github.com/tfgrass" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="LicenseText"/>
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock x:Name="SupportTitle" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SupportDescription"/>
                            <Button x:Name="DonationLink" Classes="link" HorizontalAlignment="Left"
                                    Tag="https://www.paypal.com/donate/?hosted_button_id=5BR4MK748PDSQ" Click="OnLinkClick"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CreditsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="12">
                        <TextBlock x:Name="HistoryText"/>
                        <WrapPanel>
                            <Button Content="YChan" Classes="link" Tag="https://sourceforge.net/projects/ychan/" Click="OnLinkClick"/>
                            <Button Content="Issung / GChan" Classes="link" Tag="https://github.com/Issung/GChan" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="VideoCreditsText"/>
                        <TextBlock x:Name="UICreditsText"/>
                        <TextBlock x:Name="IconsText"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="LicensesTab">
                <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
                    <TextBox x:Name="LicenseSearchBox" Grid.Row="0" TextChanged="OnLicenseSearchChanged"/>
                    <TextBlock x:Name="LicenseHintText" Grid.Row="1" Foreground="{DynamicResource Workspace.Muted}"/>
                    <Grid Grid.Row="2" ColumnDefinitions="230,*" ColumnSpacing="8">
                        <ListBox x:Name="LicenseList" SelectionChanged="OnLicenseSelectionChanged"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                            <SelectableTextBlock x:Name="LicenseMetadataText" TextWrapping="Wrap"/>
                            <TextBox x:Name="LicenseFullText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
            <SelectableTextBlock x:Name="LinkErrorText" Foreground="{DynamicResource Workspace.Error}" TextWrapping="Wrap"/>
            <Button x:Name="CloseButton" Grid.Column="1" MinWidth="96" IsCancel="True" Click="OnCloseButtonClick"/>
        </Grid>
    </Grid>
</Window>
