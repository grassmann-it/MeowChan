<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="oChan.AboutWindow"
        Title="About oChan"
        Icon="avares://oChan/Assets/ochan.png"
        Width="560" Height="570" MinWidth="340" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Workspace.Background}"
        Foreground="{DynamicResource Workspace.Text}">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Foreground" Value="{DynamicResource Workspace.Accent}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,4,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Styles>
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24" Spacing="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="oChan" FontSize="30" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource Workspace.Muted}"/>
                </StackPanel>
                <TextBlock x:Name="DescriptionText" FontSize="15"/>
                <Border Background="{DynamicResource Workspace.Panel}" BorderBrush="{DynamicResource Workspace.Border}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock x:Name="AuthorText"/>
                        <WrapPanel>
                            <Button x:Name="ProjectLink" Classes="link" Tag="https://github.com/tfgrass/oChan" Click="OnLinkClick"/>
                            <Button x:Name="AuthorLink" Classes="link" Tag="https://github.com/tfgrass" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="HistoryText"/>
                        <WrapPanel>
                            <Button Content="YChan" Classes="link" Tag="https://sourceforge.net/projects/ychan/" Click="OnLinkClick"/>
                            <Button Content="Issung / GChan" Classes="link" Tag="https://github.com/Issung/GChan" Click="OnLinkClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="8">
                    <TextBlock x:Name="IconsText" Foreground="{DynamicResource Workspace.Muted}"/>
                    <Button Content="Feather Icons" Classes="link" HorizontalAlignment="Left"
                            Tag="https://github.com/feathericons/feather" Click="OnLinkClick"/>
                    <TextBlock x:Name="LicenseText" Foreground="{DynamicResource Workspace.Muted}" FontSize="12"/>
                    <Button Content="Artistic License 2.0" Classes="link" HorizontalAlignment="Left"
                            Tag="https://github.com/tfgrass/oChan/blob/main/LICENSE" Click="OnLinkClick"/>
                </StackPanel>
                <Border x:Name="LinkErrorPanel" IsVisible="False" Background="{DynamicResource Workspace.Raised}"
                        BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="1" CornerRadius="6" Padding="12">
                    <SelectableTextBlock x:Name="LinkErrorText" TextWrapping="Wrap" Foreground="{DynamicResource Workspace.Error}"/>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0"
                Background="{DynamicResource Workspace.Panel}" Padding="16,12">
            <Button x:Name="CloseButton" HorizontalAlignment="Right" MinWidth="96" IsCancel="True"
                    Click="OnCloseButtonClick"/>
        </Border>
    </Grid>
</Window>
