<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MeowChan.AboutWindow"
        Title="About MeowChan"
        Icon="avares://MeowChan/Assets/meowchan.png"
        Width="800" Height="660" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Workspace.Background}"
        Foreground="{DynamicResource Workspace.Text}">
    <Window.Styles>
        <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="72,*" ColumnSpacing="16" Margin="16,16,16,12">
            <Image x:Name="CatLogo" Width="72" Height="72" Source="avares://MeowChan/Assets/meowchan.png" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock FontSize="26" FontWeight="SemiBold"><Run Text="Meow" Foreground="{DynamicResource Workspace.Text}"/><Run Text="Chan" Foreground="{DynamicResource Workspace.Accent}"/></TextBlock>
                <WrapPanel ItemSpacing="12" LineSpacing="4">
                    <SelectableTextBlock x:Name="VersionText" VerticalAlignment="Center"/>
                    <Button x:Name="CopyVersionButton" Classes="subtle" Click="OnCopyVersionClick"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <TabControl x:Name="AboutTabs" Grid.Row="1" Margin="16,0">
            <TabItem x:Name="AboutTab">
                <ScrollViewer x:Name="AboutScrollViewer" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="12">
                        <TextBlock x:Name="DescriptionText" FontSize="15" TextWrapping="Wrap"/>
                        <TextBlock x:Name="AuthorText"/>
                        <Border x:Name="UpdateSection" Classes="workspace-section">
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="UpdatesTitle" Classes="section-title" />
                                <TextBlock x:Name="UpdateStatusText" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock x:Name="LastUpdateCheckText" Classes="workspace-help" />
                                <Button x:Name="CheckUpdatesButton" HorizontalAlignment="Left" Click="OnCheckUpdatesClick" />
                                <TextBlock x:Name="AvailableUpdateText" AutomationProperties.LiveSetting="Polite" />
                                <WrapPanel x:Name="UpdateActions" ItemSpacing="8" LineSpacing="8">
                                    <Button x:Name="UpdateReleaseButton" Classes="link" Click="OnUpdateReleaseClick" />
                                    <Button x:Name="UpdateDownloadButton" Classes="link" Click="OnUpdateDownloadClick" />
                                    <Button x:Name="SkipUpdateButton" Classes="link" Click="OnSkipUpdateClick" />
                                </WrapPanel>
                                <TextBlock x:Name="UpdateBrowserHint" Classes="workspace-help" />
                                <TextBlock x:Name="UpdatePrivacyText" Classes="workspace-help" />
                                <TextBlock x:Name="UpdateActionErrorText" Classes="workspace-error" AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Border>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button x:Name="ProjectLink" Classes="link" Tag="https://github.com/grassmann-it/MeowChan" Click="OnLinkClick"/>
                            <Button x:Name="AuthorLink" Classes="link" Tag="https://github.com/tfgrass" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="LicenseText"/>
                        <StackPanel Spacing="6" Margin="0,8,0,0">
                            <TextBlock x:Name="SupportTitle" Classes="section-title"/>
                            <TextBlock x:Name="SupportDescription"/>
                            <Button x:Name="DonationLink" Classes="link" HorizontalAlignment="Left"
                                    Tag="https://www.paypal.com/donate/?hosted_button_id=5BR4MK748PDSQ" Click="OnLinkClick"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="CreditsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="12">
                        <TextBlock x:Name="HistoryText"/>
                        <WrapPanel ItemSpacing="8" LineSpacing="8">
                            <Button Content="YChan" Classes="link" Tag="https://sourceforge.net/projects/ychan/" Click="OnLinkClick"/>
                            <Button Content="Issung / GChan" Classes="link" Tag="https://github.com/Issung/GChan" Click="OnLinkClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="VideoCreditsText"/>
                        <TextBlock x:Name="UICreditsText"/>
                        <TextBlock x:Name="IconsText"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="LicensesTab">
                <Grid RowDefinitions="Auto,Auto,*" Margin="8" RowSpacing="8">
                    <TextBox x:Name="LicenseSearchBox" Grid.Row="0" TextChanged="OnLicenseSearchChanged"/>
                    <TextBlock x:Name="LicenseHintText" Grid.Row="1" Classes="workspace-help"/>
                    <Grid Grid.Row="2" ColumnDefinitions="*,2*" ColumnSpacing="8">
                        <ListBox x:Name="LicenseList" SelectionChanged="OnLicenseSelectionChanged"/>
                        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="8">
                            <Expander x:Name="LicenseMetadataExpander" HorizontalAlignment="Stretch" MaxHeight="140">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <SelectableTextBlock x:Name="LicenseMetadataText" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Expander>
                            <TextBox x:Name="LicenseFullText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Classes="workspace-dialog-footer" Margin="0,12,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <SelectableTextBlock x:Name="LinkErrorText" VerticalAlignment="Center" Classes="workspace-error" AutomationProperties.LiveSetting="Assertive"/>
                <Button x:Name="CloseButton" Grid.Column="1" MinWidth="96" IsCancel="True" Click="OnCloseButtonClick"/>
            </Grid>
        </Border>
    </Grid>
</Window>
