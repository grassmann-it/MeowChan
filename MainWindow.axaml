<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeowChan" xmlns:desktop="clr-namespace:MeowChan.Desktop" xmlns:ursa="https://irihi.tech/ursa"
        x:Class="MeowChan.MainWindow" x:DataType="local:MainWindow"
        Width="1380" Height="850" MinWidth="760" MinHeight="500"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="48"
        Title="MeowChan" Icon="avares://MeowChan/Assets/meowchan.png" TextOptions.TextRenderingMode="Antialias">
    <Grid x:Name="WorkspaceRoot" RowDefinitions="48,*,26,52">
        <Border x:Name="WorkspaceTitleBarFrame" Classes="shell-bar" BorderThickness="0,0,0,1">
            <Grid x:Name="WorkspaceTitleBar" ColumnDefinitions="*,Auto" Background="Transparent"
                  WindowDecorationProperties.ElementRole="User" PointerPressed="OnTitleBarPointerPressed">
                <Grid x:Name="WorkspaceHeader" ColumnDefinitions="Auto,*,Auto,Auto" Margin="20,0" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="BrandAboutButton" Classes="subtle" Padding="0" Width="34" Height="34"
                                Background="Transparent" BorderThickness="0" Click="OnBrandAboutClick">
                            <Image x:Name="WorkspaceLogo" Source="avares://MeowChan/Assets/meowchan.png" Width="30" Height="30"
                                   Stretch="Uniform" VerticalAlignment="Center" />
                        </Button>
                        <TextBlock Text="MeowChan" Classes="brand" VerticalAlignment="Center" />
                        <TextBlock x:Name="WorkspaceVersion" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceSubtitle" Grid.Column="1" Tag="shell.subtitle" Classes="localized muted"
                               VerticalAlignment="Center" FontStyle="Italic" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Grid x:Name="TransferSpeed" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <desktop:DownloadSpeedGraph x:Name="TransferSpeedGraph" Width="96" Height="24" IsHitTestVisible="False"
                                                        Stroke="{DynamicResource Workspace.Accent}" Fill="{DynamicResource Workspace.AccentSurface}" />
                            <TextBlock x:Name="TransferSpeedLabel" Grid.Column="1" Width="78" FontSize="11" Classes="mono muted"
                                       VerticalAlignment="Center" Text="↓ 0 B/s" />
                        </Grid>
                        <Button x:Name="ContinueReadingButton" Classes="subtle header-icon" IsVisible="False" />
                        <Button x:Name="PauseButton" Classes="subtle header-icon" Click="OnPauseClick">
                            <Path x:Name="PauseIcon" Classes="header-icon" Data="M 5,3 L 5,13 M 11,3 L 11,13" />
                        </Button>
                        <Button x:Name="FullscreenButton" Classes="subtle header-icon" />
                        <Button x:Name="ThemeToggleButton" Classes="subtle header-icon">
                            <Path x:Name="ThemeToggleIcon" Classes="header-icon" />
                        </Button>
                    </StackPanel>
                    <Menu Grid.Column="3" VerticalAlignment="Center">
                        <MenuItem x:Name="WorkspaceMenuItem" Header="⋯">
                            <MenuItem x:Name="ArchiveMenuItem" Tag="nav.archive" Classes="localized" Header="Archive" Click="OnArchiveNavigationClick" />
                            <!-- URSA-12 shared shell hunk: group manager entry in every workspace mode. -->
                            <MenuItem x:Name="ReaderGroupsMenuItem" Header="Reader groups" />
                            <MenuItem x:Name="RulesMenuItem" Tag="nav.rules" Classes="localized" Header="Rules" Click="OnRulesNavigationClick" />
                            <MenuItem x:Name="PluginsMenuItem" Tag="nav.plugins" Classes="localized" Header="Plugins" Click="OnPluginsNavigationClick" />
                            <MenuItem x:Name="SourcesMenuItem" Tag="nav.sources" Classes="localized" Header="Sources" Click="OnSourcesNavigationClick" />
                            <MenuItem x:Name="DiagnosticsMenuItem" Tag="nav.diagnostics" Classes="localized" Header="Diagnostics" Click="OnDiagnosticsNavigationClick" />
                            <MenuItem x:Name="PauseMenuItem" Header="Pause downloads" Click="OnPauseClick" />
                            <MenuItem x:Name="SettingsMenuItem" Tag="nav.settings" Classes="localized" Header="Settings" />
                            <MenuItem x:Name="AboutMenuItem" Tag="nav.about" Classes="localized" Header="About" />
                            <MenuItem x:Name="ShortcutHelpMenuItem" Header="Keyboard shortcuts" />
                            <Separator />
                            <MenuItem x:Name="ExitMenuItem" Tag="action.exit" Classes="localized" Header="Exit" />
                        </MenuItem>
                    </Menu>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="WindowMinimizeButton" Classes="window-caption" Click="OnWindowMinimizeClick"
                            WindowDecorationProperties.ElementRole="MinimizeButton">
                        <Path Data="M 0,5 L 10,5" Classes="window-caption-icon" />
                    </Button>
                    <Button x:Name="WindowMaximizeButton" Classes="window-caption" Click="OnWindowMaximizeClick"
                            WindowDecorationProperties.ElementRole="MaximizeButton">
                        <Path x:Name="WindowMaximizeIcon" Data="M 0.5,0.5 L 9.5,0.5 L 9.5,9.5 L 0.5,9.5 Z" Classes="window-caption-icon" />
                    </Button>
                    <Button x:Name="WindowCloseButton" Classes="window-caption window-close" Click="OnWindowCloseClick"
                            WindowDecorationProperties.ElementRole="CloseButton">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Classes="window-caption-icon" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid x:Name="WorkspacePages" Grid.Row="1" RowDefinitions="Auto,*">
        <ursa:Banner Grid.Row="0" x:Name="ShellActionErrorBanner" Type="Error" CanClose="False" IsVisible="False" HorizontalContentAlignment="Stretch" Margin="20,8,20,0">
            <Grid x:Name="ShellFeedbackLayout" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="4">
                <ScrollViewer x:Name="ShellActionErrorScroll" Grid.ColumnSpan="2" MaxHeight="64" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ShellActionError" TextWrapping="Wrap" /></ScrollViewer>
                <Button x:Name="ShellFeedbackDiagnosticsButton" Grid.Row="1" Click="OnDiagnosticsNavigationClick" HorizontalAlignment="Left"><TextBlock Tag="feedback.open" Classes="localized" /></Button>
            </Grid>
        </ursa:Banner>
        <Grid Grid.Row="1" x:Name="WorkspaceBody" RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="10">
            <Grid x:Name="WorkspaceHeading" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Tag="downloads.title" Classes="localized page-title" Text="Downloads" />
                <TextBlock Grid.Column="1" Tag="shell.supported" Classes="localized muted" Text="4chan · 8kun" VerticalAlignment="Center" />
            </Grid>
            <ScrollViewer x:Name="WorkspaceIntakeScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <Border x:Name="WorkspaceIntakeCard" Classes="panel" Padding="12,10">
                <StackPanel x:Name="WorkspaceIntakeStack" Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="UrlInput" PlaceholderText="Paste thread or board URLs" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MinHeight="36" MaxHeight="72" VerticalContentAlignment="Center" />
                        <Button x:Name="AddUrlButton" Grid.Column="1" Classes="primary localized" Tag="action.add" Content="Add"
                                MinWidth="100" MinHeight="36" VerticalAlignment="Stretch" Click="OnAddUrl" />
                    </Grid>
                    <TextBlock x:Name="UrlInputHint" Tag="downloads.inputHint" Classes="localized muted" FontSize="13" TextWrapping="Wrap" />
                    <ursa:Banner x:Name="AdmissionRepairPanel" IsVisible="False" Type="Error" CanClose="False" HorizontalContentAlignment="Stretch">
                        <ScrollViewer x:Name="AdmissionRepairScroll" MaxHeight="84" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock x:Name="AdmissionRepairText" TextWrapping="Wrap" FontSize="12" /></ScrollViewer>
                    </ursa:Banner>
                    <Border x:Name="AdmissionResultsPanel" IsVisible="False">
                        <Expander x:Name="AdmissionResultsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <Expander.Header><TextBlock x:Name="AdmissionResultsTitle" Text="URL results" /></Expander.Header>
                            <ScrollViewer x:Name="AdmissionResultsScroll" MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AdmissionResultRows" Spacing="6" Margin="0,6,0,0" />
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>
            </ScrollViewer>
            <Grid x:Name="WorkspaceContentGrid" Grid.Row="2" ColumnDefinitions="*,6,320" RowDefinitions="*,0">
                <Border x:Name="DownloadsPanel" Classes="panel" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="Auto,*">
                        <TabControl x:Name="DownloadsTabs" MinHeight="38" Padding="0" SelectionChanged="OnWorkspaceTabChanged">
                            <TabControl.Styles>
                                <Style Selector="TabItem"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="12" /></Style>
                            </TabControl.Styles>
                            <TabItem x:Name="ThreadsTab" Header="Threads" />
                            <TabItem x:Name="BoardsTab" Header="Boards" />
                        </TabControl>
                                <Grid x:Name="ThreadsResultPanel" Grid.Row="2" Grid.ColumnSpan="2">
<DataGrid x:Name="ThreadsDataGrid"
                              ItemsSource="{Binding VisibleThreads}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" CanUserReorderColumns="True" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Extended"
                              DoubleTapped="OnThreadDoubleTapped"
                              CanUserResizeColumns="True" SelectionChanged="OnWorkspaceSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Source / board" Width="130" SortMemberPath="SourceBoard">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HostName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding BoardLabel}" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BoardName}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <!-- Thread ID Column -->
                            <DataGridTemplateColumn Header="Thread ID" Width="105" SortMemberPath="ThreadNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding ThreadId}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title Column -->
                            <DataGridTemplateColumn Header="Thread / title" Width="*" MinWidth="200" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ThreadId, StringFormat='#{0}'}" Classes="muted inline-thread-id" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Status" Width="160" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Progress Column -->
                            <DataGridTemplateColumn Header="Media / transfer" Width="300" SortMemberPath="Completion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <StackPanel VerticalAlignment="Center" Spacing="0" ToolTip.Tip="{Binding StatusDetails}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Status}" FontSize="12" Classes="muted media-state" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Progress}">
                                                    <TextBlock Text="{Binding CompletedMedia}" Classes="mono" FontSize="12" />
                                                    <TextBlock Text="/" Classes="muted mono" FontSize="12" />
                                                    <TextBlock Text="{Binding SelectedMedia}" Classes="mono" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Text="{Binding ExceptionHint}" IsVisible="{Binding HasExceptionHint}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding ExceptionHint}" />
                                            <ProgressBar AutomationProperties.Name="{Binding Progress}" Value="{Binding Completion}" Minimum="0" Maximum="100" Height="3" MinHeight="0" MaxHeight="3" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Queued" Width="85" SortMemberPath="Queued">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Queued}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active" Width="95" SortMemberPath="Active">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Active}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Missing / errors" Width="140" SortMemberPath="MissingMedia" Binding="{Binding MissingMediaText, DataType=desktop:ThreadRow}" IsVisible="False" />
                            <DataGridTextColumn Header="Earliest retry" Width="160" SortMemberPath="EarliestRetry" Binding="{Binding EarliestRetryText, DataType=desktop:ThreadRow}" IsVisible="False" />
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu><ContextMenu /></DataGrid.ContextMenu>
                    </DataGrid>
                                    <TextBlock x:Name="ThreadsEmptyState" Tag="downloads.empty" Classes="localized muted"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               MaxWidth="360" Margin="28" TextWrapping="Wrap" IsHitTestVisible="False" />
                                </Grid>
                                <Grid x:Name="BoardsResultPanel" Grid.Row="2" Grid.ColumnSpan="2" IsVisible="False">
<DataGrid x:Name="BoardsDataGrid"
                              ItemsSource="{Binding VisibleBoards}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserReorderColumns="True"
                              GridLinesVisibility="Horizontal"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              DoubleTapped="OnBoardDoubleTapped"
                              CanUserResizeColumns="True" SelectionChanged="OnWorkspaceSelectionChanged">
                        <DataGrid.Columns>
                            <!-- Board URL Column -->
                            <DataGridTemplateColumn Header="Source" Width="100" SortMemberPath="HostName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding HostName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Board" Width="200" SortMemberPath="NiceName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding NiceName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" ToolTip.Tip="{Binding ErrorDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu><ContextMenu /></DataGrid.ContextMenu>
                    </DataGrid>
                                    <TextBlock x:Name="BoardsEmptyState" Tag="downloads.boardsEmpty" Classes="localized muted"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               MaxWidth="360" Margin="28" TextWrapping="Wrap" IsHitTestVisible="False" />
                                </Grid>
                        <desktop:ActionToolBar x:Name="WorkspaceListActions" Grid.Column="1"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="8,0,8,0">
                            <Button x:Name="DownloadSearchButton" Classes="localized subtle" Tag="downloads.search" Click="OnDownloadSearchClick" ursa:ToolBar.OverflowMode="Never" FontSize="12" />
                            <Button x:Name="DownloadsColumnsButton" Classes="subtle" Content="Columns" ursa:ToolBar.OverflowMode="AsNeeded" FontSize="12" />
                            <Button x:Name="CopyAllUrlsButton" Tag="action.copyAllUrls" Classes="localized subtle" Content="Copy URLs" ursa:ToolBar.OverflowMode="AsNeeded" FontSize="12" />
                            <Button x:Name="DetailsToggleButton" Classes="subtle" Content="Details" Click="OnDetailsToggleClick" ursa:ToolBar.OverflowMode="Never" FontSize="12" />
                        </desktop:ActionToolBar>
                        <Grid x:Name="DownloadSearchBar" Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" Margin="8,2,8,6" IsVisible="False">
                            <TextBox x:Name="DownloadSearchInput" MinWidth="100" TextChanged="OnDownloadSearchChanged" />
                            <TextBlock x:Name="DownloadSearchSummary" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            <Button x:Name="DownloadSearchClear" Grid.Column="2" Classes="localized subtle" Tag="downloads.searchClear" Click="OnDownloadSearchClear" />
                            <Button x:Name="DownloadSearchClose" Grid.Column="3" Classes="localized subtle" Tag="downloads.searchClose" Click="OnDownloadSearchClose" />
                        </Grid>
                    </Grid>
                </Border>
                <GridSplitter x:Name="WorkspaceInspectorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" Background="Transparent" />
                <Border x:Name="WorkspaceInspector" Grid.Column="2" Classes="panel" MinWidth="260">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Margin="16,10,10,8" ColumnDefinitions="*,Auto">
                            <TextBlock Tag="detail.title" Classes="localized section-title" Text="Details" VerticalAlignment="Center" />
                            <Button x:Name="InspectorCloseButton" Grid.Column="1" Content="×" Classes="subtle" MinWidth="30" Padding="8,2" Click="OnDetailsToggleClick" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,2,16,16" Spacing="12">
                                <TextBlock x:Name="InspectorEmptyState" Tag="detail.empty" Classes="localized muted" TextWrapping="Wrap" />
                                <StackPanel x:Name="InspectorSelection" Spacing="12" IsVisible="False">
                                    <StackPanel Spacing="5">
                                        <TextBlock x:Name="InspectorKind" Classes="muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <SelectableTextBlock x:Name="InspectorSource" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Tag="detail.status" Classes="localized muted" />
                                        <SelectableTextBlock x:Name="InspectorStatus" Grid.Column="1" TextWrapping="Wrap" HorizontalAlignment="Right" />
                                    </Grid>
                                    <StackPanel x:Name="InspectorErrorSection" Spacing="5">
                                        <TextBlock Tag="detail.error" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorError" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <WrapPanel x:Name="InspectorLocalActions" Orientation="Horizontal" IsVisible="False">
                                        <Button x:Name="InspectorReadPosts" Classes="subtle" Margin="0,0,6,6" Click="OnInspectorReadPosts" />
                                        <Button x:Name="InspectorGallery" Classes="subtle" Margin="0,0,6,6" Click="OnInspectorGallery" />
                                        <Button x:Name="InspectorHtmlExport" Classes="subtle" Margin="0,0,6,6" Click="OnInspectorHtmlExport" />
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="InspectorOpenFolderButton" Tag="action.openFolder" Classes="localized subtle" Content="Open folder" Margin="0,0,6,6" Click="OnInspectorOpenFolderClick" />
                                        <Button x:Name="InspectorOpenBrowserButton" Tag="action.openBrowser" Classes="localized subtle" Content="Open in browser" Margin="0,0,6,6" Click="OnInspectorOpenBrowserClick" />
                                        <Button x:Name="InspectorCheckButton" Tag="check.action" Classes="localized subtle" Content="Check now / retry missing" Margin="0,0,6,6" Click="OnCheckSelectionClick" />
                                        <Button x:Name="InspectorMediaRetryButton" Tag="work.retry" Classes="localized subtle" Content="Retry missing media" Margin="0,0,6,6" Click="OnRetryMissingMediaClick" />
                                        <Button x:Name="InspectorCopyUrlButton" Tag="action.copyUrl" Classes="localized subtle" Content="Copy URL" Margin="0,0,6,6" />
                                    </WrapPanel>
                                    <StackPanel x:Name="InspectorMediaSection" Spacing="6">
                                        <TextBlock Tag="detail.progress" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorProgress" FontSize="13" FontWeight="Medium" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InspectorKnownMedia" Classes="muted" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="InspectorProgressBar" Minimum="0" Maximum="100" Height="3" MinHeight="0" MaxHeight="3" />
                                        <TextBlock x:Name="InspectorQueue" Classes="muted" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Tag="detail.url" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorUrl" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Tag="detail.directory" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorDirectory" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <StackPanel Spacing="8">
                                            <Button x:Name="InspectorRemoveButton" Tag="action.remove" Classes="localized subtle danger" Content="Remove" Click="OnInspectorRemoveClick" />
                                            <TextBlock x:Name="InspectorRemoveHint" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <ContentControl Grid.Row="1" x:Name="SettingsPageHost" IsVisible="False" />
        <ContentControl Grid.Row="1" x:Name="DiagnosticsPageHost" IsVisible="False" />
        <ContentControl Grid.Row="1" x:Name="RulesPageHost" IsVisible="False" />
        <ContentControl Grid.Row="1" x:Name="ArchivePageHost" IsVisible="False" />
        <ContentControl Grid.Row="1" x:Name="SourcesPageHost" IsVisible="False" />
        <ContentControl Grid.Row="1" x:Name="PluginsPageHost" IsVisible="False" />
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceStatus" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WorkspaceCounts" Grid.Column="1" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border x:Name="WorkspaceNavigation" Grid.Row="3" Classes="shell-bar" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel x:Name="WorkspaceNavigationButtons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                <Button x:Name="DownloadsNavigationButton" Classes="nav selected" Click="OnDownloadsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 9,1 L 9,12 M 5,8 L 9,12 L 13,8 M 2,13 L 2,17 L 16,17 L 16,13" Width="17" Height="17" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.downloads" Classes="localized" Text="Downloads" />
                    </StackPanel>
                </Button>
                <Button x:Name="ArchiveNavigationButton" Classes="nav localized" Tag="nav.archive" Content="Archive" Click="OnArchiveNavigationClick" />
                <Button x:Name="RulesNavigationButton" Classes="nav localized" Tag="nav.rules" Content="Rules" Click="OnRulesNavigationClick" />
                <Button x:Name="SourcesNavigationButton" Classes="nav localized" Tag="nav.sources" Content="Sources" Click="OnSourcesNavigationClick" />
                <Button x:Name="DiagnosticsNavigationButton" Classes="nav" Click="OnDiagnosticsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 1,10 L 4,10 L 7,3 L 10,16 L 13,10 L 17,10" Width="17" Height="17" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.diagnostics" Classes="localized" Text="Diagnostics" />
                    </StackPanel>
                </Button>
                <Button x:Name="PluginsNavigationButton" Classes="nav" Content="Plugins" Click="OnPluginsNavigationClick" />
                <Button x:Name="ToolsNavigationButton" Classes="nav localized" Tag="nav.tools" Content="Tools">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Tag="nav.archive" Classes="localized" Header="Archive" Click="OnArchiveNavigationClick" />
                            <MenuItem Tag="nav.rules" Classes="localized" Header="Rules" Click="OnRulesNavigationClick" />
                            <MenuItem Tag="nav.plugins" Classes="localized" Header="Plugins" Click="OnPluginsNavigationClick" />
                            <MenuItem Tag="nav.sources" Classes="localized" Header="Sources" Click="OnSourcesNavigationClick" />
                            <MenuItem Tag="nav.diagnostics" Classes="localized" Header="Diagnostics" Click="OnDiagnosticsNavigationClick" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SettingsNavigationButton" Classes="nav" Click="OnSettingsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 2,4 L 16,4 M 2,9 L 16,9 M 2,14 L 16,14 M 5,2 L 5,6 M 11,7 L 11,11 M 7,12 L 7,16" Width="17" Height="17" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.settings" Classes="localized" Text="Settings" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ComboBox x:Name="WorkspaceModeComboBox" Grid.Column="1" Classes="footer-mode" Width="140" VerticalAlignment="Center">
                <ComboBoxItem x:Name="BarebonesModeItem" Tag="Barebones" Content="Barebones" />
                <ComboBoxItem x:Name="SimpleModeItem" Tag="Simple" Content="Simple" />
                <ComboBoxItem x:Name="AdvancedModeItem" Tag="Advanced" Content="Advanced" />
            </ComboBox>
            </Grid>
        </Border>
        <ContentControl x:Name="ReaderHost" Grid.Row="1" Grid.RowSpan="3" IsVisible="False" Background="{DynamicResource Workspace.Background}" />
        <ContentControl x:Name="GalleryHost" Grid.Row="1" Grid.RowSpan="3" IsVisible="False" />
        <Border x:Name="ShellHelpOverlay" Grid.RowSpan="4" IsVisible="False" ZIndex="200"
                Background="{DynamicResource Workspace.Panel}" BorderBrush="{DynamicResource Workspace.Border}"
                BorderThickness="1" CornerRadius="10" Padding="24" Margin="20" MaxWidth="620"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid RowDefinitions="*,Auto" RowSpacing="18">
                <ScrollViewer><TextBlock x:Name="ShellHelpText" TextWrapping="Wrap" /></ScrollViewer>
                <Button x:Name="ShellHelpClose" Grid.Row="1" HorizontalAlignment="Right" />
            </Grid>
        </Border>
    </Grid>
</Window>
