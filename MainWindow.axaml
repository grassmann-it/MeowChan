<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:oChan" xmlns:desktop="clr-namespace:oChan.Desktop"
        x:Class="oChan.MainWindow" x:DataType="local:MainWindow"
        Width="1380" Height="850" MinWidth="760" MinHeight="500"
        Title="oChan" Icon="avares://oChan/Assets/ochan.png">
    <Grid x:Name="WorkspaceRoot" RowDefinitions="48,*,26,52">
        <Border Classes="shell-bar" BorderThickness="0,0,0,1">
            <Grid x:Name="WorkspaceHeader" ColumnDefinitions="Auto,*,Auto,Auto" Margin="20,0" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="oChan" Classes="brand" />
                    <TextBlock x:Name="WorkspaceVersion" Classes="muted" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="WorkspaceSubtitle" Grid.Column="1" Tag="shell.subtitle" Classes="localized muted"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                    <Button x:Name="ThemeToggleButton" Classes="subtle" Content="Light" />
                </StackPanel>
                <Menu Grid.Column="3" VerticalAlignment="Center">
                    <MenuItem x:Name="WorkspaceMenuItem" Header="⋯">
                        <MenuItem x:Name="SettingsMenuItem" Tag="nav.settings" Classes="localized" Header="Settings" />
                        <MenuItem x:Name="AboutMenuItem" Tag="nav.about" Classes="localized" Header="About" />
                        <Separator />
                        <MenuItem x:Name="ExitMenuItem" Tag="action.exit" Classes="localized" Header="Exit" />
                    </MenuItem>
                </Menu>
            </Grid>
        </Border>
        <Grid x:Name="WorkspaceBody" Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="20" RowSpacing="10">
            <Grid x:Name="WorkspaceHeading" ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <TextBlock Tag="downloads.title" Classes="localized page-title" Text="Downloads" />
                <TextBlock Grid.Column="1" Tag="shell.supported" Classes="localized muted" Text="4chan · 8kun" VerticalAlignment="Center" />
            </Grid>
            <Border x:Name="WorkspaceIntakeCard" Grid.Row="1" Classes="panel" CornerRadius="6" Padding="12,10">
                <StackPanel Spacing="7">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox x:Name="UrlInput" Watermark="Paste thread or board URLs" AcceptsReturn="True" TextWrapping="NoWrap"
                                 MinHeight="36" MaxHeight="72" VerticalContentAlignment="Center" />
                        <Button x:Name="AddUrlButton" Grid.Column="1" Classes="primary localized" Tag="action.add" Content="Add"
                                MinWidth="100" MinHeight="36" VerticalAlignment="Stretch" Click="OnAddUrl" />
                    </Grid>
                    <TextBlock x:Name="UrlInputHint" Tag="downloads.inputHint" Classes="localized muted" FontSize="13" TextWrapping="Wrap" />
                    <Border x:Name="AdmissionResultsPanel" IsVisible="False">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                            <Expander.Header><TextBlock x:Name="AdmissionResultsTitle" Text="URL results" /></Expander.Header>
                            <ScrollViewer x:Name="AdmissionResultsScroll" MaxHeight="140" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="AdmissionResultRows" Spacing="6" Margin="0,6,0,0" />
                            </ScrollViewer>
                        </Expander>
                    </Border>
                </StackPanel>
            </Border>
            <Grid x:Name="WorkspaceContentGrid" Grid.Row="2" ColumnDefinitions="*,6,320" RowDefinitions="*,0">
                <Border x:Name="DownloadsPanel" Classes="panel" CornerRadius="8" ClipToBounds="True">
                    <Grid>
                        <TabControl x:Name="DownloadsTabs" Padding="0" SelectionChanged="OnWorkspaceTabChanged">
                            <TabItem x:Name="ThreadsTab" Header="Threads">
                                <Grid>
<DataGrid x:Name="ThreadsDataGrid"
                              ItemsSource="{Binding UrlList}"
                              AutoGenerateColumns="False" HeadersVisibility="Column" CanUserReorderColumns="True" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              DoubleTapped="OnThreadDoubleTapped"
                              CanUserResizeColumns="True" SelectionChanged="OnWorkspaceSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Source / board" Width="130" SortMemberPath="SourceBoard">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HostName}" />
                                            <TextBlock Grid.Column="1" Text="{Binding BoardLabel}" Classes="mono" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BoardName}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>



                            <!-- Thread ID Column -->
                            <DataGridTemplateColumn Header="Thread ID" Width="105" SortMemberPath="ThreadNumber">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding ThreadId}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Title Column -->
                            <DataGridTemplateColumn Header="Thread / title" Width="*" MinWidth="200" SortMemberPath="Title">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ThreadId, StringFormat='#{0}'}" Classes="muted inline-thread-id" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Column -->
                            <DataGridTemplateColumn Header="Status" Width="160" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Progress Column -->
                            <DataGridTemplateColumn Header="Media / transfer" Width="300" SortMemberPath="Completion">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <StackPanel VerticalAlignment="Center" Spacing="3" ToolTip.Tip="{Binding StatusDetails}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding Status}" Classes="muted media-state" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" ToolTip.Tip="{Binding Progress}">
                                                    <TextBlock Text="{Binding CompletedMedia}" Classes="mono" FontSize="12" />
                                                    <TextBlock Text="/" Classes="muted mono" FontSize="12" />
                                                    <TextBlock Text="{Binding KnownMedia}" Classes="mono" FontSize="12" />
                                                </StackPanel>
                                            </Grid>
                                            <ProgressBar Value="{Binding Completion}" Minimum="0" Maximum="100" Height="3" MinHeight="0" MaxHeight="3" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Queued" Width="85" SortMemberPath="Queued">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Queued}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Active" Width="95" SortMemberPath="Active">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:ThreadRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Active}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
 <MenuItem Tag="action.details" Classes="localized" Header="Details" Click="OnOpenWorkspaceDetailsClick" />
 <Separator />
                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" Click="OnOpenThreadDirectoryClick">
                                    <MenuItem.Icon>
                                        <Border Width="16" Height="16" Background="{DynamicResource Workspace.Text}">
                                            <Border.OpacityMask><ImageBrush Source="avares://oChan/Assets/icons/folder.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" Click="OnOpenThreadInBrowserClick">
                                    <MenuItem.Icon>
                                        <Border Width="16" Height="16" Background="{DynamicResource Workspace.Text}">
                                            <Border.OpacityMask><ImageBrush Source="avares://oChan/Assets/icons/external-link.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="ThreadCopyUrlMenuItem" Tag="action.copyUrl" Classes="localized" Header="Copy URL" />
 <Separator />
 <MenuItem Tag="action.remove" Classes="localized" Header="Remove" Click="OnRemoveThreadMenuItemClick">
                                    <MenuItem.Icon>
                                        <Border Width="16" Height="16" Background="{DynamicResource Workspace.Text}">
                                            <Border.OpacityMask><ImageBrush Source="avares://oChan/Assets/icons/delete.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                                    <TextBlock x:Name="ThreadsEmptyState" Tag="downloads.empty" Classes="localized muted"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               MaxWidth="360" Margin="28" TextWrapping="Wrap" IsHitTestVisible="False" />
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="BoardsTab" Header="Boards">
                                <Grid>
<DataGrid x:Name="BoardsDataGrid"
                              ItemsSource="{Binding BoardsList}"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" CanUserReorderColumns="True"
                              GridLinesVisibility="Horizontal"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              DoubleTapped="OnBoardDoubleTapped"
                              CanUserResizeColumns="True" SelectionChanged="OnWorkspaceSelectionChanged">
                        <DataGrid.Columns>
                            <!-- Board URL Column -->
                            <DataGridTemplateColumn Header="Source" Width="100" SortMemberPath="HostName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding HostName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Board" Width="200" SortMemberPath="NiceName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding NiceName}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="*" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="desktop:BoardRow">
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Status}" ToolTip.Tip="{Binding ErrorDetails}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>

                        <!-- ContextMenu for right-clicking on a row -->
                        <DataGrid.ContextMenu>
                            <ContextMenu>
 <MenuItem Tag="action.details" Classes="localized" Header="Details" Click="OnOpenWorkspaceDetailsClick" />
 <Separator />
                                <MenuItem Tag="action.openFolder" Classes="localized" Header="Open folder" Click="OnOpenBoardDirectoryClick">
                                    <MenuItem.Icon>
                                        <Border Width="16" Height="16" Background="{DynamicResource Workspace.Text}">
                                            <Border.OpacityMask><ImageBrush Source="avares://oChan/Assets/icons/folder.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Tag="action.openBrowser" Classes="localized" Header="Open in browser" Click="OnOpenBoardInBrowserClick">
                                    <MenuItem.Icon>
                                        <Border Width="16" Height="16" Background="{DynamicResource Workspace.Text}">
                                            <Border.OpacityMask><ImageBrush Source="avares://oChan/Assets/icons/external-link.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="BoardCopyUrlMenuItem" Tag="action.copyUrl" Classes="localized" Header="Copy URL" />
 <Separator />
 <MenuItem Tag="action.remove" Classes="localized" Header="Remove" Click="OnRemoveBoardMenuItemClick">
                                    <MenuItem.Icon>
                                        <Border Width="16" Height="16" Background="{DynamicResource Workspace.Text}">
                                            <Border.OpacityMask><ImageBrush Source="avares://oChan/Assets/icons/delete.png" Stretch="Uniform" /></Border.OpacityMask>
                                        </Border>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                                    <TextBlock x:Name="BoardsEmptyState" Tag="downloads.boardsEmpty" Classes="localized muted"
                                               VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                                               MaxWidth="360" Margin="28" TextWrapping="Wrap" IsHitTestVisible="False" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                        <StackPanel x:Name="WorkspaceListActions" Orientation="Horizontal" Spacing="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,1,8,0">
                            <Button x:Name="CopyAllUrlsButton" Tag="action.copyAllUrls" Classes="localized subtle" Content="Copy URLs" FontSize="12" />
                            <Button x:Name="DetailsToggleButton" Classes="subtle" Content="Details" Click="OnDetailsToggleClick" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
                <GridSplitter x:Name="WorkspaceInspectorSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                              ResizeDirection="Columns" Background="Transparent" />
                <Border x:Name="WorkspaceInspector" Grid.Column="2" Classes="panel" CornerRadius="8" MinWidth="260">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Margin="16,10,10,8" ColumnDefinitions="*,Auto">
                            <TextBlock Tag="detail.title" Classes="localized section-title" Text="Details" VerticalAlignment="Center" />
                            <Button x:Name="InspectorCloseButton" Grid.Column="1" Content="×" Classes="subtle" MinWidth="30" Padding="8,2" Click="OnDetailsToggleClick" />
                        </Grid>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="16,2,16,16" Spacing="12">
                                <TextBlock x:Name="InspectorEmptyState" Tag="detail.empty" Classes="localized muted" TextWrapping="Wrap" />
                                <StackPanel x:Name="InspectorSelection" Spacing="12" IsVisible="False">
                                    <StackPanel Spacing="5">
                                        <TextBlock x:Name="InspectorKind" Classes="muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <SelectableTextBlock x:Name="InspectorSource" Classes="muted" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <TextBlock Tag="detail.status" Classes="localized muted" />
                                        <SelectableTextBlock x:Name="InspectorStatus" Grid.Column="1" TextWrapping="Wrap" HorizontalAlignment="Right" />
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="InspectorOpenFolderButton" Tag="action.openFolder" Classes="localized subtle" Content="Open folder" Margin="0,0,6,6" Click="OnInspectorOpenFolderClick" />
                                        <Button x:Name="InspectorOpenBrowserButton" Tag="action.openBrowser" Classes="localized subtle" Content="Open in browser" Margin="0,0,6,6" Click="OnInspectorOpenBrowserClick" />
                                        <Button x:Name="InspectorCopyUrlButton" Tag="action.copyUrl" Classes="localized subtle" Content="Copy URL" Margin="0,0,6,6" />
                                    </WrapPanel>
                                    <StackPanel x:Name="InspectorMediaSection" Spacing="6">
                                        <TextBlock Tag="detail.progress" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorProgress" FontSize="13" FontWeight="Medium" />
                                        <ProgressBar x:Name="InspectorProgressBar" Minimum="0" Maximum="100" Height="3" MinHeight="0" MaxHeight="3" />
                                        <TextBlock x:Name="InspectorQueue" Classes="muted" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Tag="detail.url" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorUrl" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Spacing="5">
                                        <TextBlock Tag="detail.directory" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorDirectory" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>

                                    <StackPanel x:Name="InspectorErrorSection" Spacing="5">
                                        <TextBlock Tag="detail.error" Classes="localized muted" FontSize="12" />
                                        <SelectableTextBlock x:Name="InspectorError" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <StackPanel Spacing="8">
                                            <Button x:Name="InspectorRemoveButton" Tag="action.remove" Classes="localized subtle danger" Content="Remove" Click="OnInspectorRemoveClick" />
                                            <TextBlock x:Name="InspectorRemoveHint" Classes="muted" TextWrapping="Wrap" FontSize="12" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource Workspace.Border}" BorderThickness="0,1,0,0" Padding="20,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="WorkspaceStatus" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="WorkspaceCounts" Grid.Column="1" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
        <Border x:Name="WorkspaceNavigation" Grid.Row="3" Classes="shell-bar" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel x:Name="WorkspaceNavigationButtons" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="5">
                <Button x:Name="DownloadsNavigationButton" Classes="nav selected" Click="OnDownloadsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 9,1 L 9,12 M 5,8 L 9,12 L 13,8 M 2,13 L 2,17 L 16,17 L 16,13" Width="17" Height="17" Stroke="{DynamicResource Workspace.Accent}" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.downloads" Classes="localized" Text="Downloads" />
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsNavigationButton" Classes="nav" Click="OnSettingsNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 2,4 L 16,4 M 2,9 L 16,9 M 2,14 L 16,14 M 5,2 L 5,6 M 11,7 L 11,11 M 7,12 L 7,16" Width="17" Height="17" Stroke="{DynamicResource Workspace.Muted}" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.settings" Classes="localized" Text="Settings" />
                    </StackPanel>
                </Button>
                <Button x:Name="AboutNavigationButton" Classes="nav" Click="OnAboutNavigationClick">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <Path Data="M 9,1 A 8,8 0 1 1 8.99,1 M 9,8 L 9,13 M 9,4 L 9,5" Width="17" Height="17" Stroke="{DynamicResource Workspace.Muted}" StrokeThickness="1.5" Stretch="Uniform" />
                        <TextBlock Tag="nav.about" Classes="localized" Text="About" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <ComboBox x:Name="WorkspaceModeComboBox" Grid.Column="1" Classes="footer-mode" Width="140" VerticalAlignment="Center">
                <ComboBoxItem x:Name="BarebonesModeItem" Tag="Barebones" Content="Barebones" />
                <ComboBoxItem x:Name="SimpleModeItem" Tag="Simple" Content="Simple" />
                <ComboBoxItem x:Name="AdvancedModeItem" Tag="Advanced" Content="Advanced" />
            </ComboBox>
            </Grid>
        </Border>
    </Grid>
</Window>
