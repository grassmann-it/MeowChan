<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>libmeowchan</AssemblyName>
    <RootNamespace>MeowChan</RootNamespace>
    <PackageId>libmeowchan</PackageId>
    <Product>MeowChan</Product>
    <Description>MeowChan .NET library for media downloads and offline archives with explicit provider registration. The public API is not stable in 1.x; minor releases may contain breaking changes.</Description>
    <PackageProjectUrl>https://github.com/grassmann-it/MeowChan</PackageProjectUrl>
    <RepositoryUrl>https://github.com/grassmann-it/MeowChan</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>meowchan;imageboard;image-downloader;thread-archiver;offline-archive;html-export;4chan;8kun;cross-platform;dotnet;csharp</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904;RS0016;RS0017</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="NodaTime" Version="3.3.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Serilog" Version="4.0.2" />
    <Compile Include="../Shared/AtomicJsonFile.cs" Link="Persistence/AtomicJsonFile.cs" />
    <Compile Include="../Shared/PerformanceDiagnostics.cs" Link="Diagnostics/PerformanceDiagnostics.cs" />
    <None Include="../LICENSE" Pack="true" PackagePath="/" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
  <Import Project="../plugins/Official/LibraryParsing.targets" />
</Project>
